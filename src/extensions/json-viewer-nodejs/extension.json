{
  "schema": 2,
  "id": "JsonViewerNodeJS",
  "name": "JSON Viewer (nodeJS)",
  "version": "1.2.5",
  "description": "Lightweight alternative to JSON Viewer .NET. Renders JSON files in WebView2 with the Firefox/Chrome JSON Viewer (pd4d10/json-viewer).",
  "runtime": "JavaScript.Node",
  "entryPoint": "main.mjs",
  "web": "https://samandarin.net/",
  "security": {
    "networkAccess": "no",
    "externalProcesses": "no",
    "scriptExecution": "yes",
    "activeWebContent": "yes",
    "elevation": "never"
  },
  "icon": "icon.svg",
  "iconDark": "icon-dark.svg",
  "capabilities": ["ui.dialogs"],
  "events": [],
  "locales": {
    "ar": "locales/ar.json",
    "bg": "locales/bg.json",
    "cs": "locales/cs.json",
    "de": "locales/de.json",
    "el": "locales/el.json",
    "en": "locales/en.json",
    "es": "locales/es.json",
    "fr": "locales/fr.json",
    "he": "locales/he.json",
    "hr": "locales/hr.json",
    "hu": "locales/hu.json",
    "it": "locales/it.json",
    "id": "locales/id.json",
    "ja": "locales/ja.json",
    "ko": "locales/ko.json",
    "nl": "locales/nl.json",
    "pl": "locales/pl.json",
    "pt": "locales/pt.json",
    "ro": "locales/ro.json",
    "ru": "locales/ru.json",
    "sk": "locales/sk.json",
    "sv": "locales/sv.json",
    "tr": "locales/tr.json",
    "uk": "locales/uk.json",
    "vi": "locales/vi.json",
    "zh-CN": "locales/zh-CN.json",
    "zh-TW": "locales/zh-TW.json"
  },
  "viewers": [{
    "name": "JSON Viewer (nodeJS)",
    "patterns": ["*.json"],
    "handler": "viewJson"
  }]
}
