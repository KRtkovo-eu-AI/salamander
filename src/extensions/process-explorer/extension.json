{
  "schema": 2,
  "id": "ProcessExplorer",
  "name": "Process Explorer",
  "version": "1.3.0",
  "description": "Lists running Windows processes in a Salamander file-system panel.",
  "runtime": "PowerShell",
  "entryPoint": "main.ps1",
  "web": "https://samandarin.net/",
  "security": {
    "networkAccess": "no",
    "externalProcesses": "yes",
    "scriptExecution": "yes",
    "activeWebContent": "no",
    "elevation": "never"
  },
  "icon": "icon.svg",
  "iconDark": "icon-dark.svg",
  "capabilities": ["file-system", "process.read", "process.write", "panels.write", "ui.dialogs"],
  "events": [],
  "commands": [{
    "id": "ProcessExplorer.open",
    "title": "Open Process Explorer",
    "path": "salamatrix:ProcessExplorer!processes",
    "menu": "none",
    "toolbar": true,
    "icon": "icon.svg",
    "iconDark": "icon-dark.svg",
    "requires": "any"
  }],
  "locales": {
    "ar": "locales/ar.json",
    "bg": "locales/bg.json",
    "cs": "locales/cs.json",
    "de": "locales/de.json",
    "el": "locales/el.json",
    "en": "locales/en.json",
    "es": "locales/es.json",
    "fr": "locales/fr.json",
    "he": "locales/he.json",
    "hr": "locales/hr.json",
    "hu": "locales/hu.json",
    "id": "locales/id.json",
    "it": "locales/it.json",
    "ja": "locales/ja.json",
    "ko": "locales/ko.json",
    "nl": "locales/nl.json",
    "pl": "locales/pl.json",
    "pt": "locales/pt.json",
    "ro": "locales/ro.json",
    "ru": "locales/ru.json",
    "sk": "locales/sk.json",
    "sv": "locales/sv.json",
    "tr": "locales/tr.json",
    "uk": "locales/uk.json",
    "vi": "locales/vi.json",
    "zh-CN": "locales/zh-CN.json",
    "zh-TW": "locales/zh-TW.json"
  },
  "fileSystems": [{
    "id": "processes",
    "name": "Running Processes",
    "listHandler": "listProcesses",
    "icon": "icon.svg",
    "iconDark": "icon-dark.svg",
    "defaultFileIcon": "default.ico",
    "refreshIntervalMs": 5000,
    "columns": [
      {"id": "pid", "name": "PID", "description": "Process identifier", "width": 72, "numeric": true},
      {"id": "status", "name": "Status", "description": "Process status", "width": 100},
      {"id": "cpu", "name": "CPU", "description": "Current processor usage", "width": 72, "numeric": true},
      {"id": "memory", "name": "Memory", "description": "Active private working set", "width": 110, "numeric": true, "size": true},
      {"id": "userName", "name": "User name", "description": "Account that owns the process", "width": 180}
    ],
    "actions": [
      {"id":"endTask","title":"End task","handler":"endTask"},
      {"id":"endProcessTree","title":"End process tree","handler":"endProcessTree"},
      {"separator":true},
      {"id":"openFileLocation","title":"Open file location","handler":"openFileLocation","refresh":false},
      {"id":"properties","title":"Properties","handler":"properties","refresh":false}
    ]
  }]
}
