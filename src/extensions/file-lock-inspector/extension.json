{
  "schema": 1,
  "id": "FileLockInspector",
  "name": "File Lock Inspector",
  "version": "1.0.3",
  "description": "Find processes that prevent selected files from being changed, moved, or deleted.",
  "runtime": "PowerShell",
  "entryPoint": "main.ps1",
  "web": "https://samandarin.net/",
  "security": {
    "networkAccess": "no",
    "externalProcesses": "no",
    "scriptExecution": "yes",
    "activeWebContent": "no",
    "elevation": "never"
  },
  "icon": "icon.svg",
  "iconDark": "icon-dark.svg",
  "capabilities": [
    "panels.read",
    "panels.write",
    "process.read",
    "process.terminate",
    "ui.dialogs"
  ],
  "events": [],
  "locales": {
    "ar": "locales/ar.json",
    "bg": "locales/bg.json",
    "en": "locales/en.json",
    "cs": "locales/cs.json",
    "de": "locales/de.json",
    "el": "locales/el.json",
    "es": "locales/es.json",
    "fr": "locales/fr.json",
    "he": "locales/he.json",
    "hr": "locales/hr.json",
    "hu": "locales/hu.json",
    "id": "locales/id.json",
    "it": "locales/it.json",
    "ja": "locales/ja.json",
    "ko": "locales/ko.json",
    "nl": "locales/nl.json",
    "pl": "locales/pl.json",
    "pt": "locales/pt.json",
    "ro": "locales/ro.json",
    "ru": "locales/ru.json",
    "sk": "locales/sk.json",
    "sv": "locales/sv.json",
    "tr": "locales/tr.json",
    "uk": "locales/uk.json",
    "vi": "locales/vi.json",
    "zh-CN": "locales/zh-CN.json",
    "zh-TW": "locales/zh-TW.json"
  },
  "commands": [
    {
      "id": "FileLockInspector.inspect",
      "title": "File Lock Inspector...",
      "handler": "inspect",
      "menu": "both",
      "contextMenu": true,
      "toolbar": true,
      "requires": "file"
    }
  ]
}
