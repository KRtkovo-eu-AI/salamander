{
  "schema": 1,
  "id": "OpenSalamander.FileLockInspector",
  "name": "File Lock Inspector",
  "version": "1.0.0",
  "description": "Find processes that prevent selected files from being changed, moved, or deleted.",
  "runtime": "PowerShell",
  "entryPoint": "main.ps1",
  "icon": "icon.svg",
  "iconDark": "icon-dark.svg",
  "capabilities": [
    "panels.read",
    "panels.write",
    "process.read",
    "process.terminate",
    "ui.dialogs"
  ],
  "locales": {
    "en": "locales/en.json",
    "cs": "locales/cs.json",
    "de": "locales/de.json",
    "es": "locales/es.json",
    "fr": "locales/fr.json",
    "hu": "locales/hu.json",
    "nl": "locales/nl.json",
    "ro": "locales/ro.json",
    "ru": "locales/ru.json",
    "sk": "locales/sk.json",
    "zh-CN": "locales/zh-CN.json"
  },
  "commands": [
    {
      "id": "OpenSalamander.FileLockInspector.inspect",
      "title": "File Lock Inspector...",
      "handler": "inspect",
      "menu": "both",
      "contextMenu": true,
      "toolbar": false,
      "requires": "file"
    }
  ]
}
