{
  "schema": 2,
  "id": "Salamatrix.Demo.JavaScriptNode",
  "name": "Salamatrix Node Demo",
  "version": "1.4.0",
  "description": "Demonstrates commands, Viewer and a simple panel file system in a Node.js Salamatrix extension package.",
  "runtime": "JavaScript.Node",
  "entryPoint": "main.mjs",
  "icon": "icon.svg",
  "capabilities": ["ui.dialogs", "storage", "file-system"],
  "commands": [{
    "id": "Salamatrix.Demo.JavaScriptNode.run",
    "title": "Run Node demo",
    "handler": "run",
    "menu": "both",
    "contextMenu": true,
    "toolbar": true,
    "requires": "any"
  }],
  "viewers": [{
    "name": "Node demo Viewer",
    "patterns": ["*.smxview"],
    "handler": "viewDemo"
  }],
  "fileSystems": [{
    "id": "demo-machines",
    "name": "Demo machines",
    "listHandler": "listDemoMachines",
    "icon": "icon.svg",
    "refreshIntervalMs": 5000,
    "actions": [
      {"id": "inspect", "title": "Inspect", "handler": "inspectDemoMachine", "default": true},
      {"id": "toggle", "title": "Toggle state", "handler": "toggleDemoMachine"}
    ]
  }]
}
