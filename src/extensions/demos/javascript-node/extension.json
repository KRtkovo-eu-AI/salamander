{
  "schema": 2,
  "id": "Salamatrix.Demo.JavaScriptNode",
  "name": "Salamatrix Node Demo",
  "version": "1.4.1",
  "description": "Demonstrates commands, Viewer and a simple panel file system in a Node.js Salamatrix extension package.",
  "runtime": "JavaScript.Node",
  "entryPoint": "main.mjs",
  "web": "https://samandarin.net/",
  "security": {
    "networkAccess": "no",
    "externalProcesses": "no",
    "scriptExecution": "yes",
    "activeWebContent": "no",
    "elevation": "never"
  },
  "icon": "icon.svg",
  "capabilities": ["ui.dialogs", "storage", "file-system"],
  "events": [],
  "commands": [{
    "id": "Salamatrix.Demo.JavaScriptNode.run",
    "title": "Run Node demo",
    "handler": "run",
    "menu": "both",
    "contextMenu": true,
    "toolbar": true,
    "requires": "any"
  }],
  "viewers": [{
    "name": "Node demo Viewer",
    "patterns": ["*.smxview"],
    "handler": "viewDemo"
  }],
  "fileSystems": [{
    "id": "demo-machines-nodejs",
    "name": "Demo machines Node.js",
    "listHandler": "listDemoMachines",
    "icon": "icon.svg",
      "refreshIntervalMs": 0,
    "refreshDepth": 1,
    "columns": [{"id":"state","name":"State","description":"Machine state","width":100}],
    "actions": [
      {"id": "inspect", "title": "Inspect", "handler": "inspectDemoMachine", "default": true},
      {"id": "toggle", "title": "Toggle state", "handler": "toggleDemoMachine", "refresh": true}
    ]
  }]
}
