{
  "schema": 2,
  "id": "Salamatrix.Demo.PHP",
  "name": "Salamatrix PHP Demo",
  "version": "1.4.1",
  "description": "Demonstrates commands, Viewer and a simple panel file system in a PHP CLI Salamatrix extension package.",
  "runtime": "PHP.CLI",
  "entryPoint": "main.php",
  "web": "https://samandarin.net/",
  "security": {
    "networkAccess": "no",
    "externalProcesses": "no",
    "scriptExecution": "yes",
    "activeWebContent": "no",
    "elevation": "never"
  },
  "icon": "icon.svg",
  "capabilities": ["ui.dialogs", "storage", "file-system"],
  "events": [],
  "commands": [{"id":"Salamatrix.Demo.PHP.run","title":"Run PHP demo","handler":"run","menu":"both","contextMenu":true,"toolbar":true,"requires":"any"}],
  "viewers": [{
    "name": "PHP demo Viewer",
    "patterns": ["*.smxphpview"],
    "handler": "viewDemo"
  }],
  "fileSystems": [{
    "id": "demo-machines-php",
    "name": "Demo machines PHP",
    "listHandler": "listDemoMachines",
    "icon": "icon.svg",
      "refreshIntervalMs": 0,
    "refreshDepth": 1,
    "columns": [{"id":"state","name":"State","description":"Machine state","width":100}],
    "actions": [
      {"id": "inspect", "title": "Inspect", "handler": "inspectDemoMachine", "default": true},
      {"id": "toggle", "title": "Toggle state", "handler": "toggleDemoMachine", "refresh": true}
    ]
  }]
}
