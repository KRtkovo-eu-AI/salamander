{
  "schema": 2,
  "id": "Salamatrix.Demo.Python",
  "name": "Salamatrix Python Demo",
  "version": "1.4.1",
  "description": "Demonstrates commands, Viewer and a simple panel file system in a CPython Salamatrix extension package.",
  "runtime": "Python.CPython",
  "entryPoint": "main.py",
  "icon": "icon.svg",
  "capabilities": ["ui.dialogs", "storage", "file-system"],
  "commands": [{"id":"Salamatrix.Demo.Python.run","title":"Run Python demo","handler":"run","menu":"both","contextMenu":true,"toolbar":true,"requires":"any"}],
  "viewers": [{
    "name": "Python demo Viewer",
    "patterns": ["*.smxpyview"],
    "handler": "viewDemo"
  }],
  "fileSystems": [{
    "id": "demo-machines",
    "name": "Demo machines",
    "listHandler": "listDemoMachines",
    "icon": "icon.svg",
    "refreshIntervalMs": 5000,
    "actions": [
      {"id": "inspect", "title": "Inspect", "handler": "inspectDemoMachine", "default": true},
      {"id": "toggle", "title": "Toggle state", "handler": "toggleDemoMachine"}
    ]
  }]
}
