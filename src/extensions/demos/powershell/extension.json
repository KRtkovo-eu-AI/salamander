{
  "schema": 2,
  "id": "Salamatrix.Demo.PowerShell",
  "name": "Salamatrix PowerShell Demo",
  "version": "1.4.1",
  "description": "Demonstrates commands, Viewer and a simple panel file system in a PowerShell Salamatrix extension package.",
  "runtime": "PowerShell",
  "entryPoint": "main.ps1",
  "icon": "icon.svg",
  "capabilities": ["ui.dialogs", "storage", "file-system"],
  "events": [],
  "commands": [{"id":"Salamatrix.Demo.PowerShell.run","title":"Run PowerShell demo","handler":"run","menu":"both","contextMenu":true,"toolbar":true,"requires":"any"}],
  "viewers": [{
    "name": "PowerShell demo Viewer",
    "patterns": ["*.smxpsview"],
    "handler": "viewDemo"
  }],
  "fileSystems": [{
    "id": "demo-machines-powershell",
    "name": "Demo machines PowerShell",
    "listHandler": "listDemoMachines",
    "icon": "icon.svg",
      "refreshIntervalMs": 0,
    "refreshDepth": 1,
    "columns": [{"id":"state","name":"State","description":"Machine state","width":100}],
    "actions": [
      {"id": "inspect", "title": "Inspect", "handler": "inspectDemoMachine", "default": true},
      {"id": "toggle", "title": "Toggle state", "handler": "toggleDemoMachine", "refresh": true}
    ]
  }]
}
