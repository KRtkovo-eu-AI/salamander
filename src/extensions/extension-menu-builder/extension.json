{
  "schema": 1,
  "id": "ExtensionMenuBuilder",
  "name": "Extension Menu Builder",
  "version": "1.1.2",
  "description": "Create and edit simple menu-driven Salamatrix extensions interactively.",
  "runtime": "PowerShell",
  "entryPoint": "main.ps1",
  "web": "https://samandarin.net/",
  "security": {
    "networkAccess": "no",
    "externalProcesses": "no",
    "scriptExecution": "yes",
    "activeWebContent": "no",
    "elevation": "never"
  },
  "icon": "icon.svg",
  "iconDark": "icon-dark.svg",
  "capabilities": [
    "panels.read",
    "ui.dialogs"
  ],
  "events": [],
  "locales": {
    "ar": "locales/ar.json",
    "bg": "locales/bg.json",
    "cs": "locales/cs.json",
    "de": "locales/de.json",
    "el": "locales/el.json",
    "en": "locales/en.json",
    "es": "locales/es.json",
    "fr": "locales/fr.json",
    "he": "locales/he.json",
    "hr": "locales/hr.json",
    "hu": "locales/hu.json",
    "id": "locales/id.json",
    "it": "locales/it.json",
    "ja": "locales/ja.json",
    "ko": "locales/ko.json",
    "nl": "locales/nl.json",
    "pl": "locales/pl.json",
    "pt": "locales/pt.json",
    "ro": "locales/ro.json",
    "ru": "locales/ru.json",
    "sk": "locales/sk.json",
    "sv": "locales/sv.json",
    "tr": "locales/tr.json",
    "uk": "locales/uk.json",
    "vi": "locales/vi.json",
    "zh-CN": "locales/zh-CN.json",
    "zh-TW": "locales/zh-TW.json"
  },
  "commands": [
    {
      "id": "ExtensionMenuBuilder.open",
      "title": "Extension Menu Builder...",
      "handler": "open",
      "menu": "plugin",
      "contextMenu": false,
      "toolbar": true
    }
  ]
}
