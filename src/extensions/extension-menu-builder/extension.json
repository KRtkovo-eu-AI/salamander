{
  "schema": 1,
  "id": "OpenSalamander.ExtensionMenuBuilder",
  "name": "Extension Menu Builder",
  "version": "1.0.0",
  "description": "Create and edit simple menu-driven Salamatrix extensions interactively.",
  "runtime": "PowerShell",
  "entryPoint": "main.ps1",
  "icon": "icon.svg",
  "iconDark": "icon-dark.svg",
  "capabilities": [
    "panels.read",
    "ui.dialogs"
  ],
  "locales": {
    "en": "locales/en.json",
    "cs": "locales/cs.json",
    "de": "locales/de.json",
    "es": "locales/es.json",
    "fr": "locales/fr.json",
    "hu": "locales/hu.json",
    "nl": "locales/nl.json",
    "ro": "locales/ro.json",
    "ru": "locales/ru.json",
    "sk": "locales/sk.json",
    "zh-CN": "locales/zh-CN.json"
  },
  "commands": [
    {
      "id": "OpenSalamander.ExtensionMenuBuilder.open",
      "title": "Extension Menu Builder...",
      "handler": "open",
      "menu": "plugin",
      "contextMenu": false,
      "toolbar": true
    }
  ]
}
