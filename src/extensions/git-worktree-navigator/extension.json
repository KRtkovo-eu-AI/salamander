{
  "schema": 1,
  "id": "GitWorktreeNavigator",
  "name": "Git Worktree Navigator",
  "version": "1.0.2",
  "description": "Browse, open, create, and safely remove Git worktrees from Open Salamander.",
  "runtime": "PowerShell",
  "entryPoint": "main.ps1",
  "web": "https://samandarin.net/",
  "security": {
    "networkAccess": "possible",
    "externalProcesses": "yes",
    "scriptExecution": "yes",
    "activeWebContent": "no",
    "elevation": "never"
  },
  "icon": "icon.svg",
  "iconDark": "icon-dark.svg",
  "capabilities": [
    "panels.read",
    "panels.write",
    "ui.dialogs"
  ],
  "events": [],
  "locales": {
    "ar": "locales/ar.json",
    "bg": "locales/bg.json",
    "cs": "locales/cs.json",
    "de": "locales/de.json",
    "el": "locales/el.json",
    "en": "locales/en.json",
    "es": "locales/es.json",
    "fr": "locales/fr.json",
    "he": "locales/he.json",
    "hr": "locales/hr.json",
    "hu": "locales/hu.json",
    "id": "locales/id.json",
    "it": "locales/it.json",
    "ja": "locales/ja.json",
    "ko": "locales/ko.json",
    "nl": "locales/nl.json",
    "pl": "locales/pl.json",
    "pt": "locales/pt.json",
    "ro": "locales/ro.json",
    "ru": "locales/ru.json",
    "sk": "locales/sk.json",
    "sv": "locales/sv.json",
    "tr": "locales/tr.json",
    "uk": "locales/uk.json",
    "vi": "locales/vi.json",
    "zh-CN": "locales/zh-CN.json",
    "zh-TW": "locales/zh-TW.json"
  },
  "commands": [
    {
      "id": "GitWorktreeNavigator.open",
      "title": "Git Worktree Navigator...",
      "handler": "open",
      "menu": "both",
      "contextMenu": true,
      "toolbar": true,
      "toolbarMenu": true,
      "icon": "icon.svg",
      "iconDark": "icon-dark.svg",
      "requiresExecutable": "git.exe",
      "requires": "disk"
    },
    {
      "id": "GitWorktreeNavigator.commit",
      "title": "Git Commit...",
      "handler": "commit",
      "menu": "both",
      "contextMenu": true,
      "toolbar": false,
      "icon": "commit.svg",
      "iconDark": "commit-dark.svg",
      "requiresExecutable": "git.exe",
      "requires": "disk"
    },
    {
      "id": "GitWorktreeNavigator.createLocalRepository",
      "title": "Git Create Local Repository",
      "handler": "createLocalRepository",
      "menu": "both",
      "contextMenu": true,
      "toolbar": false,
      "icon": "repository.svg",
      "iconDark": "repository-dark.svg",
      "requiresExecutable": "git.exe",
      "requires": "disk"
    }
  ]
}
