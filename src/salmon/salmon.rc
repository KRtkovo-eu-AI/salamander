#endif //APSTUDIO_INVOKED

#include <winres.h>
#include "..\plugins\shared\spl_vers.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "manifest.xml"

1 ICON "res\\salmon.ico"

1 VERSIONINFO
 FILEVERSION 1,0,3,VERSINFO_BUILDNUMBER
 PRODUCTVERSION VERSINFO_SALAMANDER_MAJOR,VERSINFO_SALAMANDER_MINORA,VERSINFO_SALAMANDER_MINORB,VERSINFO_BUILDNUMBER
 FILEFLAGSMASK 0x0L
 FILEFLAGS 0x0L
 FILEOS 0x4L
 FILETYPE 0x1L  // VFT_APP=0x1
 FILESUBTYPE 0x0L
{
 BLOCK "StringFileInfo"
 {
  BLOCK "040904b0"
  {
   VALUE "CompanyName", "Open Samandarin\0"
   VALUE "FileDescription", "Open Samandarin Bug Reporter\0"
   VALUE "FileVersion", "1.0\0"
   VALUE "InternalName", "salmon\0"
   VALUE "OriginalFilename", "salmon.exe\0"
   VALUE "LegalCopyright", "Copyright \251 2012-2026 Open Salamander Authors, Open Samandarin Authors\0"
   VALUE "ProductVersion", VERSINFO_SALAMANDER_VERSION "\0"
   VALUE "ProductName", "Open Samandarin\0"
  }
 }
 BLOCK "VarFileInfo"
 {
  VALUE "Translation", 0x0409, 0x04b0
 }
}
