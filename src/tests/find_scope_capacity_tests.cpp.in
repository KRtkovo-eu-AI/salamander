struct CFindLogItem {};
struct FakeLog {
    std::vector<std::string> rows, paths;
    void Clean() { rows.clear(); paths.clear(); }
    void Add(DWORD, const char* text, const char* path) { rows.emplace_back(text); paths.emplace_back(path ? path : ""); }
    int GetErrorCount() const { return static_cast<int>(rows.size()); }
    int GetInfoCount() const { return 0; }
    int GetCount() const { return static_cast<int>(rows.size()); }
    const CFindLogItem* Get(int) const { static CFindLogItem item; return &item; }
    bool CopySnapshotTo(FakeLog& target) const { target.rows = rows; target.paths = paths; return true; }
};
struct FakeHeader { int errors = 0; void SetErrorsInfosCount(int value, int) { errors = value; } };
struct FakeLvi { int iItem = 0, iSubItem = 0, iImage = 0; };
static std::vector<std::string> summaryRows;
#define ListView_InsertItem(hwnd, item) 0
#define ListView_SetItemText(hwnd, index, column, text) do { if ((column) == 1) summaryRows.emplace_back(text); } while (0)
using CFindLog = FakeLog;
static int selectedLogRow = -1, executedDialogs = 0;
static unsigned dialogReasons = 0;
static int dialogLogRows = -1;
#define CALL_STACK_MESSAGE1(message) do {} while (0)
#define LVNI_SELECTED 0
#define ListView_GetNextItem(hwnd, start, flags) selectedLogRow
