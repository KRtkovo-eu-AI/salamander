namespace UacF7 {
struct ListingSession { bool covers = false, open = true; bool IsOpen() const { return open; } bool Contains(const std::wstring&) const { return covers; } };
struct PreparedLeaf { bool PrepareView(const std::wstring&) { return true; } };
}
@@SESSIONS_TYPE@@
struct FixtureSize { DWORD LoDWord = 0, HiDWord = 0; };
struct CFoundFilesData { DWORD Attr = 0; FixtureSize Size; FILETIME LastWrite{}; std::shared_ptr<const UacF7::PreparedLeaf> FoundView; };
static bool failPrepare, stopAfterPrepare, failStart, failAllocation;
static DWORD finishError;
static int starts, preparations, finishes, omitted, reused;
static std::vector<size_t> preparedScopes;
static UacF7::ListingSession* reusedSession;
static bool mismatchedSession;
static bool preparedKnownIdentity;
struct FindProtectedRequest {
    std::wstring path;
    CMaskGroup* masks = nullptr;
    bool singleFile = false;
    DWORD attributes = 0;
    UacF7::ListingSession session;
    bool Prepare(CGrepData* data, std::wstring name, CMaskGroup* mask, BOOL, int,
                 const std::shared_ptr<CFindIgnore>&, size_t scope, const WIN32_FIND_DATAW* file, const std::wstring&,
                 std::shared_ptr<const UacF7::PreparedLeaf> known, bool) {
        if (failAllocation) throw std::bad_alloc();
        preparedScopes.push_back(scope);
        preparedKnownIdentity = known != nullptr;
        ++preparations; path = std::move(name); masks = mask; singleFile = file != nullptr;
        attributes = file ? file->dwFileAttributes : 0;
        if (stopAfterPrepare) data->StopSearch = true;
        return !failPrepare;
    }
    bool Matches(const std::wstring& name, const CMaskGroup* mask, bool file) const {
        return path == name && masks == mask && singleFile == file;
    }
    bool MergeRefinedRow(const WIN32_FIND_DATAW& file) const { return attributes == file.dwFileAttributes; }
    bool Start() { ++starts; return !failStart; }
    UacF7::ListingSession* Finish(CDuplicateCandidates*) { ++finishes; return nullptr; }
    UacF7::ListingSession& ActiveSession() { return session; }
    UacF7::ListingSession* FinishWithSession(UacF7::ListingSession& approved, CDuplicateCandidates*) {
        if (reusedSession && reusedSession != &approved) mismatchedSession = true;
        reusedSession = &approved; ++finishes; ++reused; return nullptr;
    }
    DWORD BatchFailure() const { return finishError; }
    void OmitAfterFailure(DWORD) { ++omitted; }
};
std::wstring SalPathRemoveExtendedPrefixW(const wchar_t* path) { return path; }
@@QUEUE@@
static int digestAuthorizations;
static DWORD digestAuthorizationResult;
DWORD AuthorizeFindFile(CGrepData*, const std::wstring&, UacF7::ListingSession& session, bool) {
    ++digestAuthorizations; if (!digestAuthorizationResult) { session.open = true; session.covers = true; } return digestAuthorizationResult;
}
std::wstring FindSearchRootForFile(CGrepData*, const std::wstring&, bool& recursive) { recursive = false; return L"C:\\"; }
static DWORD DigestDenied(CGrepData* data, CFoundFilesData* file, size_t& remainingFileConsents, UacF7::ListingSession* approved = nullptr, UacF7::ListingSession* existingDigest = nullptr)
{
    DWORD error = ERROR_ACCESS_DENIED;
    bool scoped = false;
    const std::wstring fullPath = L"C:\\file";
    UacF7::ListingSession localSession;
    localSession.open = false;
    auto& digestSession = existingDigest ? *existingDigest : localSession;
    UacF7::PreparedLeaf deniedFile;
    bool verifyDeniedFile = false;
    UacF7::ListingSession* protectedSession = approved;
@@DIGEST_DENIED@@
    if (scoped && !protectedSession) return ERROR_INVALID_DATA;
    return error;
}
struct FIND_LOG_ITEM { DWORD Flags; const char* Text; const char* Path; };
std::string SalWideToMultiBytePath(const wchar_t* path, UINT) {
    std::string result; while (*path) result.push_back(static_cast<char>(*path++)); return result;
}
