enum class FindQueueResult { Added, Stopped, Limit, Failed };
constexpr size_t maxFindProtectedScopes = 32;
constexpr DWORD FLI_ERROR = 1;
constexpr int IDS_UAC_FIND_SCOPE_LIMIT = 1;
constexpr int IDS_UAC_FIND_SCOPE_LIMIT_CARRIED = 2;
constexpr int IDS_FIND_ACTIVITY_INCOMPLETE = 3, IDS_FIND_NO_DUPS_FOUND = 4, IDS_FIND_NO_FILES_FOUND = 5;
constexpr int IDS_FIND_ACTIVITY_INCOMPLETE_OTHER = 6, IDS_FIND_INCOMPLETE_DIRECTORY_CAPACITY = 7,
              IDS_FIND_INCOMPLETE_SCAN_BUDGET = 8, IDS_FIND_INCOMPLETE_DEPTH = 9,
              IDS_FIND_INCOMPLETE_REPARSE = 10, IDS_FIND_INCOMPLETE_PROTECTED_FAILURE = 11,
              IDS_FINDLOG_ERROR = 12, IDS_ERRORTITLE = 13;
constexpr int SB_SETTEXT = 1, SBT_NOBORDERS = 2;
constexpr WORD CM_FIND_APPEND = 100, CM_FIND_INTERSECT = 101, CM_FIND_SUBTRACT = 102;
struct CMaskGroup {};
struct CFindIgnore {};
struct CDuplicateCandidates {};
struct Root { std::wstring path; };
struct CGrepData {
    std::atomic_bool StopSearch{false};
    unsigned IncompleteReasons = FindIncompleteNone;
    bool FindDuplicates = false;
    bool failLog = false;
    int Refine = 0;
    std::shared_ptr<Root> ProtectedRoot;
    std::vector<std::string> logs;
};
const char* LoadStr(int id) {
    if (id == IDS_FIND_ACTIVITY_INCOMPLETE) return "Incomplete (admin limit)";
    if (id == IDS_FIND_ACTIVITY_INCOMPLETE_OTHER) return "Incomplete (see log)";
    if (id == IDS_FIND_INCOMPLETE_DIRECTORY_CAPACITY) return "Directory capacity";
    if (id == IDS_FIND_INCOMPLETE_SCAN_BUDGET) return "Scan budget";
    if (id == IDS_FIND_INCOMPLETE_DEPTH) return "Depth";
    if (id == IDS_FIND_INCOMPLETE_REPARSE) return "Reparse";
    if (id == IDS_FIND_INCOMPLETE_PROTECTED_FAILURE) return "Protected failure";
    if (id == IDS_FINDLOG_ERROR) return "Error";
    if (id == IDS_FIND_NO_DUPS_FOUND) return "No duplicates";
    if (id == IDS_FIND_NO_FILES_FOUND) return "No files";
    return id == IDS_UAC_FIND_SCOPE_LIMIT_CARRIED ? "Earlier limit %s; items were not searched." :
                                                   "Limit %s; this search is incomplete.";
}
const char* GetErrorText(DWORD) { return "error"; }
void AddFindLog(CGrepData* data, DWORD, const char* text, const char* path) {
    if (!data->failLog) data->logs.emplace_back(std::string(text) + "|" + path);
}
