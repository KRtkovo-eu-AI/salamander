    CFindLogDialog() = default;
    CFindLogDialog(HWND, FakeLog* log, unsigned reasons) : Log(log), shownReasons(reasons) {}
    unsigned shownReasons = 0;
    void Execute() { ++executedDialogs; dialogReasons = shownReasons; dialogLogRows = Log->GetCount(); }
    const CFindLogItem* GetSelectedItem();
};
