struct CFileData { char* Name; char* Ext; size_t NameLen; };
struct CFilesArray
{
    std::vector<CFileData> Data;
    int Count = 0;
    CFileData& At(int index) { return Data.at(index); }
    void Add(const char* name)
    {
        char* text = const_cast<char*>(name);
        Data.push_back({text, strrchr(text, '.') + 1, strlen(text)}); ++Count;
    }
};
struct CIconData { int Index; int GetIndex() const { return Index; } int GetFlag() const { return 1; } };
struct CIconCache
{
    std::vector<std::string> Names;
    std::vector<CIconData> Data;
    CIconList List;
    CIconSizeEnum Size = ICONSIZE_16;
    CIconSizeEnum GetIconSize() const { return Size; }
    CIconData& At(int index) { return Data.at(index); }
    void Add(const char* name, int image) { Data.push_back({static_cast<int>(Data.size())}); Names.push_back(name); List.Images.push_back(image); }
    BOOL GetIndex(const char* name, int& index, void*, void*)
    {
        auto found = std::find(Names.begin(), Names.end(), name);
        index = static_cast<int>(found - Names.begin()); return found != Names.end();
    }
    BOOL GetIcon(int index, CIconList** list, int* slot) { *list = &List; *slot = index; return TRUE; }
};
CAssociations Associations;
