int Failures = 0, Checks = 0;
#define CHECK(condition, message) do { ++Checks; if (!(condition)) { ++Failures; std::cerr << "FAIL: " << message << "\n"; } } while (0)
int AddAssociation(const char* extension, int semantic = -1, bool overwrite = false)
{
    char padded[64] = {}; strcpy(padded, extension);
    int index; Associations.GetIndex(extension, index);
    CAssociationData data = {}; data.SetIndexAll(semantic); data.SetFlag(1);
    LONG size;
    Associations.InsertData("test", index, overwrite, padded, padded + strlen(padded), data, size, "", "");
    return index;
}
int CachedImage(int association, int pixels)
{
    int slot = Associations.GetPixelIconIndex(association, pixels);
    return slot < 0 ? slot : Associations.Icons.at(pixels).Images.at(slot);
}

void TestDynamicAndStatic()
{
    for (int pixels : {16, 24, 32, 48})
        for (auto logical : {ICONSIZE_16, ICONSIZE_32, ICONSIZE_48})
        {
            Associations.Clear();
            int exe = AddAssociation("exe", -2);
            CFilesWindow panel; panel.Pixels = pixels; panel.IconCache->Size = logical;
            panel.Add("first.exe", 101); panel.Add("second.exe", 202);
            panel.Deliver(0); panel.Deliver(1);
            CHECK(Associations[exe].GetIndex(logical) == -2, "dynamic EXE must retain per-file semantics");
            CHECK(Associations.GetPixelIconIndex(exe, pixels) == -1, "no EXE may seed the shared extension cache");
            BOOL load = FALSE;
            char extension[] = "exe";
            Associations.IsAssociated(extension, load, logical, pixels);
            CHECK(load, "EXE in the next directory must still load its own icon");
            CHECK(panel.ExtensionRepaints == 0, "dynamic delivery must not repaint every EXE");
        }

    Associations.Clear();
    int pdf = AddAssociation("pdf");
    CFilesWindow panel; panel.Add("first.pdf", 301); panel.Add("second.pdf", 302);
    for (int pixels : {16, 24, 32, 48})
    {
        panel.Pixels = pixels;
        BOOL load = FALSE; char extension[] = "pdf";
        Associations.IsAssociated(extension, load, ICONSIZE_16, pixels);
        CHECK(load, "static association must load for each missing pixel size");
        panel.Deliver(0); panel.Deliver(1);
        CHECK(CachedImage(pdf, pixels) == 301, "static files must share the first loaded image at this size");
        CHECK(Associations[pdf].GetIndex(ICONSIZE_16) >= 0, "static semantic marker becomes loaded");
    }
    for (int pixels : {16, 24, 32, 48})
        CHECK(CachedImage(pdf, pixels) == 301, "loading another size must preserve existing pixel caches");
}

void SeedMappings()
{
    Associations.Clear(); AddAssociation("bbb"); AddAssociation("ddd"); AddAssociation("fff");
    for (int pixels : {16, 24, 32, 48})
        for (int index = 0; index < 3; ++index)
            Associations.SetPixelIconIndex(index, pixels, pixels * 100 + index);
}
void CheckKnownMappings()
{
    for (int pixels : {16, 24, 32, 48})
        for (int oldIndex = 0; oldIndex < 3; ++oldIndex)
        {
            int index; const char* names[] = {"bbb", "ddd", "fff"};
            CHECK(Associations.GetIndex(names[oldIndex], index), "existing extension survives insertion");
            CHECK(Associations.GetPixelIconIndex(index, pixels) == pixels * 100 + oldIndex, "new association must not steal or shift another extension's icon");
        }
}
void TestInsertion()
{
    for (const char* added : {"aaa", "ccc", "zzz"})
    {
        SeedMappings(); int inserted = AddAssociation(added); CheckKnownMappings();
        for (int pixels : {16, 24, 32, 48})
            CHECK(Associations.GetPixelIconIndex(inserted, pixels) == -1, "new extension starts uncached at every size");
    }
    SeedMappings();
    // Run the real lazy shell discovery caller, not only InsertData directly.
    BOOL load = FALSE; char extension[8] = "ccc";
    CHECK(Associations.IsAssociated(extension, load, ICONSIZE_16, 16) && load, "shell discovery schedules the new extension");
    CheckKnownMappings();
    int inserted; Associations.GetIndex("ccc", inserted);
    CHECK(Associations.GetPixelIconIndex(inserted, 16) == -3, "new shell association has its own pending slot");

    SeedMappings(); Associations.PixelIconSets[0].AssociationIndexes.resize(1);
    inserted = AddAssociation("ccc");
    CHECK(Associations.GetPixelIconIndex(0, 16) == 1600, "sparse prefix stays associated with its original extension");
    CHECK(Associations.GetPixelIconIndex(inserted, 16) == -1, "sparse map miss remains uncached");
    CHECK(Associations.GetPixelIconIndex(3, 24) == 2402, "dense map still shifts alongside sparse map");
    Associations.SetPixelIconIndex(3, 16, 999);
    CHECK(Associations.GetPixelIconIndex(3, 16) == 999 && Associations.GetPixelIconIndex(inserted, 16) == -1, "sparse map may grow safely after insertion");

    SeedMappings(); AddAssociation("ddd", -1, true);
    for (int pixels : {16, 24, 32, 48})
    {
        CHECK(Associations.GetPixelIconIndex(1, pixels) == -1, "replaced association invalidates its own pixels");
        CHECK(Associations.GetPixelIconIndex(2, pixels) == pixels * 100 + 2, "replacement preserves neighboring association");
    }
    SeedMappings(); Associations.FailInsert = true; AddAssociation("ccc");
    CHECK(!Associations.IsGood() && Associations.Count == 3, "legacy array failure does not publish an association");
    CheckKnownMappings();
    SeedMappings(); Associations.Data.reserve(Associations.Count + 1);
    for (auto& set : Associations.PixelIconSets) set.AssociationIndexes.shrink_to_fit();
    FailNewCountdown = 1; // 16px grows successfully, 24px throws, 32px/48px succeed.
    AddAssociation("ccc");
    FailNewCountdown = -1;
    CHECK(Associations.GetPixelIconIndex(2, 24) == -1, "allocation failure discards unsafe pixel mapping");
    CHECK(Associations.GetPixelIconIndex(2, 16) == 1601 && Associations.GetPixelIconIndex(2, 32) == 3201, "allocation failure preserves other pixel-size maps");
}

int main()
{
    for (int i = 0; i < 256; ++i) LowerCase[i] = static_cast<unsigned char>(i >= 'A' && i <= 'Z' ? i + 'a' - 'A' : i);
    TestDynamicAndStatic(); TestInsertion();
    std::cout << "association_icon_cache_tests: " << Checks << " checks, " << Failures << " failures\n";
    return Failures == 0 ? 0 : 1;
}
