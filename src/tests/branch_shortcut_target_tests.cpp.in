enum CPanelType {ptDisk,ptZIPArchive,ptPluginFS};
struct CFileData {std::string Key,Text;wchar_t* NameW=nullptr;char* Name=nullptr;DWORD Attr=0;std::wstring Full;
 bool UseWideName()const{return NameW&&NameW[0];}};
struct Rows {int Count=0;std::vector<CFileData> Data;CFileData& At(int i){return Data.at(size_t(i));}};
class CFilesWindow {
public:
 BOOL Branch=TRUE,Current=TRUE,ChangeOK=TRUE,Redirect=FALSE;CPanelType Type=ptDisk;ULONGLONG Generation=1,PanelTabId=17;HWND HWindow=nullptr;
 std::wstring Root,Changed,FocusedWide;std::string RootA,Focus;Rows FileRows,DirRows;Rows *Files=&FileRows,*Dirs=&DirRows;int Caret=0,Changes=0,SetCarets=0;
 void Set(const std::wstring& root,const std::wstring& full){Root=root;RootA=SalWideToMultiBytePath(root.c_str(),CP_UTF8);FileRows.Data.resize(1);FileRows.Count=1;auto& f=FileRows.Data[0];f.Key="identity";f.Full=full;f.Text="input.lnk";f.Name=f.Text.data();}
 BOOL Is(CPanelType t){return t==Type;}CPanelType GetPanelType(){return Type;}BOOL IsBranchView(){return Branch;}
 const wchar_t* GetPathW(){return Root.c_str();}const char* GetPath(){return RootA.c_str();}ULONGLONG GetBranchViewGeneration(){return Generation;}
 const char* GetItemCacheKeyPtr(const CFileData& f){return f.Key.c_str();}
 const CFileData* GetBranchViewFileByCacheKey(const char* key){return Branch&&Current&&Files->Count&&Files->At(0).Key==key?&Files->At(0):nullptr;}
 std::wstring GetItemFullPathW(const CFileData& f){return f.Full;}int GetCaretIndex(){return Caret;}
 BOOL ChangePathToDiskW(HWND,const wchar_t* path,int=-1,const char* focus=nullptr){++Changes;Changed=path;Focus=focus?focus:"";if(!ChangeOK)return FALSE;Root=Redirect?L"C:\\wrong rescue":path;RootA=SalWideToMultiBytePath(Root.c_str(),CP_UTF8);Branch=FALSE;Type=ptDisk;
 FileRows.Data.clear();FileRows.Count=0;if(focus){FileRows.Data.resize(2);FileRows.Count=2;FileRows.Data[0].Text="wrong";FileRows.Data[0].Name=FileRows.Data[0].Text.data();FileRows.Data[1].Text=Focus;FileRows.Data[1].Name=FileRows.Data[1].Text.data();}return TRUE;}
 void SetCaretIndex(int i,BOOL){++SetCarets;const auto& f=Files->At(i-Dirs->Count);FocusedWide=f.UseWideName()?f.NameW:SalMultiByteToWidePath(f.Name,CP_UTF8);}
 void FocusShortcutTarget(CFilesWindow*);void FocusBranchShortcutTarget(CFilesWindow*,const CFileData&);
};
static std::wstring FakeTarget,LoadedSource;static HRESULT LoadResult=S_OK,ResolveResult=S_OK,PathResult=S_OK,CreateResult=S_OK,QueryResult=S_OK;
static int PidlMode=0;static std::unordered_set<void*> FakePidls;static std::function<void()> OnPidl;
static BOOL Fake=FALSE,Unterminated=FALSE;static DWORD ResolveFlags=0;static std::function<void()> OnLoad,OnResolve,OnGetPath;
struct FakePersist final:IPersistFile {
 HRESULT STDMETHODCALLTYPE QueryInterface(REFIID,void** p)override{*p=nullptr;return E_NOINTERFACE;}ULONG STDMETHODCALLTYPE AddRef()override{return 1;}ULONG STDMETHODCALLTYPE Release()override{++Releases;return 0;}
 HRESULT STDMETHODCALLTYPE GetClassID(CLSID*)override{return E_NOTIMPL;}HRESULT STDMETHODCALLTYPE IsDirty()override{return S_FALSE;}
 HRESULT STDMETHODCALLTYPE Load(LPCOLESTR path,DWORD mode)override{++Loads;LoadedSource=path;if(mode!=STGM_READ)++Failed;if(OnLoad)OnLoad();return LoadResult;}
 HRESULT STDMETHODCALLTYPE Save(LPCOLESTR,BOOL)override{return E_NOTIMPL;}HRESULT STDMETHODCALLTYPE SaveCompleted(LPCOLESTR)override{return E_NOTIMPL;}HRESULT STDMETHODCALLTYPE GetCurFile(LPOLESTR*)override{return E_NOTIMPL;}
} Persist;
struct FakeLink final:IShellLinkW {
 HRESULT STDMETHODCALLTYPE QueryInterface(REFIID iid,void** p)override{*p=nullptr;if(iid==IID_IPersistFile&&QueryResult==S_OK){*p=&Persist;return S_OK;}return QueryResult==S_OK?E_NOINTERFACE:QueryResult;}
 ULONG STDMETHODCALLTYPE AddRef()override{return 1;}ULONG STDMETHODCALLTYPE Release()override{++Releases;return 0;}
 HRESULT STDMETHODCALLTYPE GetPath(LPWSTR path,int n,WIN32_FIND_DATAW*,DWORD flags)override{++Paths;if(flags!=SLGP_UNCPRIORITY)++Failed;if(OnGetPath)OnGetPath();if(Unterminated){for(int i=0;i<n;++i)path[i]=L'x';}else wcscpy_s(path,size_t(n),FakeTarget.c_str());return PathResult;}
 HRESULT STDMETHODCALLTYPE GetIDList(PIDLIST_ABSOLUTE* out)override{*out=nullptr;if(OnPidl)OnPidl();if(PidlMode==0)return E_NOTIMPL;if(PidlMode==3)return S_OK;if(PidlMode==2){HRESULT r=SHGetKnownFolderIDList(FOLDERID_RecycleBinFolder,0,nullptr,out);if(r!=S_OK)return r;}else {HRESULT r=SHParseDisplayName(FakeTarget.c_str(),nullptr,out,0,nullptr);if(r!=S_OK)return r;}FakePidls.insert(*out);return PidlMode==4?E_FAIL:S_OK;}HRESULT STDMETHODCALLTYPE SetIDList(PCIDLIST_ABSOLUTE)override{return E_NOTIMPL;}
 HRESULT STDMETHODCALLTYPE GetDescription(LPWSTR,int)override{return E_NOTIMPL;}HRESULT STDMETHODCALLTYPE SetDescription(LPCWSTR)override{return E_NOTIMPL;}
 HRESULT STDMETHODCALLTYPE GetWorkingDirectory(LPWSTR,int)override{return E_NOTIMPL;}HRESULT STDMETHODCALLTYPE SetWorkingDirectory(LPCWSTR)override{return E_NOTIMPL;}
 HRESULT STDMETHODCALLTYPE GetArguments(LPWSTR,int)override{return E_NOTIMPL;}HRESULT STDMETHODCALLTYPE SetArguments(LPCWSTR)override{return E_NOTIMPL;}
 HRESULT STDMETHODCALLTYPE GetHotkey(WORD*)override{return E_NOTIMPL;}HRESULT STDMETHODCALLTYPE SetHotkey(WORD)override{return E_NOTIMPL;}
 HRESULT STDMETHODCALLTYPE GetShowCmd(int*)override{return E_NOTIMPL;}HRESULT STDMETHODCALLTYPE SetShowCmd(int)override{return E_NOTIMPL;}
 HRESULT STDMETHODCALLTYPE GetIconLocation(LPWSTR,int,int*)override{return E_NOTIMPL;}HRESULT STDMETHODCALLTYPE SetIconLocation(LPCWSTR,int)override{return E_NOTIMPL;}
 HRESULT STDMETHODCALLTYPE SetRelativePath(LPCWSTR,DWORD)override{return E_NOTIMPL;}HRESULT STDMETHODCALLTYPE Resolve(HWND,DWORD flags)override{++Resolves;ResolveFlags=flags;if(OnResolve)OnResolve();return ResolveResult;}
 HRESULT STDMETHODCALLTYPE SetPath(LPCWSTR)override{return E_NOTIMPL;}
} Link;
static HRESULT NativeCreate(REFCLSID cls,LPUNKNOWN outer,DWORD context,REFIID iid,LPVOID* object){++Creates;if(Fake){*object=CreateResult==S_OK?&Link:nullptr;return CreateResult;}return CoCreateInstance(cls,outer,context,iid,object);}
static void CountedPidlFree(void* p){FakePidls.erase(p);CoTaskMemFree(p);}
#define CoTaskMemFree CountedPidlFree
#define CoCreateInstance NativeCreate
