// Only the production callback/state/converter are injected. UI, panel storage and
// link-size queries are deterministic dependencies; no archive algorithm is copied.
#define WIN32_LEAN_AND_MEAN
#define NOMINMAX
#include <windows.h>
#include <climits>
#include <cstdio>
#include <cstring>
#include <memory>
#include <new>
#include <string>
