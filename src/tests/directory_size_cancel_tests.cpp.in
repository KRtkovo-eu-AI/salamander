// | Date | Summary | Reason | Ticket | Model |
// | 2026-11-11 | Distinguish consent refusal from an item cancellation. | Share only a declined Windows prompt. | #731 | GPT-6.1 Terra |
// | 2026-11-10 | Model copy planning in the shared scan fixture. | Compile the production error branch without changing size assertions. | #731 | GPT-6.1 Sol |
// | 2026-11-10 | Exercise Skip, Skip All, Cancel and Windows refusal. | Verify readable totals after declined elevation. | #731 | GPT-6.1 Sol |
// | 2026-11-10 | Model incomplete directory deletion in the scan fixture. | Compile the shared error branch after the protected delete change. | #731 | GPT-6.1 Sol |
// The error branch and storage are extracted verbatim from production. UI is a
// recording facade; paths include actual UTF-8 bytes, not a shortened surrogate.
#define _CRT_SECURE_NO_WARNINGS // Match production headers; retain /GS and /WX.
#define WIN32_LEAN_AND_MEAN
#define NOMINMAX
#include <windows.h>
#include <algorithm>
#include <cstdio>
#include <cstring>
#include <string>
#include <vector>
#include <cstdlib>
#define SAL_MAX_PATH 32768
static const int SAL_MAX_EXTENDED_PATH = SAL_MAX_PATH;
using std::max;
@@HEADER@@
@@BUFFER@@
static constexpr int IDS_CANNOTREADDIR=1,IDS_ERRORTITLE=2,IDS_MSGBOXBTN_SKIP=3,IDS_MSGBOXBTN_SKIPALL=4;
static constexpr int DIALOG_YES=IDYES,DIALOG_NO=IDNO,MSGBOXEX_DEFBUTTON3=MB_DEFBUTTON3,MSGBOXEX_SILENT=0;
struct MSGBOXEX_PARAMS {HWND HParent; UINT Flags; const char* Caption; const char* Text; const char* AliasBtnNames;};
static struct {HWND HWindow=nullptr;} MainWindowObject;
static auto MainWindow=&MainWindowObject;
static bool BadPattern=false;
static const char* Pattern=nullptr;
static const char* LoadStr(int id) {
    if(id==IDS_CANNOTREADDIR)return BadPattern?"%n":Pattern;
    return id==IDS_MSGBOXBTN_SKIP?"Skip":id==IDS_MSGBOXBTN_SKIPALL?"Skip All":"Error";
}
static const char* GetErrorText(DWORD) {return "(3) The system cannot find the path specified. %n %s";}
static BOOL ErrListDirSkipAll=FALSE;
static int Choice=IDCANCEL,Dialogs=0,Checks=0,Failures=0;
static std::string Shown;
static int SalMessageBoxEx(MSGBOXEX_PARAMS* params) {
    ++Dialogs;Shown=params->Text;
    if(params->Flags!=(MB_YESNOCANCEL|MB_ICONEXCLAMATION|MSGBOXEX_DEFBUTTON3|MSGBOXEX_SILENT))++Failures;
    return Choice;
}
static void Check(bool ok,const char* label){++Checks;if(!ok){++Failures;std::printf("FAIL %s\n",label);}}
// Called through a non-inlined boundary so the original /GS cookie is tested on
// return, just like Esc/Cancel unwinding the recursive application call.
__declspec(noinline) static BOOL ReadError(char* sourcePath,char* sourceEnd,char* targetEnd,DWORD err) {
@@STORAGE@@
    [[maybe_unused]] bool directoryDeleteIncomplete = false;
    [[maybe_unused]] const bool copyTreeEntry = false;
    [[maybe_unused]] int createDirIndex = -1;
    struct
    {
        int Count = 0;
        struct Entry { char* SourceName = nullptr; char* TargetName = nullptr; } Value;
        Entry& At(int) { return Value; }
        void Delete(int) {}
        bool IsGood() const { return true; }
        void ResetState() {}
    } state;
    [[maybe_unused]] auto* script = &state;
@@ERROR@@
    return TRUE;
}
#if @@HAS_PROTECTED_SKIP@@
static BOOL ProtectedReadResult(int choice, DWORD inventoryError, char* sourceEnd, char* targetEnd,
                                bool& incomplete, bool& declined, bool consentDeclined)
{
    struct { bool CountSizeIncomplete = false; } scriptState;
    struct Scope { bool ElevationDeclined = false; void DeclineElevation() { ElevationDeclined = true; } } scope;
    auto* script = &scriptState;
    auto* sizeScope = &scope;
    const BOOL proceed = [&]() -> BOOL {
@@PROTECTED_SKIP@@
        return TRUE;
    }();
    incomplete = scriptState.CountSizeIncomplete;
    declined = scope.ElevationDeclined;
    return proceed;
}
#endif
struct Golden {const char* Pattern;const char* Expected;int Count;};
static const Golden Patterns[]={
@@PATTERNS@@
};
int main(){
    SetErrorMode(SEM_FAILCRITICALERRORS|SEM_NOGPFAULTERRORBOX);
    _set_abort_behavior(0,_WRITE_ABORT_MSG|_CALL_REPORTFAULT);
    for(const auto& row:Patterns){
        CPathBuffer textBuffer(2*SAL_MAX_PATH+100);
        const bool ok=row.Count==1?Salamander::LocalizedText::Write(textBuffer.Data(),textBuffer.Capacity(),row.Pattern,"PATH"):
            Salamander::LocalizedText::Write(textBuffer.Data(),textBuffer.Capacity(),row.Pattern,"PATH","ERROR");
        Check(ok&&std::string(textBuffer.Data())==row.Expected,"real localized error and confirmation patterns");
    }
    std::vector<std::string> paths={"C:\\owned\\child",u8"C:\\owned\\東京",u8"C:\\café\\one\\東京"};
    std::string utf8Short="C:\\";for(int i=0;i<100;++i)utf8Short+=u8"東";paths.push_back(utf8Short+"\\child");
    std::string deep=u8"C:\\owned\\東京";for(int i=0;i<100;++i)deep+=u8"\\deep-東%n";paths.push_back(deep+"\\child");
    paths.push_back("\\\\server\\share\\"+std::string(31000,'x')+"\\child");
    for(const auto& path:paths)for(bool hasTarget:{false,true})for(int choice:{IDYES,IDNO,IDCANCEL}){
        std::vector<char> source(SAL_MAX_PATH,0);strcpy_s(source.data(),source.size(),path.c_str());
        const auto parent=path.substr(0,path.rfind('\\'));
        char target[]="C:\\target\\child";char* targetEnd=hasTarget?target+9:nullptr;
        Choice=choice;Dialogs=0;Shown.clear();ErrListDirSkipAll=FALSE;BadPattern=false;
        Pattern="Cannot read directory \"%s\".\n%s";
        const BOOL ok=ReadError(source.data(),source.data()+parent.size(),targetEnd,ERROR_PATH_NOT_FOUND);
        Check(ok==(choice!=IDCANCEL),"Skip/Skip All continue, Cancel unwinds safely");
        Check(Dialogs==1&&Shown=="Cannot read directory \""+path+"\".\n"+GetErrorText(3),"complete path and error reach dialog without overflow or format injection");
        Check(source.data()==parent,"source path restored before dialog result");
        Check(!hasTarget||std::string(target)=="C:\\target","target path restored");
        Check(ErrListDirSkipAll==(choice==IDNO),"Skip All state preserved");
    }
    for(bool skipAll:{false,true}){
        std::string path=deep+"\\child";std::vector<char> source(SAL_MAX_PATH,0);strcpy_s(source.data(),source.size(),path.c_str());
        const auto parent=path.substr(0,path.rfind('\\'));
        ErrListDirSkipAll=skipAll;Dialogs=0;BadPattern=true;SetLastError(0);
        Check(!ReadError(source.data(),source.data()+parent.size(),nullptr,ERROR_PATH_NOT_FOUND),"malformed resource refuses operation, even with Skip All");
        Check(Dialogs==0&&GetLastError()==ERROR_INVALID_DATA&&source.data()==parent,"no malformed dialog and path restored on formatting failure");
    }
#if @@HAS_PROTECTED_SKIP@@
    for (const int choice : {IDYES, IDNO, IDCANCEL, IDOK})
    {
        bool incomplete = false, declined = false;
        const DWORD error = choice == IDOK ? ERROR_CANCELLED : ERROR_SUCCESS;
        ErrListDirSkipAll = FALSE;
        char source = 's', target = 't';
        int bytes = 17; // one readable sibling already counted
        const BOOL proceed = ProtectedReadResult(choice, error, &source, &target, incomplete, declined, choice == IDOK);
        if (proceed)
            bytes += 27; // the sibling following the inaccessible subtree
        Check(proceed == (choice != IDCANCEL) && bytes == (choice == IDCANCEL ? 17 : 44),
              "only canceling the entire scan stops before the next readable sibling");
        Check(incomplete == (choice != IDCANCEL) && declined == (choice == IDOK),
              "skips mark partial results and Windows cancellation suppresses another attempt in this tree");
        Check(ErrListDirSkipAll == (choice == IDNO) && !source && !target,
              "skip all applies only when selected and restores both paths");
    }
    {
        bool incomplete = false, declined = false;
        char source = 's', target = 't';
        Check(ProtectedReadResult(IDOK, ERROR_CANCELLED, &source, &target, incomplete, declined, false) &&
              incomplete && !declined,
              "an item-level inventory cancellation does not decline the batch consent");
    }
#endif
    std::printf("Directory size error/cancel: %d checks, %d failures.\n",Checks,Failures);
    return Failures?1:0;
}
