// Production policy/dispatch are injected. Plugin storage, InitDLL and callbacks
// are explicit recording facades; no DLL, GUI or file operation runs here.
#define WIN32_LEAN_AND_MEAN
#include <windows.h>
#include <cstdio>
#include <cstring>
#include <vector>
#define CALL_STACK_MESSAGE5(...) ((void)0)
#define TRACE_E(...) ((void)0)
@@CONSTANTS@@
enum { pmitItemOrSeparator,pmitStartSubmenu,pmitEndSubmenu };
struct CPluginMenuItem { int Type=pmitItemOrSeparator;const char* Name="Compare";int SUID=50003;int ID=1; };
template<class T> struct Array { std::vector<T> Items;int Count=0;T operator[](int i){return Items.at(i);}void Add(T p){Items.push_back(p);Count=static_cast<int>(Items.size());} };
struct CFilesWindow { bool Branch=true;bool IsBranchView() const{return Branch;} };
struct CSalamanderForOperations { explicit CSalamanderForOperations(CFilesWindow*){} };
struct InterfaceStub { bool Loaded=true;int Calls=0,LastID=-1;bool NotEmpty()const{return Loaded;}bool LastHadOperations=false;DWORD LastMask=99;BOOL ExecuteMenuItem(CSalamanderForOperations* operation,HWND,int id,DWORD mask){++Calls;LastID=id;LastHadOperations=operation!=nullptr;LastMask=mask;return TRUE;} };
struct MENU_ITEM_INFO {};
struct CPluginData {
 const char* DLLName="filecomp\\filecomp.spl";const char* Version="test";
 Array<CPluginMenuItem*> MenuItems;InterfaceStub PluginIfaceForMenuExt;
 BOOL GetMenuItemStateType(int,int,MENU_ITEM_INFO*){return TRUE;}
 int InitCalls=0;BOOL InitDLL(HWND){++InitCalls;return TRUE;}DWORD GetMaskForMenuItems(int){return 7;}
 BOOL IsBranchCommandAllowed(int id);
 BOOL ExecutePostedMenuItem(CFilesWindow*,HWND,int,BOOL);
 BOOL ExecuteMenuItem(CFilesWindow*,HWND,int,int,BOOL&);
 BOOL ExecuteMenuItem2(CFilesWindow*,HWND,int,int,BOOL&);
 BOOL ExecuteToolbarCommand(CFilesWindow*,HWND,int,int,BOOL&);
};
struct CPlugins { void CalculateStateCache(){} BOOL ExecuteCommand(int,int,CFilesWindow*,HWND); Array<CPluginData*> Data;int LastChanges=0;void SetLastPlgCmd(const char*,int){++LastChanges;}int GetCount(){return Data.Count;}CPluginData* Get(int i){return i>=0&&i<Data.Count?Data[i]:nullptr;} } Plugins;
@@POLICY@@
@@SUID_GATE@@
@@DISPATCH@@
@@HOTKEY@@
static int Checks=0,Failures=0;
static void Check(bool value,const char* text){++Checks;if(!value){++Failures;printf("FAIL: %s\n",text);}}
int main(){
 CFilesWindow panel;CPluginData plugin;CPluginMenuItem item;plugin.MenuItems.Add(&item);Plugins.Data.Add(&plugin);
 Check(plugin.IsBranchCommandAllowed(1)!=FALSE,"known comparator command accepted");
 Check(!plugin.IsBranchCommandAllowed(2),"unknown comparator command refused");
 Check(BranchReadOnlyCommandAllowed(item.SUID),"SUID resolved to exact plugin and command");
 Check(!BranchReadOnlyCommandAllowed(item.SUID+1),"unregistered SUID refused");
 Check(!BranchReadOnlyCommandAllowed(CM_PLUGINCMD_MIN-1)&&!BranchReadOnlyCommandAllowed(CM_PLUGINCMD_MAX+1),"range boundaries refused");
 for(const char* dll: {"unknown\\filecomp.spl","filecomp.spl","C:\\plugins\\filecomp\\filecomp.spl","custom\\zip.spl",static_cast<const char*>(nullptr)}){
  plugin.DLLName=dll;Check(!plugin.IsBranchCommandAllowed(1)&&!BranchReadOnlyCommandAllowed(item.SUID),"unknown/custom/absolute DLL identity refused");
  BOOL unselect=TRUE;int before=Plugins.LastChanges;
  Check(plugin.ExecuteMenuItem(&panel,NULL,0,item.SUID,unselect)&&!unselect,"blocked SUID handled without unselect");
  Check(!plugin.ExecuteMenuItem2(&panel,NULL,0,1,unselect)&&!unselect,"direct blocked ID refused");
  Check(!plugin.ExecuteToolbarCommand(&panel,NULL,0,1,unselect)&&!unselect,"toolbar blocked ID refused");
  Check(!Plugins.ExecuteCommand(0,0,&panel,NULL),"hotkey blocked before initialization");
  Check(!plugin.ExecutePostedMenuItem(&panel,NULL,1,FALSE)&&!plugin.ExecutePostedMenuItem(&panel,NULL,1,TRUE),"unknown plugin refused by both posted contexts");
  Check(plugin.InitCalls==0&&plugin.PluginIfaceForMenuExt.Calls==0&&Plugins.LastChanges==before,"blocked command cannot initialize/call DLL or update last command");
 }
 plugin.DLLName="zip\\zip.spl";item.ID=3;
 Check(plugin.IsBranchCommandAllowed(3)&&BranchReadOnlyCommandAllowed(item.SUID),"verified ZIP Test Archive accepted");
 for(int route=0;route<4;++route){BOOL unselect=FALSE;BOOL result=route==0?plugin.ExecuteMenuItem(&panel,NULL,0,item.SUID,unselect):route==1?plugin.ExecuteMenuItem2(&panel,NULL,0,3,unselect):route==2?plugin.ExecuteToolbarCommand(&panel,NULL,0,3,unselect):(unselect=Plugins.ExecuteCommand(0,0,&panel,NULL));Check(result&&unselect&&plugin.PluginIfaceForMenuExt.LastID==3,"ZIP test passes each actual dispatcher");}
 Check(!plugin.IsBranchCommandAllowed(2),"ZIP repair command remains refused");
 item.ID=1;Check(plugin.IsBranchCommandAllowed(1)&&BranchReadOnlyCommandAllowed(item.SUID),"verified ZIP Create SFX accepted");
 for(int route=0;route<4;++route){BOOL unselect=FALSE;BOOL result=route==0?plugin.ExecuteMenuItem(&panel,NULL,0,item.SUID,unselect):route==1?plugin.ExecuteMenuItem2(&panel,NULL,0,1,unselect):route==2?plugin.ExecuteToolbarCommand(&panel,NULL,0,1,unselect):(unselect=Plugins.ExecuteCommand(0,0,&panel,NULL));Check(result&&unselect&&plugin.PluginIfaceForMenuExt.LastID==1,"ZIP SFX passes each actual dispatcher");}
 item.ID=4;Check(plugin.IsBranchCommandAllowed(4)&&BranchReadOnlyCommandAllowed(item.SUID),"verified ZIP Comment accepted");
 for(int route=0;route<4;++route){BOOL unselect=FALSE;BOOL result=route==0?plugin.ExecuteMenuItem(&panel,NULL,0,item.SUID,unselect):route==1?plugin.ExecuteMenuItem2(&panel,NULL,0,4,unselect):route==2?plugin.ExecuteToolbarCommand(&panel,NULL,0,4,unselect):(unselect=Plugins.ExecuteCommand(0,0,&panel,NULL));Check(result&&unselect&&plugin.PluginIfaceForMenuExt.LastID==4,"ZIP comment passes each actual dispatcher");}
 for(const char* dll:{"zip.spl","custom\\zip.spl"}){plugin.DLLName=dll;Check(!plugin.IsBranchCommandAllowed(3),"custom ZIP DLL identity refused");}
 item.ID=1;
 plugin.DLLName="7zip\\7zip.spl";item.ID=1;
 Check(plugin.IsBranchCommandAllowed(1)&&BranchReadOnlyCommandAllowed(item.SUID),"verified 7-Zip focused Test Archive accepted");
 for(int route=0;route<4;++route){BOOL unselect=FALSE;BOOL result=route==0?plugin.ExecuteMenuItem(&panel,NULL,0,item.SUID,unselect):route==1?plugin.ExecuteMenuItem2(&panel,NULL,0,1,unselect):route==2?plugin.ExecuteToolbarCommand(&panel,NULL,0,1,unselect):(unselect=Plugins.ExecuteCommand(0,0,&panel,NULL));Check(result&&unselect&&plugin.PluginIfaceForMenuExt.LastID==1,"7-Zip test passes each actual dispatcher");}
 Check(!plugin.IsBranchCommandAllowed(0)&&!plugin.IsBranchCommandAllowed(2),"unregistered 7-Zip IDs refused");
 for(const char* dll:{"7zip.spl","custom\\7zip.spl"}){plugin.DLLName=dll;Check(!plugin.IsBranchCommandAllowed(1),"custom 7-Zip identity refused");}
 plugin.DLLName="renamer\\renamer.spl";
 Check(plugin.IsBranchCommandAllowed(1)&&BranchReadOnlyCommandAllowed(item.SUID),"verified Batch Rename command accepted");
 Check(!plugin.IsBranchCommandAllowed(2),"unregistered Renamer Undo command remains refused");
 plugin.DLLName="checksum\\checksum.spl";
 Check(plugin.IsBranchCommandAllowed(1)&&BranchReadOnlyCommandAllowed(item.SUID),"verified Checksum Calculate accepted");
 item.ID=2;Check(plugin.IsBranchCommandAllowed(2)&&BranchReadOnlyCommandAllowed(item.SUID),"verified Checksum Verify accepted");
 Check(!plugin.IsBranchCommandAllowed(99)&&!plugin.IsBranchCommandAllowed(3),"Checksum auxiliary commands remain refused");item.ID=1;
 plugin.DLLName="splitcbn\\splitcbn.spl";
 Check(plugin.IsBranchCommandAllowed(1)&&BranchReadOnlyCommandAllowed(item.SUID),"verified Split command accepted");
 item.ID=2;Check(plugin.IsBranchCommandAllowed(2)&&BranchReadOnlyCommandAllowed(item.SUID),"verified Combine command accepted");
 Check(!plugin.IsBranchCommandAllowed(0)&&!plugin.IsBranchCommandAllowed(3),"unknown Split/Combine IDs remain refused");item.ID=1;
 plugin.DLLName="pictview\\pictview.spl";item.ID=188;
 Check(plugin.IsBranchCommandAllowed(188)&&BranchReadOnlyCommandAllowed(item.SUID),"verified PictView Update Thumbnail accepted");
 for(int route=0;route<4;++route){BOOL unselect=FALSE;BOOL result=route==0?plugin.ExecuteMenuItem(&panel,NULL,0,item.SUID,unselect):route==1?plugin.ExecuteMenuItem2(&panel,NULL,0,188,unselect):route==2?plugin.ExecuteToolbarCommand(&panel,NULL,0,188,unselect):(unselect=Plugins.ExecuteCommand(0,0,&panel,NULL));Check(result&&unselect&&plugin.PluginIfaceForMenuExt.LastID==188,"PictView thumbnail passes each actual dispatcher");}
 Check(!plugin.IsBranchCommandAllowed(187)&&!plugin.IsBranchCommandAllowed(189)&&!plugin.IsBranchCommandAllowed(197),"PictView neighboring and auxiliary commands remain refused");
 for(const char* dll:{"pictview.spl","custom\\pictview.spl"}){plugin.DLLName=dll;Check(!plugin.IsBranchCommandAllowed(188),"custom PictView DLL identity refused");}
 item.ID=1;
 plugin.DLLName="automation\\automation.spl";
 Check(plugin.IsBranchCommandAllowed(1)&&BranchReadOnlyCommandAllowed(item.SUID),"verified Automation focused script accepted");
 Check(plugin.IsBranchCommandAllowed(2)&&plugin.IsBranchCommandAllowed(3),"Automation popup and internal deferred continuation accepted");
 Check(!plugin.IsBranchCommandAllowed(1000)&&!plugin.IsBranchCommandAllowed(0)&&!plugin.IsBranchCommandAllowed(-1),"unregistered Automation IDs refused");
 item.ID=0x12345600;Check(plugin.IsBranchCommandAllowed(item.ID)&&BranchReadOnlyCommandAllowed(item.SUID),"registered preloaded script accepted");
 item.ID=0x60000001;Check(plugin.IsBranchCommandAllowed(item.ID)&&BranchReadOnlyCommandAllowed(item.SUID),"registered runtime command accepted");
 Check(!plugin.IsBranchCommandAllowed(item.ID+1),"unregistered runtime command refused");
 item.Type=pmitStartSubmenu;Check(!plugin.IsBranchCommandAllowed(item.ID),"script submenu refused");item.Type=pmitItemOrSeparator;
 item.Name=nullptr;Check(!plugin.IsBranchCommandAllowed(item.ID),"script separator refused");item.Name="Compare";
 int beforePosted=plugin.PluginIfaceForMenuExt.Calls;int beforeLast=Plugins.LastChanges;
 Check(plugin.ExecutePostedMenuItem(&panel,NULL,3,FALSE)&&!plugin.PluginIfaceForMenuExt.LastHadOperations&&plugin.PluginIfaceForMenuExt.LastMask==0,"immediate posted continuation retains null operation and zero mask");
 Check(plugin.ExecutePostedMenuItem(&panel,NULL,3,TRUE)&&plugin.PluginIfaceForMenuExt.LastHadOperations&&plugin.PluginIfaceForMenuExt.LastMask==0,"idle posted continuation retains operation and zero mask");
 Check(plugin.PluginIfaceForMenuExt.Calls==beforePosted+2&&plugin.PluginIfaceForMenuExt.LastID==3&&Plugins.LastChanges==beforeLast,"posted continuation preserves ID and does not change last command");
 Check(!plugin.ExecutePostedMenuItem(&panel,NULL,item.ID+1,FALSE)&&!plugin.ExecutePostedMenuItem(&panel,NULL,item.ID+1,TRUE),"unknown script refused by both posted contexts");
 plugin.PluginIfaceForMenuExt.Loaded=false;Check(!plugin.ExecutePostedMenuItem(&panel,NULL,3,FALSE)&&!plugin.ExecutePostedMenuItem(&panel,NULL,3,TRUE),"unloaded interface cannot execute either posted context");plugin.PluginIfaceForMenuExt.Loaded=true;
 item.ID=1;
 plugin.DLLName="salamatrix\\salamatrix.spl";
 item.ID=0x62000001;
 Check(plugin.IsBranchCommandAllowed(item.ID)&&BranchReadOnlyCommandAllowed(item.SUID),"registered Salamatrix package command accepted");
 Check(!plugin.IsBranchCommandAllowed(item.ID+1),"unregistered Salamatrix package ID refused");
 for(int route=0;route<4;++route){BOOL unselect=FALSE;BOOL result=route==0?plugin.ExecuteMenuItem(&panel,NULL,0,item.SUID,unselect):route==1?plugin.ExecuteMenuItem2(&panel,NULL,0,item.ID,unselect):route==2?plugin.ExecuteToolbarCommand(&panel,NULL,0,item.ID,unselect):(unselect=Plugins.ExecuteCommand(0,0,&panel,NULL));Check(result&&unselect&&plugin.PluginIfaceForMenuExt.LastID==item.ID,"registered package command passes each actual dispatcher");}
 Check(!plugin.IsBranchCommandAllowed(1)&&!plugin.IsBranchCommandAllowed(0x61ffffff),"unverified Salamatrix fixed IDs refused");
 item.Type=pmitStartSubmenu;Check(!plugin.IsBranchCommandAllowed(item.ID),"Salamatrix submenu is not executable");item.Type=pmitItemOrSeparator;
 item.Name=nullptr;Check(!plugin.IsBranchCommandAllowed(item.ID),"Salamatrix separator is not executable");item.Name="Compare";item.ID=1;
 plugin.DLLName="FILECOMP\\FILECOMP.SPL";
 for(int route=0;route<4;++route){BOOL unselect=FALSE;BOOL result=route==0?plugin.ExecuteMenuItem(&panel,NULL,0,item.SUID,unselect):route==1?plugin.ExecuteMenuItem2(&panel,NULL,0,1,unselect):route==2?plugin.ExecuteToolbarCommand(&panel,NULL,0,1,unselect):(unselect=Plugins.ExecuteCommand(0,0,&panel,NULL));Check(result&&unselect&&plugin.PluginIfaceForMenuExt.LastID==1,"verified actual dispatcher invokes comparator");}
 item.ID=2;Check(!BranchReadOnlyCommandAllowed(item.SUID),"SUID with unverified internal ID refused");
 item.ID=1;item.Type=pmitStartSubmenu;Check(!BranchReadOnlyCommandAllowed(item.SUID),"submenu is not a command");item.Type=pmitItemOrSeparator;item.Name=nullptr;Check(!BranchReadOnlyCommandAllowed(item.SUID),"separator is not a command");item.Name="Compare";
 plugin.DLLName="unknown\\other.spl";panel.Branch=false;BOOL unselect=FALSE;
 Check(plugin.ExecuteMenuItem(&panel,NULL,0,item.SUID,unselect)&&unselect,"ordinary panel preserves plugin dispatch");
 Check(plugin.ExecuteMenuItem2(&panel,NULL,0,1,unselect)&&unselect,"ordinary direct command unchanged");
 Check(plugin.ExecuteToolbarCommand(&panel,NULL,0,1,unselect)&&unselect,"ordinary toolbar command unchanged");
 Check(plugin.ExecutePostedMenuItem(&panel,NULL,999,FALSE)&&plugin.ExecutePostedMenuItem(&panel,NULL,999,TRUE),"ordinary unknown plugin posted command unchanged");
 printf("Branch plugin actual policy/dispatch: %d/%d checks passed\n",Checks-Failures,Checks);return Failures?1:0;
}
