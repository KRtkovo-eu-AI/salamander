struct CQuadWord {ULONGLONG Value=0;CQuadWord(ULONGLONG v=0):Value(v){} CQuadWord& operator+=(const CQuadWord& b){Value+=b.Value;return *this;}};
struct COperations {CQuadWord TotalSize=100;};
struct CProgressDlgData {HANDLE WorkerNotSuspended=nullptr;BOOL* CancelWorker=nullptr;BOOL SkipAllChangeAttrs=FALSE;};
enum {IDB_SKIP=400,IDB_SKIPALL,IDS_ERRORCOMPRESSING,IDS_ERRORENCRYPTING,IDS_COMPRNOTSUPPORTED,IDS_ENCRYPNOTSUPPORTED,IDS_ERRORCHANGINGATTRS,WM_USER_DIALOG=WM_APP+3};
static int Reply=IDCANCEL,Dialogs=0,Progress=0,Failures=0,Checks=0,FailReadTime=0,FailWriteTime=0,FailRestore=0,FailOpenTime=0,ReadCalls=0,WriteCalls=0,Closes=0;
static DWORD LastDialogError=0;static bool TimeAttempted=false;
static char* LoadStr(int){static char s[]="fixture";return s;}
static char* GetErrorText(DWORD e){LastDialogError=e;return LoadStr(0);}
static LRESULT Dialog(HWND,UINT,WPARAM kind,LPARAM p){++Dialogs;if(kind==0)*(int*)((char**)p)[0]=Reply;return 0;}
static void SetProgress(HWND,int,int,CProgressDlgData&){++Progress;}
static int CaclProg(const CQuadWord&,const CQuadWord&){return 0;}
static DWORD UncompressFile(char*,DWORD,const wchar_t* = nullptr){return ERROR_INVALID_FUNCTION;}
static DWORD CompressFile(char*,DWORD,const wchar_t* = nullptr){return ERROR_INVALID_FUNCTION;}
static DWORD MyDecryptFile(char*,DWORD,BOOL,const wchar_t* = nullptr){return ERROR_INVALID_FUNCTION;}
static DWORD MyEncryptFile(HWND,char*,DWORD,DWORD,CProgressDlgData&,BOOL&,BOOL,const wchar_t* = nullptr){return ERROR_INVALID_FUNCTION;}
static BOOL ReadTime(HANDLE h,FILETIME* c,FILETIME* a,FILETIME* m){++ReadCalls;if(FailReadTime>0){--FailReadTime;SetLastError(ERROR_ACCESS_DENIED);return FALSE;}return ::GetFileTime(h,c,a,m);}
static BOOL WriteTime(HANDLE h,const FILETIME* c,const FILETIME* a,const FILETIME* m){++WriteCalls;TimeAttempted=true;if(FailWriteTime>0){--FailWriteTime;SetLastError(ERROR_ACCESS_DENIED);return FALSE;}return ::SetFileTime(h,c,a,m);}
static HANDLE OpenTime(LPCWSTR p,DWORD a,DWORD share,LPSECURITY_ATTRIBUTES sec,DWORD disp,DWORD flags,HANDLE t){if(FailOpenTime>0){--FailOpenTime;SetLastError(ERROR_SHARING_VIOLATION);return INVALID_HANDLE_VALUE;}return ::CreateFileW(p,a,share,sec,disp,flags,t);}
static BOOL Close(HANDLE h){++Closes;return ::CloseHandle(h);}
static BOOL Attrs(const wchar_t* p,DWORD a){if(FailRestore>0&&TimeAttempted&&(a&FILE_ATTRIBUTE_READONLY)){--FailRestore;SetLastError(ERROR_ACCESS_DENIED);return FALSE;}return ::SetFileAttributesW(p,a);}
#define HANDLES_Q(x) (x)
#define HANDLES(x) (x)
#pragma push_macro("SendMessage")
#undef SendMessage
#define SendMessage Dialog
#define GetFileTime ReadTime
#define SetFileTime WriteTime
#define SetFileAttributesW Attrs
#define CloseHandle Close
#define CreateFileW OpenTime
@@WORKER@@
#undef GetFileTime
#undef SetFileTime
