@@IGNORE_TYPE@@
struct CFindIgnoreItem {
    BOOL Enabled = TRUE; std::string Storage; const char* Path = nullptr; CFindIgnoreItemType Type = fiitUnknow; int Len = 0;
    CFindIgnoreItem(BOOL enabled, const char* path) : Enabled(enabled), Storage(path), Path(Storage.c_str()) {}
};
struct IgnoreItems {
    std::vector<std::unique_ptr<CFindIgnoreItem>> rows; int Count = 0;
    CFindIgnoreItem* operator[](int i) { return rows.at(static_cast<size_t>(i)).get(); }
    void DestroyMembers() { rows.clear(); Count = 0; }
};
class CFindIgnore {
public:
    IgnoreItems Items;
    CFindIgnoreItem* At(int i) { return Items[i]; }
    BOOL Add(BOOL enabled, const char* path) { Items.rows.push_back(std::make_unique<CFindIgnoreItem>(enabled, path)); ++Items.Count; return TRUE; }
    BOOL Prepare(CFindIgnore* source);
    BOOL Contains(const char* path, int startPathLen);
};
static unsigned char LowerCase[256];
static int StrNICmp(const char* a, const char* b, int count) { return _strnicmp(a, b, static_cast<size_t>(count)); }
static const char* StrIStr(const char* text, const char* needle) {
    const size_t length = std::strlen(needle);
    for (; *text; ++text) if (!_strnicmp(text, needle, length)) return text;
    return nullptr;
}
#define TRACE_E(message) do {} while (0)
