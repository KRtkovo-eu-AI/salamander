struct CDuplicateCandidates {};
struct Text { void Set(const char*) {} };
struct CGrepData {
    std::atomic_bool StopSearch{false}; unsigned IncompleteReasons = 0;
    int Refine = 0; Text text; Text* SearchingText = &text; HANDLE StopEvent = nullptr;
