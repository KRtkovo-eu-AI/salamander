};
static int checks, failures;
static void Check(bool ok, const char* text) { ++checks; if (!ok) { ++failures; std::printf("FAIL: %s\n", text); } }
static WIN32_FIND_DATAW File(const wchar_t* name, DWORD attributes = 0) {
    WIN32_FIND_DATAW file{}; wcscpy_s(file.cFileName, name); file.dwFileAttributes = attributes; return file;
}
int main() {
    for (unsigned i = 0; i < 256; ++i) LowerCase[i] = static_cast<unsigned char>(std::tolower(static_cast<int>(i)));
    {
        CGrepData data; FindProtectedRequest scan(data); scan.discardCandidates = true;
        auto& files=scan.session.entries[scan.path];
        for (int i=0; i<5003; ++i) files.push_back(File((L"file-"+std::to_wstring(i)).c_str()));
        liveListingRows=maxLiveListingRows=0;
        scan.Scan(scan.path,0,nullptr);
        Check(!data.IncompleteReasons && scan.candidateCount==5003 && scan.session.lists==1 &&
              maxLiveListingRows<=64 && liveListingRows==0, "wide directory over 4096 uses bounded pages without lost rows");
    }
    {
        CGrepData data; FindProtectedRequest scan(data);
        scan.session.entries[scan.path]={File(L"first"),File(L"dír",FILE_ATTRIBUTE_DIRECTORY),File(L"last")};
        scan.session.entries[scan.path+L"\\dír"]={File(L"東.txt")};
        scan.Scan(scan.path,0,nullptr);
        Check(!data.IncompleteReasons && scan.published==std::vector<std::wstring>({scan.path+L"\\first",scan.path+L"\\dír",
              scan.path+L"\\dír\\東.txt",scan.path+L"\\last"}), "nested pages preserve original DFS order and Unicode");
    }
    {
        CGrepData data; FindProtectedRequest scan(data);
        scan.session.entries[scan.path]={File(L"fallback")}; scan.session.openErrors[scan.path]=ERROR_NOT_SUPPORTED;
        scan.Scan(scan.path,0,nullptr);
        Check(!data.IncompleteReasons && scan.published.size()==1 && scan.session.lists==2,
              "unsupported open falls back to original bounded List");
    }
    {
        CGrepData data; FindProtectedRequest scan(data);
        scan.session.entries[scan.path]={File(L"fallback")}; scan.session.firstPageErrors[scan.path]=ERROR_NOT_SUPPORTED;
        scan.Scan(scan.path,0,nullptr);
        Check(!data.IncompleteReasons && scan.published.size()==1 && scan.session.lists==2 && scan.session.cursors.empty(),
              "unsupported first page closes its cursor before the legacy fallback");
    }
    {
        CGrepData data; FindProtectedRequest scan(data);
        const auto child=scan.path+L"\\child";
        scan.session.entries[scan.path]={File(L"child",FILE_ATTRIBUTE_DIRECTORY)};
        scan.session.entries[child]={File(L"should-not-appear")}; scan.session.openErrors[child]=ERROR_NOT_SUPPORTED;
        scan.session.legacyRejectExpected=true; scan.Scan(scan.path,0,nullptr);
        Check(scan.session.legacyExpectedSeen && scan.published.size()==1 &&
              data.IncompleteReasons==FindIncompleteProtectedFailure && scan.logs.size()==1 &&
              scan.logs[0].second==ERROR_FILE_INVALID,
              "unsupported child fallback carries its listed ID and rejects a replacement");
    }
    {
        CGrepData data; FindProtectedRequest scan(data);
        for (int i=0; i<70; ++i) scan.session.entries[scan.path].push_back(File((L"row-"+std::to_wstring(i)).c_str()));
        scan.session.laterPageErrors[scan.path]=ERROR_NOT_SUPPORTED;
        scan.Scan(scan.path,0,nullptr);
        Check(data.IncompleteReasons==FindIncompleteProtectedFailure && scan.published.size()==64 && scan.session.lists==1 &&
              scan.logs.size()==1 && scan.logs[0].second==ERROR_NOT_SUPPORTED && scan.session.cursors.empty(),
              "failure after a published page retains results and never restarts legacy enumeration");
    }
    {
        CGrepData data; FindProtectedRequest scan(data);
        for (int i=0; i<70; ++i) scan.session.entries[scan.path].push_back(File((L"row-"+std::to_wstring(i)).c_str()));
        scan.stopOnCandidate=true; scan.Scan(scan.path,0,nullptr);
        Check(data.StopSearch && !data.IncompleteReasons && scan.published.size()==1 && scan.session.cursors.empty(),
              "Stop during a nonterminal page closes its cursor and retains already-published result");
    }
    {
        CGrepData data; FindProtectedRequest scan(data);
        scan.session.entries[scan.path] = {File(L"first", FILE_ATTRIBUTE_DIRECTORY), File(L"second", FILE_ATTRIBUTE_DIRECTORY)};
        for (const wchar_t* name : {L"first", L"second"}) {
            auto& child = scan.session.entries[scan.path + L"\\" + name];
            for (int i = 0; i < 3000; ++i) child.push_back(File((L"file" + std::to_wstring(i)).c_str()));
        }
        scan.consent.emplace();
        scan.Finish(nullptr);
        Check(!data.IncompleteReasons && scan.published.size() == 6002 && scan.logs.empty() &&
              scan.session.lists == 3 && scan.starts == 1,
              "two 3000-item branches complete under one approved session without an aggregate limit");
    }
    {
        CGrepData data; FindProtectedRequest scan(data); scan.discardCandidates = true;
        std::wstring directory = scan.path;
        for (int depth = 0; depth <= 32; ++depth) {
            auto& items = scan.session.entries[directory];
            items.resize(4096, File(L"file"));
            if (depth != 32) { items[0] = File(L"child", FILE_ATTRIBUTE_DIRECTORY); directory += L"\\child"; }
        }
        const SIZE_T before = PrivateBytes();
        liveListingRows = maxLiveListingRows = 0; maxPrivateBytes = 0;
        scan.Scan(scan.path, 0, nullptr);
        Check(!data.IncompleteReasons && scan.session.lists == 33 && scan.candidateCount == size_t(33) * 4096 &&
              maxLiveListingRows <= size_t(33) * 64 && liveListingRows == 0,
              "maximum depth retains at most one 64-row page per level");
        std::printf("Synthetic maximum: row_size=%zu max_live_rows=%zu listing_bytes=%zu peak_private_delta=%llu\n",
                    sizeof(WIN32_FIND_DATAW), maxLiveListingRows, maxLiveListingRows * sizeof(WIN32_FIND_DATAW),
                    static_cast<unsigned long long>(maxPrivateBytes >= before ? maxPrivateBytes - before : 0));
    }
    { CGrepData data; FindProtectedRequest scan(data);
      scan.Scan(scan.path, 33, nullptr);
      Check(data.IncompleteReasons == FindIncompleteScanDepth && scan.session.lists == 0 && scan.logs.size() == 1,
            "depth beyond 32 is marked incomplete without enumerating the branch"); }
    { CGrepData data; FindProtectedRequest scan(data);
      scan.session.entries[scan.path] = {File(L"link", FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_REPARSE_POINT),
          File(L"deny", FILE_ATTRIBUTE_DIRECTORY), File(L"good", FILE_ATTRIBUTE_DIRECTORY)};
      scan.session.errors[scan.path + L"\\deny"] = ERROR_ACCESS_DENIED;
      scan.session.entries[scan.path + L"\\good"] = {File(L"readable")};
      scan.Scan(scan.path, 0, nullptr);
      Check(data.IncompleteReasons == (FindIncompleteReparse | FindIncompleteProtectedFailure) &&
            scan.logs.size() == 2 && scan.published.size() == 4 && scan.session.lists == 3,
            "link and denied branch are reported while a readable sibling is searched"); }
    { CGrepData data; FindProtectedRequest scan(data);
      scan.session.entries[scan.path] = {File(L"locked", FILE_ATTRIBUTE_DIRECTORY), File(L"good", FILE_ATTRIBUTE_DIRECTORY)};
      scan.session.openErrors[scan.path + L"\\locked"] = ERROR_SHARING_VIOLATION;
      scan.session.entries[scan.path + L"\\good"] = {File(L"accessible")};
      scan.Scan(scan.path, 0, nullptr);
      Check(data.IncompleteReasons == FindIncompleteProtectedFailure && scan.logs.size() == 1 &&
            scan.logs[0].second == ERROR_SHARING_VIOLATION && scan.published.size() == 3 &&
            scan.published.back() == scan.path + L"\\good\\accessible",
            "a sharing-locked branch is reported incomplete while an accessible sibling remains searchable"); }
    { CGrepData data; FindProtectedRequest scan(data);
      scan.ignoreSnapshot = SnapshotIgnore("C:\\root");
      scan.Scan(scan.path, 0, nullptr);
      Check(!data.IncompleteReasons && scan.logs.size() == 1 && scan.session.lists == 0,
            "an explicitly ignored directory is not treated as a failed protected access"); }
    { CGrepData data; FindProtectedRequest scan(data);
      scan.ignoreSnapshot = SnapshotIgnore("C:\\root");
      scan.Scan(scan.path, 33, nullptr);
      Check(!data.IncompleteReasons && scan.logs.size() == 1 && scan.logs[0].second == ERROR_CANCELLED &&
            scan.session.lists == 0, "Ignore takes precedence over the depth limit"); }
    { CGrepData data; FindProtectedRequest scan(data);
      scan.ignoreSnapshot = SnapshotIgnore("C:\\root\\link");
      scan.session.entries[scan.path] = {File(L"link", FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_REPARSE_POINT),
                                         File(L"good", FILE_ATTRIBUTE_DIRECTORY)};
      scan.session.entries[scan.path + L"\\good"] = {File(L"readable")};
      scan.Scan(scan.path, 0, nullptr);
      Check(!data.IncompleteReasons && scan.logs.size() == 1 && scan.logs[0].second == ERROR_CANCELLED &&
            scan.published.size() == 3 && scan.session.lists == 2,
            "an explicitly ignored link has no false incompleteness and its sibling is still searched"); }
    { CGrepData data; FindProtectedRequest scan(data); scan.session.open = false;
      scan.Scan(scan.path, 0, nullptr);
      Check(data.IncompleteReasons == FindIncompleteProtectedFailure && scan.logs.size() == 1 &&
            scan.logs[0].second == ERROR_NOT_READY, "closed session at scan entry is incomplete"); }
    { CGrepData data; FindProtectedRequest scan(data);
      scan.session.entries[scan.path] = {File(L"one"), File(L"two")}; scan.closeOnCandidate = true;
      scan.Scan(scan.path, 0, nullptr);
      Check(data.IncompleteReasons == FindIncompleteProtectedFailure && scan.logs.size() == 1 &&
            scan.published.size() == 1, "session loss after a candidate reports incomplete and retains the first result"); }
    { CGrepData data; FindProtectedRequest scan(data);
      scan.session.entries[scan.path] = {File(L"last")}; scan.closeOnCandidate = true;
      scan.Scan(scan.path, 0, nullptr);
      Check(!data.IncompleteReasons && scan.logs.empty() && scan.published.size() == 1,
            "session loss after the last published leaf does not invent incomplete work"); }
    { CGrepData data; FindProtectedRequest scan(data);
      scan.session.entries[scan.path] = {File(L"child", FILE_ATTRIBUTE_DIRECTORY)}; scan.closeOnCandidate = true;
      scan.Scan(scan.path, 0, nullptr);
      Check(data.IncompleteReasons == FindIncompleteProtectedFailure && scan.logs.size() == 1 &&
            scan.published.size() == 1, "session loss before descending into a directory marks incomplete"); }
    { CGrepData data; FindProtectedRequest scan(data);
      scan.session.entries[scan.path] = {File(L"child", FILE_ATTRIBUTE_DIRECTORY)}; scan.closeOnCandidate = true;
      scan.ignoreSnapshot = SnapshotIgnore("C:\\root\\child");
      scan.Scan(scan.path, 0, nullptr);
      Check(!data.IncompleteReasons && scan.published.size() == 1 && scan.logs.size() == 1 &&
            scan.logs[0].second == ERROR_CANCELLED, "session loss before an ignored child does not invent incomplete work"); }
    { CGrepData data; FindProtectedRequest scan(data);
      scan.session.entries[scan.path] = {File(L"one"), File(L"two")}; scan.session.stopOnList = true;
      scan.Scan(scan.path, 0, nullptr);
      Check(data.StopSearch && !data.IncompleteReasons && scan.logs.empty() && scan.published.empty(),
            "Stop racing the listing prevents a false omission"); }
    { CGrepData data; FindProtectedRequest scan(data);
      scan.session.entries[scan.path] = {File(L"link", FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_REPARSE_POINT)};
      scan.stopOnCandidate = true; scan.Scan(scan.path, 0, nullptr);
      Check(data.StopSearch && !data.IncompleteReasons && scan.logs.empty(),
            "Stop while publishing a link does not report a false omission"); }
    { CGrepData data; FindProtectedRequest scan(data);
      scan.session.errors[scan.path] = ERROR_BUFFER_OVERFLOW; scan.Scan(scan.path, 0, nullptr);
      Check(data.IncompleteReasons == FindIncompleteProtectedFailure && scan.logs.size() == 1 &&
            scan.logs[0].second == ERROR_BUFFER_OVERFLOW,
            "untyped broker overflow remains a generic protected failure with its original error"); }
    { CGrepData data; FindProtectedRequest scan(data); CQuadWord size{}; auto file = File(L"file");
      scan.session.contentError = ERROR_ACCESS_DENIED;
      Check(!scan.MatchFile(scan.path, file, size) && data.IncompleteReasons == FindIncompleteProtectedFailure &&
            scan.logs.size() == 1, "denied protected content marks the search incomplete"); }
    { CGrepData data; FindProtectedRequest scan(data); CQuadWord size{}; auto file = File(L"file");
      scan.session.contentError = ERROR_ACCESS_DENIED; scan.session.stopOnOpen = true;
      Check(!scan.MatchFile(scan.path, file, size) && !data.IncompleteReasons && scan.logs.empty(),
            "Stop racing a content error does not publish a spurious failure"); }
    { CGrepData data; FindProtectedRequest scan(data); CQuadWord size{}; auto file = File(L"file");
      scan.session.contentSize = 1;
      Check(!scan.MatchFile(scan.path, file, size) && data.IncompleteReasons == FindIncompleteProtectedFailure &&
            scan.logs.size() == 1, "a changed content revision is not presented as a nonmatch"); }
    { CGrepData data; FindProtectedRequest scan(data); CQuadWord size{}; auto file = File(L"file");
      UacF7::MoveFileIdentity identity{}; identity.id[0]=1;
      Check(!scan.MatchFile(scan.path,file,size,&identity) && data.IncompleteReasons==FindIncompleteProtectedFailure &&
            scan.logs.size()==1 && scan.logs[0].second==ERROR_FILE_INVALID,
            "a same-size, same-time file with changed ID is rejected before content matching"); }
    { UacF7::MoveFileIdentity identity{}; UacF7::ArchiveRevision revision{}; identity.serial=7; identity.id[0]=4;
      revision.serial=7; revision.fileId[0]=4;
      Check(FindListedIdentityMatches(&identity,revision), "matching identity allows the deferred content read");
      revision.fileId[0]=5;
      Check(!FindListedIdentityMatches(&identity,revision), "deferred duplicate read rejects same-name replacement ID");
      revision.fileId[0]=4; revision.serial=8;
      Check(!FindListedIdentityMatches(&identity,revision), "deferred duplicate read rejects another volume"); }
    { CGrepData data; FindProtectedRequest scan(data); CQuadWord size{}; auto file = File(L"file");
      scan.session.closeError = ERROR_BROKEN_PIPE;
      Check(!scan.MatchFile(scan.path, file, size) && data.IncompleteReasons == FindIncompleteProtectedFailure &&
            scan.logs.size() == 1, "lost broker content close is reported as incomplete"); }
    { CGrepData data; FindProtectedRequest scan(data); scan.launchThread = reinterpret_cast<HANDLE>(1);
      scan.consent.emplace(); scan.consent->result = ERROR_CANCELLED; scan.Finish(nullptr);
      Check(data.IncompleteReasons == FindIncompleteProtectedFailure && scan.logs.size() == 1,
            "declined elevation marks the protected search incomplete"); }
    { CGrepData data; FindProtectedRequest scan(data); scan.launchThread = reinterpret_cast<HANDLE>(1);
      scan.consent.emplace(); scan.consent->result = ERROR_ACCESS_DENIED; scan.Finish(nullptr);
      Check(data.IncompleteReasons == FindIncompleteProtectedFailure && scan.logs.size() == 1,
            "broker denial marks the protected search incomplete"); }
    { CGrepData data; FindProtectedRequest scan(data); scan.launchThread = reinterpret_cast<HANDLE>(1);
      scan.consent.emplace(); scan.consent->result = ERROR_CANCELLED; data.StopSearch = true; scan.Finish(nullptr);
      Check(!data.IncompleteReasons && scan.logs.empty(), "explicit Stop suppresses consent failure diagnostics"); }
    { CGrepData data; FindProtectedRequest scan(data); scan.startOk = false; scan.Finish(nullptr);
      Check(data.IncompleteReasons == FindIncompleteProtectedFailure && scan.logs.size() == 1,
            "consent launch failure cannot be presented as a complete search"); }
    std::printf("Actual protected Find scan: %d checks, %d failures\n", checks, failures);
    return failures ? 1 : 0;
}
