@@IGNORE_CONTAINS@@
static std::shared_ptr<CFindIgnore> SnapshotIgnore(const char* path) {
    CFindIgnore user; user.Add(TRUE, path);
    auto snapshot = std::make_shared<CFindIgnore>();
    if (!snapshot->Prepare(&user)) return {};
    user.Items.DestroyMembers(); // the live settings can change after this snapshot
    return snapshot;
}
static size_t liveListingRows = 0, maxLiveListingRows = 0;
static SIZE_T maxPrivateBytes = 0;
static SIZE_T PrivateBytes() {
    PROCESS_MEMORY_COUNTERS_EX counters{};
    return GetProcessMemoryInfo(GetCurrentProcess(), reinterpret_cast<PROCESS_MEMORY_COUNTERS*>(&counters), sizeof(counters))
        ? counters.PrivateUsage : 0;
}
struct TrackRows {
    size_t rows;
    explicit TrackRows(size_t count) : rows(count) {
        liveListingRows += rows;
        if (liveListingRows > maxLiveListingRows) maxLiveListingRows = liveListingRows;
        const SIZE_T bytes = PrivateBytes();
        if (bytes > maxPrivateBytes) maxPrivateBytes = bytes;
    }
    ~TrackRows() { liveListingRows -= rows; }
};
namespace UacF7 {
struct MoveFileIdentity { ULONGLONG serial = 0; BYTE id[16]{}; };
struct PagedListingEntry { WIN32_FIND_DATAW data{}; BYTE id[16]{}; };
}
struct FakeSession {
    CGrepData* data = nullptr; bool open = true, stopOnList = false; int lists = 0;
    std::map<std::wstring, std::vector<WIN32_FIND_DATAW>> entries;
    std::map<std::wstring, DWORD> errors;
    std::map<std::wstring, DWORD> openErrors, firstPageErrors;
    std::map<std::wstring, DWORD> laterPageErrors;
    bool legacyExpectedSeen = false, legacyRejectExpected = false;
    DWORD contentError = ERROR_SUCCESS, closeError = ERROR_SUCCESS; bool stopOnOpen = false;
    ULONGLONG contentSize = 0;
    struct Cursor { std::wstring path; size_t next = 0; };
    std::map<ULONGLONG, Cursor> cursors; ULONGLONG nextCursor = 1;
    bool IsOpen() const { return open; }
    bool GetPreparedFindRootIdentity(UacF7::MoveFileIdentity& identity) const { identity.serial = 1; identity.id[0] = 1; return open; }
    DWORD OpenDirectoryCursor(const std::wstring& path, const UacF7::MoveFileIdentity& expected,
                              UacF7::MoveFileIdentity& actual, ULONGLONG& lease, HANDLE) {
        ++lists; auto special = openErrors.find(path); if (special != openErrors.end()) return special->second;
        auto found = errors.find(path);
        if (found != errors.end()) return found->second;
        actual = expected; lease = nextCursor++; cursors.emplace(lease, Cursor{path, 0}); return ERROR_SUCCESS;
    }
    DWORD NextDirectoryPage(ULONGLONG lease, std::vector<UacF7::PagedListingEntry>& out, bool& done, HANDLE) {
        auto it = cursors.find(lease); if (it == cursors.end()) return ERROR_INVALID_HANDLE;
        auto firstError = firstPageErrors.find(it->second.path);
        if (!it->second.next && firstError != firstPageErrors.end()) { const DWORD code = firstError->second; cursors.erase(it); return code; }
        auto laterError = laterPageErrors.find(it->second.path);
        if (it->second.next && laterError != laterPageErrors.end()) { const DWORD code = laterError->second; cursors.erase(it); return code; }
        auto& source = entries[it->second.path];
        const size_t end = (std::min)(it->second.next + 64, source.size());
        while (it->second.next < end) { UacF7::PagedListingEntry row{}; row.data=source[it->second.next++]; row.id[0]=1; out.push_back(row); }
        done = end == source.size(); if (done) cursors.erase(it);
        if (stopOnList) data->StopSearch = true;
        return ERROR_SUCCESS;
    }
    DWORD CloseDirectoryCursor(ULONGLONG lease) { cursors.erase(lease); return ERROR_SUCCESS; }
    DWORD OpenContent(const std::wstring&, ULONGLONG& size, FILETIME& modified, struct UacRevision&);
    DWORD CloseContent() { return closeError; }
    DWORD List(const std::wstring& path, std::vector<WIN32_FIND_DATAW>& out, const UacF7::MoveFileIdentity* expected = nullptr) {
        if (expected) { legacyExpectedSeen = true; if (legacyRejectExpected) return ERROR_FILE_INVALID; }
        ++lists; out = entries[path];
        if (stopOnList) data->StopSearch = true;
        const auto found = errors.find(path); return found == errors.end() ? ERROR_SUCCESS : found->second;
    }
};
struct UacRevision { ULONGLONG serial=0; BYTE fileId[16]{}; };
DWORD FakeSession::OpenContent(const std::wstring&, ULONGLONG& size, FILETIME& modified, UacRevision&) {
    size = contentSize; modified = {}; if (stopOnOpen) data->StopSearch = true; return contentError;
}
namespace UacF7 { using ListingSession = FakeSession; using ArchiveRevision = UacRevision; }
