namespace
{
bool WriteContent(const std::wstring& path, DWORD value)
{
    const auto file = Adopt(CreateFileW(path.c_str(), GENERIC_WRITE, 0, nullptr, CREATE_ALWAYS, 0, nullptr));
    DWORD written = 0;
    return file && WriteFile(file.get(), &value, sizeof(value), &written, nullptr) && written == sizeof(value);
}

bool HasContent(const std::wstring& path, DWORD expected)
{
    const auto file = Adopt(CreateFileW(path.c_str(), GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
                                         nullptr, OPEN_EXISTING, 0, nullptr));
    DWORD value = 0, read = 0;
    return file && ReadFile(file.get(), &value, sizeof(value), &read, nullptr) && read == sizeof(value) && value == expected;
}

bool MakePrior(UacF7::OverwriteApproval& prior)
{
    const auto open = [](const std::wstring& path) {
        return Adopt(CreateFileW(path.c_str(), FILE_READ_ATTRIBUTES, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
                                 nullptr, OPEN_EXISTING, FILE_FLAG_OPEN_REPARSE_POINT, nullptr));
    };
    const auto source = open(sourceFile), target = open(targetFile);
    UacF7::ArchiveRevision sourceRevision{};
    if (!source || !target || UacZipUpdate::ReadRevision(source.get(), sourceRevision) ||
        UacZipUpdate::ReadRevision(target.get(), prior.revision)) return false;
    prior.captured = true;
    prior.sourceSerial = sourceRevision.serial;
    CopyMemory(prior.sourceId, sourceRevision.fileId, 16);
    return true;
}

struct Fixture
{
    BOOL cancelled = FALSE;
    Handle cancel = Adopt(CreateEventW(nullptr, TRUE, FALSE, nullptr));
    Handle resumed = Adopt(CreateEventW(nullptr, TRUE, TRUE, nullptr));
    COperation op;
    COperations script;
    CProgressDlgData data;
    CQuadWord total;
    DWORD error = 0;
    HWND window = nullptr;
    Fixture()
    {
        data.CancelWorker = &cancelled; data.CancelWorkerEvent = cancel.get(); data.WorkerNotSuspended = resumed.get();
        op.SourceNameW = sourceFile; op.TargetNameW = targetFile;
        window = CreateWindowExW(0, L"STATIC", L"fixture", WS_OVERLAPPED, 0, 0, 20, 20, nullptr, nullptr,
                                 GetModuleHandleW(nullptr), nullptr);
    }
    ~Fixture() { data.TransferJobs.clear(); if (peer.joinable()) peer.join(); if (window) DestroyWindow(window); }
};

void Reset(FakeMode mode)
{
    fakeMode = mode; starts = prompts = consents = unknownDialogs = unknownWhileCancelled = progressMessages = 0;
    gotCommit = gotAbort = fakeOk = false;
    initialCreateOnly = initialCopySeen = expectSourceRejection = false;
}

struct DenyTraversal
{
    std::wstring path;
    PSECURITY_DESCRIPTOR saved = nullptr;
    PACL original = nullptr;
    bool active = false;
    bool Apply(const std::wstring& dir)
    {
        path = dir;
        if (GetNamedSecurityInfoW(const_cast<wchar_t*>(path.c_str()), SE_FILE_OBJECT, DACL_SECURITY_INFORMATION,
                                  nullptr, nullptr, &original, nullptr, &saved) != ERROR_SUCCESS) return false;
        HANDLE token = nullptr;
        if (!OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token)) return false;
        DWORD length = 0;
        GetTokenInformation(token, TokenUser, nullptr, 0, &length);
        std::vector<BYTE> bytes(length);
        const bool ok = length && GetTokenInformation(token, TokenUser, bytes.data(), length, &length);
        CloseHandle(token);
        if (!ok) return false;
        EXPLICIT_ACCESSW access{};
        access.grfAccessPermissions = FILE_TRAVERSE; access.grfAccessMode = DENY_ACCESS;
        access.grfInheritance = NO_INHERITANCE;
        access.Trustee.TrusteeForm = TRUSTEE_IS_SID; access.Trustee.TrusteeType = TRUSTEE_IS_USER;
        access.Trustee.ptstrName = reinterpret_cast<LPWSTR>(reinterpret_cast<TOKEN_USER*>(bytes.data())->User.Sid);
        PACL changed = nullptr;
        const DWORD made = SetEntriesInAclW(1, &access, original, &changed);
        if (made != ERROR_SUCCESS) return false;
        const DWORD set = SetNamedSecurityInfoW(const_cast<wchar_t*>(path.c_str()), SE_FILE_OBJECT,
                                                DACL_SECURITY_INFORMATION, nullptr, nullptr, changed, nullptr);
        LocalFree(changed);
        active = set == ERROR_SUCCESS;
        return active;
    }
    bool Restore()
    {
        const bool privilege = ToggleTraversePrivilege(true);
        const bool restored = !active || SetNamedSecurityInfoW(const_cast<wchar_t*>(path.c_str()), SE_FILE_OBJECT,
                                                               DACL_SECURITY_INFORMATION, nullptr, nullptr, original, nullptr) == ERROR_SUCCESS;
        if (restored) active = false;
        return privilege && restored;
    }
    ~DenyTraversal()
    {
        Restore();
        if (saved) LocalFree(saved);
    }
};
}

int main()
{
    const ComApartment com;
    if (FAILED(com.result)) return 2;
    wchar_t cwd[32768]{};
    if (!GetCurrentDirectoryW(_countof(cwd), cwd) || !CreateDirectoryW(L"source", nullptr) ||
        !CreateDirectoryW(L"target", nullptr)) return 2;
    sourceFile = std::wstring(cwd) + L"\\source\\file-\u6771.txt";
    targetFile = std::wstring(cwd) + L"\\target\\file-\u65e5.txt";
    if (!WriteContent(sourceFile, 11) || !WriteContent(targetFile, 22)) return 2;
    int checks = 0, failures = 0;
    const auto check = [&](bool ok, const char* text) { ++checks; if (!ok) ++failures; std::printf("%s %s\n", ok ? "PASS" : "FAIL", text); };
    using Outcome = SourceOverwriteResult;
    {
        Reset(FakeMode::Success); Fixture f; UacF7::OverwriteApproval prior{};
        const auto result = TrySingleProbedOverwrite(f.window, f.op, f.script, f.total, f.data, prior, f.error, true, false);
        if (peer.joinable()) peer.join();
        std::printf("debug success: result=%d err=%lu starts=%d consents=%d prompts=%d commit=%d fake=%d progress=%d interim=%d completed=%d transferred=%llu done=%llu\n",
                    static_cast<int>(result), f.error, starts, consents, prompts, gotCommit, fakeOk, progressMessages,
                    f.script.interimWrites, f.script.completedWrites, f.script.transferred.Value, f.total.Value);
        check(result == Outcome::Finished && starts == 1 && consents == 1 && prompts == 1 && gotCommit && fakeOk &&
              progressMessages >= 2 && f.script.interimWrites >= 1 && f.script.completedWrites == 1 &&
              f.script.transferred.Value == 4 && f.total.Value == 100,
              "single item uses probe, native-dialog seam and fake success with single progress accounting");
    }
    for (bool same : {true, false})
    {
        Reset(FakeMode::Success); Fixture f; UacF7::OverwriteApproval prior{};
        const bool captured = MakePrior(prior);
        if (!same) prior.revision.modified ^= 1;
        const auto result = TrySingleProbedOverwrite(f.window, f.op, f.script, f.total, f.data, prior, f.error, true, false);
        check(captured && result == Outcome::Unavailable && !starts && !consents && !prompts && !gotCommit,
              same ? "matching earlier approval returns to original path without new UAC" :
                     "changed earlier approval returns to original path without new UAC");
    }
    for (FakeMode mode : {FakeMode::No, FakeMode::Cancel, FakeMode::Unsupported, FakeMode::Unknown, FakeMode::Oom, FakeMode::DialogOom})
    {
        Reset(mode); Fixture f; UacF7::OverwriteApproval prior{};
        const auto result = TrySingleProbedOverwrite(f.window, f.op, f.script, f.total, f.data, prior, f.error, true, false);
        if (peer.joinable()) peer.join();
        const bool expected = mode == FakeMode::No ? result == Outcome::Skipped && gotAbort && prompts == 1 :
                              mode == FakeMode::Cancel ? result == Outcome::Cancelled && !gotCommit && prompts == 1 :
                              mode == FakeMode::Unsupported ? result == Outcome::Unavailable && gotAbort && !prompts :
                              mode == FakeMode::Unknown ? result == Outcome::Cancelled && gotCommit && unknownDialogs == 1 && !f.script.completedWrites :
                              result == Outcome::Failed && f.error == ERROR_NOT_ENOUGH_MEMORY && !gotCommit && prompts == 1;
        std::printf("debug mode=%d result=%d err=%lu starts=%d consents=%d prompts=%d commit=%d abort=%d fake=%d unknown=%d transferred=%llu done=%llu\n",
                    static_cast<int>(mode), static_cast<int>(result), f.error, starts, consents, prompts, gotCommit, gotAbort,
                    fakeOk, unknownDialogs, f.script.transferred.Value, f.total.Value);
        check(expected && fakeOk && f.total.Value == 0 && f.script.transferred.Value == 0,
              "No, Cancel, unsupported target and lost commit reply retain accounting");
    }
    {
        Reset(FakeMode::No); Fixture f; UacF7::OverwriteApproval prior{}; f.script.Count = 2;
        check(TrySingleProbedOverwrite(f.window, f.op, f.script, f.total, f.data, prior, f.error, true, false) == Outcome::Unavailable &&
              !starts && !consents, "multi-item jobs are not routed through the singleton pilot");
    }
    {
        Reset(FakeMode::No); Fixture f; UacF7::OverwriteApproval prior{};
        check(TrySingleProbedOverwrite(f.window, f.op, f.script, f.total, f.data, prior, f.error, false, false) == Outcome::Unavailable &&
              !starts && !consents, "no confirmed target denial stays on the original path");
    }
    {
        Reset(FakeMode::No); Fixture f; UacF7::OverwriteApproval prior{}; f.script.CopyMoveConflictMode = CMCM_SCAN_AHEAD;
        check(TrySingleProbedOverwrite(f.window, f.op, f.script, f.total, f.data, prior, f.error, true, false) == Outcome::Unavailable &&
              !starts && !consents, "Scan Ahead is not claimed by the singleton pilot");
    }
    {
        Reset(FakeMode::No); Fixture f; UacF7::OverwriteApproval prior{};
        check(TrySingleProbedOverwrite(f.window, f.op, f.script, f.total, f.data, prior, f.error, true, true) == Outcome::Unavailable &&
              !starts && !consents, "previous user decision remains on the original path");
    }
    {
        Reset(FakeMode::No); Fixture f; UacF7::OverwriteApproval prior{}; f.data.CnfrmFileOver = false;
        check(TrySingleProbedOverwrite(f.window, f.op, f.script, f.total, f.data, prior, f.error, true, false) == Outcome::Unavailable &&
              !starts && !consents, "disabled native overwrite confirmation remains on the original path");
    }
    {
        Reset(FakeMode::No); Fixture f; UacF7::OverwriteApproval prior{}; SetEvent(f.cancel.get());
        check(TrySingleProbedOverwrite(f.window, f.op, f.script, f.total, f.data, prior, f.error, true, false) == Outcome::Cancelled &&
              f.error == ERROR_CANCELLED && !starts && !consents, "pre-cancelled worker starts no prompt or peer");
    }
    {
        Reset(FakeMode::No); Fixture f; UacF7::OverwriteApproval prior{}; CopySourceContext copy; copy.ElevationDeclined = true;
        f.script.CopySource = &copy;
        check(TrySingleProbedOverwrite(f.window, f.op, f.script, f.total, f.data, prior, f.error, true, false) == Outcome::Unavailable &&
              !starts && !consents, "previously declined elevation is not asked again");
    }
    {
        Reset(FakeMode::No); Fixture f; UacF7::OverwriteApproval prior{};
        ResetEvent(f.resumed.get());
        const auto started = Adopt(CreateEventW(nullptr, TRUE, FALSE, nullptr));
        peerStarted = started.get();
        Outcome outcome = Outcome::Failed;
        std::thread worker([&] { outcome = TrySingleProbedOverwrite(f.window, f.op, f.script, f.total, f.data, prior, f.error, true, false); });
        const bool paused = WaitForSingleObject(started.get(), 150) == WAIT_TIMEOUT;
        SetEvent(f.resumed.get());
        worker.join();
        if (peer.joinable()) peer.join();
        peerStarted = nullptr;
        std::printf("debug pause: paused=%d result=%d err=%lu starts=%d consents=%d prompts=%d abort=%d fake=%d\n",
                    paused, static_cast<int>(outcome), f.error, starts, consents, prompts, gotAbort, fakeOk);
        check(paused && outcome == Outcome::Skipped && gotAbort && fakeOk,
              "suspended worker waits before starting consent and probe");
    }
    for (bool cancelDuringPause : {false, true})
    {
        Reset(cancelDuringPause ? FakeMode::CancelAfter : FakeMode::PauseAfter);
        Fixture f; UacF7::OverwriteApproval prior{};
        const auto shown = Adopt(CreateEventW(nullptr, TRUE, FALSE, nullptr));
        const auto committed = Adopt(CreateEventW(nullptr, TRUE, FALSE, nullptr));
        dialogSeen = shown.get(); workerResume = f.resumed.get(); commitSeen = committed.get();
        Outcome outcome = Outcome::Failed;
        std::thread worker([&] { outcome = TrySingleProbedOverwrite(f.window, f.op, f.script, f.total, f.data, prior, f.error, true, false); });
        const bool shownInTime = shown && WaitForSingleObject(shown.get(), 4000) == WAIT_OBJECT_0;
        const bool waited = shownInTime && committed && WaitForSingleObject(committed.get(), 150) == WAIT_TIMEOUT;
        if (cancelDuringPause) SetEvent(f.cancel.get()); else SetEvent(f.resumed.get());
        worker.join();
        if (peer.joinable()) peer.join();
        dialogSeen = workerResume = commitSeen = nullptr;
        const bool expected = cancelDuringPause ? outcome == Outcome::Cancelled && !gotCommit && f.error == ERROR_CANCELLED :
                                                   outcome == Outcome::Finished && gotCommit && f.total.Value == 100;
        check(waited && expected && fakeOk,
              cancelDuringPause ? "Cancel during post-dialog pause prevents commit" :
                                  "post-dialog pause delays commit until resumed");
    }
    {
        Reset(FakeMode::UnknownCancel); Fixture f; UacF7::OverwriteApproval prior{};
        cancelTrigger = f.cancel.get(); cancelFlag = reinterpret_cast<volatile LONG*>(&f.cancelled);
        const auto outcome = TrySingleProbedOverwrite(f.window, f.op, f.script, f.total, f.data, prior, f.error, true, false);
        if (peer.joinable()) peer.join();
        cancelTrigger = nullptr; cancelFlag = nullptr;
        check(outcome == Outcome::Cancelled && gotCommit && fakeOk && unknownDialogs == 1 &&
              unknownWhileCancelled == 1 && !f.script.completedWrites && f.total.Value == 0,
              "lost commit reply still requests unknown-result dialog when cancellation is active");
    }
    for (FakeMode mode : {FakeMode::Success, FakeMode::No, FakeMode::Cancel, FakeMode::Oom, FakeMode::Unsupported})
    {
        Reset(mode); Fixture f; BOOL skipped = FALSE; DWORD error = ERROR_ACCESS_DENIED; skippedAccounting = 0;
        const int actual = RunDeniedCallSite(f.window, &f.op, &f.script, f.total, f.data, skipped, error);
        if (peer.joinable()) peer.join();
        const bool expected = mode == FakeMode::Success ? actual == TRUE && !skipped && f.total.Value == 100 && gotCommit :
                              mode == FakeMode::No ? actual == TRUE && skipped && f.total.Value == 100 && gotAbort && skippedAccounting == 1 :
                              mode == FakeMode::Cancel ? actual == FALSE && !skipped && f.total.Value == 0 :
                              mode == FakeMode::Oom ? actual == -1 && error == ERROR_NOT_ENOUGH_MEMORY && f.total.Value == 0 :
                              actual == -2 && gotAbort && f.total.Value == 0;
        const char* label = mode == FakeMode::Success ? "F5 caller returns finished" :
                            mode == FakeMode::No ? "F5 caller reaches skip and advances progress" :
                            mode == FakeMode::Cancel ? "F5 caller returns cancelled" :
                            mode == FakeMode::Oom ? "F5 caller reaches normal error handling" :
                            "F5 caller continues original conflict handling";
        check(expected && fakeOk, label);
    }
    {
        Reset(FakeMode::Success); Fixture f; BOOL skipped = FALSE; DWORD error = ERROR_FILE_EXISTS;
        const int actual = RunTargetExistsCallSite(f.window, &f.op, &f.script, f.total, f.data, skipped, error);
        check(actual == -3 && !starts && !prompts, "accessible target retains native conflict path");
    }
    {
        Reset(FakeMode::Success); Fixture f; BOOL skipped = FALSE; DWORD error = ERROR_FILE_EXISTS;
        f.op.TargetNameW += L"-missing";
        const int actual = RunTargetExistsCallSite(f.window, &f.op, &f.script, f.total, f.data, skipped, error);
        check(actual == -2 && !starts && !prompts, "missing target does not trigger elevated probe");
    }
    {
        DenyTraversal acl;
        const bool installed = acl.Apply(std::wstring(cwd) + L"\\target");
        check(installed, "test installs explicit deny traversal on its own target parent");
        if (installed)
        {
            for (FakeMode mode : {FakeMode::Success, FakeMode::No, FakeMode::Cancel})
            {
                Reset(mode); Fixture f; BOOL skipped = FALSE; DWORD error = ERROR_FILE_EXISTS;
                const bool disabled = ToggleTraversePrivilege(false);
                const auto denied = Adopt(CreateFileW(targetFile.c_str(), 0, FILE_SHARE_READ | FILE_SHARE_WRITE,
                                                       nullptr, OPEN_EXISTING, 0, nullptr));
                const DWORD accessError = denied ? ERROR_SUCCESS : GetLastError();
                const auto parent = Adopt(CreateFileW((std::wstring(cwd) + L"\\target").c_str(), FILE_READ_ATTRIBUTES,
                                                       7, nullptr, OPEN_EXISTING,
                                                       FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT, nullptr));
                restoreTraverseOnPeer = true;
                const int actual = RunTargetExistsCallSite(f.window, &f.op, &f.script, f.total, f.data, skipped, error);
                if (peer.joinable()) peer.join();
                restoreTraverseOnPeer = false; ToggleTraversePrivilege(true);
                const bool expected = mode == FakeMode::Success ? actual == TRUE && !skipped && gotCommit :
                                      mode == FakeMode::No ? actual == TRUE && skipped && gotAbort :
                                      actual == FALSE && !skipped && !gotCommit;
                check(disabled && accessError == ERROR_ACCESS_DENIED && parent && expected && fakeOk &&
                      starts == 1 && prompts == 1 && consents == 1,
                      "prior create-only broker FILE_EXISTS seam reaches real denied NTFS identity and native conflict seam");
            }
            for (int scenario : {0, 1, 2, 3})
            {
                const bool changeSource = scenario == 1;
                const bool reject = scenario != 0;
                Reset(FakeMode::Success); Fixture f; BOOL skipped = FALSE; DWORD error = ERROR_GEN_FAILURE;
                const bool disabled = ToggleTraversePrivilege(false);
                restoreTraverseOnPeer = true; initialCreateOnly = true; expectSourceRejection = reject;
                auto& job = f.data.TransferJobs.emplace_back();
                UacF7::Result first{}; bool prepared = false;
                CreateOnlySourceReceipt receipt{};
                {
                    UacF7::PreparedTransfer request;
                    prepared = request.Prepare(sourceFile, targetFile, f.op.FileSize.Value, UacF7::Operation::Copy);
                    if (prepared)
                    {
                        first = request.Execute(f.window, f.cancel.get(), &job);
                        request.SourceIdentities(receipt.source, receipt.parent);
                        receipt.session = &job; receipt.opening = job.OpeningGeneration();
                    }
                }
                const bool initialOk = prepared && first.error == ERROR_FILE_EXISTS && !first.unknown && job.IsOpen();
                const std::wstring savedSource = sourceFile + L".original";
                bool swapped = !changeSource;
                bool movedSource = false;
                if (changeSource && initialOk)
                {
                    movedSource = MoveFileExW(sourceFile.c_str(), savedSource.c_str(), 0) != FALSE;
                    swapped = movedSource && WriteContent(sourceFile, 33);
                }
                if (scenario == 2) job.Close();
                if (scenario == 3) ++receipt.opening;
                error = first.error;
                const int actual = initialOk && swapped ?
                    RunTargetExistsCallSite(f.window, &f.op, &f.script, f.total, f.data, skipped, error, &receipt) : -9;
                if (reject) f.data.TransferJobs.clear();
                if (peer.joinable()) peer.join();
                restoreTraverseOnPeer = false; ToggleTraversePrivilege(true);
                const bool intact = HasContent(sourceFile, changeSource ? 33 : 11) && HasContent(targetFile, 22);
                bool restored = true;
                if (movedSource)
                {
                    if (swapped) restored = DeleteFileW(sourceFile.c_str()) != FALSE;
                    restored = MoveFileExW(savedSource.c_str(), sourceFile.c_str(), 0) && restored;
                }
                const bool expected = reject ? actual == -1 && error == ERROR_FILE_INVALID && !gotCommit && !prompts :
                    actual == TRUE && gotCommit && prompts == 1 && consents == 0 && starts == 1;
                check(disabled && initialOk && initialCopySeen && swapped && restored && intact && expected && fakeOk,
                      scenario == 0 ? "create-only FILE_EXISTS and probe reuse one host pipe without re-consent" :
                      scenario == 1 ? "changed same-size source is rejected before overwrite" :
                      scenario == 2 ? "closed original session is rejected before overwrite" :
                                      "different session generation is rejected before overwrite");
            }
        }
        check(acl.Restore(), "test restores the target parent ACL and traverse privilege");
    }
    std::printf("single worker with test peer: %d checks, %d failures; publication and UAC simulated\n", checks, failures);
    return failures ? 1 : 0;
}
