// | Date | Summary | Reason | Ticket | Model |
// | 2026-11-12 | Exercise the existing-target identity-open path. | Verify real NTFS access denial at the worker call site. | #731 | GPT-6.1 Terra |
// | 2026-11-12 | Exercise denied F5 call-site outcomes. | Verify routing and progress at the real worker branch. | #731 | GPT-6.1 Terra |
// | 2026-11-12 | Extend singleton overwrite regression coverage. | Preserve cancellation, lifetime and prompt behavior. | #731 | GPT-6 (Codex) |
// | 2026-11-11 | Exercise the single F5 worker through the real host probe controller. | Verify choices, accounting and stop before wiring the full application. | #731 | GPT-6.1 Terra |
// Production worker functions and ExecuteProbedOverwrite run on a real pipe.
// The peer, consent, dialog and installed-image/elevation gates are seams;
// a fake success never mutates a file or proves privileged publication.
// The caller test also forces the prior overwrite preparation to fail and
// substitutes skipped-file bookkeeping; the rest of DoCopyFile is not run.
#define _CRT_SECURE_NO_WARNINGS
#define SAM_UAC_F7_HOST
#include <aclapi.h>
#include <thread>
#include <list>
#include "uac_single_worker_fixture.cpp"

namespace
{
enum class FakeMode { Success, No, Cancel, Unsupported, Unknown, Oom, DialogOom, PauseAfter, CancelAfter, UnknownCancel };
FakeMode fakeMode = FakeMode::Success;
std::thread peer;
HANDLE peerStarted = nullptr;
HANDLE dialogSeen = nullptr, workerResume = nullptr, commitSeen = nullptr, cancelTrigger = nullptr;
volatile LONG* cancelFlag = nullptr;
int starts = 0, prompts = 0, consents = 0, unknownDialogs = 0;
int unknownWhileCancelled = 0;
bool gotCommit = false, gotAbort = false, fakeOk = false;
bool restoreTraverseOnPeer = false;
bool initialCreateOnly = false, initialCopySeen = false, expectSourceRejection = false;
std::wstring sourceFile, targetFile;

bool ToggleTraversePrivilege(bool enabled)
{
    HANDLE token = nullptr;
    if (!OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY | TOKEN_ADJUST_PRIVILEGES, &token)) return false;
    LUID luid{};
    const bool found = LookupPrivilegeValueW(nullptr, L"SeChangeNotifyPrivilege", &luid) != FALSE;
    TOKEN_PRIVILEGES privileges{};
    privileges.PrivilegeCount = 1; privileges.Privileges[0].Luid = luid;
    privileges.Privileges[0].Attributes = enabled ? SE_PRIVILEGE_ENABLED : 0;
    SetLastError(ERROR_SUCCESS);
    const bool ok = found && AdjustTokenPrivileges(token, FALSE, &privileges, 0, nullptr, nullptr) && GetLastError() == ERROR_SUCCESS;
    CloseHandle(token);
    return ok;
}

HANDLE StartRunProbeFakePeer(const std::wstring& name)
{
    ++starts;
    if (peerStarted) SetEvent(peerStarted);
    HANDLE process = nullptr;
    if (!DuplicateHandle(GetCurrentProcess(), GetCurrentProcess(), GetCurrentProcess(), &process, 0, FALSE,
                         DUPLICATE_SAME_ACCESS)) return nullptr;
    peer = std::thread([name] {
        auto pipe = Adopt(CreateFileW(name.c_str(), pipeAccess, 0, nullptr, OPEN_EXISTING,
            FILE_FLAG_OVERLAPPED | SECURITY_SQOS_PRESENT | SECURITY_IDENTIFICATION, nullptr));
        if (!pipe) return;
        const auto deadline = GetTickCount64() + 5000;
        Frame hello{protocolVersion, appCapabilities, Phase::Hello}, accept{};
        if (Exchange(pipe.get(), hello, true, deadline) || Exchange(pipe.get(), accept, false, deadline, true) ||
            !Matches(accept, Phase::AcceptTransferJob, appCapabilities)) return;
        RequestHeader request{};
        if (TransferRequest(pipe.get(), &request, sizeof(request), false, deadline)) return;
        auto readBody = [&](const RequestHeader& current) {
            const size_t chars = volumeLength * 2 + current.relativeLength + current.leafLength +
                                 current.targetRelativeLength + current.targetLeafLength;
            std::wstring body(chars, L'\0');
            return TransferRequest(pipe.get(), body.data(), static_cast<DWORD>(chars * sizeof(wchar_t)), false, deadline);
        };
        if (readBody(request)) return;
        if (initialCreateOnly)
        {
            if (request.operation != Operation::Copy) return;
            initialCopySeen = true;
            DWORD exists = ERROR_FILE_EXISTS;
            if (TransferRequest(pipe.get(), &exists, sizeof(exists), true, deadline)) return;
            const DWORD nextError = TransferRequest(pipe.get(), &request, sizeof(request), false, deadline);
            if (nextError) { fakeOk = expectSourceRejection; return; }
            if (readBody(request)) return;
        }
        if (request.operation != Operation::ProbeOverwrite) return;
        if (restoreTraverseOnPeer && !ToggleTraversePrivilege(true)) return;
        auto open = [](const std::wstring& path) {
            return Adopt(CreateFileW(path.c_str(), FILE_READ_ATTRIBUTES,
                FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, OPEN_EXISTING,
                FILE_FLAG_OPEN_REPARSE_POINT, nullptr));
        };
        const auto source = open(sourceFile), target = open(targetFile);
        UacF7::OverwriteProbeReply reply{};
        if (!source || !target || UacZipUpdate::ReadRevision(source.get(), reply.source) ||
            UacZipUpdate::ReadRevision(target.get(), reply.target)) return;
        reply.present = 1; reply.nonce.Data1 = 123;
        reply.sourceParentSerial = request.serial; reply.targetParentSerial = request.targetSerial;
        CopyMemory(reply.sourceParentId, request.parentId.Identifier, 16);
        CopyMemory(reply.targetParentId, request.targetParentId.Identifier, 16);
        if (fakeMode == FakeMode::Unsupported) reply.target.attributes |= FILE_ATTRIBUTE_HIDDEN;
        DWORD status = ERROR_SUCCESS;
        if (TransferRequest(pipe.get(), &status, sizeof(status), true, deadline) ||
            TransferRequest(pipe.get(), &reply, sizeof(reply), true, deadline)) return;
        RequestHeader next{};
        const DWORD nextError = TransferRequest(pipe.get(), &next, sizeof(next), false, deadline);
        if (nextError)
        {
            fakeOk = fakeMode == FakeMode::Cancel || fakeMode == FakeMode::Oom ||
                     fakeMode == FakeMode::DialogOom || fakeMode == FakeMode::CancelAfter;
            return;
        }
        if (next.operation == Operation::AbortOverwriteProbe)
        {
            GUID nonce{};
            if (TransferRequest(pipe.get(), &nonce, sizeof(nonce), false, deadline) ||
                !IsEqualGUID(nonce, reply.nonce)) return;
            gotAbort = true;
            fakeOk = !TransferRequest(pipe.get(), &status, sizeof(status), true, deadline);
            return;
        }
        if (next.operation != Operation::CopyOverwrite) return;
        const size_t nextChars = volumeLength * 2 + next.relativeLength + next.leafLength +
                                 next.targetRelativeLength + next.targetLeafLength;
        std::wstring nextBody(nextChars, L'\0');
        UacF7::ArchiveRevision targetRevision{}; GUID nonce{};
        if (TransferRequest(pipe.get(), nextBody.data(), static_cast<DWORD>(nextChars * sizeof(wchar_t)), false, deadline) ||
            TransferRequest(pipe.get(), &targetRevision, sizeof(targetRevision), false, deadline) ||
            TransferRequest(pipe.get(), &nonce, sizeof(nonce), false, deadline) ||
            !IsEqualGUID(nonce, reply.nonce) || !UacF7::SameFileRevision(targetRevision, reply.target)) return;
        gotCommit = true;
        if (commitSeen) SetEvent(commitSeen);
        DWORD marker = transferProgressFrame;
        TransferProgressUpdate update{2, 0}; // ordinary CopyOverwrite progress has no explicit total
        if (TransferRequest(pipe.get(), &marker, sizeof(marker), true, deadline) ||
            TransferRequest(pipe.get(), &update, sizeof(update), true, deadline)) return;
        if (fakeMode == FakeMode::Unknown || fakeMode == FakeMode::UnknownCancel)
        {
            if (fakeMode == FakeMode::UnknownCancel)
            {
                if (cancelFlag) InterlockedExchange(cancelFlag, TRUE);
                if (cancelTrigger) SetEvent(cancelTrigger);
            }
            fakeOk = true;
            return;
        }
        UacF7::OverwriteProbeReply noChange{};
        fakeOk = !TransferRequest(pipe.get(), &status, sizeof(status), true, deadline) &&
                 !TransferRequest(pipe.get(), &noChange, sizeof(noChange), true, deadline);
    });
    return process;
}
}

struct CQuadWord
{
    ULONGLONG Value = 0;
    CQuadWord() = default;
    CQuadWord(DWORD low, DWORD high) : Value((static_cast<ULONGLONG>(high) << 32) | low) {}
    CQuadWord& SetUI64(ULONGLONG value) { Value = value; return *this; }
    CQuadWord& operator+=(CQuadWord other) { Value += other.Value; return *this; }
};
static CQuadWord operator+(CQuadWord a, CQuadWord b) { return CQuadWord().SetUI64(a.Value + b.Value); }
static CQuadWord operator-(CQuadWord a, CQuadWord b) { return CQuadWord().SetUI64(a.Value - b.Value); }
static bool operator>(CQuadWord a, CQuadWord b) { return a.Value > b.Value; }
static const CQuadWord COPY_MIN_FILE_SIZE(64, 0);
struct ListedSource { std::unique_ptr<UacF7::PreparedLeaf> Request; };
struct CopySourceContext { bool ElevationDeclined = false; std::unique_ptr<UacF7::TransferJobSession> Session; };
struct COperations
{
    int Count = 1, CopyMoveConflictMode = 0;
    BOOL OverwriteOlder = FALSE, CopySecurity = FALSE, CopyAttrs = FALSE, IgnoreTransferAds = FALSE;
    bool limited = false;
    CopySourceContext* CopySource = nullptr;
    CQuadWord TotalSize{100, 0}, transferred{};
    int interimWrites = 0, completedWrites = 0;
    void GetSpeedLimit(BOOL* value, DWORD* limit) { *value = limited; *limit = 0; }
    void GetTFS(CQuadWord* value) { *value = transferred; }
    void SetTFSandProgressSize(CQuadWord value, CQuadWord) { transferred = value; ++interimWrites; }
    void AddBytesToTFSandSetProgressSize(CQuadWord value, CQuadWord) { transferred += value; ++completedWrites; }
};
struct COperation
{
    int Opcode = 1;
    DWORD OpFlags = 1, Attr = FILE_ATTRIBUTE_ARCHIVE;
    bool SourceNameWValid = true, TargetNameWValid = true;
    std::wstring SourceNameW, TargetNameW;
    char sourceName[32] = "source-UTF8", targetName[32] = "target-UTF8";
    char* SourceName = sourceName, *TargetName = targetName;
    UacF7::ArchiveRevision ScannedTargetRevision{};
    CQuadWord FileSize{4, 0}, Size{100, 0};
};
struct CProgressDlgData
{
    bool ConflictDecisionInjected = false, OverwriteAll = false, SkipAllOverwrite = false, CnfrmFileOver = true;
    BOOL SkipAllFileOpenOut = FALSE, ConflictTargetChanged = FALSE;
    bool OverwriteHiddenAll = false, SkipAllSystemOrHidden = false;
    BOOL* CancelWorker = nullptr;
    HANDLE CancelWorkerEvent = nullptr, WorkerNotSuspended = nullptr;
    std::list<UacF7::TransferJobSession> TransferJobs;
};
constexpr int CMCM_SCAN_AHEAD = 2, ocCopyFile = 1;
constexpr DWORD OPFL_UAC_TRANSFER_ELIGIBLE = 1, OPFL_AS_ENCRYPTED = 2, OPFL_UAC_TRANSFER_LISTED = 4, OPFL_COPY_ADS = 8;
constexpr UINT WM_USER_DIALOG = WM_APP + 20;
constexpr WPARAM WORKER_DIALOG_UAC_TRANSFER = 1, WORKER_DIALOG_UAC_OVERWRITE_PROBE = 2,
                 WORKER_DIALOG_UAC_DISK_RECOVERY_UNKNOWN = 3;
constexpr int IDB_SKIP = 200, IDB_SKIPALL = 201, IDB_ALL = 202;
@@DIALOG_PAYLOAD@@
static const ListedSource* ListedTransferSource(const COperation&, const COperations&) { return nullptr; }
static std::wstring SalPathRemoveExtendedPrefixW(const wchar_t* text) { return text; }
static std::string SalWideToMultiBytePath(const wchar_t* text, UINT)
{
    const int count = WideCharToMultiByte(CP_UTF8, 0, text, -1, nullptr, 0, nullptr, nullptr);
    std::string bytes(count > 0 ? static_cast<size_t>(count) : 0, '\0');
    if (count) WideCharToMultiByte(CP_UTF8, 0, text, -1, bytes.data(), count, nullptr, nullptr);
    if (!bytes.empty()) bytes.pop_back();
    return bytes;
}
static void GetOverwriteRevisionInfo(char* output, size_t capacity, const UacF7::ArchiveRevision& revision)
{ sprintf_s(output, capacity, "%lld", revision.size); }
static int CaclProg(CQuadWord amount, CQuadWord total)
{ return total.Value ? static_cast<int>(1000 * amount.Value / total.Value) : 0; }
static int progressMessages = 0;
static void SetProgressWithoutSuspend(HWND, int, int, CProgressDlgData&) { ++progressMessages; }
static void SetProgress(HWND, int, int, CProgressDlgData&) { ++progressMessages; }
static void NotifyNativeBrokerActivity(HWND, bool) {}
static LRESULT TestMessage(HWND, UINT message, WPARAM kind, LPARAM value)
{
    if (message != WM_USER_DIALOG) return 0;
    if (kind == WORKER_DIALOG_UAC_TRANSFER)
    {
        ++consents;
        reinterpret_cast<UacF7::TransferPrompt*>(value)->approved = true;
    }
    else if (kind == WORKER_DIALOG_UAC_OVERWRITE_PROBE)
    {
        ++prompts;
        if (fakeMode == FakeMode::Oom) throw std::bad_alloc();
        auto& prompt = *reinterpret_cast<CUacOverwriteProbePrompt*>(value);
        if (fakeMode == FakeMode::DialogOom) { prompt.error = ERROR_NOT_ENOUGH_MEMORY; return 0; }
        if (!prompt.singleItem || prompt.sourceName != "source-UTF8" || prompt.targetName != "target-UTF8" ||
            prompt.sourceInfo != "4" || prompt.targetInfo != "4") return 0;
        if (fakeMode == FakeMode::PauseAfter || fakeMode == FakeMode::CancelAfter)
        {
            if (workerResume) ResetEvent(workerResume);
            if (dialogSeen) SetEvent(dialogSeen);
        }
        prompt.result = fakeMode == FakeMode::No ? IDNO : fakeMode == FakeMode::Cancel ? IDCANCEL : IDYES;
    }
    else if (kind == WORKER_DIALOG_UAC_DISK_RECOVERY_UNKNOWN)
    {
        ++unknownDialogs;
        if (cancelFlag && InterlockedCompareExchange(cancelFlag, 0, 0)) ++unknownWhileCancelled;
    }
    return 0;
}

