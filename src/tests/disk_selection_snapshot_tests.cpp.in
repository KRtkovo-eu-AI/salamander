static CDiskSelectionService& Service = *static_cast<CDiskSelectionService*>(GetDiskSelectionService());static CPanelItemPathsService Resolver;
BOOL CSalamanderGeneralAbstract::QueryService(const CSalamanderServiceQuery* q,CSalamanderServiceResult* r){++QueryCalls;r->Interface=nullptr;r->Version=0;if(strcmp(q->ServiceId,SALAMANDER_SERVICE_DISK_SELECTION)==0){if(!SnapshotAvailable)return FALSE;r->Interface=BadInterface?nullptr:&Service;}else{if(!ResolverAvailable)return FALSE;r->Interface=BadInterface?nullptr:&Resolver;}r->Version=BadVersion?0:q->MinimumVersion;return TRUE;}
static int Checks=0,Failures=0;
static void Check(bool value,const char* message){++Checks;if(!value){++Failures;printf("FAIL %s\n",message);}}
static CSalamanderGeneralAbstract General;
static CSalamanderGeneralAbstract* SalamanderGeneral=&General;
