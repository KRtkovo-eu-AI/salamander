// Compile the actual DemoPlug case, with only progress/UI operations replaced.
enum { MENU_EVENT_DISK=1, MENU_EVENT_FILES_SELECTED=2, MENU_EVENT_FILE_FOCUSED=4, MENUCMD_DOPFILES=7 };
static int SalamanderVersion;
struct OperationsFacade {
 int Opens=0,Closes=0,Steps=0;bool Cancel=false,DestroyListing=false;std::vector<std::string> Paths;
 void OpenProgressDialog(const char*,BOOL,void*,BOOL){++Opens;if(DestroyListing){Window.Left.Clear();MainWindow=nullptr;}}
 void ProgressSetTotalSize(CQuadWord,CQuadWord){}
 void ProgressDialogAddText(const char* text,BOOL){Paths.emplace_back(text);}
 BOOL ProgressAddSize(int,BOOL){++Steps;return !Cancel;}
 void ProgressEnableCancel(BOOL){}
 void CloseProgressDialog(){++Closes;}
};
