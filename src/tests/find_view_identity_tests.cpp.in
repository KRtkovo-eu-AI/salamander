// | 2026-11-11 | Exercise the real Find-view routing with a readable NTFS replacement. | Check captured identity before any pathname-only probe. | #731 | GPT-6.1 Terra |
#define WIN32_LEAN_AND_MEAN
#include <windows.h>
#include <algorithm>
#include <cstdio>
#include <memory>
#include <string>
#include <vector>
#define UacF7 RealUacF7
#include "@@INCLUDES@@/viewleaf.h"
#undef UacF7

static int probes, preparations, listingPreparations, confirmations, messages;
static int lastPrompt;
static bool consent = true, forceDenied = false, forceUnknown = false;
constexpr int IDS_UAC_VIEW_IDENTITY_HANDLER_UNSUPPORTED = 1, IDS_ERRORREADINGFILE = 2,
              IDS_VIEWERTITLE = 3, IDS_UAC_VIEW_VERIFIED_CONFIRM = 4, IDS_UAC_VIEW_CONFIRM = 5,
              IDS_UAC_VIEW_UNAVAILABLE = 6;
#define HANDLES_Q(x) (x)
#define HANDLES(x) (x)
static HANDLE ProbeCreateFile(const wchar_t* name, DWORD access, DWORD sharing, LPSECURITY_ATTRIBUTES security,
                              DWORD creation, DWORD flags, HANDLE templateFile)
{
    ++probes;
    if (forceDenied) { SetLastError(ERROR_ACCESS_DENIED); return INVALID_HANDLE_VALUE; }
    return ::CreateFileW(name, access, sharing, security, creation, flags, templateFile);
}
#define CreateFileW ProbeCreateFile
static const char* LoadStr(int) { return "test"; }
static const char* GetErrorText(DWORD) { return "test error"; }
static int SalMessageBox(HWND, const char*, const char*, unsigned) { ++messages; return 0; }
static bool ConfirmProtectedRead(HWND, int, int prompt, const std::wstring&)
{ ++confirmations; lastPrompt = prompt; return consent; }
static std::wstring SalPathAddExtendedPrefixW(const wchar_t* path) { return path; }

namespace UacF7 {
struct Result { DWORD error = ERROR_SUCCESS; bool unknown = false; };
struct PreparedLeaf {
    HANDLE parent = nullptr;
    UacDirectoryLeaf::ParentIdentity parentIdentity{};
    FILE_ID_INFO fileIdentity{};
    std::wstring leaf;
    bool PrepareView(const std::wstring&) { ++preparations; return false; }
    Result ReadViewerSnapshot(HWND, std::vector<BYTE>& snapshot) const {
        if (forceUnknown) return {ERROR_SUCCESS, true};
        return {UacViewLeaf::ReadVerifiedSnapshot(parent, parentIdentity, fileIdentity, leaf,
                                                 GetTickCount64() + 5000, snapshot), false};
    }
};
struct ListingSession {
    DWORD PrepareViewer(const std::wstring&, PreparedLeaf&) { ++listingPreparations; return ERROR_ACCESS_DENIED; }
};
}
@@CANDIDATE@@
@@CONTROLLER@@
constexpr int VIEWER_INTERNAL = 1, VIEWER_EXTERNAL = 2;
struct FakeViewer { int ViewerType = 0; };
static bool SupportsVerifiedViewer(HWND parent, const UacF7::PreparedLeaf* foundView, const FakeViewer* viewer) {
@@HANDLER_GUARD@@
    return true;
}
#undef CreateFileW

static int checks, failures;
static void Check(bool ok, const char* text) {
    ++checks; if (!ok) { ++failures; std::printf("FAIL %s (error %lu)\n", text, GetLastError()); }
}
static HANDLE OpenFile(const std::wstring& path, DWORD access, DWORD create) {
    return CreateFileW(path.c_str(), access, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
                       nullptr, create, FILE_ATTRIBUTE_NORMAL, nullptr);
}
int wmain(int argc, wchar_t** argv) {
    if (argc != 2) return 2;
    const std::wstring root(argv[1]), path = root + L"\\result-\u6771.txt", original = root + L"\\original.txt";
    HANDLE parent = CreateFileW(root.c_str(), FILE_LIST_DIRECTORY | FILE_READ_ATTRIBUTES,
                                FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, OPEN_EXISTING,
                                FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT, nullptr);
    if (parent == INVALID_HANDLE_VALUE) return 2;
    HANDLE file = OpenFile(path, GENERIC_WRITE | FILE_READ_ATTRIBUTES, CREATE_ALWAYS);
    DWORD written = 0; const BYTE originalByte = 42;
    if (file == INVALID_HANDLE_VALUE || !WriteFile(file, &originalByte, 1, &written, nullptr) || written != 1) return 2;
    FILETIME created{}, accessed{}, modified{};
    UacF7::PreparedLeaf verified; verified.parent = parent; verified.leaf = L"result-\u6771.txt";
    if (UacDirectoryLeaf::ReadParentIdentity(parent, verified.parentIdentity) ||
        !GetFileInformationByHandleEx(file, FileIdInfo, &verified.fileIdentity, sizeof(verified.fileIdentity)) ||
        !GetFileTime(file, &created, &accessed, &modified)) return 2;
    CloseHandle(file);
    const DWORD attrs = GetFileAttributesW(path.c_str());
    std::unique_ptr<std::vector<BYTE>> snapshot;
    bool readable = false; int source = 41, index = 42;
    Check(AllowFindViewerCandidate(true, false, 0) && AllowFindViewerCandidate(true, true, 0) &&
          AllowFindViewerCandidate(false, true, 0) && !AllowFindViewerCandidate(false, false, 0) &&
          !AllowFindViewerCandidate(true, false, FILE_ATTRIBUTE_REPARSE_POINT) &&
          !AllowFindViewerCandidate(true, false, FILE_ATTRIBUTE_DIRECTORY),
          "actual caller prepares candidates for captured identities, including alternate and explicit internal handlers");
    Check(PrepareProtectedViewerSnapshot(nullptr, &path, nullptr, &verified, snapshot, readable, source, index) &&
          snapshot && snapshot->size() == 1 && snapshot->front() == originalByte && !probes && !preparations &&
          confirmations == 1 && lastPrompt == IDS_UAC_VIEW_VERIFIED_CONFIRM && source == -1 && index == -1,
          "captured identity uses verified snapshot and disables viewer enumeration without probing the path");
    snapshot.reset(); source = 41; index = 42;
    if (!MoveFileW(path.c_str(), original.c_str())) return 2;
    file = OpenFile(original, FILE_READ_ATTRIBUTES, OPEN_EXISTING);
    if (file == INVALID_HANDLE_VALUE || !GetFileTime(file, &created, &accessed, &modified)) return 2;
    CloseHandle(file);
    file = OpenFile(path, GENERIC_WRITE | FILE_READ_ATTRIBUTES | FILE_WRITE_ATTRIBUTES, CREATE_NEW);
    const BYTE replacement = 99;
    if (file == INVALID_HANDLE_VALUE || !WriteFile(file, &replacement, 1, &written, nullptr) || written != 1 ||
        !SetFileTime(file, &created, &accessed, &modified)) return 2;
    FILE_ID_INFO replacementId{};
    if (!GetFileInformationByHandleEx(file, FileIdInfo, &replacementId, sizeof(replacementId))) return 2;
    CloseHandle(file);
    if (!SetFileAttributesW(path.c_str(), attrs)) return 2;
    Check(GetFileAttributesW(path.c_str()) == attrs &&
          std::memcmp(&replacementId.FileId, &verified.fileIdentity.FileId, sizeof(replacementId.FileId)) != 0,
          "same-name readable replacement has matching attributes but different NTFS ID");
    FILETIME replacementCreated{}, replacementAccessed{}, replacementModified{};
    file = OpenFile(path, FILE_READ_ATTRIBUTES, OPEN_EXISTING);
    const bool matchingTimes = file != INVALID_HANDLE_VALUE && GetFileTime(file, &replacementCreated, &replacementAccessed, &replacementModified) &&
        !CompareFileTime(&created, &replacementCreated) && !CompareFileTime(&accessed, &replacementAccessed) &&
        !CompareFileTime(&modified, &replacementModified);
    if (file != INVALID_HANDLE_VALUE) CloseHandle(file);
    Check(matchingTimes, "replacement duplicates all original times");
    Check(!PrepareProtectedViewerSnapshot(nullptr, &path, nullptr, &verified, snapshot, readable, source, index) &&
          snapshot && snapshot->empty() && !probes && !preparations && messages == 1,
          "readable same-metadata replacement is refused without probing or recapturing identity");
    snapshot.reset(); consent = false;
    Check(!PrepareProtectedViewerSnapshot(nullptr, &path, nullptr, &verified, snapshot, readable, source, index) &&
          !snapshot && !probes && !preparations, "declined verified viewing does not open or re-identify the file");
    consent = true;
    Check(!PrepareProtectedViewerSnapshot(nullptr, nullptr, nullptr, &verified, snapshot, readable, source, index) &&
          !snapshot && !probes && !preparations, "a missing candidate fails closed when an identity was supplied");
    consent = true; forceUnknown = true; snapshot.reset();
    Check(!PrepareProtectedViewerSnapshot(nullptr, &path, nullptr, &verified, snapshot, readable, source, index) &&
          !probes && !preparations, "an unconfirmed snapshot cannot fall back to a readable pathname");
    forceUnknown = false;
    FakeViewer internal{VIEWER_INTERNAL}, external{VIEWER_EXTERNAL}, plugin{-3};
    Check(SupportsVerifiedViewer(nullptr, &verified, &internal) &&
          !SupportsVerifiedViewer(nullptr, &verified, &external) &&
          !SupportsVerifiedViewer(nullptr, &verified, &plugin) &&
          !SupportsVerifiedViewer(nullptr, &verified, nullptr) &&
          SupportsVerifiedViewer(nullptr, nullptr, &external),
          "actual handler guard rejects external and plugin viewers only for verified results");
    snapshot.reset(); readable = false;
    Check(PrepareProtectedViewerSnapshot(nullptr, &path, nullptr, nullptr, snapshot, readable, source, index) &&
          readable && probes == 1 && !snapshot, "an ordinary result retains its native readable path probe");
    forceDenied = true; readable = false;
    UacF7::ListingSession listing;
    Check(!PrepareProtectedViewerSnapshot(nullptr, &path, &listing, nullptr, snapshot, readable, source, index) &&
          probes == 2 && preparations == 1 && listingPreparations == 1 && !snapshot,
          "ordinary denied result retains the existing listing fallback and failure");
    CloseHandle(parent);
    std::printf("Find viewer identity: %d checks, %d failures\n", checks, failures);
    return failures ? 1 : 0;
}
