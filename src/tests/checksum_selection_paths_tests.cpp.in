template<class T> struct TIndirectArray {
 std::vector<T*> Data;int Count=0;
 TIndirectArray(int,int,int=dtDelete){}
 ~TIndirectArray(){for(auto p:Data)delete p;}
 T*& operator[](int i){return Data.at(i);}
 void Add(T* p){Data.push_back(p);Count=static_cast<int>(Data.size());}
 bool IsGood()const{return true;}void ResetState(){}
};
