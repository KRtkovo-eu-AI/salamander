void CCalculateDialog::Execute(){
 CapturedRoot=SourcePath;Captured.clear();
 if(!GetFileList()){++Errors;return;}
 BOOL stop=FALSE;CCalculateThread worker(this,&stop);worker.Body();
 for(int i=0;i<FileList.Count;++i)Captured.push_back({FileList[i]->Name,FileList[i]->FullPath,FileList[i]->Hashes[0]?FileList[i]->Hashes[0]:"",FileList[i]->Size});
}
void CVerifyDialog::Execute(){
 VerifyDirectory=sourcePath;VerifyFile=sourceFile;Captured.clear();
 if(!LoadSourceFile()){++Errors;return;}
 for(int i=0;i<FileList.Count;++i)Captured.push_back({FileList[i]->Name,fileList[i]->fileName,"",fileList[i]->size});
}
static int Checks = 0, Failures = 0;
static void Check(bool success, const char* description)
{
    ++Checks;
    if (!success) { ++Failures; std::printf("FAIL: %s (Win32 %lu)\n", description, GetLastError()); }
}
static std::string Utf8(const std::wstring& value)
{
    const int count = WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, value.c_str(), -1, nullptr, 0, nullptr, nullptr);
    if (count <= 0) std::abort();
    std::string result(count, '\0');
    WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, value.c_str(), -1, &result[0], count, nullptr, nullptr);
    result.resize(count - 1);
    return result;
}
static std::wstring Extended(const std::wstring& value)
{
    return value.compare(0, 4, L"\\\\?\\") == 0 ? value : L"\\\\?\\" + value;
}
struct Fixtures
{
    std::wstring Root, OldDirectory;
    std::vector<std::wstring> Files, Directories;
    Fixtures()
    {
        std::vector<wchar_t> buffer(SAL_MAX_PATH);
        DWORD count = GetCurrentDirectoryW(static_cast<DWORD>(buffer.size()), buffer.data());
        if (!count || count >= buffer.size()) std::abort();
        OldDirectory.assign(buffer.data(), count);
        count = GetTempPathW(static_cast<DWORD>(buffer.size()), buffer.data());
        if (!count || count >= buffer.size()) std::abort();
        Root.assign(buffer.data(), count);
        Root += L"Samandarin-size-" + std::to_wstring(GetCurrentProcessId()) + L"-" + std::to_wstring(GetTickCount64());
        if (!CreateDirectoryW(Root.c_str(), nullptr)) std::abort();
        Directories.push_back(Root);
    }
    bool Owned(const std::wstring& path) const
    {
        return path == Root || (path.size() > Root.size() &&
               path.compare(0, Root.size(), Root) == 0 && path[Root.size()] == L'\\');
    }
    ~Fixtures()
    {
        Check(SetCurrentDirectoryW(OldDirectory.c_str()) != FALSE, "restore working directory");
        for (auto i = Files.rbegin(); i != Files.rend(); ++i)
            Check(Owned(*i) && DeleteFileW(Extended(*i).c_str()) != FALSE, "remove own fixture file");
        for (auto i = Directories.rbegin(); i != Directories.rend(); ++i)
            Check(Owned(*i) && RemoveDirectoryW(Extended(*i).c_str()) != FALSE, "remove own fixture directory");
    }
    std::wstring Directory(const std::wstring& parent, const std::wstring& name)
    {
        const std::wstring path = parent + L"\\" + name;
        if (!Owned(path) || !CreateDirectoryW(Extended(path).c_str(), nullptr)) std::abort();
        Directories.push_back(path);
        return path;
    }
    std::wstring File(const std::wstring& parent, const std::wstring& name, DWORD size)
    {
        const std::wstring path = parent + L"\\" + name;
        if (!Owned(path)) std::abort();
        HANDLE handle = CreateFileW(Extended(path).c_str(), GENERIC_WRITE,
            FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, nullptr);
        if (handle == INVALID_HANDLE_VALUE) std::abort();
        Files.push_back(path);
        std::string payload(size, 'x');
        DWORD written = 0;
        const BOOL ok = WriteFile(handle, payload.data(), size, &written, nullptr);
        CloseHandle(handle);
        if (!ok || written != size) std::abort();
        return path;
    }
};

static void RunPending(){auto threads=std::move(Pending);Pending.clear();for(auto p:threads){p->Body();delete p;}}
static void Populate(const Fixtures& fixture,const std::vector<std::wstring>& paths,bool selected){
 Window.Left.Clear();Window.Left.Root=fixture.Root;Window.Left.RootText=Utf8(fixture.Root);
 for(const auto& p:paths){const auto relative=p.substr(fixture.Root.size()+1);auto f=Window.Left.Add(ChecksumPaths::Base(p),p,relative,selected);WIN32_FILE_ATTRIBUTE_DATA data={};GetFileAttributesExW(Extended(p).c_str(),GetFileExInfoStandard,&data);f->Size.Set(data.nFileSizeLow,data.nFileSizeHigh);f->Attr=data.dwFileAttributes;f->IsLink=FALSE;}
 Window.Left.Focus=0;
}
int main(){
 MainThreadID=GetCurrentThreadId();TestWindow=CreateWindowExW(0,L"STATIC",L"",0,0,0,1,1,nullptr,nullptr,GetModuleHandleW(nullptr),nullptr);
 {
  Fixtures fixture;
  auto first=fixture.Directory(fixture.Root,L"ascii");auto second=fixture.Directory(fixture.Root,L"žluťoučký東京");
  std::vector<std::wstring> paths={fixture.File(first,L"same.bin",1),fixture.File(second,L"same.bin",2)};
  auto folder=second;for(int i=0;i<14;++i)folder=fixture.Directory(folder,L"long-東京-component-"+std::to_wstring(i));
  paths.push_back(fixture.File(folder,L"same.bin",3));
  paths.push_back(fixture.File(first,std::wstring(90,L'東')+L".bin",4));
  Populate(fixture,paths,true);
  Check(OpenCalculateDialog(nullptr),"actual Calculate command accepts selected snapshot");
  Window.Left.Clear();RunPending();
  Check(Errors==0&&Captured.size()==paths.size(),"actual modeless worker survives panel destruction");
  Check(CapturedRoot==Utf8(fixture.Root),"calculate preserves root output default");
  for(size_t i=0;i<paths.size()&&i<Captured.size();++i){Check(Captured[i].Full==Utf8(paths[i]),"calculation uses exact source path");Check(Captured[i].Name==Utf8(paths[i].substr(fixture.Root.size()+1)),"duplicates retain relative display/export identity");Check(!Captured[i].Hash.empty()&&Captured[i].Hash!="cancelled"&&Captured[i].Hash!="skipped","actual worker reads Unicode/long source");}
  Check(Captured.size()>1&&Captured[0].Hash!=Captured[1].Hash,"duplicate basenames read different file contents");
  Populate(fixture,paths,false);Window.Left.Focus=1;Check(OpenCalculateDialog(nullptr),"focused Calculate fallback");Window.Left.Clear();RunPending();Check(Captured.size()==1&&Captured[0].Full==Utf8(paths[1]),"focused exact actual parent");
  const auto manifest=folder+L"\\checksum.sfv";
  const std::string content="same.bin  00000000\r\n"+Utf8(paths[0])+"  00000000\r\n";
  HANDLE h=CreateFileW(Extended(manifest).c_str(),GENERIC_WRITE,0,nullptr,CREATE_NEW,0,nullptr);DWORD done=0;Check(h!=INVALID_HANDLE_VALUE&&WriteFile(h,content.data(),static_cast<DWORD>(content.size()),&done,nullptr),"create own Unicode long manifest");if(h!=INVALID_HANDLE_VALUE){CloseHandle(h);fixture.Files.push_back(manifest);}
  Populate(fixture,{manifest},false);Check(OpenVerifyDialog(nullptr),"actual Verify command accepts exact focused manifest");Window.Left.Clear();RunPending();
  Check(Errors==0&&VerifyFile==Utf8(manifest)&&VerifyDirectory==Utf8(folder),"Verify uses actual manifest parent after panel destruction");
  Check(Captured.size()==2&&Captured[0].Full==Utf8(paths[2])&&Captured[0].Size==CQuadWord(3,0),"relative manifest entry resolves under actual parent");
  Check(Captured.size()==2&&Captured[1].Full==Utf8(paths[0])&&Captured[1].Size==CQuadWord(1,0),"absolute manifest entry retains exact path");
  // Directory selections enumerate exact children, independently of panel rows.
  Populate(fixture,{second},true);Window.Left.Files->At(0).Selected=FALSE;Window.Left.Files->Clear();
  Window.Left.Add(ChecksumPaths::Base(second),second,second.substr(fixture.Root.size()+1),true,true);
  Check(OpenCalculateDialog(nullptr),"selected directory accepted");Window.Left.Clear();RunPending();
  Check(Errors==0&&Captured.size()==3,"recursive Unicode directory enumerates files and manifest without root reconstruction");
  // Exercise actual SaveHashes with only the modal destination picker replaced.
  TSeedFileList empty(1,1,dtDelete);const auto rootUtf8=Utf8(fixture.Root);
  CCalculateDialog save(nullptr,FALSE,&empty,rootUtf8.c_str());
  for(const auto& path:paths){save.AddFileListItem(Utf8(path.substr(fixture.Root.size()+1)).c_str(),CQuadWord(0,0),TRUE,Utf8(path).c_str());save.SetItemTextAndIcon(save.FileList.Count-1,2,"00000000");}
  SaveTarget=fixture.Root+L"\\export.sfv";save.SaveHashes();fixture.Files.push_back(SaveTarget);
  const auto savedUtf8=Utf8(SaveTarget);CVerifyDialog exported(nullptr,FALSE,rootUtf8.c_str(),savedUtf8.c_str());
  Check(exported.LoadSourceFile()&&exported.fileList.Count==static_cast<int>(paths.size()),"actual UTF8 export parses back all paths");
  for(int i=0;i<exported.fileList.Count;++i)Check(exported.fileList[i]->fileName==Utf8(paths[i]),"export/verify roundtrip preserves duplicate Unicode long identity");
  SaveTarget=second+L"\\elsewhere.sfv";save.SaveHashes();fixture.Files.push_back(SaveTarget);
  const auto elsewhereUtf8=Utf8(SaveTarget),secondUtf8=Utf8(second);
  CVerifyDialog elsewhere(nullptr,FALSE,secondUtf8.c_str(),elsewhereUtf8.c_str());
  Check(elsewhere.LoadSourceFile()&&elsewhere.fileList.Count==static_cast<int>(paths.size()),"save outside source root uses valid absolute entries");
  for(int i=0;i<elsewhere.fileList.Count;++i)Check(elsewhere.fileList[i]->fileName==Utf8(paths[i]),"relocated manifest resolves exact original source");
  Populate(fixture,paths,true);Window.Left.Missing=true;const auto pending=Pending.size();Check(!OpenCalculateDialog(nullptr)&&Pending.size()==pending,"resolver failure launches no calculation and never synthesizes root/name");
  Window.Left.Missing=false;FailCreate=true;Check(!OpenCalculateDialog(nullptr),"failed thread start returns failure with owned snapshot cleanup");FailCreate=false;
 }
 DestroyWindow(TestWindow);
 std::printf("Checksum actual consumers: %d checks, %d failures\n",Checks,Failures);
 return Failures?1:0;
}
