class CHashAlgo {
public:virtual ~CHashAlgo(){};std::string Bytes;
 virtual bool Init(){Bytes.clear();return true;}
 virtual bool Update(const char* p,DWORD n){Bytes.append(p,n);return true;}
 virtual bool Finalize(){return true;}
 virtual int GetDigest(char* out,DWORD){unsigned char value=0;for(char c:Bytes)value=static_cast<unsigned char>(value+static_cast<unsigned char>(c));out[0]=static_cast<char>(value);return 1;}
 virtual bool ParseDigest(char*,char*,int,char*)=0;
};
class CCRCAlgo:public CHashAlgo {public:bool ParseDigest(char*,char*,int,char*) override;};
