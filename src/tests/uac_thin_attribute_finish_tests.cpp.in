// | 2026-11-14 | Check scoped completion attribute observation. | Exercise the revised native comparison input. | #731 | GPT-6 |
// | 2026-11-14 | Compare real zero-attribute completion APIs. | Preserve the native archive-clearing semantics. | #731 | GPT-6 |
// | 2026-11-14 | Verify scoped CopyAttrs preserves the archive bit. | Match the original attribute selection. | #731 | GPT-6 |
// | 2026-11-14 | Exercise loss before scoped attribute completion. | Prevent further metadata writes after a detected broken session. | #731 | GPT-6 |
// | 2026-11-14 | Model native target attribute completion. | Preserve normal pathname behavior for a locally overwritten target. | #731 | GPT-6 |
// | 2026-11-13 | Exercise actual scoped F5 completion branch. | Compare attribute failures with the ordinary worker path. | #731 | GPT-6 |
#include <windows.h>
#include <winioctl.h>
#include <cstdio>
#include <sstream>
#include <string>
#define SAM_UAC_THIN_COPY_TEST
#define HANDLES(x) (x)
#define TRACE_E(x) do { std::ostringstream trace; trace << x; } while (0)
#define WM_USER_DIALOG (WM_APP + 42)
constexpr int IDS_ERRORWRITINGFILE = 1, IDS_ERRORCHANGINGATTRS = 2;
constexpr int IDB_SKIPALL = 300, IDB_SKIP = 301;

struct TestState {
    bool scoped = false, nativeTarget = false, copyAttrs = false, failAttributes = false, failClose = false, failScopedClose = false, connectionLost = false;
    int handleAttributes = 0, pathAttributes = 0, closes = 0, releases = 0, reports = 0;
    DWORD passedAttributes = 0, reportedError = 0, sourceAttributes = FILE_ATTRIBUTE_HIDDEN | FILE_ATTRIBUTE_READONLY;
    DWORD observedAttributes = FILE_ATTRIBUTE_ARCHIVE;
    HANDLE attributesHandle = nullptr;
} state;
struct TestScript { BOOL CopyAttrs = FALSE; };
struct TestOperation { char* TargetName = const_cast<char*>("fixture"); bool TargetNameWValid = true; std::wstring TargetNameW = L"fixture"; };
struct TestDialog { HANDLE WorkerNotSuspended = nullptr; BOOL* CancelWorker = nullptr; BOOL SkipAllFileWrite = FALSE; };
struct TestThin {
    bool Scoped() const { return state.scoped; }
    bool ScopedTarget() const { return Scoped() && !state.nativeTarget; }
    bool CheckCompletionConnection(int) {
        if (state.connectionLost) { ++state.reports; state.reportedError = ERROR_BROKEN_PIPE; return false; }
        return true;
    }
    bool CloseScopedTarget(HANDLE& out) {
        ++state.closes; out = nullptr;
        if (state.failScopedClose) { ++state.reports; state.reportedError = ERROR_INVALID_HANDLE; return false; }
        return true;
    }
    void ReleaseTargetPin() { if (state.scoped) ++state.releases; }
    void ReportTargetFailure(DWORD error, int = 0) { ++state.reports; state.reportedError = error; }
};

static BOOL MockSetFileInformationByHandle(HANDLE file, FILE_INFO_BY_HANDLE_CLASS kind, LPVOID value, DWORD size)
{
    ++state.handleAttributes; state.attributesHandle = file;
    if (kind != FileBasicInfo || size != sizeof(FILE_BASIC_INFO)) return FALSE;
    state.passedAttributes = static_cast<FILE_BASIC_INFO*>(value)->FileAttributes;
    if (state.failAttributes) { SetLastError(ERROR_ACCESS_DENIED); return FALSE; }
    state.observedAttributes = state.passedAttributes;
    return TRUE;
}
static BOOL MockGetFileInformationByHandleEx(HANDLE, FILE_INFO_BY_HANDLE_CLASS kind, LPVOID value, DWORD size)
{
    if (kind != FileBasicInfo || size != sizeof(FILE_BASIC_INFO)) return FALSE;
    static_cast<FILE_BASIC_INFO*>(value)->FileAttributes = state.observedAttributes;
    return TRUE;
}
static BOOL MockSetFileAttributesW(LPCWSTR, DWORD attrs)
{
    ++state.pathAttributes; state.passedAttributes = attrs;
    if (state.failAttributes) { SetLastError(ERROR_ACCESS_DENIED); return FALSE; }
    return TRUE;
}
static BOOL MockCloseHandle(HANDLE)
{
    ++state.closes;
    if (state.failClose) { SetLastError(ERROR_INVALID_HANDLE); return FALSE; }
    return TRUE;
}
static BOOL MockDeleteFileW(LPCWSTR) { return FALSE; }
static std::wstring WorkerOperationPathW(const char*, const wchar_t* exact) { return exact ? exact : L""; }
static char* LoadStr(int) { static char value[] = "caption"; return value; }
static char* GetErrorText(DWORD) { static char value[] = "error"; return value; }
static LRESULT MockSendMessage(HWND, UINT, WPARAM, LPARAM) { return 0; }
#define SetFileInformationByHandle MockSetFileInformationByHandle
#define GetFileInformationByHandleEx MockGetFileInformationByHandleEx
#define SetFileAttributesW MockSetFileAttributesW
#define CloseHandle MockCloseHandle
#define DeleteFileW MockDeleteFileW
#undef SendMessage
#define SendMessage MockSendMessage

static BOOL Finish()
{
    HANDLE out = reinterpret_cast<HANDLE>(static_cast<ULONG_PTR>(1));
    DWORD attr = state.sourceAttributes;
    DWORD scopedFinishedAttrs = INVALID_FILE_ATTRIBUTES;
    bool scopedFinishedTarget = false;
    TestScript object; object.CopyAttrs = state.copyAttrs; TestScript* script = &object;
    TestOperation operation; TestOperation* op = &operation;
    TestThin thin;
    BOOL cancelled = FALSE;
    TestDialog dlgData; dlgData.CancelWorker = &cancelled;
    HWND hProgressDlg = nullptr;
    if (out != nullptr)
    {
@@FINISH_BRANCH@@
    if (script->CopyAttrs) thin.ReleaseTargetPin();
    if (script->CopyAttrs && scopedFinishedTarget && scopedFinishedAttrs != state.observedAttributes) return FALSE;
    return TRUE;
COPY_ERROR:
    return FALSE;
SKIP_COPY:
    return FALSE;
COPY_AGAIN:
    return FALSE;
}

#undef SetFileInformationByHandle
#undef GetFileInformationByHandleEx
#undef SetFileAttributesW
#undef CloseHandle
#undef DeleteFileW
static bool RealZeroAttributesMatch()
{
    const wchar_t* paths[] = {L"native-\u6771.tmp", L"handle-\u6771.tmp"};
    DWORD results[2]{};
    for (unsigned i = 0; i != 2; ++i)
    {
        HANDLE file = CreateFileW(paths[i], GENERIC_WRITE, 0, nullptr, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, nullptr);
        if (file == INVALID_HANDLE_VALUE) return false;
        bool ok = CloseHandle(file) != FALSE && SetFileAttributesW(paths[i], FILE_ATTRIBUTE_ARCHIVE) != FALSE;
        if (ok && i == 0)
            ok = SetFileAttributesW(paths[i], 0) != FALSE;
        else if (ok)
        {
            file = CreateFileW(paths[i], GENERIC_WRITE, 0, nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
            if (file == INVALID_HANDLE_VALUE) ok = false;
            else
            {
                FILE_BASIC_INFO basic{};
                basic.FileAttributes = FILE_ATTRIBUTE_NORMAL;
                ok = SetFileInformationByHandle(file, FileBasicInfo, &basic, sizeof(basic)) != FALSE;
                ok = CloseHandle(file) != FALSE && ok;
            }
        }
        if (ok) results[i] = GetFileAttributesW(paths[i]);
        if (!DeleteFileW(paths[i]) || !ok) return false;
    }
    return results[0] == FILE_ATTRIBUTE_NORMAL && results[1] == results[0];
}

static bool RealCompressedAttributesMatch()
{
    const wchar_t* paths[] = {L"native-compressed-東.tmp", L"handle-compressed-東.tmp"};
    DWORD results[2]{};
    bool ok = true;
    for (unsigned i = 0; i != 2; ++i)
    {
        HANDLE file = CreateFileW(paths[i], GENERIC_READ | GENERIC_WRITE, 0, nullptr, CREATE_NEW,
                                  FILE_ATTRIBUTE_NORMAL, nullptr);
        if (file == INVALID_HANDLE_VALUE) { ok = false; break; }
        USHORT format = COMPRESSION_FORMAT_DEFAULT;
        DWORD bytes = 0;
        bool current = DeviceIoControl(file, FSCTL_SET_COMPRESSION, &format, sizeof(format),
                                       nullptr, 0, &bytes, nullptr) != FALSE;
        if (current && i == 1)
        {
            FILE_BASIC_INFO basic{};
            basic.FileAttributes = FILE_ATTRIBUTE_COMPRESSED | FILE_ATTRIBUTE_HIDDEN | FILE_ATTRIBUTE_READONLY;
            current = SetFileInformationByHandle(file, FileBasicInfo, &basic, sizeof(basic)) != FALSE;
            if (current && GetFileInformationByHandleEx(file, FileBasicInfo, &basic, sizeof(basic)))
                results[i] = basic.FileAttributes;
            else current = false;
        }
        current = CloseHandle(file) != FALSE && current;
        if (current && i == 0)
        {
            current = SetFileAttributesW(paths[i], FILE_ATTRIBUTE_COMPRESSED | FILE_ATTRIBUTE_HIDDEN |
                                                  FILE_ATTRIBUTE_READONLY) != FALSE;
            if (current) results[i] = GetFileAttributesW(paths[i]);
        }
        if (!current) { ok = false; break; }
    }
    for (const auto path : paths)
        if (GetFileAttributesW(path) != INVALID_FILE_ATTRIBUTES)
        {
            SetFileAttributesW(path, FILE_ATTRIBUTE_NORMAL);
            if (!DeleteFileW(path)) ok = false;
        }
    const DWORD mask = FILE_ATTRIBUTE_COMPRESSED | FILE_ATTRIBUTE_HIDDEN | FILE_ATTRIBUTE_READONLY | FILE_ATTRIBUTE_ARCHIVE;
    return ok && (results[0] & mask) == (results[1] & mask) && (results[1] & FILE_ATTRIBUTE_COMPRESSED);
}

static void Check(bool condition, const char* name, int& failures)
{
    std::printf("%s %s\n", condition ? "PASS" : "FAIL", name);
    if (!condition) ++failures;
}
int main()
{
    int failures = 0;
    Check(RealZeroAttributesMatch(), "real file APIs agree on clearing the archive attribute", failures);
    Check(RealCompressedAttributesMatch(), "real compressed file APIs preserve the same displayed attributes", failures);
    state = {}; state.scoped = true; state.connectionLost = true;
    Check(!Finish() && state.handleAttributes == 0 && state.pathAttributes == 0 &&
          state.reports == 1 && state.reportedError == ERROR_BROKEN_PIPE,
          "lost session stops scoped attribute updates", failures);
    state = {}; state.scoped = true; state.nativeTarget = true; state.connectionLost = true;
    Check(!Finish() && state.handleAttributes == 0 && state.pathAttributes == 0 &&
          state.reports == 1 && state.reportedError == ERROR_BROKEN_PIPE,
          "lost source session stops native target attribute updates", failures);
    state = {}; state.scoped = true; state.nativeTarget = true;
    Check(Finish() && state.handleAttributes == 0 && state.pathAttributes == 1 &&
          state.closes == 1 && state.releases == 1 && state.reports == 0,
          "native target keeps the original attribute completion even with a scoped source", failures);
    for (bool attributeFailure : {false, true})
    {
        state = {}; state.scoped = true; state.failAttributes = attributeFailure;
        Check(Finish() && state.handleAttributes == 1 && state.pathAttributes == 0 &&
              state.attributesHandle == reinterpret_cast<HANDLE>(static_cast<ULONG_PTR>(1)) &&
              state.passedAttributes == (FILE_ATTRIBUTE_HIDDEN | FILE_ATTRIBUTE_READONLY | FILE_ATTRIBUTE_ARCHIVE) &&
              state.closes == 1 && state.releases == 1 && state.reports == 0,
              attributeFailure ? "scoped ordinary attribute failure is ignored after safe handle use" :
                                 "scoped ordinary attributes are set on the exact handle", failures);
        state = {}; state.failAttributes = attributeFailure;
        Check(Finish() && state.handleAttributes == 0 && state.pathAttributes == 1 &&
              state.closes == 1 && state.releases == 0 && state.reports == 0,
              attributeFailure ? "native ordinary attribute failure is ignored" :
                                 "native ordinary attributes use the existing path", failures);
    }
    state = {}; state.scoped = true; state.copyAttrs = true;
    Check(Finish() && state.handleAttributes == 1 && state.pathAttributes == 0 &&
          state.passedAttributes == (FILE_ATTRIBUTE_HIDDEN | FILE_ATTRIBUTE_READONLY) &&
          state.closes == 1 && state.releases == 1 && state.reports == 0,
          "hypothetical CopyAttrs=true keeps archive clear on the scoped target", failures);
    state = {}; state.scoped = true; state.copyAttrs = true; state.sourceAttributes = FILE_ATTRIBUTE_ARCHIVE;
    Check(Finish() && state.passedAttributes == FILE_ATTRIBUTE_ARCHIVE && state.reports == 0,
          "hypothetical CopyAttrs=true keeps archive set on the scoped target", failures);
    state = {}; state.scoped = true; state.copyAttrs = true; state.sourceAttributes = 0;
    Check(Finish() && state.passedAttributes == FILE_ATTRIBUTE_NORMAL && state.reports == 0,
          "hypothetical zero attributes clear archive rather than leave it unchanged", failures);
    state = {}; state.scoped = true; state.failAttributes = true; state.copyAttrs = true;
    Check(Finish() && state.handleAttributes == 1 && state.pathAttributes == 0 &&
          state.closes == 1 && state.releases == 1 && state.reports == 0,
          "CopyAttrs failure is left to the native attribute comparison", failures);
    state = {}; state.scoped = true; state.failAttributes = true; state.copyAttrs = true; state.failScopedClose = true;
    Check(Finish() && state.handleAttributes == 1 && state.pathAttributes == 0 &&
          state.closes == 1 && state.releases == 1 && state.reports == 0,
          "CopyAttrs setting failure does not bypass native comparison", failures);
    state = {}; state.scoped = true; state.failAttributes = true; state.failClose = true;
    Check(!Finish() && state.closes == 1 && state.releases == 0 && state.reports == 1 &&
          state.reportedError == ERROR_INVALID_HANDLE && state.pathAttributes == 0,
          "uncertain close remains a failure and never falls back to pathname", failures);
    return failures ? 1 : 0;
}
