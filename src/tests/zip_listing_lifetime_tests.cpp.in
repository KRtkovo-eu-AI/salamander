using QWORD = unsigned long long;
static int Checks = 0, Failures = 0;
static void Check(bool ok, const char* reason)
{
    ++Checks;
    if (!ok) { ++Failures; std::printf("FAIL: %s\n", reason); }
}
static std::vector<void*> Live;
static int Allocation = 0, FailAllocation = 0;
static bool FailMetadata = false;
static void* OwnedMalloc(size_t bytes)
{
    if (++Allocation == FailAllocation) return nullptr;
    void* result = std::malloc(bytes);
    if (result) Live.push_back(result);
    return result;
}
static void OwnedFree(void* value)
{
    if (!value) return;
    const auto found = std::find(Live.begin(), Live.end(), value);
    Check(found != Live.end(), "release only an owned allocation, exactly once");
    if (found != Live.end()) { Live.erase(found); std::free(value); }
}
// One-shot fault at the actual production nothrow metadata allocation.
void* operator new(size_t bytes, const std::nothrow_t&) noexcept
{
    if (FailMetadata) { FailMetadata = false; return nullptr; }
    return std::malloc(bytes);
}
#define malloc OwnedMalloc
#define free OwnedFree
