static struct General
{
    void* Alloc(size_t bytes) { return OwnedMalloc(bytes); }
    void Free(void* data) { OwnedFree(data); }
    void GetConfigParameter(int, int* value, size_t, void*) { *value = 0; }
    BOOL IsFileLink(const char*) { return FALSE; }
} GeneralObject;
static General* SalamanderGeneral = &GeneralObject;
enum { MAX_HEADER_SIZE=65536, HS_UNIX=3, FILE_ATTTRIBUTE_MASK=0xFFFFFFFF,
    GPF_ENCRYPTED=1, SALCFG_SORTBYEXTDIRSASFILES=1, SALDIRFLAG_CASESENSITIVE=1,
    IDS_LOWMEM=10, IDS_ERRADDDIR=11, IDS_ERRADDFILE=12,
    IDS_ERRADDDIR_TOOLONG=13, IDS_ERRADDFILE_TOOLONG=14 };
struct CFileHeader { unsigned Version; };
struct Entry { std::string name; bool directory=false, unixEntry=false; };
static std::wstring Wide(const char* value)
{
    const int length = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, value, -1, nullptr, 0);
    if (!length) std::abort();
    std::wstring result(length, L'\0');
    MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, value, -1, &result[0], length);
    result.resize(length-1);
    return result;
}
static void ReleaseData(CFileData& file)
{
    delete reinterpret_cast<CZIPFileData*>(file.PluginData);
    OwnedFree(file.Name);
}
class CSalamanderDirectoryAbstract
{
public:
    std::vector<CFileData> entries;
    int reject=-1, added=0, cleared=0;
    bool optionalWideFailure=false;
    CSalamanderDirectoryAbstract() { entries.reserve(100); }
    ~CSalamanderDirectoryAbstract() { Clear(nullptr); }
    void Clear(void*)
    {
        for (auto& file : entries) ReleaseData(file);
        entries.clear(); ++cleared;
    }
    void SetFlags(int) {}
    BOOL Add(const char*, CFileData& file, bool directory)
    {
        if (optionalWideFailure) Check(file.NameW == nullptr, "optional Unicode allocation may fail safely");
        else Check(file.NameW && Wide(file.Name) == file.NameW, "borrowed Unicode name remains exact during callback");
        if (added++ == reject) return FALSE;
        CFileData copied = directory ? CopyDir(file) : CopyFile(file);
        Check(copied.NameW == nullptr, "actual legacy host boundary does not adopt optional wide name");
        Check(copied.Name == file.Name && copied.PluginData == file.PluginData, "legacy host preserves byte name and plugin owner");
        entries.push_back(copied);
        return TRUE;
    }
    BOOL AddFile(const char* path, CFileData& file, void*) { return Add(path, file, false); }
    BOOL AddDir(const char* path, CFileData& file, void*) { return Add(path, file, true); }
};
class CZipList
{
public:
    const std::vector<Entry>& input;
    const Entry* current=nullptr;
    QWORD CentrDirOffs=0, ExtraBytes=0, CentrDirSize;
    BOOL ZeroZip=FALSE, Unix=FALSE, MultiVol=FALSE;
    int DiskNum=0, CentrDirStartDisk=0, readError=-1;
    explicit CZipList(const std::vector<Entry>& entries) : input(entries), CentrDirSize(entries.size()) {}
    int ChangeDisk() { return 0; }
    int ReadCentralHeader(CFileHeader* header, QWORD* offset, unsigned* size)
    {
        if (static_cast<int>(*offset) == readError) return IDS_ERRADDFILE;
        current=&input.at(static_cast<size_t>((*offset)++));
        header->Version=current->unixEntry ? HS_UNIX<<8 : 0;
        *size=1; return 0;
    }
    int ProcessName(CFileHeader*, char* name)
    {
        strcpy(name,current->name.c_str()); return static_cast<int>(current->name.size());
    }
    void ProcessHeader(CFileHeader*, CFileInfo* info)
    {
        info->Size=11; info->CompSize=7; info->Flag=0; info->FileAttr=0;
        info->IsDir=current->directory; info->LastWrite={};
    }
    int List(CSalamanderDirectoryAbstract*, BOOL&);
};
#define malloc OwnedMalloc
#define free OwnedFree
@@LIST@@
#undef malloc
#undef free
static void Scenario(const char* label, std::vector<Entry> entries, int expected,
                     int reject=-1, int failAllocation=0, bool failMetadata=false, int readError=-1)
{
    std::printf("Scenario: %s\n",label);
    CSalamanderDirectoryAbstract directory;
    directory.reject=reject; directory.optionalWideFailure=failAllocation==4;
    CZipList zip(entries); zip.readError=readError;
    Allocation=0; FailAllocation=failAllocation; FailMetadata=failMetadata;
#ifdef _DEBUG
    _CrtMemState before, after, difference;
    _CrtMemCheckpoint(&before);
#endif
    BOOL haveFiles=FALSE;
    Check(zip.List(&directory,haveFiles)==expected,"actual listing result");
    if (!expected) Check(haveFiles && !directory.entries.empty(),"successful listing retains entries");
    if (zip.Unix) Check(directory.cleared>0,"Unix restart released earlier listing");
    for (const auto& file : directory.entries)
        Check(file.Size==CQuadWord(11,0),"listing preserves file size");
    directory.Clear(nullptr);
    Check(Live.empty(),"listing releases every owned buffer on success, rejection, reset or allocation failure");
#ifdef _DEBUG
    _CrtMemCheckpoint(&after);
    _CrtMemDifference(&difference,&before,&after);
    Check(difference.lCounts[_NORMAL_BLOCK]==0 && difference.lSizes[_NORMAL_BLOCK]==0,
          "actual CRT heap has no remaining normal blocks");
#endif
    // Clean the negative-control harness's own leaked allocations after recording
    // its failure, so testing an older revision never leaves fixture resources.
    while (!Live.empty()) OwnedFree(Live.back());
    FailAllocation=0; FailMetadata=false;
}
namespace Dispatch
{
struct CFilesActionDiskTarget { BOOL Branch=TRUE, DirectoryDefault=TRUE; std::string DefaultPath="target"; };
using SalEnumSelection = void*;
enum { ptZIPArchive=1, IDS_PACKERR_ARCNAME_UNSUP=1 };
