static void Test()
{
    CPluginData zip, seven;
    CPluginDataInterfaceAbstract zipData{&zip}, sevenData{&seven};
    CFilesWindow panel;
    panel.owner=&zip; panel.PluginData.Interface=&zipData;
    Plugins.plugins[0]=&zip; Plugins.plugins[1]=&seven;
    auto invoke=[&](const char* archive,CPluginDataInterfaceAbstract* data,CFilesWindow* source)->BOOL
    {
        void* context=&panel;
        return PackUncompress(nullptr,source,archive,data,"target","root",context,context);
    };
    Check(invoke(panel.archive,&zipData,&panel) && zip.calls==1 && seven.calls==0,
          "configured handler change does not replace listing owner");
    PackerFormatConfig.unpacker=0;
    Check(invoke(panel.archive,&zipData,&panel) && zip.calls==2 && ExternalCalls==0,
          "external unpacker configuration does not consume a plugin-owned listing");
    PackerFormatConfig.unpacker=-2;
    Check(invoke("C:\\owned\\other.zip",&sevenData,&panel) && seven.calls==1,
          "different archive retains configured dispatch");
    Check(invoke(panel.archive,&sevenData,&panel) && seven.calls==2,
          "different interface retains configured dispatch");
    Check(invoke(panel.archive,nullptr,&panel) && seven.calls==3,
          "null metadata retains configured dispatch");
    panel.owner=nullptr;
    Check(!invoke(panel.archive,&zipData,&panel) && Errors==1 && seven.calls==3,
          "missing listing owner rejects operation without calling foreign handler");
    panel.owner=&zip; zip.SupportPanelView=FALSE;
    Check(!invoke(panel.archive,&zipData,&panel) && Errors==2 && seven.calls==3,
          "unsupported owner rejects operation without foreign fallback");
    zip.SupportPanelView=TRUE;
    PackerFormatConfig.format=0;
    Check(invoke(panel.archive,&zipData,&panel) && zip.calls==3,
          "stored listing owner handles unregistered extension");
    PackerFormatConfig.format=1; PackerFormatConfig.unpacker=0;
    Check(invoke("other.external",nullptr,nullptr) && ExternalCalls==1,
          "off-panel external dispatch remains available");
}
static void BranchTest()
{
 CPluginData zip,seven;seven.DLLName="7zip\\7zip.spl";
 CPluginDataInterfaceAbstract zipData{&zip},sevenData{&seven};CFilesWindow panel;
 panel.owner=&zip;panel.PluginData.Interface=&zipData;Plugins.plugins[0]=&zip;Plugins.plugins[1]=&seven;
 CFilesActionDiskTarget destination;PackerFormatConfig.format=1;PackerFormatConfig.unpacker=-2;
 auto invoke=[&](CPluginDataInterfaceAbstract* data,const char* archive,const char* target)->BOOL{
  void* context=&panel;return PackUncompress(nullptr,&panel,archive,data,target,"root",context,context,&destination);
 };
 Check(PackGetVerifiedBranchUnpacker(&panel,panel.archive,&zipData)==&zip,"actual ZIP listing owner qualifies independently of configured handler");
 Check(invoke(&zipData,panel.archive,"target")&&zip.calls==1&&seven.calls==0,"qualified Branch dispatch uses ZIP owner not foreign association");
 const int externalBefore=ExternalCalls;PackerFormatConfig.unpacker=0;
 Check(invoke(&zipData,panel.archive,"target")&&zip.calls==2&&ExternalCalls==externalBefore,"external association cannot replace qualified ZIP listing owner");
 const int zipBefore=zip.calls;
 Check(!invoke(nullptr,panel.archive,"target"),"Branch null metadata never falls back to configured handler");
 Check(!invoke(&sevenData,panel.archive,"target"),"Branch foreign metadata never reaches a different backend");
 Check(!invoke(&zipData,"different.zip","target"),"Branch different archive cannot reuse owner qualification");
 Check(!invoke(&zipData,panel.archive,"manual"),"Branch output cannot redirect to a manual root");
 Check(!invoke(&zipData,panel.archive,nullptr),"Branch null target path refused before string access");
 destination.DirectoryDefault=FALSE;Check(!invoke(&zipData,panel.archive,"target"),"Branch unpack cannot use Copy/Move mask snapshot");destination.DirectoryDefault=TRUE;
 zip.SupportPanelView=FALSE;Check(!invoke(&zipData,panel.archive,"target"),"unsupported ZIP owner refused");zip.SupportPanelView=TRUE;
 zip.DLLName=nullptr;Check(!invoke(&zipData,panel.archive,"target"),"owner without DLL qualification refused");
 zip.DLLName="other\\zip.spl";Check(!invoke(&zipData,panel.archive,"target"),"same DLL basename in different plugin location not qualified");
 zip.DLLName="7zip\\7zip.spl";Check(!invoke(&zipData,panel.archive,"target"),"7-Zip remains deferred despite valid metadata binding");
 zip.DLLName="zip\\zip.spl";panel.owner=nullptr;Check(!invoke(&zipData,panel.archive,"target"),"missing owner cannot use ZIP association");panel.owner=&zip;
 panel.archivePanel=false;Check(!invoke(&zipData,panel.archive,"target"),"non-archive panel cannot qualify ZIP private metadata");panel.archivePanel=true;
 Check(zip.calls==zipBefore&&seven.calls==0&&ExternalCalls==externalBefore,"all refused Branch variants perform zero plugin or external dispatch");
 Check(PackGetVerifiedBranchUnpacker(nullptr,panel.archive,&zipData)==nullptr,"missing source panel qualification refused");
 Check(PackGetVerifiedBranchUnpacker(&panel,nullptr,&zipData)==nullptr,"missing archive path qualification refused");
 zip.DLLName="ZIP\\ZIP.SPL";Check(PackGetVerifiedBranchUnpacker(&panel,panel.archive,&zipData)==&zip,"bundled ZIP location classification is Windows case insensitive");
}

}
int main()
{
    Live.reserve(1024);
    std::puts("ZIP lifetime production harness");
    Scenario("ASCII file",{{"safe-archive.txt"}},0);
    Scenario("Unicode file and directory",{{"žluťoučký-東京-\xF0\x9F\x99\x82.bin"},{"東京",true}},0);
    Scenario("rejected file",{{"file.bin"}},IDS_ERRADDFILE,0);
    Scenario("rejected directory",{{"directory",true}},IDS_ERRADDDIR,0);
    Scenario("Unix listing restart",{{"first.bin"},{"unix.bin",false,true}},0);
    Scenario("central header OOM",{{"file.bin"}},IDS_LOWMEM,-1,1);
    Scenario("name scratch OOM",{{"file.bin"}},IDS_LOWMEM,-1,2);
    Scenario("byte name OOM",{{"file.bin"}},IDS_LOWMEM,-1,3);
    Scenario("optional wide OOM",{{"file.bin"}},0,-1,4);
    Scenario("metadata OOM",{{"file.bin"}},IDS_LOWMEM,-1,0,true);
    Scenario("read failure after accepted entry",{{"first.bin"},{"second.bin"}},IDS_ERRADDFILE,-1,0,false,1);
    Scenario("long rejected path then valid entry",{{std::string(270,'a')+"\\file.bin"},{"next.bin"}},IDS_ERRADDFILE_TOOLONG,0);
    Scenario("invalid oversized leaf",{{std::string(512,'a')}},IDS_ERRADDFILE);
    Dispatch::Test();
    Dispatch::BranchTest();
    std::printf("ZIP listing lifetime: %d checks, %d failures\n",Checks,Failures);
    return Failures ? 1 : 0;
}
