    @@CONTAINS@@
};
struct CFilesWindow
{
    Binding PluginData;
    const char* archive="C:\\owned\\fixture.zip";
    bool archivePanel=true;
    CPluginData* owner=nullptr;
    BOOL Is(int) { return archivePanel; }
    const char* GetZIPArchive() { return archive; }
    CPluginData* GetPluginDataForPluginIface() { return owner; }
};
static int Errors=0, ExternalCalls=0;
static BOOL Error(HWND, WORD, ...) { ++Errors; return FALSE; }
static auto PackErrorHandlerPtr = Error;
static int StrICmp(const char* a, const char* b) { return _stricmp(a,b); }
struct CPluginData
{
    BOOL SupportPanelView=TRUE;
    const char* DLLName="zip\\zip.spl";
    int calls=0;
    BOOL UnpackArchive(CFilesWindow*, const char*, CPluginDataInterfaceAbstract* data,
                       const char* target, const char* root, SalEnumSelection next, void* param,
                       const CFilesActionDiskTarget* = nullptr)
    {
        ++calls;
        Check(data==nullptr || data->owner==this,"unpacker receives only its own listing metadata");
        Check(strcmp(target,"target")==0 && strcmp(root,"root")==0 && next==param,
              "dispatch preserves target, archive root and callback parameters");
        return TRUE;
    }
};
static struct FormatConfig
{
    int format=1, unpacker=-2;
    int PackIsArchive(const char*) { return format; }
    int GetUnpackerIndex(int) { return unpacker; }
} PackerFormatConfig;
static struct Registry
{
    CPluginData* plugins[2]={};
    CPluginData* Get(int index) { return index>=0 && index<2 ? plugins[index] : nullptr; }
} Plugins;
