@@RENAME@@
static void Reset(bool right=false) {
    Window.Left.Clear();Window.Right.Clear();Window.SourceRight=right;
    Window.Left.Root="C:\\left-root";Window.Right.Root="D:\\right-root";
    General=CSalamanderGeneralAbstract();Errors=0;
}
static std::string Utf8(const std::wstring& s){return PluginWideToMultiBytePath(s.c_str(),CP_UTF8);}
static bool IntakeIsValid(CRenamerDialog& dialog) {
#if @@NEW_API@@
    return dialog.SelectionValid!=FALSE;
#else
    return dialog.NotRenamedFiles.Count!=0;
#endif
}
static int Rename(CRenamer& renamer,CSourceFile* file,char* output,int capacity,char** part) {
#if @@NEW_API@@
    return renamer.Rename(file,0,output,capacity,part);
#else
    (void)capacity;return renamer.Rename(file,0,output,part);
#endif
}
static int Manual(CRenamerDialog& dialog,CSourceFile* file,char* output,int capacity,char*& part) {
#if @@NEW_API@@
    return dialog.GetManualModeNewName(file,0,output,capacity,part);
#else
    (void)capacity;return dialog.GetManualModeNewName(file,0,output,part);
#endif
}
static void ExpectPaths(CRenamerDialog& dialog,const std::vector<std::wstring>& expected,const char* label) {
    bool ok=IntakeIsValid(dialog)&&dialog.NotRenamedFiles.Count==(int)expected.size();
    for(size_t i=0;ok&&i<expected.size();++i) {
        CSourceFile* file=dialog.NotRenamedFiles[(int)i];
        ok=file&&file->FullName&&std::string(file->FullName)==Utf8(expected[i]);
    }
    Check(ok,label);
}
static void SelectionTests() {
    for(bool right:{false,true}) {
        Reset(right);auto panel=Window.GetPanel(PANEL_SOURCE);
        std::wstring root=right?L"D:\\right-root":L"C:\\left-root";
        std::vector<std::wstring> full={root+L"\\alpha\\same.png",root+L"\\\u017elu\u0165ou\u010dk\u00fd \u6771\u4eac\\same.png",root+L"\\\u6771\u4eac\\nested\\same.png"};
        for(const auto& p:full)panel->Add(L"same.png",p,true);
        CRenamerDialog dialog;dialog.LoadSelection();ExpectPaths(dialog,full,"all duplicate basenames retain exact parents and source-panel order");
        CRenamer renamer(dialog.Root,dialog.RootLen);
        for(int i=0;i<dialog.NotRenamedFiles.Count;++i) {
            std::vector<char> out(SAL_MAX_PATH*4);char* part=nullptr;
            int result=Rename(renamer,dialog.NotRenamedFiles[i],out.data(),(int)out.size(),&part);
            auto parent=full[i].substr(0,full[i].find_last_of(L'\\')+1);
            Check(result==11&&std::string(out.data())==Utf8(parent)+"renamed.png"&&part&&std::string(part)=="renamed.png","rsFileName keeps actual parent for each duplicate row");
        }
    }
    Reset();auto panel=Window.GetPanel(PANEL_SOURCE);auto focus=panel->Add(L"\u010d\u0159.png",L"C:\\left-root\\\u6771\u4eac\\\u010d\u0159.png",false,false,"??.png");panel->Focus=focus;
    CRenamerDialog focused;focused.LoadSelection();ExpectPaths(focused,{L"C:\\left-root\\\u6771\u4eac\\\u010d\u0159.png"},"focused unselected Unicode row preserves exact wide filename");
    Reset();panel=Window.GetPanel(PANEL_SOURCE);panel->Add(L"folder",L"C:\\left-root\\nested\\folder",true,true);panel->Add(L"same.png",L"C:\\left-root\\nested\\same.png",true);
    CRenamerDialog mixed;mixed.LoadSelection();ExpectPaths(mixed,{L"C:\\left-root\\nested\\folder",L"C:\\left-root\\nested\\same.png"},"mixed file and directory selection keeps paths and enumeration order");
    Check(mixed.NotRenamedFiles.Count==2&&mixed.NotRenamedFiles[0]->IsDir&&!mixed.NotRenamedFiles[1]->IsDir,"selection preserves file/directory metadata");
}
static void LongPathTests() {
    std::vector<std::wstring> paths={L"C:\\ascii\\same.png",L"C:\\ascii\\\u010d\u0159.png",L"\\\\server\\share\\\u6771\u4eac\\same.png",L"C:\\"+std::wstring(110,L'\u6f22')+L"\\same.png",L"C:\\"+std::wstring(120,L'a')+L"\\"+std::wstring(150,L'b')+L"\\same.png",L"C:\\"+std::wstring(120,L'\u6f22')+L"\\"+std::wstring(120,L'\u6f22')+L"\\"+std::wstring(60,L'\u6f22')+L"\\same.png"};
    std::wstring veryLong=L"C:\\root";for(int i=0;i<110;++i)veryLong+=L"\\"+std::wstring(100,L'\u6f22');veryLong+=L"\\same.png";paths.push_back(veryLong);
    for(const auto& full:paths){Reset();auto panel=Window.GetPanel(PANEL_SOURCE);panel->Add(full.substr(full.find_last_of(L'\\')+1),full,true);CRenamerDialog dialog;dialog.LoadSelection();ExpectPaths(dialog,{full},"intake preserves complete ASCII/Unicode/UNC/UTF8-long/UTF16-long path");
        if(dialog.NotRenamedFiles.Count!=1)continue;auto file=dialog.NotRenamedFiles[0];
        Check(file->NameLen==strlen(file->FullName)&&std::string(file->Name)==Utf8(full.substr(full.find_last_of(L'\\')+1)),"source constructor exposes exact full length and basename offset");
        CRenamer renamer(dialog.Root,dialog.RootLen);std::vector<char> out(SAL_MAX_PATH*4);char* part=nullptr;
        auto parent=full.substr(0,full.find_last_of(L'\\')+1);int result=Rename(renamer,file,out.data(),(int)out.size(),&part);
        Check(result==11&&std::string(out.data())==Utf8(parent)+"renamed.png","target parent survives Unicode and long paths beyond old 3*MAX_PATH buffer");
        result=Manual(dialog,file,out.data(),(int)out.size(),part);
        Check(result==10&&std::string(out.data())==Utf8(parent)+"manual.png","manual rename keeps exact parent including long UTF8 paths");
#if @@NEW_API@@
        std::vector<char> guard(34,'!');part=nullptr;result=Rename(renamer,file,guard.data()+1,32,&part);
        if(Utf8(parent).size()+12>32)Check(result<0&&guard.front()=='!'&&guard.back()=='!',"short target capacity fails without overwriting adjacent memory");
#endif
    }
}
static void FallbackAndFailureTests() {
    Reset();General.Available=false;auto panel=Window.GetPanel(PANEL_SOURCE);panel->Add(L"\u010d\u0159.png",L"ignored",true,false,"??.png");CRenamerDialog legacy;legacy.LoadSelection();ExpectPaths(legacy,{L"C:\\left-root\\\u010d\u0159.png"},"old host without optional service retains ordinary-panel wide-name fallback");
#if @@NEW_API@@
    for(int fail:{0,1,2,3}) {Reset();panel=Window.GetPanel(PANEL_SOURCE);panel->Add(L"first.png",L"C:\\actual\\first.png",true);panel->Add(L"second.png",fail==3?L"":L"C:\\actual\\second.png",true);if(fail==0)panel->FailPath=true;if(fail==1)General.NullInterface=true;if(fail==2)General.OldVersion=true;CRenamerDialog dialog;dialog.LoadSelection();Check(!dialog.SelectionValid&&dialog.NotRenamedFiles.Count==0,"available service failure rejects complete intake without fabricated root or partial selection");}
    Reset();panel=Window.GetPanel(PANEL_SOURCE);panel->Add(L"first.png",L"C:\\actual\\first.png",true);panel->Add(L"second.png",L"C:\\actual\\second.png",true);panel->Root="C:\\actual";General.DiskAvailable=false;General.AdditionalReportedFiles=1;CRenamerDialog missing;missing.LoadSelection();Check(!missing.SelectionValid&&missing.NotRenamedFiles.Count==0,"count mismatch rejects prematurely exhausted selection without partial batch");
    Reset();panel=Window.GetPanel(PANEL_SOURCE);panel->Add(L"first.png",L"C:\\actual\\first.png",true);panel->Add(L"second.png",L"C:\\actual\\second.png",true);panel->Root="C:\\actual";General.DiskAvailable=false;General.ThrowOnSelectionIndex=1;CRenamerDialog allocationFailure;allocationFailure.LoadSelection();Check(!allocationFailure.SelectionValid&&allocationFailure.NotRenamedFiles.Count==0&&GetLastError()==ERROR_NOT_ENOUGH_MEMORY,"iterator bad_alloc after first captured row rejects and clears the complete batch");
    Reset();CRenamerDialog empty;empty.LoadSelection();Check(empty.NotRenamedFiles.Count==0,"empty panel intake does not dereference a missing focused item");
#endif
}

static void ConstructorAndCapacityTests() {
#if @@NEW_API@@
    Reset();auto panel=Window.GetPanel(PANEL_SOURCE);const auto* data=panel->Add(L"same.png",L"C:\\root\\\u6771\u4eac\\same.png",true);
    const std::string full=Utf8(L"C:\\root\\\u6771\u4eac\\same.png");
    CSourceFile file(data,full.c_str(),FALSE);CSourceFile copy(&file);
    Check(copy.FullName!=file.FullName&&std::string(copy.FullName)==full&&std::string(copy.Name)=="same.png"&&std::string(copy.Ext)=="png","copy/undo snapshot owns exact full path and basename offsets");
    const std::string target=Utf8(L"C:\\root\\\u6771\u4eac\\changed.png");CSourceFile renamed(&copy,target.c_str());
    Check(std::string(renamed.FullName)==target&&std::string(renamed.Name)=="changed.png","renamed snapshot updates basename within same Unicode parent");
    char* copyOwned=copy.FullName;char* renamedOwned=renamed.FullName;FailNextSourceAllocation=true;copy.SwapName(renamed);
    Check(FailNextSourceAllocation&&copy.FullName==renamedOwned&&renamed.FullName==copyOwned&&std::string(copy.Name)=="changed.png"&&std::string(renamed.Name)=="same.png","undo identity swap transfers prepared ownership without another allocation");copy.SwapName(renamed);FailNextSourceAllocation=false;
    CSourceFile dot(data,"C:\\root\\.hidden",FALSE);CSourceFile dotCopy(&dot);Check(dot.Ext==dot.FullName+dot.NameLen&&dotCopy.Ext==dotCopy.FullName+dotCopy.NameLen,"panel and snapshot constructors retain dotfile extension semantics");
    FailNextSourceAllocation=true;Check(copy.SetName(target.c_str())==nullptr&&std::string(copy.FullName)==full,"failed undo name allocation preserves previous exact identity");
    FailNextSourceAllocation=true;CSourceFile* failed=NewSourceFile(data,full.c_str(),FALSE);Check(failed==nullptr&&GetLastError()==ERROR_NOT_ENOUGH_MEMORY,"factory rejects a source with failed owned path allocation");delete failed;
    CRenamerDialog dialog;dialog.LoadSelection();CRenamer renamer(dialog.Root,dialog.RootLen);char* part=nullptr;
    std::vector<char> exact(full.substr(0,full.find_last_of('\\')+1).size()+12);int result=Rename(renamer,&file,exact.data(),(int)exact.size(),&part);
    Check(result==11&&std::string(exact.data())==full.substr(0,full.find_last_of('\\')+1)+"renamed.png","target exactly fits caller capacity including terminator");
    std::vector<char> guard(exact.size()+1,'!');result=Rename(renamer,&file,guard.data()+1,(int)exact.size()-1,&part);Check(result<0&&guard.front()=='!'&&guard.back()=='!',"one-byte-short target fails without writes past capacity");
    Check(Rename(renamer,&file,nullptr,10,&part)<0&&Rename(renamer,&file,guard.data(),0,&part)<0,"invalid target arguments are rejected");
    renamer.Spec=rsRelativePath;std::vector<char> out(2048);result=Rename(renamer,&file,out.data(),(int)out.size(),&part);Check(result==11&&std::string(out.data())==std::string(dialog.Root)+"\\renamed.png","relative-path mode intentionally retains common panel root");
    renamer.Spec=rsFullPath;result=Rename(renamer,&file,out.data(),(int)out.size(),&part);Check(result==11&&std::string(out.data())=="renamed.png","full-path mode does not prepend an item parent");
    dialog.RenamerOptions.Spec=rsRelativePath;result=Manual(dialog,&file,out.data(),(int)out.size(),part);Check(result==10&&std::string(out.data())==std::string(dialog.Root)+"\\manual.png","manual relative mode retains common root");
    dialog.RenamerOptions.Spec=rsFullPath;result=Manual(dialog,&file,out.data(),(int)out.size(),part);Check(result==10&&std::string(out.data())=="manual.png","manual full-path mode does not prepend a parent");
#endif
}
static int Sign(int value){return (value>0)-(value<0);}
static void ComparisonTests(){
#if @@NEW_API@@
    const std::vector<std::wstring> names={L"",L"same",L"same2",L"\u010c",L"\u010d",L"\u03a3",L"\u03c3",L"\u03c2",L"\u0411",L"\u0431",L"\U0001f600",L"\U0001f600a",L"\U00010400",L"\U00010428",L"\ue000",L"\U00010000",L"\ud7ff"};
    bool same=true;for(const auto& a:names)for(const auto& b:names){int expected=CompareStringOrdinal(a.c_str(),(int)a.size(),b.c_str(),(int)b.size(),TRUE)-CSTR_EQUAL;if(Sign(RenamerPaths::Compare(Utf8(a).c_str(),Utf8(b).c_str()))!=Sign(expected))same=false;}
    Check(same,"comparison matches full CompareStringOrdinal for Latin/Greek/Cyrillic/emoji/Deseret/UTF16 boundaries and prefixes");
    const std::vector<std::string> malformed={std::string("\xff",1),std::string("\xc0\xaf",2),std::string("\xed\xa0\x80",3),"valid",""};
    bool deterministic=true;for(const auto&a:malformed)for(const auto&b:malformed){int first=Sign(RenamerPaths::Compare(a.c_str(),b.c_str()));if(first!=Sign(RenamerPaths::Compare(a.c_str(),b.c_str()))||first!=-Sign(RenamerPaths::Compare(b.c_str(),a.c_str())))deterministic=false;}
    Check(deterministic,"malformed-byte comparison is repeatable and antisymmetric");
#endif
}
int main(){MainThreadID=GetCurrentThreadId();TestWindow=CreateWindowExW(0,L"STATIC",L"",0,0,0,0,0,HWND_MESSAGE,nullptr,GetModuleHandleW(nullptr),nullptr);SelectionTests();LongPathTests();FallbackAndFailureTests();ConstructorAndCapacityTests();ComparisonTests();printf("Renamer panel paths: %d checks, %d failures; no filesystem mutation or UI.\n",Checks,Failures);return Failures?1:0;}
