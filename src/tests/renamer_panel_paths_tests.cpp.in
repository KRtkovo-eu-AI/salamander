template<class T> struct TIndirectArray {
    std::vector<T*> Items; int Count=0;
    ~TIndirectArray(){DestroyMembers();}
    int Add(T* p){Items.push_back(p);Count=(int)Items.size();return Count-1;}
    bool IsGood()const{return true;}void ResetState(){}
    void DestroyMembers(){for(auto p:Items)delete p;Items.clear();Count=0;}
    T*& operator[](int i){return Items.at(i);}
};
template<class T> struct TBuffer {
    std::vector<T> Data;
    BOOL Reserve(int capacity){Data.resize(capacity);return TRUE;}
    T* Get(){return Data.data();}
};
struct CRenamerDialog {
    TBuffer<char> RootBuffer;
    HWND GetParent(){return nullptr;}
    std::vector<char> RootStorage=std::vector<char>(SAL_MAX_PATH*4);
    char* Root=RootStorage.data(); int RootLen=0; BOOL SelectionValid=FALSE;
    HWND HWindow=nullptr; TIndirectArray<CSourceFile> NotRenamedFiles;
    struct ManualOptions { CRenameSpec Spec=rsFileName; } RenamerOptions;
    struct FakeEdit { HWND HWindow=nullptr; } Edit;
    FakeEdit* ManualEdit=&Edit;
    void LoadSelection();
    @@MANUAL_DECL@@
};
