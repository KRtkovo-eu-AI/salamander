struct FakePattern {
    int Execute(char* output,int capacity,CExecuteNewNameParam*) {
        const char* name="renamed.png";const int len=(int)strlen(name);
        if(capacity<=len)return -1;memcpy(output,name,len+1);return len;
    }
};
static void ChangeCase(CChangeCase,char*,const char*,const char*,const char*) {}
struct CRenamer {
    char* Root; int RootLen; CRenameSpec Spec=rsFileName;
    CChangeCase FileCase=ccDontChange,ExtCase=ccDontChange;
    BOOL IncludePath=FALSE,Substitute=FALSE,ExcludeExt=FALSE,UseRegExp=FALSE;
    FakePattern NewName;
    CRenamer(char* root,int rootLen):Root(root),RootLen(rootLen){}
    BOOL IsGood()const{return TRUE;}
    int RESubst(const char*,int,char*,int){return -1;}
    int BMSubst(const char*,int,char*,int){return -1;}
    @@RENAME_DECL@@
