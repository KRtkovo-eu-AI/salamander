  DWORD result=action==0?CompressFile(narrow.data(),attrs):action==1?UncompressFile(narrow.data(),attrs):action==2?MyEncryptFile(nullptr,narrow.data(),attrs,0,data,canceled,TRUE):MyDecryptFile(narrow.data(),attrs,TRUE);
  Check(result==ERROR_ACCESS_DENIED&&EfsCalls==calls&&(GetFileAttributesW(wide.c_str())&FILE_ATTRIBUTE_READONLY),"failed readonly preparation prevents NTFS transform and preserves original attributes");FailClear=0;SetFileAttributesW(wide.c_str(),FILE_ATTRIBUTE_ARCHIVE);
 }
 // Deterministic EFS API facades validate failure/control flow without altering policy.
 EfsBehavior=1;
 for(bool encrypt:{true,false})for(int fault=0;fault<4;++fault){SetFileAttributesW(wide.c_str(),FILE_ATTRIBUTE_ARCHIVE|FILE_ATTRIBUTE_READONLY);DWORD attrs=GetFileAttributesW(wide.c_str())|(encrypt?0:FILE_ATTRIBUTE_ENCRYPTED);BOOL canceled=FALSE;
  FailReadTime=fault==0;FailWriteTime=fault==1;FailOpenTime=fault==2;FailRestore=fault==3;TimeAttempted=false;int calls=EfsCalls,writes=WriteCalls;
  DWORD result=encrypt?MyEncryptFile(nullptr,narrow.data(),attrs,0,data,canceled,TRUE):MyDecryptFile(narrow.data(),attrs,TRUE);
  Check(result==DWORD(fault==2?ERROR_SHARING_VIOLATION:ERROR_ACCESS_DENIED),"EFS preserve-time/open/restore failure retains Windows error");
  if(fault==0)Check(EfsCalls==calls&&WriteCalls==writes,"failed EFS timestamp read never transforms or restores uninitialized times");
  FailReadTime=FailWriteTime=FailOpenTime=FailRestore=0;SetFileAttributesW(wide.c_str(),FILE_ATTRIBUTE_ARCHIVE);
 }
 BOOL canceled=FALSE;data.EncryptSystemAll=FALSE;data.SkipAllEncryptSystem=FALSE;Reply=IDCANCEL;int calls=EfsCalls;
 Check(MyEncryptFile(nullptr,narrow.data(),FILE_ATTRIBUTE_SYSTEM,FILE_ATTRIBUTE_SYSTEM,data,canceled,FALSE)==ERROR_SUCCESS&&canceled&&EfsCalls==calls,"SYSTEM encryption confirmation Cancel preserves source");
 Reply=IDB_SKIPALL;canceled=FALSE;Check(MyEncryptFile(nullptr,narrow.data(),FILE_ATTRIBUTE_SYSTEM,FILE_ATTRIBUTE_SYSTEM,data,canceled,FALSE)==ERROR_SUCCESS&&!canceled&&data.SkipAllEncryptSystem&&EfsCalls==calls,"SYSTEM encryption SkipAll retains policy and skips API");data.SkipAllEncryptSystem=FALSE;
 Reply=IDB_ALL;Check(MyEncryptFile(nullptr,narrow.data(),FILE_ATTRIBUTE_SYSTEM,FILE_ATTRIBUTE_SYSTEM,data,canceled,FALSE)==ERROR_SUCCESS&&data.EncryptSystemAll&&EfsCalls==calls+1,"SYSTEM encryption All requires explicit confirmation");data.EncryptSystemAll=FALSE;
 EfsBehavior=2;Check(MyEncryptFile(nullptr,narrow.data(),FILE_ATTRIBUTE_ARCHIVE,0,data,canceled,TRUE)==ERROR_ACCESS_DENIED,"EFS API failure is preserved despite timestamp cleanup");
