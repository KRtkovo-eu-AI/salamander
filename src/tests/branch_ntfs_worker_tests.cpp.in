    attrs=GetFileAttributesW(efsPath.c_str());enc=TRUE;Check(DoChangeAttrs(nullptr,mirror.data(),1,attrs&~FILE_ATTRIBUTE_ENCRYPTED,&script,done,nullptr,nullptr,nullptr,comp,enc,attrs,data,efsPath.c_str()),"actual EFS owned long Unicode source decrypt through worker");
