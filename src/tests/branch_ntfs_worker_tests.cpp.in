 Check(CompressFile(dn.data(),GetFileAttributesW(Api(directory).c_str()))==ERROR_SUCCESS&&(GetFileAttributesW(Api(directory).c_str())&FILE_ATTRIBUTE_COMPRESSED),"actual long directory compression");
