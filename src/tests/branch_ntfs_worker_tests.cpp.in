 if(statusOK&&status==FILE_ENCRYPTABLE){const FILETIME probeModified=Modified(probe);EfsBehavior=0;auto pn=Utf8(probe.wstring());DWORD result=MyEncryptFile(nullptr,pn.data(),GetFileAttributesW(Api(probe).c_str()),0,data,canceled,TRUE);
  if(result==ERROR_SUCCESS){Check((GetFileAttributesW(Api(probe).c_str())&FILE_ATTRIBUTE_ENCRYPTED)!=0,"actual EFS encryption changes owned probe only");Check(Equal(Modified(probe),probeModified),"actual encryption preserves modified time");Check(MyDecryptFile(pn.data(),GetFileAttributesW(Api(probe).c_str()),TRUE)==ERROR_SUCCESS&&(GetFileAttributesW(Api(probe).c_str())&FILE_ATTRIBUTE_ENCRYPTED)==0&&Payload(probe),"actual EFS decrypt restores readable owned data");Check(Equal(Modified(probe),probeModified),"actual decryption preserves modified time");Check(MyEncryptFile(nullptr,pn.data(),GetFileAttributesW(Api(probe).c_str()),0,data,canceled,FALSE)==ERROR_SUCCESS,"actual EFS non-preserve-date encrypt caller remains supported");Check(MyDecryptFile(pn.data(),GetFileAttributesW(Api(probe).c_str()),FALSE)==ERROR_SUCCESS&&Payload(probe),"actual EFS non-preserve-date decrypt caller remains supported");
   Reply=IDCANCEL;for(const auto& source:files){auto efsPath=Api(source);auto mirror=Utf8(sentinel.wstring());DWORD attrs=GetFileAttributesW(efsPath.c_str());BOOL comp=FALSE,enc=TRUE;
