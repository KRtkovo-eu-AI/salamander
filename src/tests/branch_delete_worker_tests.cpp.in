struct CQuadWord { ULONGLONG Value=0; CQuadWord(ULONGLONG v=0):Value(v){} CQuadWord& operator+=(const CQuadWord& b){Value+=b.Value;return *this;} };
struct COperations {BOOL CanUseRecycleBin=FALSE,InvertRecycleBin=FALSE;CQuadWord TotalSize=100;};
struct CProgressDlgData {
    BOOL DeleteHiddenAll=FALSE,CnfrmSHFileDel=TRUE,SkipAllSystemOrHidden=FALSE,SkipAllDeleteErr=FALSE;
    int UseRecycleBin=0;HANDLE WorkerNotSuspended=nullptr;BOOL* CancelWorker=nullptr;
    BOOL AgreeRecycleMasks(const char*,const char*){return TRUE;}
};
enum { IDB_ALL=400,IDB_SKIPALL,IDB_SKIP,IDS_CONFIRMSHFILEDELETE,IDS_DELETESHFILE,IDS_ERRORDELETINGFILE,WM_USER_DIALOG=WM_APP+3 };
static int Reply=IDCANCEL,DialogCalls=0,ProgressCalls=0,RecycleCalls=0;
static char* LoadStr(int){static char value[]="test";return value;}
static char* GetErrorText(DWORD){return LoadStr(0);}
static LRESULT WorkerDialog(HWND,UINT,WPARAM,LPARAM data){++DialogCalls;*(int*)((char**)data)[0]=Reply;return 0;}
static void SetProgress(HWND,int,int,CProgressDlgData&){++ProgressCalls;}
static int CaclProg(const CQuadWord&,const CQuadWord&){return 0;}
struct CShellExecuteWnd { HWND Create(HWND h,const char*){return h;} };
static DWORD RecycleOperationFileW(HWND,const std::wstring&){++RecycleCalls;return ERROR_NOT_SUPPORTED;}
#define TRACE_E(x) ((void)0)
BOOL FileNameIsInvalid(const char*,BOOL,BOOL=FALSE);
@@INVALID@@
#pragma push_macro("SendMessage")
