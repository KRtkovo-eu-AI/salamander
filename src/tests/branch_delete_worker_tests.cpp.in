#define SendMessage WorkerDialog
@@DELETE@@
#pragma pop_macro("SendMessage")
static int Checks=0,Failures=0;
static void Check(bool yes,const char* label){++Checks;if(!yes){++Failures;std::printf("FAIL: %s\n",label);}}
static std::wstring Api(const std::filesystem::path& p){return LR"(\\?\)"+p.wstring();}
static std::string Utf8(const std::wstring& p){int n=WideCharToMultiByte(CP_UTF8,0,p.c_str(),-1,nullptr,0,nullptr,nullptr);std::string s(n,'\0');WideCharToMultiByte(CP_UTF8,0,p.c_str(),-1,&s[0],n,nullptr,nullptr);s.resize(n-1);return s;}
static bool Write(const std::filesystem::path& p){auto a=Api(p);HANDLE f=CreateFileW(a.c_str(),GENERIC_WRITE,0,nullptr,CREATE_NEW,FILE_ATTRIBUTE_NORMAL,nullptr);if(f==INVALID_HANDLE_VALUE)return false;DWORD count=0;BOOL ok=WriteFile(f,"owned payload",13,&count,nullptr);CloseHandle(f);return ok&&count==13;}
static bool Payload(const std::filesystem::path& p){HANDLE f=CreateFileW(Api(p).c_str(),GENERIC_READ,FILE_SHARE_READ,nullptr,OPEN_EXISTING,0,nullptr);if(f==INVALID_HANDLE_VALUE)return false;char b[14]={};DWORD n=0;BOOL ok=ReadFile(f,b,13,&n,nullptr);CloseHandle(f);return ok&&n==13&&std::string(b)=="owned payload";}
int wmain(int argc,wchar_t** argv){
    if(argc!=2)return 2;const auto parent=std::filesystem::absolute(argv[1]).lexically_normal();
    const auto root=parent/L"owned-delete";if(root.parent_path()!=parent||std::filesystem::exists(root))return 2;
    std::filesystem::create_directories(root/L"ascii");std::filesystem::create_directories(root/L"東京-ž");
    auto deep=root;for(int i=0;i<4;++i)deep/=std::wstring(65,L'東');std::filesystem::create_directories(std::filesystem::path(Api(deep)));
    std::vector<std::filesystem::path> files={root/L"ascii"/L"plain.txt",root/L"ascii"/L"ž-東京-😀.txt",root/L"東京-ž"/L"same.txt",deep/L"same.txt",root/(std::wstring(100,L'東')+L".txt")};
    const auto sentinel=root/L"untouched.txt";Check(Write(sentinel),"create untouched sibling");
    BOOL cancel=FALSE;COperations script;CProgressDlgData data;data.CancelWorker=&cancel;data.WorkerNotSuspended=CreateEventW(nullptr,TRUE,TRUE,nullptr);CQuadWord done;
    for(const auto& file:files){Check(Write(file),"create owned exact source");auto name=Utf8(file.wstring());auto exact=Api(file);
        Check(DoDeleteFile(nullptr,name.data(),CQuadWord(1),&script,done,FILE_ATTRIBUTE_NORMAL,data,exact.c_str())!=FALSE,"actual direct worker succeeds");
        Check(GetFileAttributesW(exact.c_str())==INVALID_FILE_ATTRIBUTES,"exact intended source removed");Check(Payload(sentinel),"unselected sibling intact");}
    Check(done.Value==files.size()&&ProgressCalls==(int)files.size()&&DialogCalls==0&&RecycleCalls==0,"permanent worker accounting with no recycle or UI");
    const auto readonly=root/L"readonly.txt";Check(Write(readonly)&&SetFileAttributesW(Api(readonly).c_str(),FILE_ATTRIBUTE_READONLY),"create readonly source");auto ro=Utf8(readonly.wstring());auto roW=Api(readonly);Check(DoDeleteFile(nullptr,ro.data(),1,&script,done,FILE_ATTRIBUTE_READONLY,data,roW.c_str())&&GetFileAttributesW(roW.c_str())==INVALID_FILE_ATTRIBUTES,"worker clears readonly and deletes exact file");
    const auto hidden=root/L"hidden.txt";Check(Write(hidden),"create hidden confirmation source");auto h=Utf8(hidden.wstring());auto hw=Api(hidden);Reply=IDCANCEL;
    Check(!DoDeleteFile(nullptr,h.data(),1,&script,done,FILE_ATTRIBUTE_HIDDEN,data,hw.c_str())&&Payload(hidden),"hidden confirmation Cancel preserves source");
    Reply=IDB_SKIP;Check(DoDeleteFile(nullptr,h.data(),1,&script,done,FILE_ATTRIBUTE_HIDDEN,data,hw.c_str())&&Payload(hidden),"hidden confirmation Skip preserves source");
    auto invalid=Utf8(sentinel.wstring())+".";Reply=IDCANCEL;Check(!DoDeleteFile(nullptr,invalid.data(),1,&script,done,FILE_ATTRIBUTE_NORMAL,data,nullptr)&&Payload(sentinel),"invalid alias cannot delete trimmed sibling");
    auto missing=Utf8((root/L"missing.txt").wstring());Reply=IDCANCEL;Check(!DoDeleteFile(nullptr,missing.data(),1,&script,done,FILE_ATTRIBUTE_NORMAL,data,nullptr)&&Payload(sentinel),"missing-source error Cancel preserves sibling");
    data.UseRecycleBin=99;Reply=IDCANCEL;auto safe=Utf8(sentinel.wstring());auto safeW=Api(sentinel);const int recycleBefore=RecycleCalls;
    Check(!DoDeleteFile(nullptr,safe.data(),1,&script,done,FILE_ATTRIBUTE_NORMAL,data,safeW.c_str())&&RecycleCalls==recycleBefore+1&&Payload(sentinel),"unknown configuration cannot silently delete permanently");
    CloseHandle(data.WorkerNotSuspended);Check(root.parent_path()==parent&&root.filename()==L"owned-delete","cleanup confined to owned root");std::filesystem::remove_all(std::filesystem::path(Api(root)));
    std::printf("Actual delete worker: %d checks, %d failures\n",Checks,Failures);return Failures?1:0;
}
