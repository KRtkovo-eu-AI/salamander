namespace UacF7 { struct ArchiveRevision { DWORD attributes = 0; }; }
enum CCopyMoveItemState { cmisUnscanned, cmisReady, cmisBlocked, cmisConflict, cmisOverwrite, cmisSkip, cmisRunning, cmisDone, cmisSuppressed };
enum CCopyMoveConflictDecision { cmcdNone, cmcdOverwrite, cmcdSkip };
enum CCopyMoveConflictType { cmctNone, cmctDirectoryExists, cmctTypeMismatch, cmctFileExists };
enum ItemPhase { ccipUnscanned, ccipReady, ccipLeased, ccipCompleted, ccipProbed, ccipAwaitingDecision };
enum Opcode { ocCopyFile, ocCreateDir, ocMoveFile };
enum CConflictLeaseOutcome { ccloInvalid, ccloReblocked, ccloCommitted, ccloReleased };
constexpr DWORD OPFL_UAC_TRANSFER_ELIGIBLE = 1;
constexpr int ccwpExecuting = 1;
constexpr int CMCM_SCAN_AHEAD = 1;
struct CConflictDependencyNode { int Parent = -1, SubtreeEnd = 0, FinalizeStart = 0, Finalizer = -1; };
struct COperation {
    int Opcode = ocCopyFile, ConflictParent = -1;
    DWORD OpFlags = 0;
    CCopyMoveItemState ConflictState = cmisUnscanned;
    CCopyMoveConflictDecision ConflictDecision = cmcdNone, ConflictLeaseDecision = cmcdNone;
    CCopyMoveConflictType ConflictType = cmctNone;
    ItemPhase ConflictItemState = ccipUnscanned;
    BOOL ConflictDirectoryPrepared = FALSE, ConflictIsFinalizer = FALSE;
    BOOL ScannedTargetIdentityValid = FALSE, ScannedTargetExisted = FALSE;
    DWORD ScannedTargetAttributes = 0, ScannedTargetVolumeSerial = 0;
    ULONGLONG ScannedTargetSize = 0, ScannedTargetFileIndex = 0;
    FILETIME ScannedTargetWriteTime{};
    UacF7::ArchiveRevision ScannedTargetRevision{};
    ULONGLONG ConflictGeneration = 1, ConflictLeaseGeneration = 0, ConflictLeaseToken = 0;
    ULONGLONG ConflictLeaseDependencyEpoch = 0;
};
class COperations {
public:
    CRITICAL_SECTION ConflictCS{};
    int Count = 3, ConflictWorkerState = 0, ConflictListVersion = 0, DeferredConflictCount = 0, Signals = 0;
    ULONGLONG NextConflictLeaseGeneration = 0, NextConflictLeaseToken = 0, ConflictCoordinatorGeneration = 10;
    int CopyMoveConflictMode = CMCM_SCAN_AHEAD;
    std::vector<CConflictDependencyNode> ConflictDependencies;
    COperation Items[3]{};
    COperations() : ConflictDependencies(3) { InitializeCriticalSection(&ConflictCS); }
    ~COperations() { DeleteCriticalSection(&ConflictCS); }
    COperation& At(int i) { return Items[i]; }
    const COperation& At(int i) const { return Items[i]; }
    void SignalConflictChanged() { ++Signals; }
    BOOL IsParallelCopyDisabled() const { return FALSE; }
    void GetSpeedLimit(BOOL* enabled, DWORD* value) const { *enabled = FALSE; *value = 0; }
    void AddParallelCopyBytes(DWORD, DWORD) {}
    BOOL IsPreparedParentDirectoryLocked(int) const;
    BOOL AreConflictAncestorsPreparedLocked(int) const;
    BOOL IsConflictItemReadyLocked(int) const;
    void RetractConflictSubtreeLocked(int);
    BOOL GetNextConflictReadyItem(int&, ULONGLONG&);
    BOOL LeaseNextParallelCopy(int&, ULONGLONG&, int);
    CConflictLeaseOutcome FinishParallelCopyLeaseLocked(int, ULONGLONG, CConflictLeaseOutcome);
    CConflictLeaseOutcome ReleaseParallelCopyLease(int, ULONGLONG);
    CConflictLeaseOutcome ReblockParallelCopyLease(int, ULONGLONG);
    BOOL RevalidatePreparedConflictAncestors(int);
    void RequeueChangedConflictItem(int);
    BOOL ValidateParallelCopyLeaseForSideEffect(int, ULONGLONG);
};

static bool InjectAncestors = false;
static int PathCalls = 0, ThrowPathCall = 0;
static std::wstring FixturePath;
static std::wstring GetParallelCopyPathW(COperation*, BOOL)
{
    if (++PathCalls == ThrowPathCall) throw std::bad_alloc();
    return FixturePath;
}
static std::wstring SalPathAddExtendedPrefixW(const wchar_t* path) { return path; }
static void CaptureScannedOverwriteRevision(const std::wstring&, const BY_HANDLE_FILE_INFORMATION&, UacF7::ArchiveRevision&) {}

