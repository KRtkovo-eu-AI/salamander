static int Errors=0;
template<class T>struct String {
 static char* LoadStr(int){static char s[]="resource";return s;}
 static BOOL SysError(int,int){++Errors;return FALSE;}
 static BOOL Error(int,int){++Errors;return FALSE;}
};
static std::vector<std::wstring> Opened,Created;
static bool SkipExisting=false,FailCreate=false,WantCancel=false,FailRawOpen=false,FailRawWrite=false;
static int LiveHandles=0,RawOpens=0,RawCloses=0,ModalCalls=0;
static std::wstring RawPath,RestoreTarget;
struct SAFE_FILE {HANDLE HFile;};
struct SafeFiles {
 BOOL SafeFileOpen(SAFE_FILE* f,const char* path,DWORD access,DWORD share,DWORD create,DWORD flags,HWND,int,DWORD* button,DWORD*){
  auto w=UndeletePaths::IoPath(UndeletePaths::Wide(path));Opened.push_back(w);
  f->HFile=CreateFileW(w.c_str(),access,share,nullptr,create,flags,nullptr);
  if(f->HFile!=INVALID_HANDLE_VALUE){++LiveHandles;return TRUE;}if(button)*button=IDCANCEL;return FALSE;
 }
 void SafeFileClose(SAFE_FILE* f){if(f->HFile!=INVALID_HANDLE_VALUE){CloseHandle(f->HFile);--LiveHandles;f->HFile=INVALID_HANDLE_VALUE;}}
 HANDLE SafeFileCreate(const char* path,DWORD access,DWORD share,DWORD attrs,BOOL dir,HWND,const char*,const char*,DWORD*,BOOL,BOOL* skipped,void*,int,void*,SAFE_FILE* f){
  auto w=UndeletePaths::IoPath(UndeletePaths::Wide(path));Created.push_back(w);*skipped=FALSE;
  if(FailCreate)return INVALID_HANDLE_VALUE;
  if(dir){std::error_code ec;std::filesystem::create_directories(w,ec);return !ec?reinterpret_cast<HANDLE>(1):INVALID_HANDLE_VALUE;}
  if(SkipExisting&&GetFileAttributesW(w.c_str())!=INVALID_FILE_ATTRIBUTES){*skipped=TRUE;return INVALID_HANDLE_VALUE;}
  f->HFile=CreateFileW(w.c_str(),access,share,nullptr,CREATE_ALWAYS,attrs,nullptr);
  if(f->HFile!=INVALID_HANDLE_VALUE)++LiveHandles;return f->HFile;
 }
 BOOL SafeFileRead(SAFE_FILE* f,void* data,DWORD n,DWORD* got,HWND,int,void*,void*){return ReadFile(f->HFile,data,n,got,nullptr);}
 BOOL SafeFileWrite(SAFE_FILE* f,const void* data,DWORD n,DWORD* wrote,HWND,int,void*,void*){return WriteFile(f->HFile,data,n,wrote,nullptr);}
};
static SafeFiles SafeFileService;static SafeFiles* SalamanderSafeFile=&SafeFileService;
static char* GetSCFData(FILETIME*,CQuadWord&){static char text[]="metadata";return text;}
