 HWND HWindow=reinterpret_cast<HWND>(1);
 CRestoreProgressDlg(HWND,int){}
 HWND Create(){return HWindow;}
 void SetFileProgress(DWORD){}void SetTotalProgress(DWORD){}
 void SetSourceFileName(const char*){}void SetDestFileName(const char*){}
 BOOL GetWantCancel(){return WantCancel;}
};
static BOOL FakeGetVolumeInformationW(LPCWSTR,LPWSTR,DWORD,LPDWORD,LPDWORD,LPDWORD flags,LPWSTR,DWORD){*flags=FILE_SUPPORTS_ENCRYPTION;return TRUE;}
struct RawContext{HANDLE File;};
static DWORD FakeOpenEncryptedFileRawW(LPCWSTR path,ULONG,PVOID* context){
 ++RawOpens;RawPath=path;if(FailRawOpen)return ERROR_ACCESS_DENIED;
 HANDLE file=CreateFileW(path,GENERIC_WRITE,FILE_SHARE_READ,nullptr,OPEN_EXISTING,0,nullptr);
 if(file==INVALID_HANDLE_VALUE)return GetLastError();*context=new RawContext{file};return ERROR_SUCCESS;
}
static DWORD FakeWriteEncryptedFileRaw(PFE_IMPORT_FUNC callback,PVOID cookie,PVOID context){
 if(FailRawWrite)return ERROR_CANCELLED;char buffer[37];
 for(;;){ULONG n=sizeof(buffer);DWORD error=callback(reinterpret_cast<PBYTE>(buffer),cookie,&n);if(error)return error;if(!n)return ERROR_SUCCESS;
  DWORD wrote=0;if(!WriteFile(static_cast<RawContext*>(context)->File,buffer,n,&wrote,nullptr)||wrote!=n)return ERROR_WRITE_FAULT;
 }
}
static void FakeCloseEncryptedFileRaw(PVOID context){++RawCloses;auto p=static_cast<RawContext*>(context);CloseHandle(p->File);delete p;}
#define GetVolumeInformationW FakeGetVolumeInformationW
#define OpenEncryptedFileRawW FakeOpenEncryptedFileRawW
#define WriteEncryptedFileRaw FakeWriteEncryptedFileRaw
#define CloseEncryptedFileRaw FakeCloseEncryptedFileRaw
@@RESTORE@@
#undef GetVolumeInformationW
#undef OpenEncryptedFileRawW
#undef WriteEncryptedFileRaw
#undef CloseEncryptedFileRaw
static bool ClearPanelOnModal=false,CancelModal=false;
struct CRestoreDialog {
 std::string TargetPath;
 CRestoreDialog(HWND):TargetPath(UndeletePaths::Utf8(RestoreTarget.c_str())){}
 int Execute(){++ModalCalls;if(ClearPanelOnModal)Window.Left.Clear();return CancelModal?IDCANCEL:IDOK;}
};
@@ENTRY@@
static int Checks=0,Failures=0;
static void Check(bool ok,const char* what){++Checks;if(!ok){++Failures;std::fprintf(stderr,"FAIL: %s (error %lu)\n",what,GetLastError());}}
static void MakeDir(const std::wstring& p){std::error_code ec;std::filesystem::create_directories(UndeletePaths::IoPath(p),ec);Check(!ec,"create fixture directory");}
static void Write(const std::wstring& p,const std::string& bytes){
 MakeDir(p.substr(0,p.find_last_of(L'\\')));HANDLE h=CreateFileW(UndeletePaths::IoPath(p).c_str(),GENERIC_WRITE,0,nullptr,CREATE_ALWAYS,FILE_ATTRIBUTE_NORMAL,nullptr);Check(h!=INVALID_HANDLE_VALUE,"create fixture file");
 if(h!=INVALID_HANDLE_VALUE){DWORD n=0;Check(WriteFile(h,bytes.data(),static_cast<DWORD>(bytes.size()),&n,nullptr)&&n==bytes.size(),"write fixture bytes");CloseHandle(h);}
}
static std::string Read(const std::wstring& p){HANDLE h=CreateFileW(UndeletePaths::IoPath(p).c_str(),GENERIC_READ,FILE_SHARE_READ,nullptr,OPEN_EXISTING,0,nullptr);if(h==INVALID_HANDLE_VALUE)return {};std::string out;char buffer[80];DWORD n;while(ReadFile(h,buffer,sizeof(buffer),&n,nullptr)&&n)out.append(buffer,n);CloseHandle(h);return out;}
static void Reset(){Window.Left.Clear();Opened.clear();Created.clear();Errors=0;SkipExisting=FailCreate=WantCancel=FailRawOpen=FailRawWrite=ClearPanelOnModal=CancelModal=false;RawOpens=RawCloses=ModalCalls=0;RawPath.clear();}
static void Select(const std::wstring& full,bool selected=true,bool dir=false){auto n=full.substr(full.find_last_of(L'\\')+1);auto f=Window.Left.Add(n,full,n,selected,dir);f->Size.Value=Read(full).size();}
int main(){
 MainThreadID=GetCurrentThreadId();std::vector<wchar_t> temp(SAL_MAX_PATH);GetTempPathW(static_cast<DWORD>(temp.size()),temp.data());
 const std::wstring root=std::wstring(temp.data())+L"undelete-boundary-"+std::to_wstring(GetCurrentProcessId())+L"-"+std::to_wstring(GetTickCount64());MakeDir(root);
 struct Cleanup{std::wstring Root;~Cleanup(){std::error_code ec;std::filesystem::remove_all(UndeletePaths::IoPath(Root),ec);}}cleanup{root};
 const std::wstring a=root+L"\\ascii\\same.txt",b=root+L"\\žluťoučký東京\\same.txt";Write(a,"first bytes");Write(b,"second bytes");
 RestoreTarget=root+L"\\output";MakeDir(RestoreTarget);Reset();Select(a);Select(b);SkipExisting=true;ClearPanelOnModal=true;
 Check(ExecuteRestoreEncrypted(nullptr),"actual entry restores captured selection after modal clears panel");
 Check(Opened.size()==2&&Opened[0]==UndeletePaths::IoPath(a)&&Opened[1]==UndeletePaths::IoPath(b),"duplicate basenames resolve to distinct actual sources");
 Check(Created.size()==2&&Created[0]==Created[1],"destination remains flat with ordinary collision handling");
 Check(Read(RestoreTarget+L"\\same.txt")=="first bytes","skip collision retains first destination");Check(LiveHandles==0,"copy/skip close all source handles");
 std::wstring longDir=root;for(int i=0;i<7;++i)longDir+=L"\\東京žluťoučkýabcdefghijklmnopqrstuvwxyz0123456789";
 const std::wstring longFile=longDir+L"\\日本語😀.txt";Write(longFile,"long unicode bytes");Check(longFile.size()>260,"fixture exceeds UTF16 MAX_PATH");
 RestoreTarget=root+L"\\長い出力";MakeDir(RestoreTarget);Reset();Select(longFile,false);Check(ExecuteRestoreEncrypted(nullptr),"focused-only full long Unicode restore");Check(Read(RestoreTarget+L"\\日本語😀.txt")=="long unicode bytes","Unicode filename content preserved");Check(LiveHandles==0,"long copy closes handles");
 RestoreTarget=longDir+L"\\output";MakeDir(RestoreTarget);Reset();Select(a);Check(ExecuteRestoreEncrypted(nullptr),"full UTF16-long Unicode target restored");Check(Read(RestoreTarget+L"\\same.txt")=="first bytes","long target bytes preserved");
 RestoreTarget=root+L"\\長い出力";
 const std::wstring byteLong=root+L"\\"+std::wstring(90,L'東')+L"\\short.txt";Write(byteLong,"utf8 lengthy");Check(byteLong.size()<260&&UndeletePaths::Utf8(byteLong.c_str()).size()>260,"fixture exceeds UTF8 capacity only");Reset();Select(byteLong);Check(ExecuteRestoreEncrypted(nullptr),"UTF8 byte-long path restored");Check(Read(RestoreTarget+L"\\short.txt")=="utf8 lengthy","UTF8 byte-long source correct");
 const std::wstring directory=root+L"\\tree東京";Write(directory+L"\\nested\\one.txt","one");Write(directory+L"\\two.txt","two");Reset();Select(directory,true,true);Check(ExecuteRestoreEncrypted(nullptr),"recursive restore wide local find data");Check(Read(RestoreTarget+L"\\tree東京\\nested\\one.txt")=="one"&&Read(RestoreTarget+L"\\tree東京\\two.txt")=="two","recursive siblings both retained");
 Reset();Select(directory,true,true);RestoreTarget=directory;Check(!ExecuteRestoreEncrypted(nullptr)&&Created.empty(),"reject restore directory into own descendant before mutation");
 RestoreTarget=root+L"\\efs-output";MakeDir(RestoreTarget);DWORD signature[]={7,0x004f0052,0x00530042};std::string backup(reinterpret_cast<char*>(signature),sizeof(signature));backup+="opaque backed-up bytes";
 const std::wstring bak=longDir+L"\\秘密.bak";Write(bak,backup);Reset();Select(bak);Check(ExecuteRestoreEncrypted(nullptr),"actual EFS flow through stub with exact long Unicode source");Check(RawOpens==1&&RawCloses==1&&RawPath==UndeletePaths::IoPath(RestoreTarget+L"\\秘密"),"wide EFS destination exact and raw context closed");Check(Read(RestoreTarget+L"\\秘密")==backup,"EFS import callback reads actual source bytes");Check(LiveHandles==0,"EFS success closes source handle");
 Reset();Select(bak);FailRawOpen=true;Check(!ExecuteRestoreEncrypted(nullptr),"EFS open failure reported");Check(RawOpens==1&&RawCloses==0&&LiveHandles==0,"failed EFS open never closes uninitialized context");
 Reset();Select(bak);WantCancel=true;Check(!ExecuteRestoreEncrypted(nullptr),"cancel EFS callback");Check(RawCloses==1&&LiveHandles==0&&GetFileAttributesW((RestoreTarget+L"\\秘密").c_str())==INVALID_FILE_ATTRIBUTES,"cancel closes raw/source and deletes incomplete output");
 const std::wstring shortBak=root+L"\\short.bak";Write(shortBak,"bad");Reset();Select(shortBak);Check(ExecuteRestoreEncrypted(nullptr)&&RawOpens==0,"short .bak is copied, never misidentified as EFS backup");Check(Read(RestoreTarget+L"\\short.bak")=="bad","non-backup extension unchanged");
 Reset();Select(a);FailCreate=true;Check(!ExecuteRestoreEncrypted(nullptr)&&LiveHandles==0,"failed destination create closes source");
 Reset();Select(a);CancelModal=true;Check(!ExecuteRestoreEncrypted(nullptr)&&Opened.empty(),"destination dialog cancellation has no I/O");
 Reset();Select(a);Window.Left.Missing=true;Check(!ExecuteRestoreEncrypted(nullptr)&&ModalCalls==0&&Opened.empty(),"failed resolver stops before modal and filesystem operations");
 Reset();Select(a,false);Select(b,false);Window.Left.Focus=1;Check(UndeletePaths::FocusedImagePath(&General,PANEL_SOURCE)==b,"image default uses actual focus path among duplicate basenames");Window.Left.Missing=true;Check(UndeletePaths::FocusedImagePath(&General,PANEL_SOURCE).empty(),"image default fails closed on unavailable metadata");
 char legacy[MAX_PATH];Check(UndeletePaths::LegacyImagePath(L"C:\\ascii\\disk.img",legacy,sizeof(legacy))&&strcmp(legacy,"C:\\ascii\\disk.img")==0,"legacy image ASCII roundtrip");
 Check(!UndeletePaths::LegacyImagePath(longFile,legacy,sizeof(legacy))&&legacy[0]==0,"legacy image refuses oversized path without truncation");
 if(GetACP()==1250||GetACP()==1252)Check(!UndeletePaths::LegacyImagePath(b,legacy,sizeof(legacy))&&GetLastError()==ERROR_NO_UNICODE_TRANSLATION&&legacy[0]==0,"legacy image refuses lossy ACP path");
 Check(!UndeletePaths::LegacyImagePath(L"abc",legacy,3)&&GetLastError()==ERROR_FILENAME_EXCED_RANGE&&legacy[0]==0,"legacy image exact buffer includes terminator");
 Check(!UndeletePaths::LegacyImagePath(L"",legacy,sizeof(legacy))&&legacy[0]==0,"legacy image empty path rejected");
 Check(UndeletePaths::IoPath(L"\\\\server\\share\\"+std::wstring(280,L'x')).compare(0,8,L"\\\\?\\UNC\\")==0,"long UNC extended prefix");
 Check(LiveHandles==0,"all test SafeFile handles released");std::printf("Undelete actual paths: %d checks, %d failures; real EFS calls: 0\n",Checks,Failures);return Failures?1:0;
}
