struct CFileData {
 const char* Name=nullptr; const char* Ext=nullptr; const wchar_t* NameW=nullptr;
 BOOL Selected=FALSE,SizeValid=TRUE,Hidden=FALSE,IsLink=FALSE,IsOffline=FALSE;
 DWORD Attr=0; CQuadWord Size; FILETIME LastWrite={};
 BOOL UseWideName()const{return NameW!=nullptr;}
};
@@SDK@@
struct Row {
 std::string Name,Ext;std::wstring Wide,Full,Directory,Relative; CFileData File;
 Row(std::wstring name,std::wstring full,std::wstring relative,bool selected):Name("legacy.txt"),Ext("txt"),Wide(std::move(name)),Full(std::move(full)),Relative(std::move(relative)) {
  Directory=Full.substr(0,Full.find_last_of(L'\\'));File.Name=Name.c_str();File.NameW=Wide.c_str();File.Ext=Ext.c_str();File.Selected=selected;File.Size.Value=9876543210ULL;File.Attr=FILE_ATTRIBUTE_ARCHIVE;File.LastWrite.dwLowDateTime=123;File.Hidden=TRUE;File.IsLink=TRUE;File.IsOffline=TRUE;
 }
};
struct CFilesArray {
 std::vector<CFileData> Data;std::vector<std::unique_ptr<Row>> Rows;int Count=0;
 CFilesArray(){Data.reserve(64);}
 CFileData* GetData(){return Data.data();} CFileData& At(int i){return Data.at(i);}
 void Clear(){Data.clear();Rows.clear();Count=0;}
};
struct CFilesWindow {
 CFilesArray Directories,FileRows;CFilesArray* Dirs=&Directories;CFilesArray* Files=&FileRows;
 std::wstring Root=L"C:\\root";std::string RootText="C:\\root";bool Disk=true,Missing=false,ThrowPath=false;int Focus=0;
 BOOL Is(int type){return Disk&&type==ptDisk;}int GetCaretIndex(){return Focus;}
 const wchar_t* GetPathW(){return Root.c_str();}const char* GetPath(){return RootText.c_str();}
 Row* Find(const CFileData& f)const{for(auto a:{Dirs,Files})for(int i=0;i<a->Count;++i)if(&a->Data[i]==&f)return a->Rows[i].get();return nullptr;}
 std::wstring GetItemFullPathW(const CFileData& f){if(ThrowPath)throw std::bad_alloc();return Missing?L"":Find(f)->Full;}
 std::wstring GetItemDirectoryW(const CFileData& f){return Missing?L"":Find(f)->Directory;}
 std::wstring GetItemRelativePathW(const CFileData& f){return Missing?L"":Find(f)->Relative;}
 CFileData* Add(std::wstring name,std::wstring full,std::wstring relative,bool selected=false,bool dir=false){auto a=dir?Dirs:Files;a->Rows.emplace_back(new Row(std::move(name),std::move(full),std::move(relative),selected));a->Data.push_back(a->Rows.back()->File);++a->Count;return &a->Data.back();}
 void Clear(){Dirs->Clear();Files->Clear();Root=L"C:\\root";RootText="C:\\root";Disk=true;Missing=false;ThrowPath=false;Focus=0;}
};
struct MainWindowStub {CFilesWindow Left,Right;bool RightActive=false;
 CFilesWindow* GetPanel(int panel){switch(panel){case PANEL_SOURCE:return RightActive?&Right:&Left;case PANEL_TARGET:return RightActive?&Left:&Right;case PANEL_LEFT:return &Left;case PANEL_RIGHT:return &Right;default:return nullptr;}}
};
static MainWindowStub Window;static MainWindowStub* MainWindow=&Window;static DWORD MainThreadID;static HWND TestWindow;
struct CSalamanderGeneralAbstract {
 bool SnapshotAvailable=true,ResolverAvailable=true,BadInterface=false,BadVersion=false;int RootCalls=0,QueryCalls=0,CountOffset=0;
 BOOL QueryService(const CSalamanderServiceQuery*,CSalamanderServiceResult*);
 void CreateSafeWaitWindow(const char*,void*,int,BOOL,HWND){}
 void DestroySafeWaitWindow(){}
 BOOL GetSafeWaitWindowClosePressed(){return FALSE;}
 BOOL TestFreeSpace(HWND,const char*,const CQuadWord&,const char*){return TRUE;}
 void PostChangeOnPathNotification(const char*,BOOL){}
 void GetConfigParameter(int,void*,size_t,void*) {}
 int SalMessageBox(HWND,const char*,const char*,UINT){return IDYES;}
 int DialogError(HWND,DWORD,const char*,const char*,const char*){return IDCANCEL;}
 BOOL GetLinkTgtFileSize(HWND,const char*,CQuadWord*,BOOL*,BOOL*){return FALSE;}
 BOOL SalGetFileSize(HANDLE h,CQuadWord& s,DWORD& e){e=0;SetLastError(0);s.LoDWord=GetFileSize(h,&s.HiDWord);e=GetLastError();return s.LoDWord!=INVALID_FILE_SIZE||e==0;}
 BOOL SalGetFileSize2(const char*,CQuadWord&,DWORD*){return FALSE;}

 HWND GetMainWindowHWND(){return TestWindow;}
 BOOL GetPanelPath(int panel,char* path,int capacity,int* type,void*){++RootCalls;auto p=Window.GetPanel(panel);if(!p)return FALSE;*type=p->Disk?PATH_TYPE_WINDOWS:-1;if(p->RootText.size()>=static_cast<size_t>(capacity))return FALSE;strcpy_s(path,capacity,p->RootText.c_str());return TRUE;}
 BOOL GetPanelSelection(int panel,int* files,int* dirs){auto p=Window.GetPanel(panel);*files=*dirs=0;for(auto a:{p->Dirs,p->Files})for(auto& f:a->Data)if(f.Selected)++(a==p->Dirs?*dirs:*files);*files+=CountOffset;return *files+*dirs!=0;}
 const CFileData* GetPanelFocusedItem(int panel,BOOL* isDir){auto p=Window.GetPanel(panel);if(p->Focus<0||p->Focus>=p->Dirs->Count+p->Files->Count)return nullptr;bool d=p->Focus<p->Dirs->Count;if(isDir)*isDir=d;return d?&p->Dirs->At(p->Focus):&p->Files->At(p->Focus-p->Dirs->Count);}
 const CFileData* GetPanelItem(int panel,int* index,BOOL* isDir){auto p=Window.GetPanel(panel);int i=(*index)++;if(i<0||i>=p->Dirs->Count+p->Files->Count)return nullptr;*isDir=i<p->Dirs->Count;return *isDir?&p->Dirs->At(i):&p->Files->At(i-p->Dirs->Count);}
};
