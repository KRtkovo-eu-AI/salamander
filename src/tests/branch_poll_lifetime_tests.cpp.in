namespace UacF7 {
struct ListingSession {
    bool busy = false;
    bool Contains(const std::wstring&) { return true; }
    bool TryContains(const std::wstring&, bool& contains) { if (busy) return false; contains = true; return true; }
    DWORD List(const std::wstring&, std::vector<WIN32_FIND_DATAW>&, const void* = nullptr) { return ERROR_SUCCESS; }
    bool IsOpen() const { return true; }
};
}
extern "C" void* BranchTestCreate();
extern "C" void BranchTestDestroy(void*);
extern "C" bool BranchTestStart(void*, const wchar_t*);
extern "C" bool BranchTestWait(void*);
extern "C" void BranchTestCancel(void*);
extern "C" void BranchTestDrain(void*, std::vector<Entry>*, Progress*);
struct FakeWorker {
    Progress next{};
    std::vector<Entry> batch;
    void* real = nullptr;
    ~FakeWorker() { if (real) BranchTestDestroy(real); }
    void Cancel() { ++workerCancels; if (real) BranchTestCancel(real); }
    bool Start(const std::wstring&, bool, bool) { ++workerStarts; return true; }
    void SetLocalPager(const DirectoryPager&) {}
    void Drain(std::vector<Entry>& out, Progress& status) {
        if (real) BranchTestDrain(real, &out, &status);
        else { out.swap(batch); status = next; }
    }
    void DrainFailure(std::wstring&, DWORD&) {}
    template<class Callback> void Advance(Callback, void*) {}
};
struct CBranchViewState {
    bool Enabled = true, Applying = false, Dirty = false, PreserveListing = false, HasCompletedSnapshot = false;
    bool ForcePublish = false, Preparing = false, CompletionPending = false, StoppingInitial = false, UseProtectedListing = false, RetryingProtected = false;
    bool PanelScopePending = false;
    std::shared_ptr<PreparationSession> Preparation;
    std::shared_ptr<PreparationLifetime> PreparationLifetime;
    ULONGLONG Generation = 0;
    DWORD LastPublish = 0;
    RefreshSchedule Refresh;
    std::wstring Root = L"C:\\fixture";
    FakeWorker Worker;
    Progress Status;
    std::vector<Entry> Entries, IncomingEntries;
    std::vector<Entry> StoppedBatch;
    size_t StoppedBatchNext = 0;
};
struct CFilesWindow {
    HWND HWindow = nullptr;
    CBranchViewState* BranchView = nullptr;
    std::shared_ptr<UacF7::ListingSession> ProtectedListing;
    FakeFiles* Files = nullptr;
    FakeFiles* Dirs = nullptr;
    CFilesWindow() : BranchView(new CBranchViewState), Files(new FakeFiles), Dirs(new FakeFiles) {
        HWindow = CreateWindowExW(0, L"STATIC", L"", WS_OVERLAPPED, 0, 0, 100, 40,
                                  nullptr, nullptr, GetModuleHandleW(nullptr), nullptr);
    }
    ~CFilesWindow() { ShutdownBranchView(); if (IsWindow(HWindow)) DestroyWindow(HWindow); delete Files; delete Dirs; ++panelDestructors; }
    bool IsBranchView() const { return BranchView && BranchView->Enabled; }
    void DirectoryLineSetText() { ++directoryStatusCalls; }
    void RefreshDirectory() { ++refreshCalls; if (onRefresh) onRefresh(); }
    void CancelBranchViewScan();
    void StopBranchViewScan();
    void ShutdownBranchView();
    void RefreshBranchView(BOOL automatic = FALSE);
    void PollBranchView();
};
