static int checks, failures;
static void Check(bool condition, const char* message)
{
    ++checks;
    if (!condition) { ++failures; std::printf("FAIL: %s\n", message); }
}
static void Reset()
{
    prompts = warnings = measurements = g_prepared = waitDepth = inventories = 0;
    localError = ERROR_ACCESS_DENIED; g_startError = g_allocationError = g_inventoryError = prepareError = reportedError = ERROR_SUCCESS;
    localValue = brokerValue = 0; nextChoice = IDOK; offer = true; exactPrompt = false;
}
int main()
{
    constexpr DWORD sparse = FILE_ATTRIBUTE_SPARSE_FILE | FILE_ATTRIBUTE_ARCHIVE;
    {
        Reset(); CFilesWindow panel; COperations sum; CSizeBatchConsent batch;
        CSizeScanScope first, second; first.Batch = second.Batch = &batch;
        first.Root = L"C:\\scope\\first"; second.Root = L"C:\\scope\\second";
        g_startError = ERROR_CANCELLED;
        Check(panel.MeasureDirectory(&sum, &first, first.Root + L"\\denied") == TRUE && batch.ElevationDeclined &&
              sum.CountSizeIncomplete && prompts == 1, "directory UAC refusal marks the first selected root incomplete");
        sum.CountSizeIncomplete = false; g_startError = ERROR_SUCCESS;
        Check(panel.MeasureDirectory(&sum, &second, second.Root + L"\\denied") == TRUE &&
              sum.CountSizeIncomplete && prompts == 1 && inventories == 0,
              "directory UAC refusal carries to another root without a second prompt");
    }
    {
        Reset(); CFilesWindow panel; COperations sum; CSizeBatchConsent batch;
        CSizeScanScope first, second; first.Batch = second.Batch = &batch;
        first.Root = L"C:\\scope\\first"; second.Root = L"C:\\scope\\second";
        nextChoice = IDYES;
        Check(panel.MeasureDirectory(&sum, &first, first.Root + L"\\skip") == TRUE && !batch.ElevationDeclined,
              "directory Skip leaves later root consent available");
        nextChoice = IDOK; brokerValue = 13;
        Check(panel.MeasureDirectory(&sum, &second, second.Root + L"\\approve") == TRUE && prompts == 2 &&
              inventories == 1 && sum.TotalSize.Value == 13 && !first.Session.IsOpen() && second.Session.IsOpen(),
              "later directory uses its own scope and contributes its own total after Skip");
    }
    {
        Reset(); CFilesWindow panel; COperations sum; CSizeBatchConsent batch;
        CSizeScanScope first, second; first.Batch = second.Batch = &batch;
        first.Root = L"C:\\scope\\first"; second.Root = L"C:\\scope\\second";
        nextChoice = IDNO;
        Check(panel.MeasureDirectory(&sum, &first, first.Root + L"\\skip-all") == TRUE && panel.ErrListDirSkipAll &&
              !batch.ElevationDeclined, "directory Skip All retains the existing error policy");
        Check(panel.MeasureDirectory(&sum, &second, second.Root + L"\\later") == -1 && prompts == 1,
              "directory Skip All does not create another broker prompt");
        panel.ErrListDirSkipAll = FALSE; nextChoice = IDCANCEL;
        Check(panel.MeasureDirectory(&sum, &second, second.Root + L"\\cancel") == FALSE && !batch.ElevationDeclined,
              "ordinary directory Cancel terminates without marking system refusal");
    }
    {
        Reset(); CFilesWindow panel; COperations sum; CSizeBatchConsent batch;
        CSizeScanScope first, second; first.Batch = second.Batch = &batch;
        first.Root = L"C:\\scope\\first"; second.Root = L"C:\\scope\\second";
        g_startError = ERROR_BROKEN_PIPE;
        Check(panel.MeasureDirectory(&sum, &first, first.Root + L"\\broken") == -1 && !batch.ElevationDeclined,
              "broker startup failure remains an ordinary error rather than batch refusal");
        g_startError = ERROR_SUCCESS; brokerValue = 7;
        Check(panel.MeasureDirectory(&sum, &second, second.Root + L"\\next") == TRUE && prompts == 2 && inventories == 1,
              "a later directory can still request consent after broker failure");
    }
    {
        Reset(); CFilesWindow panel; COperations sum; CSizeBatchConsent batch;
        CSizeScanScope first, second; first.Batch = second.Batch = &batch;
        first.Root = L"C:\\scope\\first"; second.Root = L"C:\\scope\\second";
        g_inventoryError = ERROR_CANCELLED;
        Check(panel.MeasureDirectory(&sum, &first, first.Root + L"\\cancelled-io") == TRUE &&
              !batch.ElevationDeclined && sum.CountSizeIncomplete,
              "an inventory cancellation is not mistaken for Windows consent refusal");
        g_inventoryError = ERROR_SUCCESS; brokerValue = 9;
        Check(panel.MeasureDirectory(&sum, &second, second.Root + L"\\next") == TRUE && prompts == 2 && inventories == 2,
              "a different root can ask after an item-level inventory cancellation");
    }
    {
        Reset(); CFilesWindow panel; COperations sum; CSizeBatchConsent batch;
        CSizeScanScope first, second; first.Batch = second.Batch = &batch;
        first.Root = L"C:\\scope\\first"; second.Root = L"C:\\scope\\second";
        g_startError = ERROR_CANCELLED;
        Check(panel.MeasureDirectory(&sum, &first, first.Root + L"\\denied") == TRUE && batch.ElevationDeclined,
              "directory refusal marks the shared operation");
        second.Session.Root = second.Root; second.Session.Open = true; brokerValue = 8;
        Check(panel.MeasureDirectory(&sum, &second, second.Root + L"\\approved") == TRUE && prompts == 1 &&
              inventories == 1 && sum.TotalSize.Value == 8,
              "a previously approved scope remains usable after refusal elsewhere");
        panel.ProtectedListing = std::make_unique<UacF7::ListingSession>();
        panel.ProtectedListing->Root = second.Root; panel.ProtectedListing->Open = true;
        Check(panel.MeasureDirectory(&sum, &second, second.Root + L"\\panel") == TRUE && prompts == 1 && inventories == 2,
              "the existing approved panel listing remains usable after refusal elsewhere");
    }
    {
        Reset(); CFilesWindow panel; COperations sum; CSizeScanScope scope; brokerValue = 100;
        Check(panel.Measure(&sum, &scope, L"one", 9000, sparse) && panel.Measure(&sum, &scope, L"two", 8000, sparse), "approved files finish");
        Check(prompts == 1 && measurements == 2 && sum.TotalSize.Value == 17000 && sum.CompressedSize.Value == 200 &&
              sum.OccupiedSpace.Value == 8192 && sum.Sizes.rows.size() == 2 && !sum.CountSizeCompressionUnavailable && !waitDepth,
              "one consent measures both files and contributes once with per-file cluster rounding");
    }
    {
        Reset(); CFilesWindow panel; COperations sum; CSizeScanScope scope; g_startError = ERROR_CANCELLED;
        Check(panel.Measure(&sum, &scope, L"one", 9000, sparse), "system refusal leaves the calculation running");
        Check(panel.Measure(&sum, &scope, L"two", 8000, sparse), "another denied file continues without another consent");
        localError = 0; localValue = 12;
        Check(panel.Measure(&sum, &scope, L"readable", 40, sparse), "readable sibling still contributes");
        Check(prompts == 1 && measurements == 0 && warnings == 0 && sum.TotalSize.Value == 17040 &&
              sum.CompressedSize.Value == 17012 && sum.Sizes.rows.size() == 3 && sum.CountSizeCompressionUnavailable &&
              sum.CountSizeOccupiedUnavailable && scope.ElevationDeclined && !waitDepth,
              "system refusal preserves all logical bytes and marks only disk totals unavailable");
    }
    {
        Reset(); CFilesWindow panel; COperations sum; CSizeBatchConsent batch;
        CSizeScanScope first, second; first.Batch = second.Batch = &batch;
        first.Root = L"C:\\scope\\first"; second.Root = L"C:\\scope\\second";
        g_startError = ERROR_CANCELLED;
        Check(panel.Measure(&sum, &first, L"first\\one", 100, sparse) && batch.ElevationDeclined,
              "Windows refusal is recorded for the selected batch");
        g_startError = ERROR_SUCCESS;
        Check(panel.Measure(&sum, &second, L"second\\two", 200, sparse) && prompts == 1 && measurements == 0 &&
              warnings == 0 && sum.TotalSize.Value == 300 && sum.CountSizeCompressionUnavailable,
              "a different selected root keeps logical totals without another Windows prompt");
        localError = ERROR_SUCCESS; localValue = 15;
        Check(panel.Measure(&sum, &second, L"second\\ordinary", 30, sparse) && sum.TotalSize.Value == 330 &&
              sum.CompressedSize.Value == 315 && prompts == 1,
              "accessible items still contribute after a different root declined elevation");
        CSizeBatchConsent nextBatch; CSizeScanScope fresh; fresh.Batch = &nextBatch;
        localError = ERROR_ACCESS_DENIED; brokerValue = 1;
        Check(panel.Measure(&sum, &fresh, L"fresh", 10, sparse) && prompts == 2 && measurements == 1,
              "a separate later operation can request elevation again");
    }
    {
        Reset(); CFilesWindow panel; COperations sum; CSizeBatchConsent batch;
        CSizeScanScope first, second; first.Batch = second.Batch = &batch;
        first.Root = L"C:\\scope\\first"; second.Root = L"C:\\scope\\second";
        nextChoice = IDYES;
        Check(panel.Measure(&sum, &first, L"first\\one", 10, sparse) && !batch.ElevationDeclined,
              "ordinary Skip does not decline elevation for other selected roots");
        nextChoice = IDOK; brokerValue = 2;
        Check(panel.Measure(&sum, &second, L"second\\two", 20, sparse) && prompts == 2 && measurements == 1 &&
              !first.Session.IsOpen() && second.Session.IsOpen(),
              "a later selected root obtains only its own approved scope after Skip");
    }
    {
        Reset(); CFilesWindow panel; COperations sum; CSizeBatchConsent batch;
        CSizeScanScope first, second; first.Batch = second.Batch = &batch;
        first.Root = L"C:\\scope\\first"; second.Root = L"C:\\scope\\second";
        g_startError = ERROR_ACCESS_DENIED;
        Check(panel.Measure(&sum, &first, L"first\\one", 10, sparse) && !batch.ElevationDeclined &&
              reportedError == ERROR_ACCESS_DENIED, "broker start failure is not a Windows refusal");
        g_startError = ERROR_SUCCESS; brokerValue = 3;
        Check(panel.Measure(&sum, &second, L"second\\two", 20, sparse) && prompts == 2 && measurements == 1,
              "a broker error in one root does not suppress a later root's consent");
    }
    {
        Reset(); CFilesWindow panel; COperations sum; CSizeBatchConsent batch;
        CSizeScanScope first, second; first.Batch = second.Batch = &batch;
        first.Root = L"C:\\scope\\first"; second.Root = L"C:\\scope\\second";
        panel.ProtectedListing = std::make_unique<UacF7::ListingSession>();
        panel.ProtectedListing->Root = second.Root; panel.ProtectedListing->Open = true;
        g_startError = ERROR_CANCELLED;
        Check(panel.Measure(&sum, &first, L"first\\one", 10, sparse) && batch.ElevationDeclined,
              "one selected root can decline a new session");
        brokerValue = 4;
        Check(panel.Measure(&sum, &second, L"second\\two", 20, sparse) && prompts == 1 && measurements == 1 &&
              sum.CompressedSize.Value == 14, "an already approved panel session remains usable after refusal");
        panel.ProtectedListing->Open = false;
        Check(panel.Measure(&sum, &second, L"second\\broken", 30, sparse) && reportedError == ERROR_BROKEN_PIPE &&
              warnings == 1, "a broken pre-existing panel session still reports its real error after refusal");
    }
    {
        Reset(); CFilesWindow panel; COperations sum; CSizeScanScope scope; nextChoice = IDYES;
        Check(panel.Measure(&sum, &scope, L"skip", 1, sparse) && !scope.ElevationDeclined, "Skip omits only one elevation");
        nextChoice = IDOK; brokerValue = 0;
        Check(panel.Measure(&sum, &scope, L"approve", 1, sparse) && prompts == 2 && measurements == 1,
              "after Skip the next file can still request consent");
    }
    {
        Reset(); CFilesWindow panel; COperations sum; CSizeScanScope scope; nextChoice = IDNO;
        Check(panel.Measure(&sum, &scope, L"skip-all", 1, sparse) && panel.Measure(&sum, &scope, L"later", 2, sparse) &&
              prompts == 1 && sum.SkipAllCountSizeErrors && measurements == 0 && sum.TotalSize.Value == 3,
              "Skip All retains totals and suppresses later prompts");
    }
    {
        Reset(); CFilesWindow panel; COperations sum; CSizeScanScope scope; nextChoice = IDCANCEL;
        Check(!panel.Measure(&sum, &scope, L"cancel", 1, sparse) && sum.Sizes.rows.empty() && !waitDepth,
              "Cancel aborts without contributing the unfinished item");
    }
    {
        Reset(); CFilesWindow panel; COperations sum; CSizeScanScope scope; panel.ProtectedListing = std::make_unique<UacF7::ListingSession>();
        panel.ProtectedListing->Root = scope.Root; panel.ProtectedListing->Open = true; brokerValue = 17;
        Check(panel.Measure(&sum, &scope, L"listed", 100, sparse) && prompts == 0 && measurements == 1 && sum.CompressedSize.Value == 17,
              "an approved panel session is reused without another consent");
        panel.ProtectedListing->Open = false;
        Check(panel.Measure(&sum, &scope, L"broken", 100, sparse) && prompts == 0 && measurements == 1 && warnings == 1 &&
              reportedError == ERROR_BROKEN_PIPE,
              "a disconnected panel session does not trigger a replacement consent");
    }
    {
        Reset(); CFilesWindow panel; COperations sum; CSizeScanScope scope; panel.ProtectedListing = std::make_unique<UacF7::ListingSession>();
        panel.ProtectedListing->Root = scope.Root; panel.ProtectedListing->Open = true; prepareError = ERROR_FILE_INVALID;
        Check(panel.Measure(&sum, &scope, L"changed", 100, sparse) && prompts == 0 && measurements == 0 &&
              reportedError == ERROR_FILE_INVALID && sum.CountSizeCompressionUnavailable,
              "a changed listed identity reports its real failure and never asks for another consent");
    }
    {
        Reset(); CFilesWindow panel; COperations sum; CSizeScanScope scope; offer = false;
        Check(panel.Measure(&sum, &scope, L"denied", 100, sparse) && prompts == 0 && sum.TotalSize.Value == 100 &&
              sum.CountSizeCompressionUnavailable && sum.CountSizeOccupiedUnavailable,
              "when elevation is unavailable the ordinary logical contribution remains");
    }
    {
        Reset(); CFilesWindow panel; COperations sum; CSizeScanScope scope; brokerValue = 20;
        Check(panel.Measure(&sum, &scope, L"first", 100, sparse), "the first metadata request is approved");
        g_allocationError = ERROR_ACCESS_DENIED;
        Check(panel.Measure(&sum, &scope, L"still-denied", 200, sparse) && prompts == 1 && measurements == 2 &&
              reportedError == ERROR_ACCESS_DENIED && sum.TotalSize.Value == 300 && sum.CountSizeCompressionUnavailable,
              "a broker denial preserves the ordinary contribution without another prompt");
    }
    {
        Reset(); CFilesWindow panel; COperations sum; CSizeScanScope scope; g_allocationError = ERROR_CANCELLED;
        Check(panel.Measure(&sum, &scope, L"cancelled-measurement", 100, sparse) && prompts == 1 && measurements == 1 &&
              !scope.ElevationDeclined && reportedError == ERROR_CANCELLED && sum.TotalSize.Value == 100,
              "a cancelled metadata request is not misreported as a Windows consent refusal");
        g_allocationError = ERROR_SUCCESS; brokerValue = 2;
        Check(panel.Measure(&sum, &scope, L"next", 200, sparse) && prompts == 1 && measurements == 2,
              "the still-open approved session can serve a later file after an item-level cancellation");
    }
    {
        Reset(); CFilesWindow panel; COperations sum; CSizeScanScope scope; localError = 0; localValue = 0x1ffffffffULL;
        Check(panel.Measure(&sum, &scope, L"sentinel", localValue, sparse) && prompts == 0 && warnings == 0 &&
              sum.TotalSize.Value == localValue && sum.CompressedSize.Value == localValue,
              "a valid low-word sentinel preserves the entire 64-bit result");
    }
    {
        Reset(); CFilesWindow panel; COperations sum; CSizeScanScope scope; scope.Root += L"\\single"; scope.ExactFile = true; brokerValue = 25;
        Check(panel.Measure(&sum, &scope, L"single", 100, sparse) && prompts == 1 && measurements == 1 && exactPrompt &&
              scope.Session.Exact && sum.TotalSize.Value == 100 && sum.CompressedSize.Value == 25 && sum.Sizes.rows.size() == 1,
              "a directly selected file uses exactly one metadata-only scope and one contribution");
    }
    {
        Reset(); CFilesWindow panel; COperations sum; CSizeScanScope scope; scope.Root += L"\\single"; scope.ExactFile = true; g_startError = ERROR_CANCELLED;
        Check(panel.Measure(&sum, &scope, L"single", 100, sparse) && prompts == 1 && exactPrompt && measurements == 0 &&
              sum.TotalSize.Value == 100 && sum.CountSizeCompressionUnavailable,
              "declining exact-file consent keeps the logical size without a metadata result");
    }
    {
        Reset(); CFilesWindow panel; COperations sum; CSizeScanScope scope; scope.Root += L"\\different"; scope.ExactFile = true;
        Check(panel.Measure(&sum, &scope, L"single", 100, sparse) && prompts == 0 && g_prepared == 0 &&
              reportedError == ERROR_FILE_INVALID && sum.TotalSize.Value == 100,
              "a reconstructed path differing from the selected file is refused before consent");
    }
    std::printf("Actual size allocation controller: %d checks, %d failures\n", checks, failures);
    return failures ? 1 : 0;
}
