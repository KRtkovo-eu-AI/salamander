namespace UacF7 { struct PreparedLeaf {}; constexpr DWORD maxViewerSnapshotBytes = 16 * 1024 * 1024; }
constexpr DWORD FLI_ERROR = 1, FindIncompleteProtectedFailure = 1u << 5;
constexpr int IDS_CANTSHOWRESULTS = 1, IDS_UAC_FIND_REFINE_IDENTITY_UNAVAILABLE = 2,
              IDS_UAC_FIND_VIEW_IDENTITY_UNAVAILABLE = 3, IDS_ERRORREADINGFILE = 4,
              IDS_UAC_FIND_VIEW_WITH_UNAVAILABLE = 5;
static int logs, messages, contentReads, tagReads, probeReads;
static bool failIdentity, throwIdentity, allowExact;
struct CQuadWord { DWORD LoDWord, HiDWord; CQuadWord(DWORD lo, DWORD hi) : LoDWord(lo), HiDWord(hi) {} };
struct CFoundFilesData {
    DWORD Attr = 0; CQuadWord Size{0, 0}; FILETIME LastWrite{}; bool IsDir = false, ProtectedOrigin = false;
    unsigned ProtectedScope = 0; const char* Path = "C:\\x"; const char* Name = "file.txt";
    std::wstring PathW = L"C:\\x", NameW = L"file.txt";
    std::shared_ptr<const UacF7::PreparedLeaf> FoundView;
    BOOL Set(const char*, const char*, const CQuadWord& size, DWORD attr, const FILETIME* time, BOOL dir) {
        Size = size; Attr = attr; LastWrite = *time; IsDir = dir != FALSE; return TRUE;
    }
    BOOL SetW(const wchar_t*, const wchar_t*, const CQuadWord& size, DWORD attr, const FILETIME* time, BOOL dir) {
        return Set(nullptr, nullptr, size, attr, time, dir);
    }
    std::wstring GetFullNameW() const { return PathW + L"\\" + NameW; }
};
struct FakeList {
    std::vector<CFoundFilesData*> rows;
    ~FakeList() { for (auto* row : rows) delete row; }
    int Add(CFoundFilesData* row) { rows.push_back(row); return static_cast<int>(rows.size()) - 1; }
    bool IsGood() const { return true; } void ResetState() {}
    CFoundFilesData* At(int i) { return rows.at(static_cast<size_t>(i)); }
    HWND HWindow = nullptr;
    void Delete(int i) { delete rows.at(static_cast<size_t>(i)); rows.erase(rows.begin() + i); }
};
struct CDuplicateCandidates { void Add(CFoundFilesData*) {} bool IsGood() { return true; } void ResetState() {} };
struct Criteria {
    bool tags = false; bool HasTags() const { return tags; }
    BOOL TestTags(const wchar_t*) const { ++tagReads; return TRUE; }
};
struct CGrepData {
    FakeList* FoundFilesListView = nullptr; void* Watchdog = nullptr;
    BOOL StopSearch = FALSE, Grep = FALSE; int Refine = 0; unsigned IncompleteReasons = 0; Criteria Criteria;
};
struct FIND_LOG_ITEM { DWORD Flags; const char* Text; const char* Path; };
static const char* LoadStr(int) { return "test"; }
static void AddFindLog(CGrepData*, DWORD, const char*, const char*) { ++logs; }
static void RecordFindWatchdogResult(void*, int) {}
static void RequestFindResultsRefresh(CGrepData*) {}
