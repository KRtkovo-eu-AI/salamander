#define ListView_EnsureVisible(hwnd, index, partial) do { (void)(hwnd); (void)(index); (void)(partial); } while (0)
constexpr DWORD LVIS_SELECTED = 1, LVIS_FOCUSED = 2;
static int RegSetStrICmp(const char* left, const char* right) { return _stricmp(left, right); }
struct CFindDialog {
    FakeList* FoundFilesListView = nullptr;
    BOOL UpdateStatusBar = FALSE;
    void UpdateListViewItems() {}
    void OnHideDuplicateNamesSorted(int sortedCount);
};
@@DEDUPE@@
static int SalMessageBox(HWND, const char*, const char*, unsigned) { ++messages; return 0; }
static void F3Guard(HWND HWindow, const CFoundFilesData* result, bool& continued) {
@@F3_GUARD@@
    continued = true;
}
static void WithGuard(HWND HWindow, FakeList* FoundFilesListView, int viewedIndex, bool& continued) {
@@WITH_GUARD@@
    continued = true;
}
static int checks, failures;
static void Check(bool value, const char* text) { ++checks; if (!value) { ++failures; std::printf("FAIL: %s\n", text); } }
int main() {
    FakeList list; CGrepData data; data.FoundFilesListView = &list; Publisher publisher; publisher.data = &data;
    WIN32_FIND_DATAW entry{}; wcscpy_s(entry.cFileName, L"x.txt");
    failIdentity = true; publisher.PublishCandidate(L"C:\\x", entry, nullptr);
    Check(list.rows.size() == 1 && list.rows[0]->ProtectedOrigin && !list.rows[0]->FoundView,
          "failed identity preparation preserves protected provenance");
    failIdentity = false; throwIdentity = true; publisher.PublishCandidate(L"C:\\x", entry, nullptr);
    Check(list.rows.size() == 2 && list.rows[1]->ProtectedOrigin && !list.rows[1]->FoundView,
          "bad_alloc during identity preparation preserves protected provenance");
    throwIdentity = false; publisher.singleFile = true; publisher.PublishCandidate(L"C:\\x", entry, nullptr);
    Check(list.rows.size() == 3 && list.rows[2]->ProtectedOrigin && !list.rows[2]->FoundView,
          "exact-file results remain protected even before viewer identity support");
    allowExact = true; publisher.PublishCandidate(L"C:\\x", entry, nullptr);
    Check(list.rows.size() == 4 && list.rows[3]->ProtectedOrigin && list.rows[3]->FoundView,
          "an authorized exact-file result carries its prepared viewer identity");
    allowExact = false; publisher.singleFile = false; publisher.PublishCandidate(L"C:\\x", entry, nullptr);
    Check(list.rows.size() == 5 && list.rows[4]->ProtectedOrigin && list.rows[4]->FoundView,
          "successful identity preparation retains protected provenance and identity");
    bool continued = false;
    F3Guard(nullptr, list.rows[0], continued);
    Check(!continued && messages == 1, "F3 refuses a protected result whose identity is missing");
    F3Guard(nullptr, list.rows[4], continued);
    Check(continued, "F3 allows a protected result with a captured identity into the verified controller");
    continued = false; WithGuard(nullptr, &list, 4, continued);
    Check(!continued && messages == 2, "View With fails before presenting a pathname-only handler");
    FILETIME time{};
    AddFoundItem("C:\\x", "ordinary", 0, 0, 0, &time, FALSE, &data, nullptr);
    continued = false; F3Guard(nullptr, list.rows.back(), continued);
    Check(continued && !list.rows.back()->ProtectedOrigin, "ordinary F3 remains available");
    for (int mode : {1, 2}) {
        data.Grep = TRUE; data.Criteria.tags = true; data.IncompleteReasons = 0;
        logs = contentReads = tagReads = probeReads = 0;
        const bool match = RefineCandidate(&data, list.rows[4]);
        Check(!match && data.IncompleteReasons == FindIncompleteProtectedFailure && logs == 1 &&
              contentReads == 0 && tagReads == 0 && probeReads == 0 &&
              IncludeRefinedFindResult(mode, match) == (mode == 2),
              "protected content and tags never read a pathname; Subtract alone preserves unverified row");
    }
    { auto* retained = list.rows[0]; data.Refine = 2; const size_t before = list.rows.size();
      PublishRefined(&data, retained, FALSE);
      Check(list.rows.size() == before + 1 && list.rows.back()->ProtectedOrigin && !list.rows.back()->FoundView,
            "actual Subtract publication preserves missing identity and protected provenance"); }
    { auto* retained = list.rows[4]; data.Refine = 1; const auto identity = retained->FoundView;
      PublishRefined(&data, retained, TRUE);
      Check(list.rows.back()->ProtectedOrigin && list.rows.back()->FoundView == identity,
            "actual Intersect publication preserves captured identity and protected provenance"); }
    { data.StopSearch = TRUE; data.IncompleteReasons = 0; logs = probeReads = contentReads = tagReads = 0;
      Check(!RefineCandidate(&data, list.rows[4]) && !data.IncompleteReasons && !logs && !probeReads &&
            !contentReads && !tagReads, "explicit Stop suppresses new diagnostics and all protected reads");
      data.StopSearch = FALSE; }
    { FakeList rows; activeList = &rows; CFindDialog dialog; dialog.FoundFilesListView = &rows;
      auto* a = new CFoundFilesData; auto* b = new CFoundFilesData; a->ProtectedOrigin = true;
      rows.rows = {a, b}; dialog.OnHideDuplicateNamesSorted(2);
      Check(rows.rows.size() == 2 && rows.rows[0]->ProtectedOrigin && !rows.rows[1]->ProtectedOrigin,
            "actual dedup retains protected then ordinary result for the same path"); }
    { FakeList rows; activeList = &rows; CFindDialog dialog; dialog.FoundFilesListView = &rows;
      auto* a = new CFoundFilesData; auto* b = new CFoundFilesData; b->ProtectedOrigin = true;
      rows.rows = {a, b}; dialog.OnHideDuplicateNamesSorted(2);
      Check(rows.rows.size() == 2 && !rows.rows[0]->ProtectedOrigin && rows.rows[1]->ProtectedOrigin,
            "actual dedup retains ordinary then protected result for the same path"); }
    { FakeList rows; activeList = &rows; CFindDialog dialog; dialog.FoundFilesListView = &rows;
      auto* a = new CFoundFilesData; auto* b = new CFoundFilesData;
      a->ProtectedOrigin = b->ProtectedOrigin = true;
      a->FoundView = std::make_shared<UacF7::PreparedLeaf>(); b->FoundView = std::make_shared<UacF7::PreparedLeaf>();
      rows.rows = {a, b}; dialog.OnHideDuplicateNamesSorted(2);
      Check(rows.rows.size() == 2, "actual dedup retains different captured identities at the same path"); }
    { FakeList rows; activeList = &rows; CFindDialog dialog; dialog.FoundFilesListView = &rows;
      auto* a = new CFoundFilesData; auto* b = new CFoundFilesData;
      a->ProtectedOrigin = b->ProtectedOrigin = true; a->FoundView = std::make_shared<UacF7::PreparedLeaf>(); b->FoundView = a->FoundView;
      rows.rows = {a, b}; dialog.OnHideDuplicateNamesSorted(2);
      Check(rows.rows.size() == 1 && rows.rows[0]->ProtectedOrigin && rows.rows[0]->FoundView,
            "actual dedup merges only equal shared protected identity"); }
    { FakeList rows; activeList = &rows; CFindDialog dialog; dialog.FoundFilesListView = &rows;
      auto* a = new CFoundFilesData; auto* b = new CFoundFilesData; auto* c = new CFoundFilesData;
      a->ProtectedOrigin = c->ProtectedOrigin = true; a->FoundView = std::make_shared<UacF7::PreparedLeaf>(); c->FoundView = a->FoundView;
      rows.rows = {a, b, c}; dialog.OnHideDuplicateNamesSorted(3);
      Check(rows.rows.size() == 3, "an intervening incompatible result does not cause a nonadjacent merge"); }
    { FakeList rows; activeList = &rows; CFindDialog dialog; dialog.FoundFilesListView = &rows;
      auto* a = new CFoundFilesData; auto* b = new CFoundFilesData;
      a->ProtectedOrigin = b->ProtectedOrigin = true; b->FoundView = std::make_shared<UacF7::PreparedLeaf>();
      rows.rows = {a, b}; dialog.OnHideDuplicateNamesSorted(2);
      Check(rows.rows.size() == 2, "missing and captured protected identity never merge"); }
    { FakeList rows; activeList = &rows; CFindDialog dialog; dialog.FoundFilesListView = &rows;
      auto* a = new CFoundFilesData; auto* b = new CFoundFilesData;
      a->ProtectedOrigin = b->ProtectedOrigin = true;
      rows.rows = {a, b}; dialog.OnHideDuplicateNamesSorted(2);
      Check(rows.rows.size() == 1 && rows.rows[0]->ProtectedOrigin && !rows.rows[0]->FoundView,
            "two unknown protected identities merge only while remaining fail-closed"); }
    { FakeList rows; activeList = &rows; CFindDialog dialog; dialog.FoundFilesListView = &rows;
      rows.rows = {new CFoundFilesData, new CFoundFilesData}; dialog.OnHideDuplicateNamesSorted(2);
      Check(rows.rows.size() == 1 && !rows.rows[0]->ProtectedOrigin, "ordinary dedup is unchanged"); }
    data.IncompleteReasons = 0; logs = contentReads = tagReads = probeReads = 0;
    (void)RefineCandidate(&data, list.rows[5]);
    Check(probeReads == 1, "ordinary Refine keeps its native pathname probe");
    std::printf("Find protected provenance: %d checks, %d failures\n", checks, failures);
    return failures ? 1 : 0;
}
