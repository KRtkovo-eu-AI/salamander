struct Session {
    bool PrepareExactFindViewer(const std::wstring&, DWORD, UacF7::PreparedLeaf&) {
        if (throwIdentity) throw std::bad_alloc();
        return allowExact;
    }
    DWORD PrepareViewer(const std::wstring&, UacF7::PreparedLeaf&, DWORD) {
        if (throwIdentity) throw std::bad_alloc();
        return failIdentity ? ERROR_ACCESS_DENIED : ERROR_SUCCESS;
    }
};
static void SalPathAppendW(std::wstring& path, const wchar_t* leaf) { path += L"\\"; path += leaf; }
struct Publisher {
    bool singleFile = false; unsigned scopeId = 1; Session session; CGrepData* data = nullptr;
