@@REFINE_PUBLISH@@
}
@@MERGE@@
static FakeList* activeList;
static HCURSOR FakeSetCursor(HCURSOR) { return nullptr; }
#undef SetCursor
#define SetCursor FakeSetCursor
#undef LoadCursor
#define LoadCursor(a, b) ((HCURSOR)nullptr)
#define ListView_GetItemCount(hwnd) ((void)(hwnd), static_cast<int>(activeList->rows.size()))
#define ListView_SetItemCount(hwnd, count) do { (void)(hwnd); (void)(count); } while (0)
