#define IDS_ERRORREADINGFILE 1
struct CCopy_Context
{
    CAsyncCopyParams* AsyncPar = nullptr;
    CCopy_ForceOp ForceOp = fopNotUsed;
    BOOL ReadingDone = FALSE;
    CCopy_BlkState BlockState[8]{};
    DWORD BlockDataLen[8]{};
    CQuadWord BlockOffset[8]{};
    DWORD BlockTime[8]{};
    DWORD CurTime = 0;
    int FreeBlocks = 8, FreeBlockIndex = 0, ReadingBlocks = 0, WritingBlocks = 0;
    CQuadWord ReadOffset{}, WriteOffset{};
    CProgressDlgData* DlgData = nullptr;
    HANDLE* In = nullptr;
    HANDLE* Out = nullptr;
    COperations* Script = nullptr;
    CThinCopyWorker* Thin = nullptr;
    DWORD PauseFailure = ERROR_SUCCESS;
    BOOL StartReading(int, DWORD, DWORD*, BOOL);
    BOOL StartWriting(int, DWORD*);
    void FreeBlock(int);
    void CancelOpPhase1();
    void CancelOpPhase2(int);
    BOOL FinishPauseFailure(BOOL*, int);
    BOOL HandleSuspModeAndCancel(BOOL*, BOOL forceWait = FALSE);
    BOOL WaitForPendingTransfer(HANDLE, OVERLAPPED*, DWORD*, BOOL*);
};
// A pipe is deliberately not seekable. Seeking is not part of this test.
static BOOL SalSetFilePointer(HANDLE, const CQuadWord&) { return TRUE; }
#define SAM_UAC_THIN_COPY_TEST
@@ISSUE@@
@@FREE@@
