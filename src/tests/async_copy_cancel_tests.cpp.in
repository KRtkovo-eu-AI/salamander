struct CThinCopyWorker
{
    std::atomic<DWORD> connectionStatus{ERROR_SUCCESS};
    bool brokerHandleDelivered = true;
    bool scoped = true;
    UacF7::ThinCopySession* transport = nullptr;
    CProgressDlgData dialog{};
    unsigned reports = 0;
    OVERLAPPED* pending = nullptr;
    bool drainedBeforeReport = false;
    bool Scoped() const { return scoped; }
    DWORD CheckTransferConnection() const { return transport ? transport->CheckTransport() : connectionStatus.load(); }
    DWORD WaitTransferResume() const;
    bool ReportTargetFailure(DWORD, int)
    {
        ++reports;
        drainedBeforeReport = pending && HasOverlappedIoCompleted(pending);
        return false;
    }
    bool ReportTransferLoss(DWORD error, int caption) { return ReportTargetFailure(error, caption); }
};
