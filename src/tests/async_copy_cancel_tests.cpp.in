// | 2026-11-14 | Exercise native async suspension on connection loss. | Verify a real pending read is drained before error reporting. | #731 | gpt-6.1-terra |
// | Date | Summary | Reason | Ticket | Model |
// | 2026-11-14 | Exercise real peer loss while workers are paused. | Connect pause handling to the actual transport check. | #731 | gpt-6.1-terra |
// | 2026-11-14 | Connect the actual transport check to pending native I/O. | Exercise a real peer process exit in the same isolated scenario. | #731 | gpt-6.1-terra |
// | 2026-11-14 | Exercise async wait on connection loss and completion. | Check real pending I/O is drained only after loss. | #731 | gpt-6.1-terra |
// | 2026-11-14 | Exercise all async pause modes and completed-write loss. | Check tracked I/O drains before loss is reported. | #731 | gpt-6.1-terra |
// | 2026-11-14 | Test synchronous pause with a disconnected session. | Verify native error state and prompt detection before resume. | #731 | gpt-6.1-terra |
// | 2026-11-14 | Test paused connection loss with pending I/O. | Verify the native wait can stop before resume. | #731 | gpt-6.1-terra |
// | 2026-11-13 | Test issued asynchronous I/O at cancellation. | Exercise native state and drain with real pending pipe requests. | #731 | GPT-6 |
#include <windows.h>
#include <atomic>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <memory>
#include <mutex>
#include <sstream>
#include <string>
#include <thread>

// These application dependencies are adapted; I/O and tested methods are real.
struct CQuadWord
{
    union { struct { DWORD LoDWord, HiDWord; }; unsigned __int64 Value; };
    CQuadWord() : Value(0) {}
    CQuadWord(DWORD lo, DWORD hi) : LoDWord(lo), HiDWord(hi) {}
    bool operator==(const CQuadWord& rhs) const { return Value == rhs.Value; }
    bool operator<(const CQuadWord& rhs) const { return Value < rhs.Value; }
    bool operator>(const CQuadWord& rhs) const { return Value > rhs.Value; }
};
#define HANDLES(value) (value)
#define TRACE_I(value) do { if (false) { std::ostringstream trace; trace << value; } } while (0)
#define TRACE_E(value) TRACE_I(value)
#define TRACE_C(value) TRACE_I(value)
static const char* GetErrorText(DWORD) { return "Win32 error"; }
static DWORD observedReadError = ERROR_SUCCESS;
static bool observedReadSucceeded = false;
static bool injectImmediateEOF = false;
static BOOL ObservedRead(HANDLE file, void* buffer, DWORD size, DWORD* read, OVERLAPPED* overlapped)
{
    if (injectImmediateEOF)
    {
        observedReadError = ERROR_HANDLE_EOF;
        observedReadSucceeded = false;
        SetLastError(observedReadError);
        return FALSE;
    }
    const BOOL result = ReadFile(file, buffer, size, read, overlapped);
    observedReadSucceeded = result != FALSE;
    observedReadError = result ? ERROR_SUCCESS : GetLastError();
    SetLastError(observedReadError);
    return result;
}
#define THIN_COPY_READ ObservedRead
static DWORD observedWriteError = ERROR_SUCCESS;
static bool observedWriteSucceeded = false;
static BOOL ObservedWrite(HANDLE file, const void* buffer, DWORD size, DWORD* written, OVERLAPPED* overlapped)
{
    const BOOL result = WriteFile(file, buffer, size, written, overlapped);
    observedWriteSucceeded = result != FALSE;
    observedWriteError = result ? ERROR_SUCCESS : GetLastError();
    SetLastError(observedWriteError);
    return result;
}
#define THIN_COPY_WRITE ObservedWrite
static HANDLE watchedDrainHandle = nullptr;
static OVERLAPPED* watchedDrainOverlapped = nullptr;
static unsigned watchedDrainCalls = 0;
static bool watchedDrainMatches = true;
static BOOL ObservedGetOverlappedResult(HANDLE file, OVERLAPPED* overlapped, DWORD* bytes, BOOL wait)
{
    if (overlapped == watchedDrainOverlapped)
    {
        ++watchedDrainCalls;
        if (file != watchedDrainHandle || !wait) watchedDrainMatches = false;
    }
    return GetOverlappedResult(file, overlapped, bytes, wait);
}
#define GetOverlappedResult ObservedGetOverlappedResult
