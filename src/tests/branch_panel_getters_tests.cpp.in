struct COperation {
    int Opcode=0;CQuadWord Size;DWORD Attr=0;char* SourceName=nullptr;char* TargetName=nullptr;
    std::wstring SourceW,TargetW;
    void SetSourceNameW(const wchar_t* p){SourceW=p;}
    void SetTargetNameW(const wchar_t* p){TargetW=p;}
};
struct CopyScript {
    CQuadWord TotalFileSize;
    std::vector<COperation> Records;
    int FailAt=-1;BOOL Good=TRUE;
    int Add(const COperation& op){if(FailAt==(int)Records.size()){Good=FALSE;return -1;}Records.push_back(op);return (int)Records.size()-1;}
    BOOL IsGood(){return Good;}
    void ResetState(){Good=TRUE;}
    ~CopyScript(){for(auto& op:Records)if(op.Opcode==ocCreateDir){free(op.SourceName);free(op.TargetName);}}
    BOOL SourcePathIsNetwork=FALSE,SameRootButDiffVolume=FALSE,ShowStatus=FALSE;
    std::vector<std::pair<std::string,int>> Storage;
    void AddStoragePath(const char* path,int access){Storage.emplace_back(path,access);}
};
