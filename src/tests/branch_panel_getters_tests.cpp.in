struct CQuadWord {
    DWORD LoDWord=0,HiDWord=0;
    CQuadWord(DWORD value=0):LoDWord(value){}
    CQuadWord operator-(const CQuadWord& other) const {return CQuadWord(LoDWord-other.LoDWord);}
