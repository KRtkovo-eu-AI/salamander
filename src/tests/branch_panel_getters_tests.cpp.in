struct CFileData
{
    const char* Name = nullptr;
    const wchar_t* NameW = nullptr;
    unsigned NameLen = 0;
    BOOL Selected = FALSE;
    BOOL UseWideName() const { return NameW != nullptr; }
};
struct CBranchViewState
{
    std::vector<Salamander::BranchView::Entry> Entries;
    std::wstring PendingFocus;
    bool Enabled = true;
    std::mutex ItemsMutex;
    std::unordered_map<const char*, Salamander::BranchView::Entry> Items;
    std::unordered_map<std::string, const CFileData*> CacheFiles;
};
struct TestRows {
    std::vector<CFileData> Values;
    int Count = 0;
    CFileData& At(int i) { return Values.at(i); }
};
struct TestMasks {
    BOOL Ready = TRUE, Match = TRUE;
    BOOL PrepareMasks(int& error) { error = 0; return Ready; }
    BOOL AgreeMasks(const char*, const char*) { return Match; }
};
const int VIEWER_EXTERNAL = 0, VIEWER_INTERNAL = 1;
struct CViewerMasksItem { TestMasks* Masks; int ViewerType; };
struct CViewerMasks {
    std::vector<CViewerMasksItem*> Values;
    int Count = 0;
    CViewerMasksItem* At(int i) { return Values.at(i); }
};
struct TestHistory {
    int Count = 0;
    std::string Path;
    void AddFile(int,int,const char* path) { ++Count; Path=path; }
};
struct TestPacker { BOOL Archive=FALSE; BOOL PackIsArchive(const char*) {return Archive;} } PackerFormatConfig;
const int fhitOpen=1, BUTTONS_OK=1, IDS_TOOLONGNAME=1, IDS_ERROROPENINGFILE=2;
static int DialogCalls=0, ShellCalls=0;
static BOOL ShellSuccess=TRUE;
static std::wstring ShellFile, ShellDirectory;
static std::function<void()> OnShell;
static BOOL RecordShell(SHELLEXECUTEINFOW* info) {
    ++ShellCalls; ShellFile=info->lpFile; ShellDirectory=info->lpDirectory;
    if(OnShell)OnShell();
    return ShellSuccess;
}
static int ProgramCalls=0;
static HRESULT ProgramResult=S_OK;
static std::wstring ProgramSource, ProgramDirectory;
static HRESULT LaunchBranchProgram(HWND, const std::wstring& source, const std::wstring& directory) {
    ++ProgramCalls;ProgramSource=source;ProgramDirectory=directory;
    if(OnShell)OnShell();return ProgramResult;
}
static void ShowBranchLaunchFailure(HWND, const std::wstring&, HRESULT, bool) {++DialogCalls;}
#define ShellExecuteExW RecordShell
struct TestMainWindow {
    TestHistory History;
    TestHistory* FileHistory=&History;
    CViewerMasks* ViewerMasks = nullptr;
    CViewerMasks* AltViewerMasks = nullptr;
} TestMain;
static TestMainWindow* MainWindow = &TestMain;
static DWORD ParentAttributes = FILE_ATTRIBUTE_DIRECTORY;
static std::wstring CheckedParent;
static DWORD RecordAttributes(const wchar_t* path) {
    CheckedParent = path;
    return ParentAttributes;
}
#define GetFileAttributesW RecordAttributes

struct CFilesWindow
{
    CBranchViewState* BranchView = nullptr;
    std::wstring WideRoot = L"C:\\root";
    std::string AnsiRoot = "C:\\root";
    bool NullWideRoot = false;
    const wchar_t* GetPathW() const { return NullWideRoot ? nullptr : WideRoot.c_str(); }
    const char* GetPath() const { return AnsiRoot.c_str(); }
    std::wstring GetItemDirectoryW(const CFileData&) const;
    std::wstring GetItemFullPathW(const CFileData&) const;
    std::wstring GetItemIdentityW(const CFileData&) const;
    std::wstring GetItemRelativePathW(const CFileData&) const;
    TestRows DirRows, FileRows;
    TestRows* Dirs = &DirRows;
    TestRows* Files = &FileRows;
    HWND HWindow = nullptr;
    int Caret = 0, NavigationCalls = 0, FocusCalls = 0, FocusedIndex = -1, EndRefreshCalls=0, ArchiveCalls=0;
    std::string OpenedArchive;
    BOOL NavigationSuccess = TRUE, ViewGatePassed = FALSE;
    std::function<void()> OnNavigate;
    std::wstring OpenedDirectory;
    std::string FocusName;
    BOOL IsBranchView() const { return BranchView != nullptr && BranchView->Enabled; }
    int GetCaretIndex() const { return Caret; }
    HWND GetListBoxHWND() const { return HWindow; }
    const char* GetItemCacheKeyPtr(const CFileData&) const;
    const CFileData* GetBranchViewFileByCacheKey(const char*) const;
    BOOL OpenBranchItemDirectory();
    void SetCaretIndex(int index, BOOL) { ++FocusCalls; FocusedIndex = index; Caret = index; }
    BOOL ChangePathToDiskW(HWND, const wchar_t* path) {
        ++NavigationCalls; OpenedDirectory = path;
        if (NavigationSuccess) { BranchView->Enabled = false; if (OnNavigate) OnNavigate(); }
        return NavigationSuccess;
    }
    void EndStopRefresh() {++EndRefreshCalls;}
    void ChangePathToArchive(const char* path,const char*,int,const char*,BOOL,BOOL*) {++ArchiveCalls;OpenedArchive=path;}
    int CancelCalls=0, RefreshCalls=0;
    bool CallbackLocked=false;
    BOOL Is(int) const {return TRUE;}
    int GetSelCount() {int n=0;for(auto& f:FileRows.Values)n+=f.Selected!=FALSE;for(auto& f:DirRows.Values)n+=f.Selected!=FALSE;return n;}
    void SetSel(BOOL selected,int index) {if(index<Dirs->Count)Dirs->At(index).Selected=selected;else Files->At(index-Dirs->Count).Selected=selected;}
    void RepaintListBox(int) {}
    void SelectFocusedItemAndGetName(CPanelTemporarySelection& selection);
    void UnselectItemWithName(const CPanelTemporarySelection& selection);
    void BranchItemRenamed(const char*,const CFileData&,const std::wstring&);
    void CancelBranchViewScan() {++CancelCalls;if(BranchView->ItemsMutex.try_lock())BranchView->ItemsMutex.unlock();else CallbackLocked=true;}
    void RefreshBranchView() {++RefreshCalls;if(BranchView->ItemsMutex.try_lock())BranchView->ItemsMutex.unlock();else CallbackLocked=true;}
    void ExecuteBranch(CFileData* file);
    void ViewPolicy(const char* name, BOOL altView, DWORD handlerID);

};
