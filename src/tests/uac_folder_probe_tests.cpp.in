constexpr UINT uacFolderProbeMessage = WM_APP + 431;
constexpr UINT uacFolderProbeContinueMessage = WM_APP + 432;
constexpr int ptDisk = 1;
struct CFileData { const char* Name; DWORD Attr; bool IsLink; std::wstring Path; };
struct CFilesArray { int Count = 0; std::vector<CFileData> data; CFileData& At(int i) { return data.at(i); } };
struct FakeListing { bool open = false; bool IsOpen() const { return open; } bool Contains(const std::wstring&) const { return open; } };
@@STATE@@
struct CFilesWindow {
    HWND HWindow = reinterpret_cast<HWND>(0x100);
    CFilesArray rows;
    CFilesArray fileRows;
    CFilesArray* Dirs = &rows;
    CFilesArray* Files = &fileRows;
    std::shared_ptr<CUacFolderProbeState> UacFolderProbe;
    std::unordered_map<std::wstring, unsigned> UacDeniedItems;
    ULONG_PTR UacFolderProbeRun = 0;
    ULONGLONG UacFolderProbeGeneration = 0;
    size_t UacFolderProbeNext = 0;
    std::wstring UacFolderProbeRoot;
    std::unique_ptr<FakeListing> ProtectedListing;
    ULONGLONG listingGeneration = 1;
    std::wstring root = L"C:\\root";
    bool disk = true;
    bool Is(int) { return disk; }
    DWORD GetPathDriveType() { return DRIVE_FIXED; }
    const wchar_t* GetPathW() const { return root.c_str(); }
    ULONGLONG GetListingIdentityGeneration() const { return listingGeneration; }
    std::wstring GetItemFullPathW(const CFileData& file) const { return file.Path; }
    HWND GetListBoxHWND() { return HWindow; }
    void StartUacFolderProbe();
    void StopUacFolderProbe();
    void UacFolderProbeContinue(WPARAM);
    void UacFolderProbeReady(WPARAM, LPARAM);
    bool HasUacDeniedItem(const CFileData*) const;
};
struct Message { UINT id; WPARAM w; LPARAM l; };
std::vector<Message> messages;
LPTHREAD_START_ROUTINE queued = nullptr;
void* queuedArgument = nullptr;
int opens = 0, repaints = 0;
bool correctFlags = true;
bool allowElevation = true;
bool useRealFilesystem = false;
CFilesWindow* cancelPanel = nullptr;
bool forceReadControlFailure = false;
std::atomic<ULONG_PTR> nextUacFolderProbeRun{1};

namespace UacF7 { bool CanOfferElevation() { return allowElevation; } }
std::wstring SalPathAddExtendedPrefixW(const wchar_t* path) { return path; }
std::wstring SalPathRemoveExtendedPrefixW(const wchar_t* path) {
    std::wstring result(path);
    if (result.compare(0, 4, L"\\\\?\\") == 0) result.erase(0, 4);
    return result;
}
UINT WINAPI FakeDrive(LPCWSTR path) { return useRealFilesystem ? ::GetDriveTypeW(path) : DRIVE_FIXED; }
BOOL WINAPI FakeVolume(LPCWSTR path, LPWSTR volume, DWORD volumeSize, LPDWORD serial, LPDWORD maxName,
                       LPDWORD flags, LPWSTR fs, DWORD size) {
    if (useRealFilesystem) return ::GetVolumeInformationW(path, volume, volumeSize, serial, maxName, flags, fs, size);
    if (size < 5) return FALSE;
    wcscpy_s(fs, size, L"NTFS");
    return TRUE;
}
DWORD WINAPI FakeAttributes(LPCWSTR path) {
    if (useRealFilesystem) return ::GetFileAttributesW(path);
    const std::wstring name(path);
    if (name.find(L"redirected") != std::wstring::npos) return FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_REPARSE_POINT;
    return FILE_ATTRIBUTE_DIRECTORY;
}
HANDLE WINAPI FakeCreate(LPCWSTR path, DWORD access, DWORD share, LPSECURITY_ATTRIBUTES security,
                         DWORD creation, DWORD flags, HANDLE templateFile) {
    ++opens;
    correctFlags &= share == (FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE) && creation == OPEN_EXISTING &&
                    (flags & FILE_FLAG_OPEN_REPARSE_POINT) &&
                    (flags & ~(FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT)) == 0;
    if (forceReadControlFailure && access == READ_CONTROL) {
        SetLastError(ERROR_ACCESS_DENIED); return INVALID_HANDLE_VALUE;
    }
    if (useRealFilesystem) return ::CreateFileW(path, access, share, security, creation, flags, templateFile);
    if (cancelPanel) { cancelPanel->StopUacFolderProbe(); cancelPanel = nullptr; }
    const std::wstring name(path);
    if (name.find(L"readonly") != std::wstring::npos && access == GENERIC_WRITE) {
        SetLastError(ERROR_ACCESS_DENIED); return INVALID_HANDLE_VALUE;
    }
    if ((name.find(L"read-denied") != std::wstring::npos && access == GENERIC_READ) ||
        (name.find(L"write-denied") != std::wstring::npos && access == GENERIC_WRITE) ||
        (name.find(L"attrs-denied") != std::wstring::npos && access == FILE_WRITE_ATTRIBUTES) ||
        (name.find(L"delete-denied") != std::wstring::npos && access == DELETE) ||
        (name.find(L"blocked-parent") != std::wstring::npos &&
         (access == FILE_DELETE_CHILD || access == FILE_ADD_FILE)) ||
        (name.find(L"denied") != std::wstring::npos && (flags & FILE_FLAG_BACKUP_SEMANTICS) &&
         access == FILE_LIST_DIRECTORY)) { SetLastError(ERROR_ACCESS_DENIED); return INVALID_HANDLE_VALUE; }
    if (name.find(L"unknown") != std::wstring::npos) { SetLastError(ERROR_SHARING_VIOLATION); return INVALID_HANDLE_VALUE; }
    return reinterpret_cast<HANDLE>(0x201);
}
BOOL WINAPI FakeClose(HANDLE handle) { return useRealFilesystem ? ::CloseHandle(handle) : TRUE; }
BOOL WINAPI FakePost(HWND, UINT id, WPARAM w, LPARAM l) { messages.push_back({id, w, l}); return TRUE; }
BOOL WINAPI FakeInvalidate(HWND, const RECT*, BOOL) { ++repaints; return TRUE; }
BOOL WINAPI FakeQueue(LPTHREAD_START_ROUTINE callback, PVOID arg, ULONG) { queued = callback; queuedArgument = arg; return TRUE; }
HANDLE OpenAclHandle(const wchar_t* path) { return ::CreateFileW(path, READ_CONTROL | WRITE_DAC,
    FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, nullptr); }
void CloseRealHandle(HANDLE handle) { ::CloseHandle(handle); }
bool CreateRealFile(const wchar_t* path) {
    const HANDLE file = ::CreateFileW(path, GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
        nullptr, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, nullptr);
    if (file == INVALID_HANDLE_VALUE) return false;
    const char expected = 'x'; DWORD written = 0;
    const bool ok = ::WriteFile(file, &expected, 1, &written, nullptr) && written == 1;
    ::CloseHandle(file);
    return ok;
}
bool ReadRealFile(const wchar_t* path) {
    const HANDLE file = ::CreateFileW(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
        nullptr, OPEN_EXISTING, 0, nullptr);
    if (file == INVALID_HANDLE_VALUE) return false;
    char actual = 0; DWORD read = 0; LARGE_INTEGER size{};
    const bool ok = ::GetFileSizeEx(file, &size) && size.QuadPart == 1 &&
                    ::ReadFile(file, &actual, 1, &read, nullptr) && read == 1 && actual == 'x';
    ::CloseHandle(file);
    return ok;
}
bool QueryRealAclWrite(const wchar_t* path, bool& allowed, bool& explicitWriteDeny, DWORD desired = FILE_WRITE_DATA) {
    allowed = false;
    explicitWriteDeny = false;
    HANDLE file = ::CreateFileW(path, READ_CONTROL, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
                                nullptr, OPEN_EXISTING, FILE_FLAG_OPEN_REPARSE_POINT, nullptr);
    if (file == INVALID_HANDLE_VALUE) return false;
    PSECURITY_DESCRIPTOR descriptor = nullptr;
    DWORD error = GetSecurityInfo(file, SE_FILE_OBJECT, OWNER_SECURITY_INFORMATION | GROUP_SECURITY_INFORMATION |
                                  DACL_SECURITY_INFORMATION, nullptr, nullptr, nullptr, nullptr, &descriptor);
    ::CloseHandle(file);
    if (error || !descriptor) return false;
    BOOL present = FALSE, defaulted = FALSE; PACL dacl = nullptr;
    if (GetSecurityDescriptorDacl(descriptor, &present, &dacl, &defaulted) && present && dacl) {
        for (DWORD i = 0; i < dacl->AceCount; ++i) {
            void* ace = nullptr;
            if (GetAce(dacl, i, &ace) && static_cast<ACE_HEADER*>(ace)->AceType == ACCESS_DENIED_ACE_TYPE &&
                (static_cast<ACCESS_DENIED_ACE*>(ace)->Mask & desired)) explicitWriteDeny = true;
        }
    }
    HANDLE primary = nullptr, token = nullptr;
    if (!OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY | TOKEN_DUPLICATE, &primary) ||
        !DuplicateToken(primary, SecurityImpersonation, &token)) {
        if (primary) ::CloseHandle(primary);
        LocalFree(descriptor);
        return false;
    }
    GENERIC_MAPPING mapping{FILE_GENERIC_READ, FILE_GENERIC_WRITE, FILE_GENERIC_EXECUTE, FILE_ALL_ACCESS};
    PRIVILEGE_SET privileges{}; DWORD privilegeBytes = sizeof(privileges), granted = 0; BOOL access = FALSE;
    const BOOL ok = AccessCheck(descriptor, token, desired, &mapping, &privileges, &privilegeBytes, &granted, &access);
    allowed = access != FALSE;
    ::CloseHandle(token); ::CloseHandle(primary); LocalFree(descriptor);
    return ok != FALSE;
}
struct RealFileAcl {
    HANDLE handle = INVALID_HANDLE_VALUE;
    PSECURITY_DESCRIPTOR original = nullptr;
    PACL oldDacl = nullptr;
    SECURITY_DESCRIPTOR_CONTROL control{};
    DWORD revision = 0;
    bool changed = false;
    bool Deny(const wchar_t* path, const wchar_t* descriptor) {
        handle = OpenAclHandle(path);
        if (handle == INVALID_HANDLE_VALUE ||
            GetSecurityInfo(handle, SE_FILE_OBJECT, DACL_SECURITY_INFORMATION, nullptr, nullptr, &oldDacl, nullptr, &original) ||
            !GetSecurityDescriptorControl(original, &control, &revision)) return false;
        PSECURITY_DESCRIPTOR replacement = nullptr;
        if (!ConvertStringSecurityDescriptorToSecurityDescriptorW(descriptor, SDDL_REVISION_1, &replacement, nullptr)) return false;
        PACL dacl = nullptr; BOOL present = FALSE, defaulted = FALSE;
        const bool valid = GetSecurityDescriptorDacl(replacement, &present, &dacl, &defaulted) && present;
        changed = valid && !SetSecurityInfo(handle, SE_FILE_OBJECT, DACL_SECURITY_INFORMATION | PROTECTED_DACL_SECURITY_INFORMATION,
                                            nullptr, nullptr, dacl, nullptr);
        LocalFree(replacement);
        return changed;
    }
    bool Restore() {
        if (!changed) return true;
        const auto protection = (control & SE_DACL_PROTECTED) ? PROTECTED_DACL_SECURITY_INFORMATION : UNPROTECTED_DACL_SECURITY_INFORMATION;
        if (SetSecurityInfo(handle, SE_FILE_OBJECT, DACL_SECURITY_INFORMATION | protection, nullptr, nullptr, oldDacl, nullptr)) return false;
        changed = false;
        return true;
    }
    ~RealFileAcl() { Restore(); if (handle != INVALID_HANDLE_VALUE) CloseRealHandle(handle); if (original) LocalFree(original); }
};
#undef PostMessage
#define PostMessage FakePost
#define GetDriveTypeW FakeDrive
#define GetVolumeInformationW FakeVolume
#define GetFileAttributesW FakeAttributes
#define CreateFileW FakeCreate
#define CloseHandle FakeClose
#define InvalidateRect FakeInvalidate
#define QueueUserWorkItem FakeQueue

@@NEW_RUN@@
@@LOCAL_PARENT@@
