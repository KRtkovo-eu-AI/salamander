static std::vector<std::string> SeenPaths,Order;
static constexpr int ptDisk=1,ptZIPArchive=2,ptPluginFS=3,IDS_TOOLONGNAME=1,IDS_ERRORCHANGINGDIR=2,IDS_FILEISNOTARCHIVE=3,CM_PROPERTIES=4;
