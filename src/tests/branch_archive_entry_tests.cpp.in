struct MainFacade {HWND HWindow=NULL;} Main;static MainFacade* MainWindow=&Main;
struct CPluginData;
struct ArchiverFacade {CPluginData* Owner;BOOL NotEmpty(){return TRUE;}BOOL CanOpenArchive(const char*);};
struct CPluginData {
 const char* DLLName;BOOL SupportPanelView=TRUE;DWORD BuiltForVersion=SAL_SDK_VER_CANOPENARCHIVE;BOOL LoadOK=TRUE;
 ArchiverFacade PluginIfaceForArchiver;
 explicit CPluginData(const char* name):DLLName(name),PluginIfaceForArchiver{this}{}
 BOOL InitDLL(HWND,BOOL,BOOL){++InitCalls;return LoadOK;}
 BOOL CanOpenArchive(const char*);
};
static CPluginData Zip("zip\\zip.spl"),Seven("7zip\\7zip.spl"),Old("legacy\\old.spl");
BOOL ArchiverFacade::CanOpenArchive(const char* name) {
 ++EngineCalls;Order.emplace_back(Owner->DLLName);std::string owned(name);SeenPaths.push_back(owned);
 if(Callback){auto callback=Callback;Callback=nullptr;callback();}
 // The actual ZIP content probe does real wide I/O. 7-Zip is an explicit double
 // here; actual 7-Zip archive listing is covered by the GUI runtime separately.
 CheckCallback=nullptr;
 return Owner==&Zip?ZipProbe().CanOpenArchive(owned.c_str()):FALSE;
}
