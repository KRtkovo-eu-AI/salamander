static BOOL SalCheckAndRestorePathWithCut(HWND,char* path,BOOL& tryNet,DWORD& err,DWORD& last,BOOL& invalid,BOOL& cut,BOOL noReconnect){++UnloadChecks;UnloadPath=path;err=last=0;invalid=cut=FALSE;return !tryNet&&noReconnect&&UnloadCheckOK;}
static const char* LoadStr(int){return "fixture";}
