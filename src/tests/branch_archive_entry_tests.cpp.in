struct HeaderFS {const char* GetPluginFSName(){return "fixture";}BOOL NotEmpty(){return FALSE;}BOOL GetCurrentPath(char*){return FALSE;}void* GetInterface(){return nullptr;}HeaderFS* GetPluginInterfaceForFS(){return this;}int GetPluginFSNameIndex(){return 0;}void ConvertPathToExternal(const char*,int,char*){}};
class CFilesWindow {
public:
 HeaderFS PluginFS;
 BOOL GetGeneralPath(char*,int,BOOL=FALSE);
 BOOL TestUnloadUsed(HWND parent){BOOL used=TRUE; @@UNLOAD_USED@@ return TRUE;}
 void ChangePathToDisk(HWND,const char* path,int,void*,void*,BOOL,BOOL,BOOL,void*,BOOL,int){++UnloadChanges;UnloadPath=path;if(UnloadChangeOK){Disk=TRUE;ArchiveView=FSView=FALSE;}}
 void ChangeToRescuePathOrFixedDrive(HWND,void*,BOOL,BOOL,int){++UnloadRescues;if(UnloadChangeOK){Disk=TRUE;ArchiveView=FSView=FALSE;}}
 HeaderHistory History;HeaderHistory* PathHistory=&History;HeaderText Header;HeaderText* DirectoryLine=&Header;
 HeaderFilter Filter;BOOL FilterEnabled=FALSE;HeaderParent HeaderOwner;HeaderParent* Parent=&HeaderOwner;HeaderFS FS;
 BOOL ArchiveView=FALSE,FSView=FALSE;std::string ArchiveName,ArchiveInside;
 HeaderFS* GetPluginFS(){return &FS;}const char* GetZIPPath(){return ArchiveInside.c_str();}
 const char* GetBranchViewStatusText(){return "ready";}
 void DirectoryLineSetText();
 BOOL Branch=TRUE,Disk=TRUE,Current=TRUE;ULONGLONG Generation=1;HWND HWindow=NULL;
 Rows FileStorage,DirStorage;Rows* Files=&FileStorage;Rows* Dirs=&DirStorage;
 ListFacade List;ListFacade* ListBox=&List;TopMemory TopIndexMem;
 std::wstring RootW;std::string Root;DWORD PathError=ERROR_SUCCESS;
 int Began=0,Ended=0,Refreshes=0,Changes=0,Executes=0;BOOL ChangeOK=TRUE,ChangeNoChange=TRUE,SkipNoChangeWrite=FALSE;
 std::string ChangedPath;CPluginData* Forced=nullptr;
 void Set(const std::wstring& root,const std::wstring& full){RootW=root;Root=SalWideToMultiBytePath(root.c_str(),CP_UTF8);FileStorage.Values={{"same.data",full,FALSE}};FileStorage.Count=1;}
 BOOL Is(int type){return (Disk&&type==ptDisk)||(ArchiveView&&type==ptZIPArchive)||(FSView&&type==ptPluginFS);}BOOL IsBranchView(){return Branch;}
 const char* GetPath(){return Root.c_str();}const wchar_t* GetPathW(){return RootW.c_str();}
 const char* GetItemCacheKeyPtr(const CFileData& file){return file.Key.c_str();}
 const CFileData* GetBranchViewFileByCacheKey(const char* key){return Current&&Files->Count==1&&Files->At(0).Key==key?&Files->At(0):nullptr;}
 std::wstring GetItemFullPathW(const CFileData& file){return file.Full;}
 ULONGLONG GetBranchViewGeneration(){return Generation;}
 void BeginStopRefresh(){++Began;}void EndStopRefresh(){++Ended;}
 DWORD CheckPath(BOOL){if(CheckCallback){auto c=CheckCallback;CheckCallback=nullptr;c();}return PathError;}
 void RefreshDirectory(){++Refreshes;}int GetCaretIndex(){return 0;}BOOL IsNethoodFS(){return FALSE;}
 const char* GetZIPArchive(){return ArchiveName.c_str();}CPluginData* GetPluginDataForPluginIface(){return nullptr;}
 void Execute(int){++Executes;}
 BOOL ChangePathToArchive(const char* path,const char*,int,const char*,BOOL,BOOL* unchanged,BOOL,int*,BOOL,BOOL,BOOL,CPluginData* forced){
  ++Changes;ChangedPath=path;Forced=forced;if(!SkipNoChangeWrite)*unchanged=ChangeNoChange;
  if(ChangeOK){ArchiveView=TRUE;ArchiveName=path;Branch=FALSE;Disk=FALSE;RootW=L"archive panel";Root="archive panel";Files->Values.clear();Files->Count=0;}
  return ChangeOK;
 }
 void TryEnterFileAsArchive(int);
 void CtrlPageDnOrEnter(WPARAM);
};
