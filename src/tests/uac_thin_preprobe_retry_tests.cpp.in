// | Date | Summary | Reason | Ticket | Model |
// | 2026-11-14 | Update batch-consent harness for native overwrite and Scan Ahead. | Keep actual worker session-selection tests current. | #731 | gpt-6.1-terra |
// | 2026-11-13 | Cover invalid cancellation after handle delivery. | Reject a received handle when cancellation can no longer be observed. | #731 | GPT-6 |
// | 2026-11-13 | Test retained batch consent across copy items. | Reject changed scopes and ambiguous broker outcomes. | #731 | GPT-6 |
// | 2026-11-13 | Model experimental planned custody. | Keep retry tests aligned with item-scoped sessions. | #731 | GPT-6 |
// | 2026-11-13 | Cover returned prelaunch classification. | Preserve consent only when the launcher was not entered. | #731 | GPT-6 |
// | 2026-11-13 | Test retry after pre-probe errors. | Keep consent and never restart an uncertain scoped operation. | #731 | GPT-6 |
#include <windows.h>
#include <algorithm>
#include <cstdio>
#include <cstring>
#include <list>
#include <memory>
#include <new>
#include <optional>
#include <string>

namespace UacF7 {
enum class ThinOpenKind { Source, TargetCreate, TargetRetry, TargetProbe, TargetOverwrite, TargetReopenWrite };
enum class TransferPromptKind { ThinPlainCopy };
struct MoveFileIdentity { ULONGLONG serial = 0; unsigned char id[16]{}; };
struct ArchiveRevision { DWORD attributes = 0; };
struct ThinScanEvidence {
    enum class Kind { None, LegacyIdentity, Revision };
    Kind kind = Kind::None;
    ArchiveRevision revision{};
    DWORD legacyVolume = 0;
    ULONGLONG legacyIndex = 0;
};
enum class Operation { Copy, Move, Metadata };
static Operation TransferJobFamily(Operation operation) { return operation; }
static bool IsSpecialTimestampFile(DWORD) { return false; }
struct TransferJobScope {
    struct Parent { ULONGLONG serial = 1; BYTE id[16]{}; };
    struct Policy { DWORD set = 0, clear = 0; };
    struct Change { ULONGLONG created = 0, accessed = 0, modified = 0; DWORD expectedAttributes = 0; };
    Operation operation = Operation::Copy;
    Parent source{}, target{};
    std::wstring sourcePath = L"source", targetPath = L"target", targetSuffix{};
    Policy policy{}; Change change{};
@@SCOPE_MATCHES@@
};
static bool failScope = false;
struct PreparedTransfer {
    TransferJobScope scope{};
    bool shareable = true, tree = false;
    bool CanShareJob() const { return shareable; }
    bool IsScopedTree() const { return tree; }
    TransferJobScope ThinBatchScope() const { if (failScope) throw std::bad_alloc(); return scope; }
};
struct ThinOpenedSource { HANDLE value; };
struct ThinCancelEvent { HANDLE value; };
struct ThinOpenResult {
    HANDLE file = INVALID_HANDLE_VALUE;
    DWORD error = ERROR_GEN_FAILURE;
    bool declined = false, unknown = false, preProbeFailure = false;
    MoveFileIdentity targetIdentity{};
};
struct TransferPrompt {
    PreparedTransfer& request;
    const char* source;
    const char* target;
    bool targetDenied;
    bool approved = false;
    DWORD promptError = ERROR_SUCCESS;
    TransferPromptKind kind = TransferPromptKind::ThinPlainCopy;
    bool batchScopeShownAndApproved = false;
};
static ThinOpenResult nextResult;
static int opens = 0;
static bool scanCaptured = false;
static ThinScanEvidence capturedScan{};
static bool nextSessionOpen = false;
static bool cancelDuringOpen = false, invalidateDuringOpen = false;
struct ThinCopySession {
    bool isOpen = false, matches = false;
    bool IsOpen() const { return isOpen; }
    bool Matches(const PreparedTransfer&) const { return matches; }
    bool Attach(ThinCopySession&, const PreparedTransfer&) { return false; }
    bool TakePlanned(std::unique_ptr<ThinCopySession>&, const PreparedTransfer&) { return false; }
    ThinOpenResult Open(HWND, const PreparedTransfer&, ThinOpenKind, bool, bool,
                        const MoveFileIdentity*, ThinOpenedSource, ThinCancelEvent cancel,
                        const ThinScanEvidence* scan) {
        ++opens; isOpen = nextSessionOpen;
        scanCaptured = scan != nullptr; if (scan) capturedScan = *scan;
        if (cancelDuringOpen) SetEvent(cancel.value);
        if (invalidateDuringOpen) CloseHandle(cancel.value);
        return nextResult;
    }
};
}
struct SourcePlan { std::unique_ptr<UacF7::ThinCopySession> Session; };
struct Script { SourcePlan* CopySource = nullptr; int Count = 1; };
struct Operation { std::wstring SourceNameW = L"source", TargetNameW = L"target"; UacF7::ArchiveRevision ScannedTargetRevision{}; };
static HANDLE testEvent = nullptr;
struct Dialog { std::list<UacF7::ThinCopySession> ThinCopyJobs; std::optional<UacF7::TransferJobScope> PendingThinConsent; BOOL* CancelWorker = nullptr; HANDLE CancelWorkerEvent = testEvent; bool ConflictDecisionInjected = false, InjectedTargetIdentityValid = false; DWORD InjectedTargetVolumeSerial = 0; ULONGLONG InjectedTargetFileIndex = 0; };
constexpr UINT WM_USER_DIALOG = WM_USER + 42;
constexpr WPARAM WORKER_DIALOG_UAC_TRANSFER = 1;
static int prompts = 0, reported = 0, waits = 0;
static bool approval = true, waitOkay = true, scopeShown = false;
static std::wstring SalPathRemoveExtendedPrefixW(const wchar_t* value) { return value; }
static std::string SalWideToMultiBytePath(const wchar_t*, UINT) { return "path"; }
#undef SendMessage
#define SendMessage Prompt
static LRESULT Prompt(HWND, UINT, WPARAM, LPARAM value) {
    ++prompts;
    auto* prompt = reinterpret_cast<UacF7::TransferPrompt*>(value);
    prompt->approved = approval;
    prompt->batchScopeShownAndApproved = approval && scopeShown;
    return 0;
}
static void ThinCopyTestHandleGate(UacF7::ThinOpenKind, HANDLE) {}
struct CThinCopyWorker {
    Dialog dialog;
    Script script;
    Operation operation;
    HWND progress = nullptr;
    HANDLE* sourceHandle = nullptr;
    std::unique_ptr<UacF7::PreparedTransfer> request = std::make_unique<UacF7::PreparedTransfer>();
    UacF7::ThinCopySession* session = nullptr;
    UacF7::ThinCopySession plannedSession;
    SourcePlan* claimedPlan = nullptr;
    bool plannedTaken = false;
    UacF7::MoveFileIdentity target{};
    bool active = true, terminal = false, sourceVerified = true, targetKnown = true;
    bool scopeMayHaveStarted = false, pendingConsent = false, brokerHandleDelivered = false, targetCreatedByBroker = false, batchScopeApproved = false, nativeTargetOverwrite = false;
    bool WaitBeforeElevation() {
        ++waits;
        if (CancelBeforeElevation()) return false;
        if (!waitOkay) SetLastError(ERROR_INVALID_HANDLE);
        return waitOkay;
    }
    bool EnsurePrepared() { return true; }
    bool CancelBeforeElevation() {
        if (!*dialog.CancelWorker && WaitForSingleObject(dialog.CancelWorkerEvent, 0) != WAIT_OBJECT_0) return false;
        terminal = true; SetLastError(ERROR_CANCELLED); return true;
    }
    HANDLE CancelReceivedHandle(UacF7::ThinOpenKind, HANDLE, DWORD reason = ERROR_CANCELLED) { terminal = true; SetLastError(reason); return INVALID_HANDLE_VALUE; }
    bool ReportTargetFailure(DWORD) { ++reported; terminal = true; return false; }
    HANDLE Open(UacF7::ThinOpenKind kind, bool overlapped);
};
@@ACTUAL_OPEN@@
struct ProbeJob { bool open = false; int closes = 0; void Close() { ++closes; open = false; } };
struct ProbeHarness {
    int markersCleared = 0;
    void ClearMarker() { ++markersCleared; }
    UacF7::ThinOpenResult Failure(ProbeJob* job, bool preProbeEligible, bool transportEntered) {
        UacF7::ThinOpenResult output;
        try { throw std::bad_alloc(); }
@@ACTUAL_TRANSPORT_CATCH@@
    }
};
enum { Ok, Failed, Cancelled };
struct ProbeResult { DWORD error = ERROR_GEN_FAILURE; bool unknown = false; };
static bool ReturnedPrelaunch(DWORD error, bool unknown, int launched, bool transportEntered, bool preProbeEligible) {
    UacF7::ThinOpenResult output;
    ProbeResult result{error, unknown};
@@ACTUAL_RETURN_CLASSIFICATION@@
    return output.preProbeFailure;
}
static void Check(bool value, const char* label, int& failures) {
    std::printf("%s %s\n", value ? "PASS" : "FAIL", label); if (!value) ++failures;
}
static void Reset() {
    prompts = reported = waits = UacF7::opens = 0; approval = waitOkay = true; scopeShown = false; UacF7::failScope = false;
    UacF7::nextResult = {}; UacF7::nextSessionOpen = false;
    UacF7::scanCaptured = false; UacF7::capturedScan = {};
    UacF7::cancelDuringOpen = UacF7::invalidateDuringOpen = false;
}
int main() {
    int failures = 0; BOOL cancelled = FALSE;
    testEvent = CreateEventW(nullptr, TRUE, FALSE, nullptr);
    if (!testEvent) return 2;
    const HANDLE file = reinterpret_cast<HANDLE>(static_cast<ULONG_PTR>(0x1234));
    {
        Reset(); CThinCopyWorker worker; worker.dialog.CancelWorker = &cancelled;
        UacF7::nextResult.error = ERROR_NOT_ENOUGH_MEMORY; UacF7::nextResult.preProbeFailure = true;
        Check(worker.Open(UacF7::ThinOpenKind::Source, false) == INVALID_HANDLE_VALUE &&
              GetLastError() == ERROR_NOT_ENOUGH_MEMORY && worker.pendingConsent && !worker.scopeMayHaveStarted &&
              worker.session && prompts == 1 && UacF7::opens == 1, "pre-probe failure keeps approved consent", failures);
        UacF7::nextResult = {}; UacF7::nextResult.file = file; UacF7::nextResult.error = ERROR_SUCCESS;
        UacF7::nextSessionOpen = true;
        Check(worker.Open(UacF7::ThinOpenKind::Source, false) == file && !worker.pendingConsent &&
              worker.scopeMayHaveStarted && worker.brokerHandleDelivered && prompts == 1 && UacF7::opens == 2,
              "retry uses same approved session without a second prompt", failures);
        UacF7::nextSessionOpen = false; worker.session->isOpen = false;
        Check(worker.Open(UacF7::ThinOpenKind::Source, false) == INVALID_HANDLE_VALUE &&
              GetLastError() == ERROR_BROKEN_PIPE && worker.terminal && UacF7::opens == 2,
              "closed previously started session cannot restart", failures);
    }
    {
        Reset(); CThinCopyWorker worker; worker.dialog.CancelWorker = &cancelled;
        UacF7::nextResult.error = ERROR_NOT_ENOUGH_MEMORY; UacF7::nextResult.preProbeFailure = true;
        if (worker.Open(UacF7::ThinOpenKind::Source, false) != INVALID_HANDLE_VALUE) return 4;
        waitOkay = false;
        Check(worker.Open(UacF7::ThinOpenKind::Source, false) == INVALID_HANDLE_VALUE &&
              GetLastError() == ERROR_INVALID_HANDLE && worker.pendingConsent && !worker.scopeMayHaveStarted &&
              prompts == 1 && UacF7::opens == 1, "wait failure preserves pending consent without broker", failures);
        waitOkay = true; UacF7::nextResult.file = file; UacF7::nextResult.error = ERROR_SUCCESS;
        UacF7::nextResult.preProbeFailure = false; UacF7::nextSessionOpen = true;
        Check(worker.Open(UacF7::ThinOpenKind::Source, false) == file && prompts == 1 && UacF7::opens == 2,
              "retry after wait recovery reuses pending consent", failures);
    }
    {
        Reset(); CThinCopyWorker worker; worker.dialog.CancelWorker = &cancelled;
        UacF7::nextResult.error = ERROR_NOT_ENOUGH_MEMORY; UacF7::nextResult.preProbeFailure = true;
        if (worker.Open(UacF7::ThinOpenKind::Source, false) != INVALID_HANDLE_VALUE) return 4;
        if (!SetEvent(testEvent)) return 5;
        Check(worker.Open(UacF7::ThinOpenKind::Source, false) == INVALID_HANDLE_VALUE &&
              GetLastError() == ERROR_CANCELLED && worker.terminal && UacF7::opens == 1 && prompts == 1,
              "cancellation while pending never starts broker", failures);
        if (!ResetEvent(testEvent)) return 6;
    }
    {
        Reset(); CThinCopyWorker worker; worker.dialog.CancelWorker = &cancelled;
        UacF7::nextResult.error = ERROR_NOT_ENOUGH_MEMORY; UacF7::nextResult.preProbeFailure = true;
        UacF7::cancelDuringOpen = true;
        Check(worker.Open(UacF7::ThinOpenKind::Source, false) == INVALID_HANDLE_VALUE &&
              GetLastError() == ERROR_CANCELLED && worker.terminal && !worker.pendingConsent &&
              worker.scopeMayHaveStarted && UacF7::opens == 1,
              "cancel during prelaunch error prevents pending restoration", failures);
        if (!ResetEvent(testEvent)) return 7;
    }
    {
        Reset(); CThinCopyWorker worker; worker.dialog.CancelWorker = &cancelled;
        worker.dialog.CancelWorkerEvent = CreateEventW(nullptr, TRUE, FALSE, nullptr);
        if (!worker.dialog.CancelWorkerEvent) return 8;
        UacF7::nextResult.error = ERROR_NOT_ENOUGH_MEMORY; UacF7::nextResult.preProbeFailure = true;
        UacF7::invalidateDuringOpen = true;
        Check(worker.Open(UacF7::ThinOpenKind::Source, false) == INVALID_HANDLE_VALUE &&
              GetLastError() == ERROR_INVALID_HANDLE && !worker.pendingConsent && worker.scopeMayHaveStarted &&
              UacF7::opens == 1, "invalid cancel event prevents pending restoration", failures);
    }
    {
        Reset(); CThinCopyWorker worker; worker.dialog.CancelWorker = &cancelled;
        worker.dialog.CancelWorkerEvent = CreateEventW(nullptr, TRUE, FALSE, nullptr);
        if (!worker.dialog.CancelWorkerEvent) return 8;
        UacF7::nextResult.error = ERROR_SUCCESS; UacF7::nextResult.file = file;
        UacF7::nextSessionOpen = true; UacF7::invalidateDuringOpen = true;
        Check(worker.Open(UacF7::ThinOpenKind::Source, false) == INVALID_HANDLE_VALUE &&
              GetLastError() == ERROR_INVALID_HANDLE && worker.terminal && worker.brokerHandleDelivered,
              "invalid cancel event rejects an already received handle", failures);
    }
    for (int mode = 0; mode < 4; ++mode) {
        Reset(); CThinCopyWorker worker; worker.dialog.CancelWorker = &cancelled;
        if (mode == 0) worker.scopeMayHaveStarted = true;
        if (mode == 1) worker.brokerHandleDelivered = true;
        if (mode == 2) worker.targetCreatedByBroker = true;
        if (mode == 3) UacF7::nextSessionOpen = true;
        UacF7::nextResult.error = ERROR_NOT_ENOUGH_MEMORY; UacF7::nextResult.preProbeFailure = true;
        Check(worker.Open(UacF7::ThinOpenKind::Source, false) == INVALID_HANDLE_VALUE &&
              !worker.pendingConsent && worker.scopeMayHaveStarted,
              "defensive gate rejects a previously used or open scope", failures);
    }
    {
        Reset(); CThinCopyWorker worker; worker.dialog.CancelWorker = &cancelled;
        UacF7::nextResult.error = ERROR_NOT_ENOUGH_MEMORY; UacF7::nextResult.unknown = true;
        Check(worker.Open(UacF7::ThinOpenKind::Source, false) == INVALID_HANDLE_VALUE &&
              GetLastError() == ERROR_PARTIAL_COPY && worker.terminal && !worker.pendingConsent &&
              worker.scopeMayHaveStarted && reported == 1, "unknown result is terminal", failures);
    }
    {
        Reset(); CThinCopyWorker worker; worker.dialog.CancelWorker = &cancelled;
        UacF7::nextResult.error = ERROR_CANCELLED; UacF7::nextResult.declined = true;
        Check(worker.Open(UacF7::ThinOpenKind::Source, false) == INVALID_HANDLE_VALUE &&
              GetLastError() == ERROR_CANCELLED && worker.terminal && !worker.pendingConsent,
              "declined elevation is terminal", failures);
    }
    {
        Reset(); CThinCopyWorker worker; worker.dialog.CancelWorker = &cancelled;
        UacF7::ThinCopySession prior{}; prior.isOpen = true; prior.matches = true;
        worker.dialog.ThinCopyJobs.push_back(prior);
        UacF7::nextResult.error = ERROR_NOT_ENOUGH_MEMORY; UacF7::nextResult.preProbeFailure = true;
        Check(worker.Open(UacF7::ThinOpenKind::Source, false) == INVALID_HANDLE_VALUE &&
              worker.scopeMayHaveStarted && !worker.pendingConsent && prompts == 0,
              "existing batch session never becomes pre-probe again", failures);
    }
    for (bool matching : {true, false}) {
        Reset(); scopeShown = true; UacF7::nextSessionOpen = true;
        UacF7::nextResult.error = ERROR_SUCCESS; UacF7::nextResult.file = file;
        CThinCopyWorker first; first.dialog.CancelWorker = &cancelled; first.script.Count = 2;
        const bool firstOpened = first.Open(UacF7::ThinOpenKind::Source, false) == file && prompts == 1 &&
                                 first.dialog.ThinCopyJobs.size() == 1;
        if (!firstOpened) { Check(false, "first batch item opens a session", failures); continue; }
        first.dialog.ThinCopyJobs.front().matches = matching;
        CThinCopyWorker next; next.dialog.CancelWorker = &cancelled; next.script.Count = 2;
        next.dialog.ThinCopyJobs.splice(next.dialog.ThinCopyJobs.end(), first.dialog.ThinCopyJobs);
        const bool opened = next.Open(UacF7::ThinOpenKind::Source, false) == file;
        Check(opened && prompts == (matching ? 1 : 2) && UacF7::opens == 2 &&
              next.dialog.ThinCopyJobs.size() == (matching ? 1u : 2u),
              matching ? "next matching item reuses the live batch session without another prompt" :
                         "nonmatching item obtains a separate consent and session", failures);
    }
    for (bool revision : {false, true}) {
        Reset(); UacF7::nextSessionOpen = true;
        UacF7::nextResult.error = ERROR_SUCCESS; UacF7::nextResult.file = file;
        CThinCopyWorker worker; worker.dialog.CancelWorker = &cancelled;
        HANDLE source = file; worker.sourceHandle = &source;
        worker.dialog.ConflictDecisionInjected = worker.dialog.InjectedTargetIdentityValid = true;
        worker.dialog.InjectedTargetVolumeSerial = 37; worker.dialog.InjectedTargetFileIndex = 123;
        worker.operation.ScannedTargetRevision.attributes = revision ? FILE_ATTRIBUTE_ARCHIVE : 0;
        const bool opened = worker.Open(UacF7::ThinOpenKind::TargetOverwrite, false) == file;
        Check(opened && UacF7::scanCaptured &&
              (revision ? UacF7::capturedScan.kind == UacF7::ThinScanEvidence::Kind::Revision &&
                          UacF7::capturedScan.revision.attributes == FILE_ATTRIBUTE_ARCHIVE :
                          UacF7::capturedScan.kind == UacF7::ThinScanEvidence::Kind::LegacyIdentity &&
                          UacF7::capturedScan.legacyVolume == 37 && UacF7::capturedScan.legacyIndex == 123),
              "deferred overwrite forwards its native Scan Ahead evidence", failures);
    }
    for (int missing = 0; missing < 2; ++missing) {
        Reset(); UacF7::nextSessionOpen = true;
        UacF7::nextResult.error = ERROR_SUCCESS; UacF7::nextResult.file = file;
        CThinCopyWorker worker; worker.dialog.CancelWorker = &cancelled;
        HANDLE source = file; worker.sourceHandle = &source;
        worker.dialog.ConflictDecisionInjected = missing != 0;
        worker.dialog.InjectedTargetIdentityValid = missing != 1;
        worker.operation.ScannedTargetRevision.attributes = FILE_ATTRIBUTE_ARCHIVE;
        Check(worker.Open(UacF7::ThinOpenKind::TargetOverwrite, false) == file && !UacF7::scanCaptured,
              "ordinary overwrite does not acquire a deferred Scan Ahead check", failures);
    }
    {
        Reset(); scopeShown = true;
        CThinCopyWorker first; first.dialog.CancelWorker = &cancelled; first.script.Count = 2;
        UacF7::nextResult.error = ERROR_NOT_ENOUGH_MEMORY; UacF7::nextResult.preProbeFailure = true;
        first.Open(UacF7::ThinOpenKind::Source, false);
        Check(first.dialog.PendingThinConsent.has_value() && prompts == 1,
              "displayed batch scope saved after proven prelaunch failure", failures);
        CThinCopyWorker next; next.dialog.CancelWorker = &cancelled; next.script.Count = 2;
        next.dialog.PendingThinConsent = std::move(first.dialog.PendingThinConsent);
        UacF7::nextResult = {}; UacF7::nextResult.file = file; UacF7::nextResult.error = ERROR_SUCCESS;
        UacF7::nextSessionOpen = true;
        Check(next.Open(UacF7::ThinOpenKind::Source, false) == file && prompts == 1 &&
              !next.dialog.PendingThinConsent && next.scopeMayHaveStarted,
              "next same-scope item reuses only displayed consent and consumes it before launch", failures);
    }
    for (int changed = 0; changed < 6; ++changed) {
        Reset(); scopeShown = true;
        CThinCopyWorker first; first.dialog.CancelWorker = &cancelled; first.script.Count = 2;
        UacF7::nextResult.error = ERROR_NOT_ENOUGH_MEMORY; UacF7::nextResult.preProbeFailure = true;
        first.Open(UacF7::ThinOpenKind::Source, false);
        CThinCopyWorker next; next.dialog.CancelWorker = &cancelled; next.script.Count = 2;
        next.dialog.PendingThinConsent = std::move(first.dialog.PendingThinConsent);
        auto& scope = next.request->scope;
        if (changed == 0) ++scope.source.serial;
        if (changed == 1) ++scope.source.id[0];
        if (changed == 2) ++scope.target.id[0];
        if (changed == 3) scope.sourcePath += L"different";
        if (changed == 4) scope.targetSuffix = L"different";
        if (changed == 5) scope.operation = UacF7::Operation::Move;
        approval = false;
        next.Open(UacF7::ThinOpenKind::Source, false);
        Check(prompts == 2 && next.terminal && !next.dialog.PendingThinConsent,
              "changed scope requires new consent and refusal clears it", failures);
    }
    for (int mode = 0; mode < 4; ++mode) {
        Reset(); scopeShown = true;
        CThinCopyWorker worker; worker.dialog.CancelWorker = &cancelled; worker.script.Count = 2;
        UacF7::nextResult.error = ERROR_NOT_ENOUGH_MEMORY; UacF7::nextResult.preProbeFailure = true;
        if (mode == 0) scopeShown = false; // shielded OK, no displayed batch scope
        if (mode == 1) worker.script.Count = 1;
        if (mode == 2) worker.request->tree = true;
        if (mode == 3) UacF7::failScope = true;
        worker.Open(UacF7::ThinOpenKind::Source, false);
        Check(!worker.dialog.PendingThinConsent, "undisclosed, single, tree or unallocatable scope is not saved", failures);
    }
    for (int mode = 0; mode < 4; ++mode) {
        Reset(); scopeShown = true;
        CThinCopyWorker worker; worker.dialog.CancelWorker = &cancelled; worker.script.Count = 2;
        UacF7::nextResult.error = mode == 1 || mode == 3 ? ERROR_CANCELLED : ERROR_NOT_ENOUGH_MEMORY;
        UacF7::nextResult.unknown = mode == 0;
        UacF7::nextResult.declined = mode == 1;
        UacF7::nextSessionOpen = mode == 2;
        UacF7::nextResult.preProbeFailure = true;
        worker.Open(UacF7::ThinOpenKind::Source, false);
        Check(!worker.dialog.PendingThinConsent, "unknown, cancellation, refusal or started job cannot restore batch consent", failures);
    }
    {
        Reset(); scopeShown = true;
        CThinCopyWorker worker; worker.dialog.CancelWorker = &cancelled; worker.script.Count = 2;
        worker.dialog.PendingThinConsent.emplace(); UacF7::failScope = true;
        worker.Open(UacF7::ThinOpenKind::Source, false);
        Check(GetLastError() == ERROR_NOT_ENOUGH_MEMORY && !worker.dialog.PendingThinConsent && !prompts,
              "scope comparison OOM discards pending authority", failures);
    }
    {
        ProbeHarness probe; ProbeJob job{};
        const auto result = probe.Failure(&job, true, false);
        Check(result.error == ERROR_NOT_ENOUGH_MEMORY && result.preProbeFailure && !result.unknown &&
              !job.closes && !probe.markersCleared, "pre-transport OOM keeps fresh consent", failures);
    }
    {
        ProbeHarness probe; ProbeJob job{}; job.open = true;
        const auto result = probe.Failure(&job, false, false);
        Check(result.error == ERROR_NOT_ENOUGH_MEMORY && !result.preProbeFailure && !result.unknown &&
              job.open && !job.closes && !probe.markersCleared, "pre-transport OOM preserves live batch session", failures);
    }
    for (bool live : {false, true}) {
        ProbeHarness probe; ProbeJob job{}; job.open = live;
        const auto result = probe.Failure(&job, false, true);
        Check(result.error == ERROR_NOT_ENOUGH_MEMORY && !result.preProbeFailure && result.unknown &&
              !job.open && job.closes == 1 && probe.markersCleared == 1,
              live ? "OOM after sending on existing transport is unknown" :
                     "OOM after entering new probe is unknown", failures);
    }
    Check(ReturnedPrelaunch(ERROR_GEN_FAILURE, false, Failed, false, true), "returned prelaunch failure is retryable", failures);
    Check(!ReturnedPrelaunch(ERROR_CANCELLED, false, Cancelled, false, true), "cancelled prelaunch is not retryable", failures);
    Check(!ReturnedPrelaunch(ERROR_GEN_FAILURE, false, Failed, true, true), "entered launcher is not prelaunch", failures);
    Check(!ReturnedPrelaunch(ERROR_GEN_FAILURE, true, Failed, false, true), "unknown result is not prelaunch", failures);
    Check(!ReturnedPrelaunch(ERROR_GEN_FAILURE, false, Failed, false, false), "ineligible scope is not prelaunch", failures);
    Check(!ReturnedPrelaunch(ERROR_SUCCESS, false, Ok, false, true), "success is not prelaunch failure", failures);
    if (!CloseHandle(testEvent)) return 3;
    return failures ? 1 : 0;
}
