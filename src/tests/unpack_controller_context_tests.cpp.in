class CUnpackDialog {
 char* Path;BOOL* Delete;CWholeArchiveUnpackerSnapshot Displayed;
public:
 CUnpackDialog(HWND,char* path,int,const char*,char*,CTruncatedString*,CUnpackerConfig*,BOOL* del,BOOL allow=TRUE):Path(path),Delete(del){ModalAllowsDelete=allow;Check(Displayed.Capture(&UnpackerConfig,TRUE),"capture displayed modal choice facade");}
 int Execute(){++Dialogs;if(!ManualPath.empty())strcpy(Path,ManualPath.c_str());*Delete=RequestDelete;if(OnDialog)OnDialog();return DialogResult;}
 bool IsSelectionCurrent() const{return Displayed.IsCurrent();}
};
