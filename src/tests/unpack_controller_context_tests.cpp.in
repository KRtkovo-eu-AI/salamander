  ExpectedSource=SalWideToMultiBytePath(source.FileStore.Item.Full.c_str(),CP_UTF8);ExpectedTarget=SalWideToMultiBytePath(target.Root.c_str(),CP_UTF8);
  const auto list=[](const std::string& s){return s+std::string(1,0);};
  if(scenario==1)DialogResult=IDCANCEL;
  if(scenario==2)BackendOK=FALSE;
  if(scenario==3){CustomVolumes=TRUE;ReturnedVolumes=list(ExpectedSource)+"unterminated";}
