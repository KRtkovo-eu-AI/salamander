static void Row(CUnpackerConfigData& row,bool external=false){row.Type=external?0:-1;row.Title=_strdup("selected");row.Ext=_strdup("7z");if(external){row.CmdExecExtract=_strdup("own-external");row.CmdArgsExtract=_strdup("args");row.SupportLongNames=TRUE;}}
static void Reset(){
 Check(StopDepth==0&&PriorityDepth==0,"prior controller invocation left no refresh/priority imbalance");
 Begins=Ends=PriorityChanges=Creates=Cleanups=Resolves=Dialogs=Updates=Notifications=Messages=FocusPosts=0;
 NotificationPaths.clear();SDKCalls=ExternalCalls=MoveCalls=OperationContexts=DeletedVolumes=CloseCalls=0;
 VolumePaths.clear();DeletedPaths.clear();ReturnedVolumes.clear();ReturnedVolumeStorage=nullptr;CustomVolumes=BadVolumeCapacity=FALSE;VolumeAttributesCalls=VolumeSetCalls=FileErrors=DeleteFailures=0;VolumeAttributeError=0;VolumeDeleteError=ERROR_SHARING_VIOLATION;VolumeFlags=FILE_ATTRIBUTE_NORMAL;FileResponses.clear();OnFileError=nullptr;LastAttributePath.clear();RootIsDirectory=TRUE;ExpectedDiskTarget=TRUE;RootExists=CreateOK=ResolveOK=BackendOK=TRUE;RecordNewDirectory=FALSE;DetachedTransitions=0;RequestDelete=FALSE;DialogResult=IDOK;ManualPath.clear();
 OnDialog=OnUpdate=OnCreate=OnInit=OnBackend=OnNotify=OnCheck=OnMove=OnDelete=nullptr;
 Configuration.UseAnotherPanelForUnpack=TRUE;Configuration.UseSubdirNameByArchiveForUnpack=FALSE;
}
int main(){
 for(int external=0;external<2;++external)for(int phase=0;phase<9;++phase)for(int mutation=0;mutation<19;++mutation){
  if((external&&phase==3)||(!external&&phase>=7)||(mutation==18&&phase>2))continue;
  Reset();CFilesWindow source,target,other;source.Root=L"C:\\source";source.Tab=2;target.Root=L"C:\\target";target.Tab=3;other.Tab=4;
  CMainWindow main;MainWindow=&main;main.Left={&source};main.Right={&target};main.LeftPanel=&source;main.RightPanel=&target;
  CUnpackerConfigData row,second;Row(row,external!=0);Row(second,external!=0);CPluginData plugin,foreign;foreign.DLLName="zip\\zip.spl";
  UnpackerConfig.Unpackers.Data={&row,&second};UnpackerConfig.Unpackers.Count=2;UnpackerConfig.PreferedUnpacker=0;Plugins.Data={&plugin};
  ExpectedSource="C:\\source\\archive.7z";ExpectedTarget="C:\\target";bool fired=false;
  auto mutate=[&]{if(fired)return;fired=true;switch(mutation){
   case 1:main.ClosePanelTab(&source);break;case 2:source.Root+=L"\\changed";break;case 3:++source.Tab;break;
   case 4:main.Left.push_back(&other);main.LeftPanel=&other;break;case 5:source.Kind=ptPluginFS;break;case 6:source.Scanning=TRUE;break;
   case 7:main.ClosePanelTab(&target);break;case 8:target.Root+=L"\\changed";break;case 9:++target.Tab;break;
   case 10:main.Right.push_back(&other);main.RightPanel=&other;break;case 11:target.Scanning=TRUE;break;case 12:target.Kind=ptPluginFS;break;
   case 13:source.Branch=TRUE;break;case 14:target.Branch=TRUE;break;case 15:UnpackerConfig.PreferedUnpacker=1;break;
   case 16:free(row.Title);row.Title=_strdup("changed");break;
   case 17:if(external){free(row.CmdArgsExtract);row.CmdArgsExtract=_strdup("changed args");}else Plugins.Data[0]=&foreign;break;
   case 18:RootExists=FALSE;break;
  }};
  if(phase==0)OnDialog=mutate;else if(phase==1)OnUpdate=[&]{if(Updates==1)mutate();};else if(phase==2)OnCreate=mutate;
  else if(phase==3)OnInit=mutate;else if(phase==4)OnBackend=mutate;else if(phase==5)OnNotify=mutate;
  else if(phase==6)OnUpdate=[&]{if(Updates>=2)mutate();};else if(phase==7)OnMove=mutate;else OnCheck=mutate;
  source.Unpack(&target,-1,nullptr,nullptr);
  Check(StopDepth==0&&Begins==1&&Ends==1&&PriorityDepth==0,"all callback paths balance one refresh scope and thread priority");
  Check(source.StaleReads==0&&target.StaleReads==0,"actual controller/snapshot never reads a retired panel getter");
  Check(!source.FilesActionInProgress,"source busy lifetime restored before returning controller");
  if(!NotificationPaths.empty())Check(NotificationPaths.front().first=="C:\\source","post-callback notification keeps original owned source root");
  if(mutation!=0&&phase<=2)Check(SDKCalls==0&&ExternalCalls==0&&MoveCalls==0,"modal/update/create mutation refuses all backend I/O");
  if(mutation!=0&&phase<=1)Check(Creates==0,"modal/update invalidation refuses before directory creation");
  if(mutation!=0&&phase==3)Check(SDKCalls==0&&OperationContexts==0,"InitDLL mutation refuses before SDK context");
  if(mutation==1&&((!external&&phase==4)||(external&&phase>=7)))Check(!source.Retired&&CloseCalls==0,"SDK/MoveFiles callback cannot close protected busy source tab");
  if(mutation!=0&&phase<=4&&!(mutation==1&&!external&&phase==4))Check(FocusPosts==0&&DeletedVolumes==0,"invalid context cannot apply stale focus or delete archive volumes");
  if(mutation==0)Check(SDKCalls+ExternalCalls==1&&FocusPosts==1,"unchanged context completes ordinary whole-archive operation");
 }
 // Additional independent failure/retry/cancel/detached and real path conversion cases.
 for(int scenario=0;scenario<16;++scenario){
  Reset();CFilesWindow source,target;source.Root=L"C:\\source";source.Tab=2;target.Root=L"C:\\target";target.Tab=3;
  CMainWindow main;MainWindow=&main;main.Left={&source};main.Right={&target};main.LeftPanel=&source;main.RightPanel=&target;
  CUnpackerConfigData row;Row(row);CPluginData plugin;UnpackerConfig.Unpackers.Data={&row};UnpackerConfig.Unpackers.Count=1;UnpackerConfig.PreferedUnpacker=0;Plugins.Data={&plugin};
  ExpectedSource="C:\\source\\archive.7z";ExpectedTarget="C:\\target";
  if(scenario==0)DialogResult=IDCANCEL;
  if(scenario==1){DialogResult=IDCANCEL;OnDialog=[&]{main.ClosePanelTab(&source);};}
  if(scenario==2)ResolveOK=FALSE;
  if(scenario==3)CreateOK=FALSE;
  if(scenario==4)BackendOK=FALSE;
  if(scenario==5){ManualPath="C:\\manual";ExpectedTarget=ManualPath;RootExists=FALSE;}
  if(scenario==6){main.Left.clear();main.Right.clear();main.LeftPanel=main.RightPanel=nullptr;main.Detached={&source,&target};}
  if(scenario==7){main.Left.clear();main.Right.clear();main.LeftPanel=main.RightPanel=nullptr;main.Detached={&source,&target};OnDialog=[&]{main.CloseDetachedTab(&target);};}
  if(scenario>=8&&scenario<=11){
   source.Root=L"C:\\rodič-東京\\další-🙂";source.FileStore.Item.NameW=L"soubor-東京-🙂.7z";
   if(scenario==9)target.Root=L"C:\\"+std::wstring(100,L'東');
   if(scenario==10)target.Root=L"C:\\"+std::wstring(140,L'日')+L"\\"+std::wstring(140,L'本');
   if(scenario==11){RequestDelete=TRUE;OnDelete=[&]{main.ClosePanelTab(&source);};}
   source.FileStore.Item.Full=source.Root+L"\\"+source.FileStore.Item.NameW;
   ExpectedSource=SalWideToMultiBytePath(source.FileStore.Item.Full.c_str(),CP_UTF8);ExpectedTarget=SalWideToMultiBytePath(target.Root.c_str(),CP_UTF8);
  }
  if(scenario==12){main.Left.clear();main.Right.clear();main.LeftPanel=main.RightPanel=nullptr;main.Detached={&source,&target};OnBackend=[&]{main.CloseDetachedTab(&source);};}
  if(scenario==13){RecordNewDirectory=TRUE;BackendOK=FALSE;}
  if(scenario==14){RecordNewDirectory=TRUE;CreateOK=FALSE;}
  if(scenario==15){RecordNewDirectory=TRUE;OnCreate=[&]{main.ClosePanelTab(&source);};}
  source.Unpack(&target,-1,nullptr,nullptr);
  Check(StopDepth==0&&Begins==1&&Ends==1&&PriorityDepth==0&&!source.FilesActionInProgress,"cancel/retry/failure/detached/path cases balance all lifetimes");
  Check(source.StaleReads==0&&target.StaleReads==0,"cancel/deletion callback avoids retired panel reads");
  if(scenario<=1)Check(SDKCalls==0&&Creates==0,"cancel has no filesystem or backend work");
  if(scenario==2||scenario==3)Check(Dialogs==2&&SDKCalls==1,"retry retains one refresh scope and revalidates new dialog choice");
  if(scenario==4)Check(SDKCalls==1&&FocusPosts==0,"backend failure does not apply success focus");
  if(scenario==5)Check(SDKCalls==1,"manual destination does not recreate or require unused implicit root");
  if(scenario==6)Check(SDKCalls==1,"live detached source/target accepted");
  if(scenario==7)Check(SDKCalls==0&&Creates==0,"closed detached target refuses before create");
  if(scenario==11)Check(DeletedVolumes==1&&FocusPosts==0,"post-success deletion callback stops remaining volumes and stale focus");
  if(scenario==12){Check(DetachedTransitions==0&&!source.Retired,"busy detached close does not reattach or destroy SDK source");main.CloseDetachedTab(&source);Check(DetachedTransitions==1&&source.Retired,"ordinary detached close works after SDK busy scope ends");}
  if(scenario==13)Check(Cleanups==1&&SDKCalls==1,"backend failure cleans only scoped newly created directory");
  if(scenario==14)Check(Creates==2&&SDKCalls==1&&Notifications==3,"directory creation retry reports owned path and revalidates dialog");
  if(scenario==15)Check(Cleanups==1&&SDKCalls==0&&FocusPosts==0,"create callback invalidation cleans scoped directory before return");
 }

 {
  Reset();CFilesWindow source,target;source.Root=L"C:\\source";source.Tab=2;target.Root=L"C:\\target";target.Tab=3;CMainWindow main;MainWindow=&main;main.Left={&source};main.Right={&target};main.LeftPanel=&source;main.RightPanel=&target;
  CUnpackerConfigData row;Row(row);CPluginData plugin;UnpackerConfig.Unpackers.Data={&row};UnpackerConfig.Unpackers.Count=1;UnpackerConfig.PreferedUnpacker=-2;Plugins.Data={&plugin};ExpectedSource="C:\\source\\archive.7z";ExpectedTarget="C:\\target";
  source.Unpack(&target,-1,nullptr,nullptr);Check(SDKCalls==1&&StopDepth==0,"actual preferred getter normalizes invalid negative index before extension lookup");
  Reset();source.Unpack(&target,INT_MIN,nullptr,nullptr);Check(Begins==0&&Dialogs==0,"invalid plugin index refused before arithmetic or modal work");
  Reset();free(row.Title);row.Title=_strdup("external");row.Type=0;row.CmdExecExtract=_strdup("external.exe");row.CmdArgsExtract=_strdup("args");UnpackerConfig.PreferedUnpacker=0;
  target.Root=L"C:\\"+std::wstring(300,L'a');ExpectedTarget=SalWideToMultiBytePath(target.Root.c_str(),CP_UTF8);OnDialog=[&]{if(Dialogs>1)DialogResult=IDCANCEL;};
  source.Unpack(&target,-1,nullptr,nullptr);Check(Creates==0&&ExternalCalls==0&&Dialogs==2&&StopDepth==0,"unsupported long external destination refused before create and allows cancel from retry dialog");
