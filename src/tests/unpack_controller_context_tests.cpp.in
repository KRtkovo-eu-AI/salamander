  if(scenario==7){CustomVolumes=TRUE;ReturnedVolumes=list(ExpectedSource)+list(ExpectedSource)+list(ExpectedSource+".part2");}
  if(scenario==10)VolumeFlags=FILE_ATTRIBUTE_READONLY|FILE_ATTRIBUTE_HIDDEN;
  if(scenario==11)VolumeAttributeError=ERROR_ACCESS_DENIED;
  if(scenario==12){DeleteFailures=1;FileResponses={IDRETRY};}
  if(scenario==13){DeleteFailures=1;FileResponses={IDB_SKIP};}
  if(scenario==14){DeleteFailures=2;FileResponses={IDB_SKIPALL};}
  if(scenario==15)DeleteFailures=1;
