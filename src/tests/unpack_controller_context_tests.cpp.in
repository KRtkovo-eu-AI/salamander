static BOOL OwnUpdateWindow(HWND){++Updates;if(OnUpdate)OnUpdate();return TRUE;}
static BOOL OwnPostMessage(HWND,UINT,WPARAM,LPARAM){++FocusPosts;return TRUE;}
static DWORD OwnAttributes(const wchar_t* path){LastAttributePath=path;if(std::find(VolumePaths.begin(),VolumePaths.end(),path)!=VolumePaths.end()){++VolumeAttributesCalls;if(VolumeAttributeError){SetLastError(VolumeAttributeError);return INVALID_FILE_ATTRIBUTES;}return VolumeFlags;}return RootExists?(RootIsDirectory?FILE_ATTRIBUTE_DIRECTORY:FILE_ATTRIBUTE_NORMAL):INVALID_FILE_ATTRIBUTES;}
static BOOL OwnPriority(HANDLE,int priority){PriorityDepth+=priority==THREAD_PRIORITY_NORMAL?1:-1;++PriorityChanges;return TRUE;}
static BOOL OwnDelete(const wchar_t* path){++DeletedVolumes;DeletedPaths.emplace_back(path);if(OnDelete)OnDelete();if(DeleteFailures>0){--DeleteFailures;SetLastError(VolumeDeleteError);return FALSE;}return TRUE;}
