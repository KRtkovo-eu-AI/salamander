struct CSalamanderForOperations {explicit CSalamanderForOperations(CFilesWindow*){++OperationContexts;}};
struct ArchiverFacade {
 BOOL UnpackWholeArchive(CSalamanderForOperations*,const char* source,const char*,const char* target,BOOL del,CDynamicString* volumes){
  ++SDKCalls;Check(ExpectedSource==source&&ExpectedTarget==target,"SDK receives exact owned source/destination bytes");
  if(del&&volumes){auto* v=static_cast<CDynamicStringImp*>(volumes);const std::string data=CustomVolumes?ReturnedVolumes:ExpectedSource+std::string(1,0)+ExpectedSource+".part2"+std::string(1,0);memcpy(v->Text,data.data(),data.size());v->Length=(int)data.size();ReturnedVolumeStorage=v->Text;if(BadVolumeCapacity)v->Allocated=v->Length;VolumePaths.clear();size_t at=0;while(at<data.size()){size_t end=data.find(char(0),at);if(end==std::string::npos)break;std::wstring path=SalMultiByteToWidePath(data.substr(at,end-at).c_str(),CP_UTF8);if(path.size()>=MAX_PATH)path=SalPathAddExtendedPrefixW(path.c_str());VolumePaths.push_back(path);at=end+1;}}

  if(OnBackend)OnBackend();return BackendOK;
 }
};
struct CPluginData {
 const char* DLLName="7zip\\7zip.spl";BOOL SupportCustomUnpack=TRUE;ArchiverFacade PluginIfaceForArchiver;
 BOOL InitDLL(HWND){if(OnInit)OnInit();return TRUE;}
 @@WRAPPER_DECL@@
};
static struct {std::vector<CPluginData*> Data;CPluginData* Get(int i){return i>=0&&i<(int)Data.size()?Data[i]:nullptr;}} Plugins;
static char* DupStr(const char* s){return _strdup(s);}
static void* PackEnumMask=nullptr;
static BOOL PackUniversalUncompress(HWND,const char*,void*,const char*,BOOL,CFilesWindow* panel,BOOL,const char* source,const char* target,void*,void*,char**,BOOL,const CFilesActionDiskTarget* src,const CFilesActionDiskTarget* dst){
 ++ExternalCalls;Check(src!=nullptr&&src->Panel==panel&&(dst!=nullptr||!ExpectedDiskTarget),"controller/dispatcher forward both external contexts");
 Check(ExpectedSource==source&&ExpectedTarget==target,"external receives exact owned source/destination bytes");
 if(src==nullptr){SetLastError(ERROR_RETRY);return FALSE;}
 if(OnBackend)OnBackend();if(!src->IsCurrent(MainWindow)||(dst!=nullptr&&!dst->IsCurrent(MainWindow))){SetLastError(ERROR_RETRY);return FALSE;}
 return panel->MoveFiles("own-extract-temp",target,"own-temp",source);
}
