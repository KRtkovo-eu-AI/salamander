static BOOL SalGetFullName(char* path,int* error,const char* parent,char* focus,void*,int capacity){
 ++Resolves;Check(parent!=nullptr&&std::string(parent)==ExpectedSource.substr(0,ExpectedSource.find_last_of('\\')+1),"relative resolution uses owned exact source parent");
 if(!ResolveOK){ResolveOK=TRUE;*error=IDS_PATHISINVALID;return FALSE;}
 std::string result=path;if(result.empty())result=parent;else if(result.size()<2||result[1]!=':')result=std::string(parent)+result;
 if(result.size()>=(size_t)capacity){*error=IDS_TOOLONGPATH;return FALSE;}strcpy(path,result.c_str());strcpy(focus,"result");return TRUE;
}
