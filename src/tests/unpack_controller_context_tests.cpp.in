static void Check(bool ok,const char* why){++Checks;if(!ok){++Failures;printf("FAIL: %s\n",why);}}
static void RemovePanel(CMainWindow& main,CFilesWindow* panel){
 for(auto* list:{&main.Left,&main.Right,&main.Detached})list->erase(std::remove(list->begin(),list->end(),panel),list->end());
 if(main.LeftPanel==panel)main.LeftPanel=nullptr;if(main.RightPanel==panel)main.RightPanel=nullptr;panel->Retired=TRUE;++CloseCalls;
}
