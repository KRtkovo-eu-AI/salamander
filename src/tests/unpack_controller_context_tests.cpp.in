  Check(DeletedVolumes==expectedDeletes,"ordinary volume delete count follows validated list and retry/skip/cancel/context contract");
  Check(StopDepth==0&&PriorityDepth==0&&!source.FilesActionInProgress&&source.StaleReads==0&&target.StaleReads==0,"volume errors and reentrant callbacks balance scopes without stale getters");
