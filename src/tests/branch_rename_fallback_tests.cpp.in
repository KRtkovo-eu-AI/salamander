static BOOL RenameForControllerTest(LPCWSTR source,LPCWSTR target,DWORD flags)
{
 if(ForcedRenameError){SetLastError(ForcedRenameError);return FALSE;}
 return MoveFileExW(source,target,flags);
}
static DWORD AttributesForControllerTest(LPCWSTR path)
{
 ++TargetQueries;
 if(ForcedAttributesError){SetLastError(ForcedAttributesError);return INVALID_FILE_ATTRIBUTES;}
 return GetFileAttributesW(path);
}
#define MoveFileExW RenameForControllerTest
#define GetFileAttributesW AttributesForControllerTest
@@RENAME_WIDE@@
#undef GetFileAttributesW
#undef MoveFileExW
void CFilesWindow::RenameFileInternal(CFileData* f,const char* formatedFileName,BOOL isDir,BOOL* mayChange,BOOL* tryAgain)
{
@@BRANCH_ROUTE@@
 // The ordinary legacy remainder is deliberately outside this narrow facade.
 // Its sentinel proves Branch dispatch returned before legacy mask/root work.
 ++LegacyCalls;*tryAgain=FALSE;(void)f;(void)formatedFileName;(void)isDir;(void)mayChange;
}
