struct PreparedLeaf
{
    struct Result { DWORD error; bool unknown; };
    bool Prepare(const std::wstring&, const std::wstring&) { ++ElevationAttempts; return PrepareOrdinary; }
    bool IsJunctionRename() const { return false; }
    bool PrepareRenameLink(const std::wstring&, const std::wstring&, bool) { ++ElevationAttempts; return PrepareLink; }
    Result Execute(HWND) const { ++ExecutedRenames; return {ExecutionError, ExecutionUnknown}; }
};
struct ListingSession
{
    std::wstring Root,LastSource,LastTarget;
    bool Open=true;
    bool Contains(const std::wstring& path) const
    {
        return Open && path.size()>Root.size() && path.compare(0,Root.size(),Root)==0 && path[Root.size()]==L'\\';
    }
    DWORD PrepareRename(const std::wstring& path,const std::wstring& target,PreparedLeaf&)
    {
        ++ScopedPreparations;LastSource=path;LastTarget=target;return PreparationError;
    }
};
}
