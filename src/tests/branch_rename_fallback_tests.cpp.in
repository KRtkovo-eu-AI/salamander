static void Check(bool ok,const char* name){++Checks;if(!ok){++Failed;std::printf("FAIL: %s (%lu)\n",name,GetLastError());}}
static std::wstring Exact(const std::wstring& path){return SalPathAddExtendedPrefixW(path.c_str());}
static std::vector<std::wstring> OwnedFiles;
static void Write(const std::wstring& path,const char* content){HANDLE h=CreateFileW(Exact(path).c_str(),GENERIC_WRITE,0,NULL,CREATE_NEW,FILE_ATTRIBUTE_NORMAL,NULL);Check(h!=INVALID_HANDLE_VALUE,"create owned source");if(h!=INVALID_HANDLE_VALUE){OwnedFiles.push_back(path);DWORD n=0;Check(WriteFile(h,content,(DWORD)strlen(content),&n,NULL)&&n==strlen(content),"write owned contents");CloseHandle(h);}}
static std::string Read(const std::wstring& path){HANDLE h=CreateFileW(Exact(path).c_str(),GENERIC_READ,0,NULL,OPEN_EXISTING,FILE_ATTRIBUTE_NORMAL,NULL);if(h==INVALID_HANDLE_VALUE)return "ABSENT";char text[64]={};DWORD n=0;ReadFile(h,text,63,&n,NULL);CloseHandle(h);return std::string(text,n);}
static void CheckProtectedRenameController(HWND owner,const std::wstring& parent)
{
 CFilesWindow panel;panel.Branch=FALSE;panel.HWindow=owner;panel.Storage.Count=1;
 UacF7::ListingSession listing;listing.Root=parent;panel.ProtectedListing=&listing;
 auto& file=panel.Storage.Item;file.Parent=parent;
 const std::wstring source=L"source-\u6771.txt",target=L"renamed-\u017e.txt";
 BOOL change=FALSE,retry=FALSE;
 const auto reset=[&] {
  file.Assign(source);file.Attr=FILE_ATTRIBUTE_NORMAL;panel.Branch=FALSE;listing.Open=true;listing.Root=parent;
  ConsentCalls=ScopedPreparations=ExecutedRenames=TargetQueries=0;ConsentAnswer=IDCANCEL;
  ForcedRenameError=ForcedAttributesError=ERROR_ACCESS_DENIED;
  PreparationError=ExecutionError=ReportedError=ERROR_SUCCESS;ExecutionUnknown=PrepareOrdinary=PrepareLink=false;
  change=retry=FALSE;
 };
 reset();int attempts=ElevationAttempts,errors=Errors;
 panel.RenameFileInternalW(&file,target,FALSE,&change,&retry);
 Check(ScopedPreparations==1&&TargetQueries==0&&ElevationAttempts==attempts&&ConsentCalls==1&&ExecutedRenames==0,
       "protected rename prepares through the listing without requiring target visibility or a local source handle");
 Check(!retry&&file.Wide==source&&Errors==errors&&listing.LastSource==parent+L"\\"+source&&listing.LastTarget==target,
       "declined protected rename retains the selected Unicode source and stops retrying");

 reset();ConsentAnswer=IDOK;int updates=Updates;
 panel.RenameFileInternalW(&file,target,FALSE,&change,&retry);
 Check(ExecutedRenames==1&&!retry&&file.Wide==target&&Updates==updates+1&&TargetQueries==0,
       "confirmed protected rename uses the existing successful metadata and focus path");

 reset();updates=Updates;
 panel.RenameFileInternalW(&file,target,FALSE,&change,&retry,true);
 Check(ScopedPreparations==1&&ConsentCalls==0&&ExecutedRenames==1&&!retry&&file.Wide==target&&Updates==updates+1,
       "shielded F2 acceptance goes directly to Windows consent for the verified rename");

 reset();ExecutionError=ERROR_CANCELLED;
 panel.RenameFileInternalW(&file,target,FALSE,&change,&retry,true);
 Check(ScopedPreparations==1&&ConsentCalls==0&&ExecutedRenames==1&&!retry&&file.Wide==source,
       "cancelling Windows consent after shielded F2 preserves the source");

 reset();listing.Open=false;ForcedAttributesError=ERROR_FILE_NOT_FOUND;PrepareOrdinary=true;
 panel.RenameFileInternalW(&file,target,FALSE,&change,&retry,true);
 Check(ScopedPreparations==0&&TargetQueries==1&&ConsentCalls==0&&ExecutedRenames==1&&!retry&&file.Wide==target,
       "shielded F2 also uses direct Windows consent when the normal retry can verify the source");

 reset();file.Attr=FILE_ATTRIBUTE_REPARSE_POINT;ForcedAttributesError=ERROR_FILE_NOT_FOUND;PrepareLink=true;
 panel.RenameFileInternalW(&file,target,FALSE,&change,&retry,true);
 Check(ScopedPreparations==0&&ConsentCalls==1&&ExecutedRenames==0&&!retry&&file.Wide==source,
       "a shielded regular-file confirmation never skips link-specific confirmation");

 reset();ConsentAnswer=IDOK;ExecutionError=ERROR_ALREADY_EXISTS;int fallback=OverwriteFallbacks;
 panel.RenameFileInternalW(&file,target,FALSE,&change,&retry);
 Check(ExecutedRenames==1&&retry&&file.Wide==source&&ReportedError==ERROR_ALREADY_EXISTS&&OverwriteFallbacks==fallback&&TargetQueries==0,
       "broker collision preserves the source and never enters the legacy overwrite fallback");

 reset();PreparationError=ERROR_FILE_EXISTS;fallback=OverwriteFallbacks;
 panel.RenameFileInternalW(&file,target,FALSE,&change,&retry,true);
 Check(ConsentCalls==0&&ExecutedRenames==0&&retry&&ReportedError==ERROR_FILE_EXISTS&&OverwriteFallbacks==fallback,
       "shielded F2 still requires scoped preparation and does not widen to an overwrite");

 reset();ConsentAnswer=IDOK;ExecutionError=ERROR_CANCELLED;
 panel.RenameFileInternalW(&file,target,FALSE,&change,&retry);
 Check(ExecutedRenames==1&&!retry&&file.Wide==source,
       "cancelled Windows consent leaves the selected source and exits the rename retry");

 reset();ConsentAnswer=IDOK;ExecutionUnknown=true;ExecutionError=ERROR_BROKEN_PIPE;errors=Errors;
 panel.RenameFileInternalW(&file,target,FALSE,&change,&retry);
 Check(ExecutedRenames==1&&!retry&&file.Wide==source&&Errors==errors+1,
       "unknown broker outcome reports once and does not replay the rename");

 reset();listing.Root=parent+L"-other";
 panel.RenameFileInternalW(&file,target,FALSE,&change,&retry);
 Check(ScopedPreparations==0&&ExecutedRenames==0&&ConsentCalls==0&&TargetQueries==1,
       "a protected panel never supplies a grant for a sibling-prefix path");

 reset();listing.Open=false;
 panel.RenameFileInternalW(&file,target,FALSE,&change,&retry);
 Check(ScopedPreparations==0&&ExecutedRenames==0&&ConsentCalls==0,
       "a disconnected listing cannot prepare a protected rename");

 reset();file.Attr=FILE_ATTRIBUTE_DIRECTORY;
 panel.RenameFileInternalW(&file,target,TRUE,&change,&retry);
 Check(ScopedPreparations==0&&ConsentCalls==0,"ordinary directories remain outside the protected file rename capability");

 reset();file.Attr=FILE_ATTRIBUTE_REPARSE_POINT;
 panel.RenameFileInternalW(&file,target,FALSE,&change,&retry);
 Check(ScopedPreparations==0&&ConsentCalls==0,"link rename does not borrow the protected regular-file capability");

 reset();panel.Branch=TRUE;
 panel.RenameFileInternalW(&file,target,FALSE,&change,&retry);
 Check(ScopedPreparations==0&&ConsentCalls==0,"Branch View remains outside the protected listing rename capability");

 ForcedRenameError=ForcedAttributesError=ERROR_SUCCESS;
}
int wmain()
{
 DWORD size=GetCurrentDirectoryW(0,NULL);std::vector<wchar_t> cwd(size);if(!GetCurrentDirectoryW(size,cwd.data()))return 2;
 std::wstring root=std::wstring(cwd.data())+L"\\owned-rename";if(!CreateDirectoryW(root.c_str(),NULL))return 2;
 std::vector<std::wstring> dirs={root};
 std::wstring parent=root+L"\\\u017elu\u0165ou\u010dk\u00fd-\u6771\u4eac";
 Check(CreateDirectoryW(parent.c_str(),NULL)!=FALSE,"create Unicode real parent");dirs.push_back(parent);
 std::wstring longParent=parent;for(int i=0;i<4;++i){longParent+=L"\\"+std::wstring(65,L'\u65e5');Check(CreateDirectoryW(Exact(longParent).c_str(),NULL)!=FALSE,"create exact long parent");dirs.push_back(longParent);}
 Check(longParent.size()>MAX_PATH,"real parent exceeds UTF-16 MAX_PATH");
 HWND owner=CreateWindowExW(0,L"STATIC",L"Owned native fallback fixture",WS_OVERLAPPED,0,0,300,50,NULL,NULL,HInstance,NULL);
 Check(owner!=NULL,"create owned hidden control parent");
 for(const auto& directory: {parent,longParent}) {
  CFilesWindow panel;panel.HWindow=owner;panel.Root=SalWideToMultiBytePath(root.c_str(),CP_UTF8);panel.Storage.Count=1;
  auto& f=panel.Storage.Item;f.Parent=directory;f.Assign(L"\u65e5\U0001f600.txt");
  std::wstring source=directory+L"\\"+f.Wide,wrong=root+L"\\"+f.Wide;
  Write(source,"RIGHT");Write(wrong,"ROOT-SENTINEL");
  HWND edit=panel.ForcedAnsiEdit("renamed.txt");
  Check(edit!=NULL&&!IsWindowUnicode(edit)&&panel.QuickRenameWindow.WideCreates==1&&panel.QuickRenameWindow.AnsiCreates==1,"failed wide create reaches real ANSI edit control");
  int remaps=Remaps,sleeps=Sleeps,wakes=Wakes;
  Check(panel.HandeQuickRenameWindowKey(VK_RETURN)!=FALSE&&panel.QuickRenameWindow.Closed,"actual ANSI Enter completes rename and closes edit");
  Check(Read(source)=="ABSENT"&&Read(directory+L"\\renamed.txt")=="RIGHT","ANSI fallback renames exact nested file via actual wide implementation");
  Check(Read(wrong)=="ROOT-SENTINEL"&&Read(root+L"\\renamed.txt")=="ABSENT","duplicate root basename is untouched");
  Check(LegacyCalls==0&&Remaps==remaps+1&&Updates>0&&Sleeps==sleeps+1&&Wakes==wakes+1,"route bypasses legacy and retains remap/cache locking calls");
  BOOL change=FALSE,retry=FALSE;
  const std::wstring target=L"p\u0159ejmenov\u00e1no-\u6771\u4eac-\U0001f600.txt";
  panel.RenameFileInternal(&f,SalWideToMultiBytePath(target.c_str(),CP_UTF8).c_str(),FALSE,&change,&retry);
  Check(change&&!retry&&Read(directory+L"\\"+target)=="RIGHT","direct fallback preserves UTF-8-first new basename");
  Check(f.Wide==target,"actual wide path updates metadata adapter with complete new name");
  panel.Current=FALSE;change=FALSE;retry=TRUE;
  panel.RenameFileInternal(&f,"stale.txt",FALSE,&change,&retry);
  Check(!change&&!retry&&Read(directory+L"\\"+target)=="RIGHT"&&Read(directory+L"\\stale.txt")=="ABSENT","stale metadata guard stops forced ANSI route before I/O");
  panel.Current=TRUE;change=FALSE;retry=FALSE;
  panel.RenameFileInternal(&f,"bad/name.txt",FALSE,&change,&retry);
  Check(!change&&retry&&Read(directory+L"\\"+target)=="RIGHT","invalid basename remains refused by actual wide validator");
  Write(directory+L"\\occupied.txt","KEEP");int errors=Errors;
  panel.RenameFileInternal(&f,"occupied.txt",FALSE,&change,&retry);
  Check(retry&&Read(directory+L"\\occupied.txt")=="KEEP"&&Read(directory+L"\\"+target)=="RIGHT"&&Errors==errors,"collision No preserves both files without replacing data");
  Check(DeleteFileW(Exact(directory+L"\\occupied.txt").c_str())&&DeleteFileW(Exact(directory+L"\\"+target).c_str())&&DeleteFileW(Exact(wrong).c_str()),"cleanup owned files only");
 }
 CFilesWindow ordinary;BOOL change=FALSE,retry=TRUE;ordinary.Branch=FALSE;ordinary.RenameFileInternal(NULL,"ordinary.txt",FALSE,&change,&retry);
 Check(LegacyCalls==1&&!change,"ordinary panel still selects untouched legacy remainder");
 Check(ElevationAttempts==0,"Branch View does not offer a broker rename");
 CheckProtectedRenameController(owner,longParent);
 Check(DestroyWindow(owner)!=FALSE,"destroy owned control parent");
 // A deliberately failing mutation must also leave no deep fixture behind.
 for(const auto& file:OwnedFiles)if(GetFileAttributesW(Exact(file).c_str())!=INVALID_FILE_ATTRIBUTES){Check(file.rfind(root+L"\\",0)==0&&DeleteFileW(Exact(file).c_str()),"cleanup leftover owned source after failure");}
 bool clean=true;for(auto i=dirs.rbegin();i!=dirs.rend();++i){if(i->rfind(root,0)!=0){clean=false;continue;}clean=RemoveDirectoryW(Exact(*i).c_str())!=FALSE&&clean;}
 Check(clean,"clean only isolated exact fixture directories");
 std::printf("Actual ANSI rename fallback: %d checks, %d failures\n",Checks,Failed);return Failed?1:0;
}
