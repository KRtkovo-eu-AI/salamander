  ++AnsiCreates;HWindow=CreateWindowExA(ex,type,text,style,x,y,w,h,parent,menu,instance,NULL);return HWindow;
 }
};
static HINSTANCE HInstance=GetModuleHandleW(NULL);
class CFilesWindow {
public:
 BOOL Branch=TRUE,Current=TRUE;HWND HWindow=NULL;Rows Storage,Empty;Rows* Files=&Storage;Rows* Dirs=&Empty;
 Visible VisibleItemsArray,VisibleItemsArraySurround;EditFacade QuickRenameWindow;FakeFS FS;
 char NextFocusName[32768]={};std::string Root;
 BOOL IsBranchView(){return Branch;}BOOL Is(int type){return type==ptDisk;}
 int GetCaretIndex(){return 0;}const char* GetPath(){return Root.c_str();}
 FakeFS* GetPluginFS(){return &FS;}HWND GetListBoxHWND(){return HWindow;}
 const char* GetItemCacheKeyPtr(const CFileData& f){return f.Name;}
 const CFileData* GetBranchViewFileByCacheKey(const char*){return Current?&Storage.Item:NULL;}
 std::wstring GetItemDirectoryW(const CFileData& f){return f.Parent;}
 std::wstring GetItemFullPathW(const CFileData& f){return f.Parent+L"\\"+f.Wide;}
 void SleepIconCacheThread(){++Sleeps;}void WakeupIconCacheThread(){++Wakes;}
 void BranchItemRenamed(const char*,const CFileData&,const std::wstring&){++Remaps;}
 void QuickRenameEnd(){QuickRenameWindow.Closed=true;if(QuickRenameWindow.HWindow){DestroyWindow(QuickRenameWindow.HWindow);QuickRenameWindow.HWindow=NULL;}}
 void RenameFileInternal(CFileData*,const char*,BOOL,BOOL*,BOOL*);
 void RenameFileInternalW(CFileData*,const std::wstring&,BOOL,BOOL*,BOOL*);
 BOOL HandeQuickRenameWindowKey(WPARAM);
