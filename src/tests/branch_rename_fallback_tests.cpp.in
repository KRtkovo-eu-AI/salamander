struct CFileData {
 std::string Mirror;std::wstring Wide,Parent;const char* Name=nullptr;const wchar_t* NameW=nullptr;
 bool UseWideName()const{return true;}
 void Assign(const std::wstring& name){Wide=name;Mirror=SalWideToMultiBytePath(name.c_str(),CP_UTF8);Name=Mirror.c_str();NameW=Wide.c_str();}
};
static void UpdateFileDataNameAfterRename(CFileData* f,const std::wstring& name,BOOL){++Updates;f->Assign(name);}
struct Visible {int Calls=0;void InvalidateArr(){++Calls;}};
