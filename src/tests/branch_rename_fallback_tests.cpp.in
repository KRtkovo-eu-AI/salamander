 HWND HWindow=nullptr;bool Unicode=false;int WideCreates=0,AnsiCreates=0;bool Closed=false;
 void SetUnicodeWindow(BOOL unicode){Unicode=unicode!=FALSE;}
 void SetCloseEnabled(BOOL){}
