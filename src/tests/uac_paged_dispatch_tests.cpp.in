// | Date | Summary | Reason | Ticket | Model |
// | 2026-11-12 | Interleave Find content with identity pages. | Verify the allowed scope and pipe termination on an interrupted read. | #731 | GPT-6.1 Terra |
// | 2026-11-12 | Exercise scoped identity pages through the real dispatcher. | Check paging, identity and scope without a UAC or UI claim. | #731 | GPT-6 (Codex) |
@@JOB_FIXTURE@@
#include <set>

int wmain()
{
    Directory root;
    if (!root.Open(L"paged-root")) return 2;
    const auto targetPath = root.File(L"paged-\u6771");
    if (!CreateDirectoryW(targetPath.c_str(), nullptr)) return 3;
    auto target = Adopt(CreateFileW(targetPath.c_str(), FILE_LIST_DIRECTORY | FILE_READ_ATTRIBUTES | SYNCHRONIZE,
        FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, OPEN_EXISTING,
        FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT, nullptr));
    FILE_ID_INFO targetId{};
    if (!target || !GetFileInformationByHandleEx(target.get(), FileIdInfo, &targetId, sizeof(targetId))) return 4;
    UacF7::MoveFileIdentity expected{targetId.VolumeSerialNumber};
    std::memcpy(expected.id, targetId.FileId.Identifier, sizeof(expected.id));
    const auto smallPath = root.File(L"verified-\u6771");
    if (!CreateDirectoryW(smallPath.c_str(), nullptr) || !WriteByte(smallPath + L"\\\u65e5.txt", 9)) return 12;
    const auto smallHandle = Adopt(CreateFileW(smallPath.c_str(), FILE_LIST_DIRECTORY | FILE_READ_ATTRIBUTES | SYNCHRONIZE,
        FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, OPEN_EXISTING,
        FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT, nullptr));
    FILE_ID_INFO smallId{};
    if (!smallHandle || !GetFileInformationByHandleEx(smallHandle.get(), FileIdInfo, &smallId, sizeof(smallId))) return 13;
    for (const auto scope : {Operation::List, Operation::FindContent})
    {
        JobPipe verified;
        FILE_ID_INFO wrongSmall = smallId; wrongSmall.FileId.Identifier[0] ^= 1;
        Check(verified.Open(nullptr, root.handle.get(), scope) &&
              verified.CompareList(L"verified-\u6771", smallId, ERROR_SUCCESS, L"\u65e5.txt") &&
              verified.CompareList(L"verified-\u6771", wrongSmall, ERROR_FILE_INVALID),
              "verified legacy descendant listing accepts exact ID and rejects a replacement");
        JobPipe noRoot;
        Check(noRoot.Open(nullptr, root.handle.get(), scope) && noRoot.RejectFindRequest(UacListing::verifiedListingRequest),
              "Find listing scopes reject a verified request for the root itself");
    }
    for (const auto scope : {Operation::Inventory, Operation::FindFile})
    {
        JobPipe denied;
        Check(denied.Open(nullptr, root.handle.get(), scope) && denied.RejectFindRequest(UacListing::verifiedListingRequest | 1),
              "unrelated scope rejects a verified descendant listing");
    }
    {
        UacListing::PagedListingReply reply{};
        std::vector<UacF7::PagedListingEntry> rows;
        const auto lockedPath = root.File(L"delete-locked");
        if (!CreateDirectoryW(lockedPath.c_str(), nullptr) || !WriteByte(lockedPath + L"\\readable.txt", 1)) return 15;
        auto deleteHandle = Adopt(CreateFileW(lockedPath.c_str(), DELETE | FILE_READ_ATTRIBUTES,
            FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, OPEN_EXISTING,
            FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT, nullptr));
        FILE_ID_INFO lockedId{};
        if (!deleteHandle || !GetFileInformationByHandleEx(deleteHandle.get(), FileIdInfo, &lockedId, sizeof(lockedId))) return 16;
        UacF7::MoveFileIdentity lockedExpected{lockedId.VolumeSerialNumber};
        std::memcpy(lockedExpected.id, lockedId.FileId.Identifier, sizeof(lockedExpected.id));
        for (const auto scope : {Operation::List, Operation::FindContent})
        {
            JobPipe denied;
            Check(denied.Open(nullptr, root.handle.get(), scope) && denied.PlainList(L"delete-locked", L"readable.txt") &&
                  denied.PageRequest(UacListing::PagedListingOp::Open, L"delete-locked", &lockedExpected, reply, rows) &&
                  reply.error == ERROR_SHARING_VIOLATION && rows.empty() &&
                  denied.CompareList(L"delete-locked", lockedId, ERROR_SHARING_VIOLATION),
                  "preexisting DELETE handle permits old List but verified paging fails closed");
        }
        deleteHandle.reset();
        for (const auto scope : {Operation::List, Operation::FindContent})
        {
            JobPipe retry;
            Check(retry.Open(nullptr, root.handle.get(), scope) &&
                  retry.PageRequest(UacListing::PagedListingOp::Open, L"delete-locked", &lockedExpected, reply, rows) && !reply.error &&
                  retry.PageRequest(UacListing::PagedListingOp::Close, {}, nullptr, reply, rows) && !reply.error,
                  "verified paging succeeds when the conflicting DELETE handle is released");
        }
    }
    {
        UacListing::PagedListingReply reply{};
        std::vector<UacF7::PagedListingEntry> rows;
        const auto parentPath = root.File(L"delete-locked-parent");
        const auto childPath = parentPath + L"\\child";
        if (!CreateDirectoryW(parentPath.c_str(), nullptr) || !CreateDirectoryW(childPath.c_str(), nullptr) ||
            !WriteByte(childPath + L"\\readable.txt", 1)) return 17;
        auto child = Adopt(CreateFileW(childPath.c_str(), FILE_READ_ATTRIBUTES,
            FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, OPEN_EXISTING,
            FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT, nullptr));
        FILE_ID_INFO childId{};
        if (!child || !GetFileInformationByHandleEx(child.get(), FileIdInfo, &childId, sizeof(childId))) return 18;
        child.reset();
        auto deleteHandle = Adopt(CreateFileW(parentPath.c_str(), DELETE | FILE_READ_ATTRIBUTES,
            FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, OPEN_EXISTING,
            FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT, nullptr));
        if (!deleteHandle) return 19;
        UacF7::MoveFileIdentity childExpected{childId.VolumeSerialNumber};
        std::memcpy(childExpected.id, childId.FileId.Identifier, sizeof(childExpected.id));
        for (const auto scope : {Operation::List, Operation::FindContent})
        {
            JobPipe denied;
            Check(denied.Open(nullptr, root.handle.get(), scope) &&
                  denied.PlainList(L"delete-locked-parent\\child", L"readable.txt") &&
                  denied.PageRequest(UacListing::PagedListingOp::Open, L"delete-locked-parent\\child", &childExpected, reply, rows) &&
                  reply.error == ERROR_SHARING_VIOLATION && rows.empty() &&
                  denied.CompareList(L"delete-locked-parent\\child", childId, ERROR_SHARING_VIOLATION),
                  "preexisting DELETE handle on ancestor preserves old List but verified paging fails closed");
        }
        deleteHandle.reset();
        for (const auto scope : {Operation::List, Operation::FindContent})
        {
            JobPipe retry;
            Check(retry.Open(nullptr, root.handle.get(), scope) &&
                  retry.PageRequest(UacListing::PagedListingOp::Open, L"delete-locked-parent\\child", &childExpected, reply, rows) && !reply.error &&
                  retry.PageRequest(UacListing::PagedListingOp::Close, {}, nullptr, reply, rows) && !reply.error,
                  "verified descendant paging succeeds after the ancestor DELETE handle closes");
        }
    }
    {
        const auto casePath = root.File(L"case-parent");
        const bool created = CreateDirectoryW(casePath.c_str(), nullptr) != FALSE;
        const auto caseHandle = Adopt(CreateFileW(casePath.c_str(), FILE_READ_ATTRIBUTES | FILE_WRITE_ATTRIBUTES,
            FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, OPEN_EXISTING,
            FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT, nullptr));
        ULONG enabled = 1;
        const bool caseEnabled = created && caseHandle && SetFileInformationByHandle(caseHandle.get(),
            static_cast<FILE_INFO_BY_HANDLE_CLASS>(23), &enabled, sizeof(enabled));
        if (caseEnabled && CreateDirectoryW((casePath + L"\\a").c_str(), nullptr) &&
            CreateDirectoryW((casePath + L"\\A").c_str(), nullptr) &&
            WriteByte(casePath + L"\\a\\lower.txt", 1) && WriteByte(casePath + L"\\A\\upper.txt", 2))
        {
            auto lower = Adopt(CreateFileW((casePath + L"\\a").c_str(), FILE_READ_ATTRIBUTES,
                FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, OPEN_EXISTING,
                FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT, nullptr));
            auto upper = Adopt(CreateFileW((casePath + L"\\A").c_str(), FILE_READ_ATTRIBUTES,
                FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, OPEN_EXISTING,
                FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT, nullptr));
            FILE_ID_INFO lowId{}, highId{};
            const bool ids = lower && upper && GetFileInformationByHandleEx(lower.get(), FileIdInfo, &lowId, sizeof(lowId)) &&
                GetFileInformationByHandleEx(upper.get(), FileIdInfo, &highId, sizeof(highId)) &&
                std::memcmp(lowId.FileId.Identifier, highId.FileId.Identifier, sizeof(lowId.FileId.Identifier));
            JobPipe exact;
            Check(ids && exact.Open(nullptr, root.handle.get(), Operation::FindContent) &&
                  exact.CompareList(L"case-parent\\a", lowId, ERROR_SUCCESS, L"lower.txt") &&
                  exact.CompareList(L"case-parent\\A", highId, ERROR_SUCCESS, L"upper.txt") &&
                  exact.CompareList(L"case-parent\\a", highId, ERROR_FILE_INVALID),
                  "verified Find fallback preserves exact case-distinct directory identities");
        }
        else std::printf("SKIP: case-sensitive directory fixture unavailable (%lu)\n", GetLastError());
    }
    for (unsigned i = 0; i < 4104; ++i)
    {
        wchar_t leaf[32]{};
        swprintf_s(leaf, L"\\row-%04u.txt", i);
        if (!WriteByte(targetPath + leaf, static_cast<BYTE>(i))) return 5;
    }
    JobPipe job;
    if (!job.Open(nullptr, root.handle.get(), Operation::CompareList)) return 6;
    std::vector<UacF7::PagedListingEntry> rows;
    UacListing::PagedListingReply reply{};
    auto wrong = expected;
    wrong.id[0] ^= 1;
    Check(job.PageRequest(UacListing::PagedListingOp::Open, L"paged-\u6771", &wrong, reply, rows) &&
          reply.error == ERROR_FILE_INVALID && rows.empty(), "mismatched directory ID returns no rows");
    Check(job.PageRequest(UacListing::PagedListingOp::Open, L"..\\outside", &expected, reply, rows) &&
          reply.error == ERROR_INVALID_NAME && rows.empty(), "paged traversal cannot leave approved root");
    Check(job.PageRequest(UacListing::PagedListingOp::Open, L"paged-\u6771", &expected, reply, rows) &&
          !reply.error && reply.identity.serial == expected.serial &&
          !std::memcmp(reply.identity.id, expected.id, sizeof(expected.id)), "open exact directory identity");
    ULONGLONG sibling = 0;
    Check(job.PageRequest(UacListing::PagedListingOp::Open, L"paged-\u6771", &expected, reply, rows, &sibling) && !reply.error &&
          job.PageRequest(UacListing::PagedListingOp::Next, {}, nullptr, reply, rows, &sibling) && !reply.error && !rows.empty() &&
          job.PageRequest(UacListing::PagedListingOp::Close, {}, nullptr, reply, rows, &sibling) && !reply.error &&
          job.PageRequest(UacListing::PagedListingOp::Next, {}, nullptr, reply, rows, &sibling) && reply.error == ERROR_INVALID_STATE,
          "a nested token is independent and cannot be reused after close");
    std::set<std::wstring> names;
    bool complete = false, pagesOk = true;
    unsigned pages = 0;
    while (!complete && pages++ < 100)
    {
        if (!job.PageRequest(UacListing::PagedListingOp::Next, {}, nullptr, reply, rows) || reply.error ||
            reply.count != rows.size() || rows.size() > UacF7::maxPagedListingEntries)
        { pagesOk = false; break; }
        for (const auto& row : rows)
        {
            const BYTE zero[16]{};
            if (!std::memcmp(row.id, zero, sizeof(zero)) || !names.emplace(row.data.cFileName).second)
                pagesOk = false;
        }
        complete = reply.done != 0;
    }
    Check(pagesOk && complete && names.size() == 4104 && pages > 64,
          "more than 4096 identity-bearing rows arrive once in bounded pages");
    Check(job.PageRequest(UacListing::PagedListingOp::Next, {}, nullptr, reply, rows) &&
          reply.error == ERROR_INVALID_STATE && rows.empty(), "completed cursor cannot be read again");
    Check(job.PageRequest(UacListing::PagedListingOp::Open, L"paged-\u6771", &expected, reply, rows) && !reply.error &&
          job.PageRequest(UacListing::PagedListingOp::Close, {}, nullptr, reply, rows) && !reply.error &&
          job.PageRequest(UacListing::PagedListingOp::Next, {}, nullptr, reply, rows) && reply.error == ERROR_INVALID_STATE,
          "closing one cursor prevents further reads and permits a new one");
    {
        JobPipe find;
        UacF7::ArchiveRevision revision{};
        const auto exactFile = Adopt(CreateFileW((targetPath + L"\\row-0001.txt").c_str(), FILE_READ_ATTRIBUTES,
            FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr));
        FILE_ID_INFO fileId{};
        const bool exactId = exactFile && GetFileInformationByHandleEx(exactFile.get(), FileIdInfo, &fileId, sizeof(fileId));
        Check(find.Open(nullptr, root.handle.get(), Operation::FindContent) &&
              find.PageRequest(UacListing::PagedListingOp::Open, L"paged-\u6771", &expected, reply, rows) && !reply.error &&
              find.PageRequest(UacListing::PagedListingOp::Next, {}, nullptr, reply, rows) && !reply.error && !rows.empty() &&
              find.OpenFindContent(L"paged-\u6771\\row-0001.txt", &revision) &&
              exactId && revision.serial == fileId.VolumeSerialNumber &&
              !std::memcmp(revision.fileId, fileId.FileId.Identifier, sizeof(revision.fileId)) &&
              find.ReadAndCloseFindContent(1) &&
              find.PageRequest(UacListing::PagedListingOp::Next, {}, nullptr, reply, rows) && !reply.error && !rows.empty() &&
              find.PageRequest(UacListing::PagedListingOp::Close, {}, nullptr, reply, rows) && !reply.error,
              "FindContent interleaves bounded pages with one verified content read on the same pipe");
        JobPipe stopped;
        Check(stopped.Open(nullptr, root.handle.get(), Operation::FindContent) &&
              stopped.PageRequest(UacListing::PagedListingOp::Open, L"paged-\u6771", &expected, reply, rows) && !reply.error &&
              stopped.OpenFindContent(L"paged-\u6771\\row-0001.txt") && stopped.Finish() == ERROR_BROKEN_PIPE,
              "disconnect during a content read ends the scoped dispatcher and cursor");
    }
    {
        DWORD before = 0, during = 0, after = 0;
        GetProcessHandleCount(GetCurrentProcess(), &before);
        JobPipe many;
        std::array<ULONGLONG, UacF7::maxPagedDirectoryCursors> tokens{};
        bool opened = many.Open(nullptr, root.handle.get(), Operation::FindContent);
        for (auto& token : tokens)
            opened = opened && many.PageRequest(UacListing::PagedListingOp::Open, L"paged-\u6771", &expected, reply, rows, &token) && !reply.error;
        ULONGLONG overflow = 0;
        const bool limited = opened && many.PageRequest(UacListing::PagedListingOp::Open, L"paged-\u6771", &expected, reply, rows, &overflow) &&
            reply.error == ERROR_TOO_MANY_OPEN_FILES;
        GetProcessHandleCount(GetCurrentProcess(), &during);
        const bool interrupted = limited &&
            many.PageRequest(UacListing::PagedListingOp::Next, {}, nullptr, reply, rows, &tokens[0]) && !reply.error && !rows.empty() &&
            many.OpenFindContent(L"paged-\u6771\\row-0001.txt") && many.Finish() == ERROR_BROKEN_PIPE;
        GetProcessHandleCount(GetCurrentProcess(), &after);
        Check(interrupted && during >= before + UacF7::maxPagedDirectoryCursors && after <= before + 2,
              "all 33 open cursors are released when the pipe ends during content read");
    }
    {
        std::wstring relative = L"depth";
        std::wstring native = root.File(relative.c_str());
        bool made = CreateDirectoryW(native.c_str(), nullptr) != FALSE;
        JobPipe nested;
        made = made && nested.Open(nullptr, root.handle.get(), Operation::FindContent);
        std::array<ULONGLONG, UacF7::maxPagedDirectoryCursors> tokens{};
        for (size_t i = 0; made && i < tokens.size(); ++i)
        {
            if (i) { relative += L"\\d"; native += L"\\d"; made = CreateDirectoryW(native.c_str(), nullptr) != FALSE; }
            auto directory = Adopt(CreateFileW(native.c_str(), FILE_READ_ATTRIBUTES,
                FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, OPEN_EXISTING,
                FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT, nullptr));
            FILE_ID_INFO id{};
            made = made && directory && GetFileInformationByHandleEx(directory.get(), FileIdInfo, &id, sizeof(id));
            UacF7::MoveFileIdentity item{id.VolumeSerialNumber};
            std::memcpy(item.id, id.FileId.Identifier, sizeof(item.id));
            made = made && nested.PageRequest(UacListing::PagedListingOp::Open, relative, &item, reply, rows, &tokens[i]) && !reply.error;
        }
        const bool parentStillWorks = made &&
            nested.PageRequest(UacListing::PagedListingOp::Next, {}, nullptr, reply, rows, &tokens[0]) &&
            !reply.error && rows.size() == 1 && !wcscmp(rows[0].data.cFileName, L"d");
        bool closed = made;
        for (size_t i = tokens.size(); i > 1; --i)
            closed = nested.PageRequest(UacListing::PagedListingOp::Close, {}, nullptr, reply, rows, &tokens[i - 1]) && !reply.error && closed;
        // The root cursor reached its terminal page above and is already closed.
        Check(parentStillWorks && closed, "33 distinct nested directory cursors keep their own traversal state");
    }
    const bool openedBeforeChange = job.PageRequest(UacListing::PagedListingOp::Open, L"paged-\u6771", &expected, reply, rows) && !reply.error;
    target.reset();
    const auto movedTarget = root.File(L"paged-moved");
    if (openedBeforeChange && MoveFileW(targetPath.c_str(), movedTarget.c_str()))
    {
        const bool replaced = CreateDirectoryW(targetPath.c_str(), nullptr) != FALSE;
        Check(replaced && job.PageRequest(UacListing::PagedListingOp::Next, {}, nullptr, reply, rows) &&
              reply.error == ERROR_FILE_INVALID && rows.empty(),
              "a moved directory and same-name replacement cannot provide another page");
    }
    else
    {
        std::printf("SKIP: moving the open directory is unavailable (%lu)\n", GetLastError());
        if (openedBeforeChange) job.PageRequest(UacListing::PagedListingOp::Close, {}, nullptr, reply, rows);
    }
    const auto current = Adopt(CreateFileW(targetPath.c_str(), FILE_LIST_DIRECTORY | FILE_READ_ATTRIBUTES | SYNCHRONIZE,
        FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, OPEN_EXISTING,
        FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT, nullptr));
    FILE_ID_INFO currentId{};
    if (!current || !GetFileInformationByHandleEx(current.get(), FileIdInfo, &currentId, sizeof(currentId))) return 11;
    UacF7::MoveFileIdentity panelIdentity{currentId.VolumeSerialNumber};
    std::memcpy(panelIdentity.id, currentId.FileId.Identifier, sizeof(panelIdentity.id));
    JobPipe panel;
    Check(panel.Open(nullptr, root.handle.get(), Operation::List) &&
          panel.PageRequest(UacListing::PagedListingOp::Open, L"paged-\u6771", &panelIdentity, reply, rows) && !reply.error &&
          panel.PageRequest(UacListing::PagedListingOp::Close, {}, nullptr, reply, rows) && !reply.error,
          "the existing read-only panel listing scope admits verified metadata pages");
    // The ACL is applied only to this disposable fixture and restored through
    // its already-open handle before the test returns.
    const auto ancestorPath = root.File(L"traverse-only");
    const auto childPath = ancestorPath + L"\\child";
    const auto movedPath = root.File(L"traverse-only-moved");
    if (!CreateDirectoryW(ancestorPath.c_str(), nullptr) || !CreateDirectoryW(childPath.c_str(), nullptr)) return 7;
    auto childControl = Adopt(CreateFileW(childPath.c_str(), READ_CONTROL | WRITE_DAC,
        FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, OPEN_EXISTING,
        FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT, nullptr));
    PSECURITY_DESCRIPTOR childDescriptor = nullptr;
    PACL childDacl = nullptr;
    BOOL childPresent = FALSE, childDefaulted = FALSE;
    if (!childControl || !ConvertStringSecurityDescriptorToSecurityDescriptorW(L"D:P(A;;FA;;;WD)",
            SDDL_REVISION_1, &childDescriptor, nullptr) ||
        !GetSecurityDescriptorDacl(childDescriptor, &childPresent, &childDacl, &childDefaulted) || !childPresent ||
        SetSecurityInfo(childControl.get(), SE_FILE_OBJECT, DACL_SECURITY_INFORMATION | PROTECTED_DACL_SECURITY_INFORMATION,
                        nullptr, nullptr, childDacl, nullptr)) return 10;
    FILE_ID_INFO childIdentity{};
    if (!GetFileInformationByHandleEx(childControl.get(), FileIdInfo, &childIdentity, sizeof(childIdentity))) return 14;
    LocalFree(childDescriptor);
    const auto control = Adopt(CreateFileW(ancestorPath.c_str(), READ_CONTROL | WRITE_DAC,
        FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, OPEN_EXISTING,
        FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT, nullptr));
    PACL oldDacl = nullptr;
    PSECURITY_DESCRIPTOR oldDescriptor = nullptr, temporaryDescriptor = nullptr;
    SECURITY_DESCRIPTOR_CONTROL oldFlags{};
    DWORD revision = 0;
    if (!control || GetSecurityInfo(control.get(), SE_FILE_OBJECT, DACL_SECURITY_INFORMATION,
                                    nullptr, nullptr, &oldDacl, nullptr, &oldDescriptor) ||
        !GetSecurityDescriptorControl(oldDescriptor, &oldFlags, &revision) ||
        !ConvertStringSecurityDescriptorToSecurityDescriptorW(L"D:P(D;;0x1;;;WD)(A;;FA;;;WD)",
                                                               SDDL_REVISION_1, &temporaryDescriptor, nullptr))
        return 8;
    PACL temporaryDacl = nullptr;
    BOOL present = FALSE, defaulted = FALSE;
    if (!GetSecurityDescriptorDacl(temporaryDescriptor, &present, &temporaryDacl, &defaulted) || !present ||
        SetSecurityInfo(control.get(), SE_FILE_OBJECT, DACL_SECURITY_INFORMATION | PROTECTED_DACL_SECURITY_INFORMATION,
                        nullptr, nullptr, temporaryDacl, nullptr)) return 9;
    auto childProbe = Adopt(CreateFileW(childPath.c_str(), FILE_LIST_DIRECTORY | FILE_READ_ATTRIBUTES,
        FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, OPEN_EXISTING,
        FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT, nullptr));
    if (!childProbe) std::printf("DETAIL: absolute child open=%lu\n", GetLastError());
    {
        std::vector<Handle> pins;
        HANDLE anchored = nullptr;
        const DWORD pinStatus = PinPagedDirectory(root.handle.get(), L"traverse-only\\child", nullptr, pins, anchored);
        for (const auto scope : {Operation::List, Operation::FindContent})
        {
            JobPipe verified;
            Check(verified.Open(nullptr, root.handle.get(), scope) &&
                  verified.CompareList(L"traverse-only\\child", childIdentity, ERROR_SUCCESS),
                  "verified legacy listing traverses a non-listable ancestor with exact child ID");
        }
        // Restore the original ACL while the traverse-only pin is still held,
        // so that the following rename probes share-mode protection rather than
        // merely rediscovering an ACL denial.
        const DWORD earlyRestore = SetSecurityInfo(control.get(), SE_FILE_OBJECT, DACL_SECURITY_INFORMATION |
            ((oldFlags & SE_DACL_PROTECTED) ? PROTECTED_DACL_SECURITY_INFORMATION : UNPROTECTED_DACL_SECURITY_INFORMATION),
            nullptr, nullptr, oldDacl, nullptr);
        childControl.reset();
        childProbe.reset();
        const BOOL renamedWhilePinned = pinStatus == ERROR_SUCCESS && MoveFileW(ancestorPath.c_str(), movedPath.c_str());
        const DWORD pinnedMoveError = renamedWhilePinned ? ERROR_SUCCESS : GetLastError();
        std::printf("DETAIL: traverse pin=%lu, renameWhilePinned=%d, renameError=%lu, pins=%zu\n",
                    pinStatus, renamedWhilePinned, pinnedMoveError, pins.size());
        if (pinStatus && !pins.empty())
        {
            FILE_CASE_SENSITIVE_INFO info{};
            const BOOL queried = GetFileInformationByHandleEx(pins.back().get(), FileCaseSensitiveInfo, &info, sizeof(info));
            const DWORD queryError = queried ? 0 : GetLastError();
            HANDLE probe = nullptr;
            const DWORD childError = UacRenameLeaf::Detail::OpenSource(pins.back().get(), L"child", probe,
                FILE_LIST_DIRECTORY, FILE_SHARE_READ | FILE_SHARE_WRITE, UacRenameLeaf::MoveKind::RenameDirectory, false);
            if (probe) CloseHandle(probe);
            std::printf("DETAIL: caseQuery=%d caseError=%lu childOpen=%lu\n", queried, queryError, childError);
        }
        Check(pinStatus == ERROR_SUCCESS && earlyRestore == ERROR_SUCCESS && !renamedWhilePinned,
              "traverse-only ancestor remains pinned during scoped page operation");
        pins.clear();
        const BOOL renamedAfter = pinStatus == ERROR_SUCCESS && !renamedWhilePinned &&
                                  MoveFileW(ancestorPath.c_str(), movedPath.c_str());
        if (!renamedAfter) std::printf("DETAIL: renameAfter=%d error=%lu\n", renamedAfter, GetLastError());
        Check(renamedAfter != FALSE, "the same ancestor can move after scoped pins close");
    }
    const DWORD restored = SetSecurityInfo(control.get(), SE_FILE_OBJECT, DACL_SECURITY_INFORMATION |
        ((oldFlags & SE_DACL_PROTECTED) ? PROTECTED_DACL_SECURITY_INFORMATION : UNPROTECTED_DACL_SECURITY_INFORMATION),
        nullptr, nullptr, oldDacl, nullptr);
    LocalFree(temporaryDescriptor);
    LocalFree(oldDescriptor);
    Check(restored == ERROR_SUCCESS, "restore disposable ancestor DACL");
    for (const auto scope : {Operation::CompareContent, Operation::Inventory, Operation::FindFile})
    {
        JobPipe rejected;
        Check(rejected.Open(nullptr, root.handle.get(), scope) &&
              rejected.RejectFindRequest(UacListing::pagedListingRequest),
              "unrelated scope rejects the paged request before any data");
    }
    return failures ? 1 : 0;
}
