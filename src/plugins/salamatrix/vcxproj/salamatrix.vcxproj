  <Target Name="CopySalamatrixDemoPackages" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Debug' Or '$(Configuration)' == 'Release' Or '$(Configuration)' == 'Release clean'">
    <MakeDir Directories="$(OutDir)..\..\extensions\demos" />
    <Copy SourceFiles="@(DemoPackageFiles)"
          DestinationFiles="@(DemoPackageFiles->'$(OutDir)..\..\extensions\demos\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <MakeDir Directories="$(OutDir)..\..\extensions\extension-menu-builder" />
    <Copy SourceFiles="@(ExtensionMenuBuilderFiles)"
          DestinationFiles="@(ExtensionMenuBuilderFiles->'$(OutDir)..\..\extensions\extension-menu-builder\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <MakeDir Directories="$(OutDir)..\..\extensions\git-worktree-navigator" />
    <Copy SourceFiles="@(GitWorktreeNavigatorFiles)"
          DestinationFiles="@(GitWorktreeNavigatorFiles->'$(OutDir)..\..\extensions\git-worktree-navigator\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <MakeDir Directories="$(OutDir)..\..\extensions\file-lock-inspector" />
    <Copy SourceFiles="@(FileLockInspectorFiles)"
          DestinationFiles="@(FileLockInspectorFiles->'$(OutDir)..\..\extensions\file-lock-inspector\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <MakeDir Directories="$(OutDir)..\..\extensions\process-explorer" />
    <Copy SourceFiles="@(ProcessExplorerFiles)"
          DestinationFiles="@(ProcessExplorerFiles->'$(OutDir)..\..\extensions\process-explorer\%(RecursiveDir)%(Filename)%(Extension)')"
