;Volby pro Self-Extractor

;Toto je ukázkový soubor s volbami pro Self-Extractor. Všechny
;hodnoty zde uvedené jsou implicitní hodnoty jednotlivých proměnných.
;
;Syntaxe souboru:
;
;Řádky začínající středníkem jsou považovány za komentáře a jsou ignoro-
;vány během zpracování souboru.
;
;Všechny proměnné kromě proměnné version jsou nepovinné. Není-li
;proměnná v souboru s volbami nalezena, je použita její implicitní
;hodnota. Implicitní hodnoty pro jazykově závislé proměnné (dlg_text,
;dlg_title, button_text) jsou načteny z použitého sfx balíčku.
;
;Všechny hodnoty reprezentované řetězcem, včetně prázdných řetězců,
;musejí být uzavřeny ve dvojitých uvozovkách. Pro zapsání uvozovek do
;řetězce použijte dvě po sobě jdoucí dvojité uvozovky.
;
;Číselné hodnoty nesmějí být uzavřeny v uvozovkách.

;verze souboru s nastavením, současná verze je 2
;toto je jediná povinná proměnná

version=2

;specifikace cílového adresáře, může to být buď absolutní cesta
;nebo relativní cesta; relativní cesta je relativní k aktuálnímu adre-
;sáři, když je samorozbalitelný archív spuštěn
;na začátku (!) řetězce 'target_dir' můžete také použít předdefinované
;proměnné:
;
;  $(Temp)      dočasný adresář, nesmí být v proměnné target_dir nás-
;               ledován žádným dalším textem
;  $(ProgFiles) uživatelova složka 'Program Files'
;  $(WinDir)    windows adresář
;  $(SysDir)    systémový adresář
;  $[variable]  hodnota systémové proměnné s názvem 'variable'
;  $<regkey>    hodnota proměnné v registrech s názvem 'regkey'
;  např. SOFTWARE\Microsoft\Windows\CurrentVersion\ProgramFilesDir

target_dir=""

;určuje zda je uživatelovi povoleno změnit cílový adresář pro rozbalení
;archivu
;nastavte tuto hodnotu na 1, přejete-li si změnu povolit

allow_dir_change=1

;určuje zda se mají smazat soubory v dočasném adresáři, když
;program specifikovaný proměnnou 'command' skončí
;nastavte tuto hodnotu na 1, přejete-li si smazat soubory v dočasném
;adresáři
;použití této volby má smysl pouze tehdy, je-li 'target_dir' nastavena
;na "$(Temp)", v ostatních případech je hodnota ignorována

remove_temp=0

;Tato volba umožňuje čekat před smazáním souborů v dočasném adresáři
;na jiný program než program specifikovaný proměnnou 'Command'
;Po zakončení tohoto programu self-extractor smaže soubory v dočasném
;adresáři a sám skončí.
;Tato volba je nutná pouze v případě, že instalační program spustí
;program, který pokračuje v instalaci, zatímco původní instalační
;program skončí
;Takto se chovají např. některé verze programu Install Shield.
;Tato volba je ignorována pokud 'remove_temp' není nastaven na 1.

wait_for=""

;určuje zda začít rozbalování automaticky po spuštění samorozba-
;litelného archivu
;nastavte tuto hodnotu na 1, přejete-li si, aby rozbalování začalo
;automaticky

autostart=0

;určuje zda zobrazit dialogové okénko informující o úspěšnosti
;rozbalování archivu
;nastavte tuto hodnotu na 1, přejete-li si zobrazit toto okénko

show_summary=1

;určuje zda zobrazit dialogové okénko programu
;nastavte tuto hodnotu na 1, přejete-li si zobrazit toto okénko
;použití této volby má smysl pouze tehdy, je-li 'autostart' nastavena
;na 1, v ostatních případech je hodnota ignorována

hide_dlg=0

;určuje zda automaticky přepisovat soubory v cílovém adresáři
;nastavte tuto hodnotu na 1, přejete-li si automatické přepisování
;souborů

ovewrite_all=0

;určuje zda automaticky vytvořit cílový adresář bez dotazování uživatele
;nastavte tuto hodnotu na 1, přejete-li si automatické vytváření cílového
;adresáře

create_target_dir=0

;program, http link nebo dokument, který má být spuštěn/otevřen
;když je archiv úspěšně rozbalen, cesta je relativní k cílovému adre-
;sáři, do kterého je archiv rozbalován, u programu můžete také uvést
;jeho parametry pro spuštění

command=""

;sfx balíček, který má být použit pro tvorbu samorozbalitelného
;archivu; relativní cesta je relativní k adresáři se zip2sfx.exe

sfxpackage="..\sfx\czech.sfx"

;tlačítka ve volitelném dialogovém okénku
;může být jedna z následujících: "ok", "ok_cancel", "yes_no",
;"agree_disagree"

mbox_buttons="ok"

;typ volitelného dialogového okénka
;může být jedna z následujících: "simple", "exclamation", "information",
;"question", "long_message"

mbox_type="simple"

;text a titulek volitelného dialogového okénka, které je zobrazeno
;než začne rozbalování archivu
;nepřejete-li si zobrazit žádné okénko nechte hodnoty obou proměnných
;prázdné("")

mbox_text=""
mbox_title=""

;text, který bude zobrazen v hlavním dialogovém okénku

dlg_text="Tento program rozbalí ZIP archiv."

;titulek hlavního dialogového okénka

dlg_title="Samorozbalitelný ZIP archiv"

;text tlačítka 'rozbalit' v hlavním dialogovém okénku

button_text="&Rozbalit"

;jméno firmy v levém dolním rohu dialogového okénka

vendor="Self-Extractor © 2000-2026 Open Salamander Authors"

;www odkaz v pravém dolním rohu dialogového okénka

link="https://www.altap.cz"

;soubor obsahující ikonu, může to být buď ICO soubor nebo PE spusti-
;telný modul (jako jsou win32 EXE a DLL soubory) obsahující ikonu
;relativní cesta je relativní k adresáři se zip2sfx.exe

icon_file="..\zip.spl"

;kladná hodnota znamená index ikony (pořadové číslo) ve spustitelném
;souboru specifikovaném proměnnou 'icon_file'
;záporná hodnota znamená resource ID ikony
;pro ICO soubory je index vždy 0 a hodnota proměnné je ignorována

icon_index=-500

;požadovat práva administrátora na OS Windows Vista nebo pozdějším

requires_administrative_privileges=1
