namespace SalamanderDiskSelection { @@CONVERSIONS@@ }
struct Row
{
    std::wstring Name, Full, Directory;
    CSalamanderDiskSelectionItem Item = {};
    void Bind()
    {
        Item.NameW = Name.c_str(); Item.FullPathW = Full.c_str(); Item.DirectoryW = Directory.c_str();
        Item.RelativePathW = Name.c_str(); Item.ExtensionW = L"";
    }
};
struct CSalamanderGeneralAbstract
{
    std::vector<Row> Rows;
    std::wstring Target;
    bool FailCapture = false;
    int TargetType = PATH_TYPE_WINDOWS;
    int Errors = 0;
    int CaptureMode = -1;
    std::vector<std::string> Notifications;
    BOOL GetPanelPath(int, char* value, int capacity, int* type, void*)
    {
        if (type) *type = TargetType;
        const std::string path = SalamanderDiskSelection::Utf8FromWide(Target.c_str());
        return strcpy_s(value, static_cast<size_t>(capacity), path.c_str()) == 0;
    }
    HWND GetMsgBoxParent() { return NULL; }
    void SalUpdateDefaultDir(BOOL) {}
    int ShowMessageBox(const char*, const char*, int) { ++Errors; return IDYES; }
    int SalMessageBox(HWND, const char*, const char*, UINT) { return IDYES; }
    void PostChangeOnPathNotification(const char* path, BOOL) { Notifications.push_back(path); }
    const char* SalPathFindFileName(const char* path)
    { const char* name = strrchr(path, '\\'); return name ? name + 1 : path; }
    UINT32 UpdateCrc32(const void* data, DWORD count, UINT32 value)
    {
        value = ~value;
        const BYTE* bytes = static_cast<const BYTE*>(data);
        for (DWORD i = 0; i < count; ++i)
        {
            value ^= bytes[i];
            for (int bit = 0; bit < 8; ++bit) value = (value >> 1) ^ (0xedb88320U & (0U - (value & 1U)));
        }
        return ~value;
    }
};
class CSalamanderDiskSelection
{
    std::vector<Row> Rows;
public:
    BOOL Capture(CSalamanderGeneralAbstract* general, int, DWORD mode = 0)
    {
        Rows.clear(); general->CaptureMode = static_cast<int>(mode);
        if (general->FailCapture) { SetLastError(ERROR_NOT_SUPPORTED); return FALSE; }
        bool anySelected = false;
        for (const Row& row : general->Rows) anySelected = anySelected || row.Item.Selected != FALSE;
        for (const Row& row : general->Rows)
        {
            if (row.Name == L"..") continue;
            if (mode == 0 && !(anySelected ? row.Item.Selected : row.Item.Focused)) continue;
            if (mode == 1 && !row.Item.Selected) continue;
            if (mode == 2 && !row.Item.Focused) continue;
            Rows.push_back(row);
        }
        for (Row& row : Rows) row.Bind();
        return TRUE;
    }
    int GetCount() const { return static_cast<int>(Rows.size()); }
    const CSalamanderDiskSelectionItem* GetItem(int i) const
    { return i >= 0 && static_cast<size_t>(i) < Rows.size() ? &Rows[static_cast<size_t>(i)].Item : NULL; }
};
@@PATHS@@
CSalamanderGeneralAbstract General;
CSalamanderGeneralAbstract* SalamanderGeneral = &General;
BOOL configIncludeFileExt = TRUE, configCreateBatchFile = TRUE;
BOOL configSplitToOther = FALSE, configCombineToOther = FALSE, configSplitToSubdir = FALSE;
static int checks = 0, failures = 0;
#define CHECK(x) do { ++checks; if (!(x)) { ++failures; printf("FAIL line %d: %s (error %lu)\n", __LINE__, #x, GetLastError()); } } while (0)
static const char* LoadStr(int id)
{
    if (id == IDS_BATFILE_DESCR) return "Combine %s";
    return "Fixture";
}
static BOOL Error(int, int, ...) { ++General.Errors; return FALSE; }
static BOOL Error2(HWND, int, int, ...) { ++General.Errors; return FALSE; }
static void GetInfo(char* value, CQuadWord& size) { sprintf_s(value, 50, "%llu", size.Value); }
static void StripExtension(char* name) { if (char* dot = strrchr(name, '.')) *dot = 0; }
static void MakeDirectories(const std::string& directory)
{
    std::filesystem::create_directories(SplitCBNPaths::ApiPath(directory.c_str()));
}
struct SAFE_FILE { HANDLE HFile = INVALID_HANDLE_VALUE; };
struct SafeFileService
{
    bool FailNextRead = false;
    std::string ReplaceTargetWithHardlink;
    std::vector<std::string> Opened, Created;
    BOOL SafeFileOpen(SAFE_FILE* file, const char* path, DWORD access, DWORD share, DWORD disposition, DWORD flags, HWND, DWORD, void*, void*)
    {
        Opened.push_back(path);
        file->HFile = CreateFileW(SplitCBNPaths::ApiPath(path).c_str(), access, share, NULL, disposition, flags, NULL);
        return file->HFile != INVALID_HANDLE_VALUE;
    }
    HANDLE SafeFileCreate(const char* path, DWORD access, DWORD share, DWORD flags, BOOL directory, HWND,
                          const char*, const char*, DWORD*, BOOL, BOOL* skip, void*, int, void*, SAFE_FILE* file)
    {
        Created.push_back(path);
        if (skip) *skip = FALSE;
        if (directory) { MakeDirectories(path); return reinterpret_cast<HANDLE>(1); }
        MakeDirectories(SplitCBNPaths::Parent(path));
        if (!ReplaceTargetWithHardlink.empty())
        {
            CHECK(DeleteFileW(SplitCBNPaths::ApiPath(path).c_str()));
            CHECK(CreateHardLinkW(SplitCBNPaths::ApiPath(path).c_str(), SplitCBNPaths::ApiPath(ReplaceTargetWithHardlink.c_str()).c_str(), NULL));
            ReplaceTargetWithHardlink.clear();
        }
        file->HFile = CreateFileW(SplitCBNPaths::ApiPath(path).c_str(), access, share, NULL, CREATE_ALWAYS, flags, NULL);
        return file->HFile;
    }
    void SafeFileClose(SAFE_FILE* file) { CloseHandle(file->HFile); file->HFile = INVALID_HANDLE_VALUE; }
    BOOL SafeFileRead(SAFE_FILE* file, void* data, DWORD size, DWORD* read, HWND, DWORD, void*, void*)
    {
        if (FailNextRead) { FailNextRead = false; SetLastError(ERROR_READ_FAULT); return FALSE; }
        return ReadFile(file->HFile, data, size, read, NULL);
    }
    BOOL SafeFileWrite(SAFE_FILE* file, const void* data, DWORD size, DWORD* written, HWND, DWORD, void*, void*)
    { return WriteFile(file->HFile, data, size, written, NULL); }
    BOOL SafeFileSeekMsg(SAFE_FILE* file, CQuadWord* distance, DWORD method, HWND, DWORD, void*, void*, BOOL)
    {
        LARGE_INTEGER amount; amount.QuadPart = static_cast<LONGLONG>(distance->Value);
        return SetFilePointerEx(file->HFile, amount, NULL, method);
    }
} SafeFiles;
SafeFileService* SalamanderSafeFile = &SafeFiles;
class CSalamanderForOperationsAbstract
{
public:
    int ProgressDepth = 0;
    void OpenProgressDialog(const char*, BOOL, HWND, BOOL) { ++ProgressDepth; }
    void CloseProgressDialog() { --ProgressDepth; }
    void ProgressSetTotalSize(CQuadWord, CQuadWord) {}
    BOOL ProgressSetSize(CQuadWord, CQuadWord, BOOL) { return TRUE; }
    void ProgressDialogAddText(const char*, BOOL) {}
} Operations;
const int dtDelete = 1;
template<class T> class TIndirectArray
{
    std::vector<T*> Values;
public:
    int Count = 0;
    TIndirectArray(int, int, int) {}
    ~TIndirectArray() { for (T* item : Values) free(item); }
    void Add(T* item) { Values.push_back(item); Count = static_cast<int>(Values.size()); }
    bool IsGood() const { return true; }
    T* operator[](int index) const { return Values[static_cast<size_t>(index)]; }
};
static std::string DialogTarget, DialogName;
static std::vector<std::string> DialogFiles;
static BOOL SplitDialog(const char* name, CQuadWord&, std::string& target, const char*, CQuadWord*, HWND)
{ DialogName = name; DialogTarget = target; return FALSE; }
static BOOL CombineDialog(TIndirectArray<char>& files, std::string& target, BOOL, UINT32, HWND, CSalamanderForOperationsAbstract*)
{
    DialogTarget = target; DialogFiles.clear();
    for (int i = 0; i < files.Count; ++i) DialogFiles.push_back(files[i]);
    return FALSE;
}
