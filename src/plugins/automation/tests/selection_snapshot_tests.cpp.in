struct CQuadWord
{
    unsigned long long Value;
    CQuadWord(DWORD low = 0, DWORD high = 0) : Value((static_cast<unsigned long long>(high) << 32) | low) {}
};
@@SDK_ITEM@@
namespace SalamanderDiskSelection { @@CONVERSIONS@@ }
struct CFileData
{
    const char* Name = NULL;
    const wchar_t* NameW = NULL;
    const char* Ext = "png";
    CQuadWord Size;
    DWORD Attr = FILE_ATTRIBUTE_ARCHIVE;
    FILETIME LastWrite = {};
    BOOL SizeValid = TRUE, Hidden = FALSE, IsLink = FALSE, IsOffline = FALSE;
    BOOL UseWideName() const { return NameW != NULL; }
};
struct Row
{
    std::wstring Name, Full, Extension = L"png";
    std::string EncodedName;
    CSalamanderDiskSelectionItem Item = {};
    CFileData Data;
    void Bind()
    {
        Item.NameW = Name.c_str(); Item.FullPathW = Full.c_str(); Item.ExtensionW = Extension.c_str();
        EncodedName = SalamanderDiskSelection::Utf8FromWide(Name.c_str());
        Data.Name = EncodedName.c_str(); Data.NameW = Name.c_str();
        Data.Size = Item.Size; Data.Attr = Item.Attr; Data.LastWrite = Item.LastWrite;
        Data.SizeValid = Item.SizeValid; Data.Hidden = Item.Hidden; Data.IsLink = Item.IsLink; Data.IsOffline = Item.IsOffline;
    }
};
class CSalamanderGeneralAbstract
{
public:
    int Type = PATH_TYPE_WINDOWS;
    bool FailCapture = false;
    int CaptureCalls = 0;
    std::wstring Root = L"C:\\root";
    std::vector<Row> Rows;
    void Seal() { for (Row& row : Rows) row.Bind(); }
    BOOL GetPanelPath(int, char* path, int capacity, int* type, char**)
    {
        if (type != NULL) *type = Type;
        if (path == NULL) return TRUE;
        const std::string value = SalamanderDiskSelection::Utf8FromWide(Root.c_str());
        return SUCCEEDED(StringCchCopyA(path, static_cast<size_t>(capacity), value.c_str()));
    }
    int GetSourcePanel() const { return PANEL_LEFT; }
    BOOL GetPanelSelection(int, int* files, int* dirs)
    {
        *files = *dirs = 0;
        for (const Row& row : Rows) if (row.Item.Selected) (row.Item.IsDir ? *dirs : *files)++;
        return TRUE;
    }
    const CFileData* GetPanelItem(int, int* cursor, BOOL* isDir)
    {
        if (*cursor < 0 || static_cast<size_t>(*cursor) >= Rows.size()) return NULL;
        Row& row = Rows[static_cast<size_t>((*cursor)++)];
        if (isDir != NULL) *isDir = row.Item.IsDir;
        return &row.Data;
    }
    const CFileData* GetPanelSelectedItem(int, int* cursor, BOOL* isDir)
    {
        while (*cursor >= 0 && static_cast<size_t>(*cursor) < Rows.size())
        {
            Row& row = Rows[static_cast<size_t>((*cursor)++)];
            if (!row.Item.Selected) continue;
            if (isDir != NULL) *isDir = row.Item.IsDir;
            return &row.Data;
        }
        return NULL;
    }
    const CFileData* GetPanelFocusedItem(int, BOOL* isDir)
    {
        for (Row& row : Rows) if (row.Item.Focused)
        {
            if (isDir != NULL) *isDir = row.Item.IsDir;
            return &row.Data;
        }
        return NULL;
    }
};
class CSalamanderDiskSelection
{
    std::vector<Row> Rows;
    std::wstring Root;
public:
    const wchar_t* GetRootPathW() const { return Root.c_str(); }
    BOOL Capture(CSalamanderGeneralAbstract* general, int, DWORD mode)
    {
        Rows.clear(); Root = general->Root; ++general->CaptureCalls;
        if (general->FailCapture) { SetLastError(ERROR_RETRY); return FALSE; }
        for (const Row& row : general->Rows)
        {
            if (row.Name == L"..") continue;
            if (mode == SALDISKSELECTION_SELECTED_ONLY && !row.Item.Selected) continue;
            if (mode == SALDISKSELECTION_FOCUSED_ONLY && !row.Item.Focused) continue;
            Rows.push_back(row);
        }
        for (Row& row : Rows) row.Bind();
        return TRUE;
    }
    int GetCount() const { return static_cast<int>(Rows.size()); }
    const CSalamanderDiskSelectionItem* GetItem(int index) const
    { return index >= 0 && static_cast<size_t>(index) < Rows.size() ? &Rows[static_cast<size_t>(index)].Item : NULL; }
};
CSalamanderGeneralAbstract* SalamanderGeneral = NULL;

// Minimal COM shell lets the actual item property/storage code run unchanged.
struct ISalamanderPanelItem : IDispatch
{
    virtual HRESULT STDMETHODCALLTYPE get_Path(BSTR*) = 0;
    virtual HRESULT STDMETHODCALLTYPE get_Name(BSTR*) = 0;
    virtual HRESULT STDMETHODCALLTYPE get_Size(VARIANT*) = 0;
    virtual HRESULT STDMETHODCALLTYPE get_DateLastModified(DATE*) = 0;
    virtual HRESULT STDMETHODCALLTYPE get_Attributes(int*) = 0;
};
struct ISalamanderPanelItemCollection : IDispatch
{
    virtual HRESULT STDMETHODCALLTYPE get_Item(VARIANT, ISalamanderPanelItem**) = 0;
    virtual HRESULT STDMETHODCALLTYPE get_Count(long*) = 0;
    virtual HRESULT STDMETHODCALLTYPE get__NewEnum(IUnknown**) = 0;
};
static int LiveDispatchObjects = 0;
template<class Derived, class Interface> class CDispatchImpl : public Interface
{
    ULONG References = 1;
public:
    CDispatchImpl() { ++LiveDispatchObjects; }
    ~CDispatchImpl() { --LiveDispatchObjects; }
    HRESULT STDMETHODCALLTYPE QueryInterface(REFIID, void** result) { *result = static_cast<Interface*>(this); AddRef(); return S_OK; }
    ULONG STDMETHODCALLTYPE AddRef() { return ++References; }
    ULONG STDMETHODCALLTYPE Release() { ULONG remaining = --References; if (!remaining) delete static_cast<Derived*>(this); return remaining; }
    HRESULT STDMETHODCALLTYPE GetTypeInfoCount(UINT* count) { *count = 0; return S_OK; }
    HRESULT STDMETHODCALLTYPE GetTypeInfo(UINT, LCID, ITypeInfo**) { return E_NOTIMPL; }
    HRESULT STDMETHODCALLTYPE GetIDsOfNames(REFIID, LPOLESTR*, UINT, LCID, DISPID*) { return E_NOTIMPL; }
    HRESULT STDMETHODCALLTYPE Invoke(DISPID, REFIID, LCID, WORD, DISPPARAMS*, VARIANT*, EXCEPINFO*, UINT*) { return E_NOTIMPL; }
};
static void QuadWordToVariant(LARGE_INTEGER size, VARIANT* value)
{ VariantInit(value); V_VT(value) = VT_UI8; V_UI8(value) = static_cast<ULONGLONG>(size.QuadPart); }
