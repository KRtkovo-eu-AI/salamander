<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutDir>$(OPENSAL_BUILD_DIR)salamander\$(Configuration)_$(ShortPlatform)\plugins\extension-runtimes\$(ProjectName)\</OutDir>
    <IntDir>$(OutDir)Intermediate\</IntDir>
    <LuaVcpkgRoot>$(MSBuildThisFileDirectory)..\..\..\..\build\vcpkg_installed_third_party\$(ShortPlatform)-windows</LuaVcpkgRoot>
    <LuaToolsDir>$(LuaVcpkgRoot)\tools\lua</LuaToolsDir>
    <LuaLicenseFile>$(LuaVcpkgRoot)\share\lua\copyright</LuaLicenseFile>
    <TargetExt>.spl</TargetExt>
    <IgnoreImportLibrary>true</IgnoreImportLibrary>
    <GenerateManifest>false</GenerateManifest>
    <EmbedManifest>false</EmbedManifest>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalOptions>/MP /J %(AdditionalOptions)</AdditionalOptions>
      <AdditionalIncludeDirectories>..\..\shared;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>_MT;WIN32;_WINDOWS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>precomp.h</PrecompiledHeaderFile>
      <WarningLevel>Level3</WarningLevel>
    </ClCompile>
    <Link>
      <AdditionalDependencies>comctl32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <SubSystem>Windows</SubSystem>
      <OutputFile>$(OutDir)$(ProjectName).spl</OutputFile>
      <AdditionalLibraryDirectories>..\..\shared\libs\$(ShortPlatform);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <ModuleDefinitionFile>..\$(ProjectName).def</ModuleDefinitionFile>
    </Link>
    <ResourceCompile>
      <Culture>0x0409</Culture>
      <AdditionalIncludeDirectories>..\..\shared;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ResourceCompile>
  </ItemDefinitionGroup>
  <Target Name="CopyBundledLuaRuntime" AfterTargets="Build">
    <Error Condition="!Exists('$(LuaToolsDir)\lua.exe')" Text="Bundled Lua interpreter not found. Run tools\vcpkg\build-third-party-libs.ps1 -Triplet $(ShortPlatform)-windows." />
    <Error Condition="!Exists('$(LuaToolsDir)\lua.dll')" Text="Bundled Lua runtime DLL not found. Run tools\vcpkg\build-third-party-libs.ps1 -Triplet $(ShortPlatform)-windows." />
    <Error Condition="!Exists('$(LuaLicenseFile)')" Text="Lua license notice not found in the vcpkg installation." />
    <MakeDir Directories="$(OutDir)runtime" />
    <Copy SourceFiles="$(LuaToolsDir)\lua.exe;$(LuaToolsDir)\lua.dll;$(LuaLicenseFile)"
          DestinationFiles="$(OutDir)runtime\lua.exe;$(OutDir)runtime\lua.dll;$(OutDir)runtime\LICENSE-LUA.txt"
          SkipUnchangedFiles="true" />
  </Target>
</Project>

