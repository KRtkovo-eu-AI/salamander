[STRINGTABLE 0]
100,1,"DiskDir"
101,1,"Створює та переглядає файлові каталоги, сумісні з DiskDir у Total Commander."
102,1,"DiskDir"
103,1,"Про DiskDir"
104,1,"Вбудована підтримка каталогів, сумісних із DiskDir.\n\nФайли каталогів містять імена, розміри й часові мітки, а не вміст файлів."
105,1,"Каталог DiskDir"
106,1,"Шлях до каталогу неправильний або надто довгий."
107,1,"Назва каталогу вже використовується директорією."
108,1,"Каталог уже існує:\n\n"
109,1,"\n\nПерезаписати його?"
110,1,"Каталоги DiskDir не зберігають вміст файлів, тому вихідні файли не можна перемістити."
111,1,"Додавання записів до наявного каталогу DiskDir не підтримується."

[STRINGTABLE 1]
112,1,"Не вдалося створити каталог DiskDir."
113,1,"Оригінальний файл, записаний у каталозі, недоступний."
114,1,"Один або кілька оригінальних файлів, записаних у каталозі, недоступні."
115,1,"Не вдалося відкрити каталог."
116,1,"Каталог завеликий."
117,1,"Не вдалося прочитати каталог."
118,1,"Каталог UTF-8 містить неправильний текст."
119,1,"Файл не містить правильного каталогу DiskDir."
120,1,"Не вдалося записати каталог DiskDir."

