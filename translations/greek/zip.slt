[STRINGTABLE 14]
1200,1,"Η ζητούμενη λειτουργία δεν υποστηρίζεται για αρχειοθήκες ZIP64. Μπορούν μόνο να προβληθούν και να αποσυμπιεστούν."
1201,1," (διαθέσιμο μόνο στην πλήρη έκδοση)"
1202,1,"Δημιουργία, περιήγηση και εξαγωγή αρχείων ZIP."
1208,1,"Παρουσιάστηκε σφάλμα στη ροή BZIP2. Η αρχειοθήκη ίσως είναι κατεστραμμένη."
1209,1,"Ο κεντρικός κατάλογος της αρχειοθήκης που περιέχει τη λίστα αρχείων είναι κρυπτογραφημένος ή συμπιεσμένος.\nΑυτό δεν υποστηρίζεται."
1210,1,";Ρυθμίσεις αυτοαποσυμπιεστή\r\n\r\n;Αυτό είναι αρχείο ρυθμίσεων για τον αυτοαποσυμπιεστή.\r\n;\r\n;Σύνταξη μορφής αρχείου:\r\n;\r\n"
1211,1,";Οι γραμμές που αρχίζουν με τον χαρακτήρα ';' θεωρούνται σχόλια και\r\n;αγνοούνται κατά την επεξεργασία του αρχείου ρυθμίσεων.\r\n;\r\n"
1212,1,";Όλες οι μεταβλητές εκτός από την έκδοση είναι προαιρετικές. Αν η μεταβλητή δεν\r\n;υπάρχει στο αρχείο ρυθμίσεων, χρησιμοποιείται η προεπιλεγμένη τιμή της.\r\n;Οι προεπιλεγμένες τιμές για τις μεταβλητές που εξαρτώνται από τη γλώσσα (dlg_text, dlg_title,\r\n;button_text) λαμβάνονται από το πακέτο SFX.\r\n;\r\n"
1213,1,";Όλες οι τιμές συμβολοσειράς, συμπεριλαμβανομένων των κενών, πρέπει να\r\n;περικλείονται σε διπλά εισαγωγικά. Για εισαγωγικά μέσα στη συμβολοσειρά, πληκτρολογήστε δύο\r\n;διαδοχικά διπλά εισαγωγικά.\r\n;\r\n;Οι αριθμοί δεν πρέπει να περικλείονται σε εισαγωγικά.\r\n\r\n"
1214,1,"\r\n;έκδοση του αρχείου ρυθμίσεων, τρέχουσα έκδοση 2\r\n;αυτή είναι η μόνη υποχρεωτική μεταβλητή\r\n\r\n"
1215,1,"\r\n;καθορισμός καταλόγου προορισμού, μπορεί να είναι απόλυτη ή\r\n;σχετική διαδρομή· η σχετική διαδρομή ξεκινά από τον τρέχοντα κατάλογο\r\n;όταν εκκινηθεί το εκτελέσιμο SFX\r\n"

[STRINGTABLE 15]
1216,1,";μπορείτε επίσης να χρησιμοποιήσετε προκαθορισμένες μεταβλητές στην αρχή (!)\r\n;της συμβολοσειράς 'target_dir':\r\n;\r\n"
1217,1,";  $(Temp)      προσωρινός κατάλογος, πρέπει να εμφανίζεται μόνος\r\n;               του στο πεδίο target_dir, χωρίς άλλη διαδρομή\r\n"
1218,1,";  $(ProgFiles) φάκελος 'Program Files' του χρήστη\r\n;  $(WinDir)    κατάλογος Windows\r\n;  $(SysDir)    κατάλογος συστήματος\r\n"
1219,1,";  $[variable]  τιμή μεταβλητής περιβάλλοντος που περιγράφεται από\r\n;               το 'variable'\r\n;  $<regkey>    τιμή κλειδιού μητρώου που περιγράφεται από το 'regkey'\r\n;  π.χ. SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\ProgramFilesDir\r\n\r\n"
1220,1,"\r\n;καθορίζει αν ο χρήστης μπορεί να αλλάξει τον κατάλογο προορισμού\r\n;κατά την αποσυμπίεση\r\n;ορίστε την τιμή σε 1 για ενεργοποίηση\r\n\r\n"
1221,1,"\r\n;καθορίζει αν θα αφαιρεθούν τα αποσυμπιεσμένα αρχεία από τον\r\n;προσωρινό φάκελο όταν τερματιστεί το πρόγραμμα της μεταβλητής 'command'\r\n"
1222,1,";ορίστε την τιμή σε 1 για αφαίρεση των προσωρινών αρχείων\r\n;η μεταβλητή έχει νόημα μόνο αν το 'target_dir' έχει οριστεί σε\r\n;"$(Temp)", διαφορετικά η τιμή αγνοείται\r\n\r\n"
1223,1,"\r\n;καθορίζει αν η αποσυμπίεση θα ξεκινά αυτόματα κατά την εκτέλεση\r\n;αυτοαποσυμπιεζόμενης αρχειοθήκης\r\n;ορίστε την τιμή σε 1 για αυτόματη έναρξη της αποσυμπίεσης\r\n\r\n"
1224,0,"\r\n;specify whether to show a message box notifying of the operation\r\n;success after files extracting is finished\r\n;set its value to 1 if you want to show operation summary\r\n\r\n"
1225,0,"\r\n;specify whether to show the main dialog of self-extractor\r\n;set its value to 1 if you don't want to show the main sfx dialog\r\n;use of this variable makes sense only if 'autostart' is set to 1,\r\n;otherwise the value is ignored\r\n\r\n"
1226,0,"\r\n;specify whether to overwrite automatically all files in target\r\n;directory\r\n;set its value to 1 if you want the files to be overwritten\r\n;automatically\r\n\r\n"
1227,0,"\r\n;specify whether to create target directory automatically without asking\r\n;user\r\n;set its value to 1 if you want the target directory to be created\r\n;automatically\r\n\r\n"
1228,0,"\r\n;program, http link or document to be run/opened when the files\r\n;extraction is successfully finished, the path is relative to the\r\n;extraction target directory, if you specify a program you can also\r\n;type in its arguments\r\n\r\n"
1229,0,"\r\n;sfx package to be used when creating self-extracting archive\r\n;relative path is relative to the directory with zip2sfx.exe\r\n\r\n"
1230,0,"\r\n;buttons in the optional message box\r\n;could be one of the following: "ok", "ok_cancel", "yes_no",\r\n;"agree_disagree"\r\n\r\n"
1231,0,"\r\n;type of the optional message box\r\n;could be one of the following: "simple", "exclamation", "information",\r\n;"question", "long_message"\r\n\r\n"

[STRINGTABLE 16]
1232,0,"\r\n;text and title of the optional message box, which is shown before\r\n;the extraction begins\r\n;if you don't want to display any message box leave both fields\r\n;empty ("")\r\n\r\n"
1233,0,"\r\n;text which will be displayed in the main self-extractor's dialog\r\n\r\n"
1234,0,"\r\n;title of the main self-extractor's dialog\r\n\r\n"
1235,0,"\r\n;text in the extract button of the main sfx dialog\r\n\r\n"
1236,0,"\r\n;vendor name in bottom-left corner of main sfx dialog\r\n\r\n"
1237,0,"\r\n;www link in bottom-right corner of main sfx dialog\r\n\r\n"
1238,0,"\r\n;files containing icon data, it can be either an ICO file or an PE\r\n;executable file (like win32 EXEs or DLLs) containing the icon\r\n;relative path is relative to the directory with zip2sfx.exe\r\n\r\n"
1239,0,"\r\n;positive value means the index of an icon in the executable file\r\n;specified by 'icon_file' variable\r\n;negative value means a resource ID of the icon\r\n;for ICO files the index is always 0 and its value is ignored\r\n\r\n"
1240,0,"\r\n;This option enables you to wait for another process than the process\r\n;you specified in the field 'Command'. After this process is finished\r\n;the self-extractor removes temporary files and then finishes itself.\r\n"
1241,0,";It is necessary only if the installation program launches another\r\n;executable which continues installation while the original installation\r\n;program is finished.\r\n"
1242,0,";In this manner behaves e.g like some versions of Install Shield.\r\n;This option is ignored unless 'remove_temp' is set to 1.\r\n\r\n"
1243,0,"\r\n;requires administrative privileges to run on Windows Vista or later\r\n\r\n"

