1210,1,";הגדרות הארכיון לחילוץ עצמי\r\n\r\n;זהו קובץ ההגדרות של הארכיון לחילוץ עצמי.\r\n;\r\n;תחביר פורמט הקובץ:\r\n;\r\n"
1211,1,";שורות המתחילות בתו ';' נחשבות להערות\r\n;ומתעלמים מהן בעת עיבוד קובץ ההגדרות.\r\n;\r\n"
1212,1,";כל המשתנים מלבד version הם אופציונליים. אם משתנה אינו נמצא\r\n;בקובץ ההגדרות, ייעשה שימוש בערך ברירת המחדל שלו.\r\n;ערכי ברירת המחדל של משתנים התלויים בשפה (dlg_text, dlg_title,\r\n;button_text) נלקחים מחבילת SFX.\r\n;\r\n"
1213,1,";יש להקיף את כל ערכי המחרוזות, כולל מחרוזות ריקות,\r\n;במרכאות כפולות. כדי לכלול מרכאות כפולות במחרוזת, יש להקליד\r\n;שתי מרכאות כפולות רצופות.\r\n;\r\n;אין להקיף מספרים במרכאות כפולות.\r\n\r\n"
1214,1,"\r\n;גרסת קובץ ההגדרות, הגרסה הנוכחית היא 2\r\n;זהו המשתנה היחיד שחובה לציין\r\n\r\n"
1215,1,"\r\n;ציון תיקיית היעד: אפשר לציין נתיב מוחלט או יחסי\r\n;הנתיב היחסי מחושב ביחס לתיקייה הנוכחית\r\n;בעת הפעלת קובץ SFX\r\n"

[STRINGTABLE 15]
1216,1,";אפשר להשתמש גם במשתנים מוגדרים מראש בתחילת (!)\r\n;המחרוזת 'target_dir':\r\n;\r\n"
1217,1,";  $(Temp)      תיקייה זמנית שיש לציין לבדה\r\n;               בשדה target_dir, ללא המשך נתיב\r\n;               או רכיב נתיב נוסף\r\n"
1218,1,";  $(ProgFiles) תיקיית Program Files של המשתמש\r\n;  $(WinDir)    תיקיית Windows\r\n;  $(SysDir)    תיקיית המערכת\r\n"
1219,1,";  $[variable]  ערך משתנה הסביבה שמתואר על ידי\r\n;               'variable'\r\n;  $<regkey>    ערך מפתח הרישום שמתואר על ידי 'regkey'\r\n;  לדוגמה SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\ProgramFilesDir\r\n\r\n"
1220,1,"\r\n;ציין אם המשתמש יכול לשנות את תיקיית היעד\r\n;במהלך החילוץ\r\n;הגדר את הערך ל־1 כדי להפעיל אפשרות זו\r\n\r\n"
1221,1,"\r\n;ציין אם להסיר את הקבצים שחולצו מהתיקייה הזמנית\r\n;לאחר שהתוכנית שצוינה במשתנה 'command' תסתיים\r\n"
1222,1,";הגדר את הערך ל־1 כדי להסיר את הקבצים הזמניים\r\n;יש להשתמש במשתנה זה רק אם 'target_dir' מוגדר לערך\r\n;"$(Temp)"; אחרת המערכת תתעלם מהערך\r\n\r\n"
1223,1,"\r\n;ציין אם להתחיל חילוץ אוטומטית בעת הפעלת\r\n;ארכיון לחילוץ עצמי\r\n;הגדר ל־1 כדי להתחיל את החילוץ אוטומטית\r\n\r\n"
1224,1,"\r\n;ציין אם להציג הודעה על הצלחת הפעולה לאחר\r\n;סיום חילוץ הקבצים\r\n;הגדר את הערך ל־1 כדי להציג סיכום פעולה\r\n\r\n"
1225,1,"\r\n;ציין אם להציג את תיבת הדו־שיח הראשית של הארכיון לחילוץ עצמי\r\n;הגדר את הערך ל־1 כדי להסתיר את תיבת הדו־שיח הראשית של SFX\r\n;אפשר להשתמש במשתנה זה רק אם 'autostart' מוגדר ל־1;\r\n;אחרת המערכת תתעלם מהערך\r\n\r\n"
1226,1,"\r\n;ציין אם להחליף אוטומטית את כל הקבצים\r\n;בתיקיית היעד\r\n;הגדר את הערך ל־1 כדי להפעיל החלפה\r\n;אוטומטית\r\n\r\n"
1227,1,"\r\n;ציין אם ליצור את תיקיית היעד אוטומטית\r\n;ללא בקשת אישור מהמשתמש\r\n;הגדר ל־1 כדי ליצור את תיקיית היעד\r\n;אוטומטית\r\n\r\n"
1228,1,"\r\n;תוכנית, קישור HTTP או מסמך להפעלה או לפתיחה\r\n;לאחר סיום חילוץ הקבצים בהצלחה. הנתיב יחסי\r\n;לתיקיית היעד של החילוץ. כשמציינים תוכנית,\r\n;אפשר להזין גם את הארגומנטים שלה\r\n\r\n"
1229,1,"\r\n;חבילת SFX לשימוש בעת יצירת ארכיון לחילוץ עצמי\r\n;נתיב יחסי מחושב ביחס לתיקייה שבה נמצא zip2sfx.exe\r\n\r\n"
1230,1,"\r\n;הלחצנים בתיבת ההודעה האופציונלית\r\n;אפשר לבחור אחד מהערכים הבאים: "ok", "ok_cancel", "yes_no",\r\n;"agree_disagree"\r\n\r\n"
1231,1,"\r\n;סוג תיבת ההודעה האופציונלית\r\n;אפשר לבחור אחד מהערכים הבאים: "simple", "exclamation", "information",\r\n;"question", "long_message"\r\n\r\n"

[STRINGTABLE 16]
1232,1,"\r\n;הטקסט והכותרת של תיבת ההודעה האופציונלית\r\n;שמוצגת לפני תחילת החילוץ\r\n;כדי להסתיר את תיבת ההודעה, השאר את שני\r\n;השדות ריקים ("")\r\n\r\n"
1233,1,"\r\n;הטקסט שיוצג בתיבת הדו־שיח הראשית של הארכיון לחילוץ עצמי\r\n\r\n"
1234,1,"\r\n;כותרת תיבת הדו־שיח הראשית של הארכיון לחילוץ עצמי\r\n\r\n"
1235,1,"\r\n;הטקסט בלחצן החילוץ בתיבת הדו־שיח הראשית של SFX\r\n\r\n"
1236,1,"\r\n;שם הספק בפינה השמאלית התחתונה של תיבת הדו־שיח הראשית של SFX\r\n\r\n"
1237,1,"\r\n;קישור האינטרנט בפינה הימנית התחתונה של תיבת הדו־שיח הראשית של SFX\r\n\r\n"
1238,1,"\r\n;קבצים המכילים נתוני סמל: קובץ ICO או קובץ PE להרצה\r\n;(כגון EXE או DLL של Win32) שמכיל את הסמל\r\n;נתיב יחסי מחושב ביחס לתיקייה שבה נמצא zip2sfx.exe\r\n\r\n"
1239,1,"\r\n;ערך חיובי מציין את האינדקס של סמל בקובץ ההרצה\r\n;שצוין במשתנה 'icon_file'\r\n;ערך שלילי מציין את מזהה המשאב של הסמל\r\n;בקובצי ICO האינדקס הוא תמיד 0 ומתעלמים מערכו\r\n\r\n"
1240,1,"\r\n;אפשרות זו מאפשרת להמתין לתהליך אחר מזה שצוין בשדה 'Command'.\r\n;לאחר שהתהליך יסתיים, הארכיון לחילוץ עצמי יסיר קבצים זמניים\r\n;ויסיים לפעול.\r\n"
1241,1,";הדבר נחוץ רק אם תוכנית ההתקנה מפעילה קובץ\r\n;הרצה אחר שממשיך בהתקנה לאחר סיום פעולתה של\r\n;תוכנית ההתקנה המקורית.\r\n"
1242,1,";כך פועלות, למשל, גרסאות מסוימות של Install Shield.\r\n;מתעלמים מאפשרות זו אלא אם 'remove_temp' מוגדר ל־1.\r\n\r\n"
1243,1,"\r\n;נדרשות הרשאות מנהל כדי לפעול ב־Windows Vista ואילך\r\n\r\n"

[STRINGTABLE 17]
1250,1,"דחוס"
1251,1,"גודל הקובץ הדחוס"
1252,1,"KB"
1253,1,"MB"
1254,1,"קובץ ZIP זה משתמש בפורמט נתונים שהגרסה הנוכחית של תוסף ZIP אינה תומכת בשינויו"
1255,1,"לא כל פריטי הארכיון חולצו. הארכיון המקורי נשמר."

