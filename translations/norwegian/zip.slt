1209,1,"Sentralkatalogen i dette arkivet som inneholder fillisten, er kryptert eller komprimert.\nDette støttes ikke."
1210,1,";Self-Extractor Settings\r\n\r\n;This is settings file for Self-Extractor.\r\n;\r\n;File format syntax:\r\n;\r\n"
1211,1,";Linjer som starter med ';', er kommentarer og ignoreres ved\r\n;behandling av innstillingsfilen.\r\n;\r\n"
1212,1,";Alle variabler unntatt version er valgfrie. Hvis variabelen ikke\r\n;finnes i innstillingsfilen, brukes standardverdien.\r\n;Standardverdier for språkavhengige variabler (dlg_text, dlg_title,\r\n;button_text) hentes fra sfx-pakken.\r\n;\r\n"
1213,1,";Alle strengverdier, også null-strenger, skal stå i\r\n;doble anførselstegn. Bruk to påfølgende doble anførselstegn for å\r\n;skrive dem i strengen.\r\n;\r\n;Tall kan ikke stå i doble anførselstegn.\r\n\r\n"
1214,1,"\r\n;versjon av innstillingsfilen, gjeldende versjon er 2\r\n;denne variabelen er obligatorisk\r\n\r\n"
1215,1,"\r\n;angivelse av målkatalogen, enten en absolutt sti\r\n;eller en relativ sti; en relativ sti er relativ til gjeldende katalog\r\n;når sfx-programmet startes\r\n"

[STRINGTABLE 15]
1216,1,";you could also use predefined variables at the beginning (!)\r\n;of the 'target_dir' string:\r\n;\r\n"
1217,1,";  $(Temp)      midlertidig katalog, skal stå alene\r\n;               i feltet target_dir ikke etterfulgt av noen bane\r\n;               del\r\n"
1218,1,";  $(ProgFiles) brukerens 'Program Files'-mappe\r\n;  $(WinDir)    windows-katalog\r\n;  $(SysDir)    systemkatalog\r\n"
1219,1,";  $[variable]  verdien av en miljøvariabel beskrevet av\r\n;               'variable'\r\n;  $<regkey>    verdien av en registernøkkel beskrevet av 'regkey'\r\n;  e.g SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\ProgramFilesDir\r\n\r\n"
1220,1,"\r\n;spesifiser om brukeren kan endre en målkatalog ved\r\n;utpakking\r\n;sett verdien til 1 hvis du vil aktivere dette\r\n\r\n"
1221,1,"\r\n;angi om ekstraherte filer i midlertidig mappe skal fjernes\r\n;når programmet som er angitt av variabelen 'command' er fullført\r\n"
1222,1,";sett verdien til 1 hvis du vil fjerne de midlertidige filene\r\n;bruk av denne variabelen gir kun mening hvis 'target_dir' er satt til\r\n;"$(Temp)", ellers blir verdien ignorert\r\n\r\n"
1223,1,"\r\n;angi om ekstraheringen skal starte automatisk når en bruker kjører\r\n;et selvutpakkende arkiv\r\n;sett verdien til 1 for automatisk start av ekstraheringen\r\n\r\n"
1224,1,"\r\n;angi om en meldingsboks skal varsle om operasjonen\r\n;var vellykket etter at filutpakkingen er fullført\r\n;sett verdien til 1 for å vise operasjonssammendrag\r\n\r\n"
1225,1,"\r\n; angi om selvutpakkerens hoveddialog skal vises\r\n; sett verdien til 1 hvis du ikke vil vise hoveddialogen for sfx\r\n; bruk av denne variabelen gir kun mening hvis 'autostart' er satt til 1,\r\n; ellers ignoreres verdien\r\n\r\n"
1226,1,"\r\n;angi om alle filer i målkatalogen\r\n;skal overskrives automatisk\r\n;sett verdien til 1 hvis du vil at filene\r\n;skal overskrives automatisk\r\n\r\n"
1227,1,"\r\n;angi om målkatalogen skal opprettes automatisk uten å spørre\r\n;bruker\r\n;sett verdien til 1 hvis du vil at målkatalogen skal opprettes\r\n;automatisk\r\n\r\n"
1228,1,"\r\n;program, http-lenke eller dokument som skal kjøres/åpnes når filene\r\n;ekstraksjonen er fullført, filbanen er relativ til\r\n;ekstraksjonsmålmappen, hvis du angir et program, kan du også\r\n;skrive inn argumentene\r\n\r\n"
1229,1,"\r\n;sfx-pakke som brukes ved oppretting av selvekstraherende arkiv\r\n;relativ bane er relativ til mappen med zip2sfx.exe\r\n\r\n"
1230,1,"\r\n;knappene i den valgfrie meldingsboksen\r\n;kan være en av følgende: "ok", "ok_cancel", "yes_no",\r\n;"agree_disagree"\r\n\r\n"
1231,1,"\r\n;type for den valgfrie meldingsboksen\r\n;kan være en av følgende: "simple", "exclamation", "information",\r\n;"question", "long_message"\r\n\r\n"

[STRINGTABLE 16]
1232,1,"\r\n;tekst og tittel for den valgfrie meldingsboksen, som vises før\r\n;utpakkingen starter\r\n;hvis du ikke vil vise en meldingsboks, la begge feltene være\r\n;tomme ("")\r\n\r\n"
1233,1,"\r\n;tekst som vil bli vist i hoveddialogen for selvutpakkeren\r\n\r\n"
1234,1,"\r\n;tittel på hoveddialogen i selvutpakkeren\r\n\r\n"
1235,1,"\r\n;tekst i pakk-ut-knappen i hoved-sfx-dialogen\r\n\r\n"
1236,1,"\r\n;leverandørnavn nederst til venstre i sfx-hoveddialog\r\n\r\n"
1237,1,"\r\n;www-lenke nederst til høyre i hoveddialog for sfx\r\n\r\n"
1238,1,"\r\n;filer som inneholder ikond data, en ICO-fil eller en kjørbar PE\r\n;fil (som win32 EXE-er eller DLL-er) som inneholder ikonet\r\n;relativ bane er relativ til katalogen med zip2sfx.exe\r\n\r\n"
1239,1,"\r\n;positiv verdi betyr indeksen til et ikon i den kjørbare filen\r\n;angitt av variabelen 'icon_file'\r\n;negativ verdi betyr en ressurs-ID for ikonet\r\n;for ICO-filer er indeksen alltid 0 og verdien ignoreres\r\n\r\n"
1240,1,"\r\n;Dette alternativet lar deg vente på en annen prosess enn prosessen\r\n;du anga i feltet 'Command'. Når denne prosessen er fullført,\r\n;fjerner selvutpakkeren midlertidige filer og avslutter seg selv.\r\n"
1241,1,";Det er bare nødvendig hvis installasjonsprogrammet starter en annen\r\n;kjørbar fil som fortsetter installasjonen mens det opprinnelige\r\n;programmet er ferdig.\r\n"
1242,1,";Oppfører den seg f.eks. som enkelte Install Shield-versjoner.\r\n;Ignoreres med mindre 'remove_temp' er satt til 1.\r\n\r\n"
1243,1,"\r\n;krever adminrettigheter for å kjøre på Windows Vista eller nyere\r\n\r\n"

