1211,1,";Merkillä ';' alkavat rivit käsitellään kommentteina ja\r\n;ohitetaan asetustiedostoa käsiteltäessä.\r\n;\r\n"
1212,1,";Versiota lukuun ottamatta kaikki ovat valinnaisia. Jos\r\n;muuttujaa ei löydy asetustiedostosta, käytetään sen oletusarvoa.\r\n;Kieliriippuvaisten muuttujien (dlg_text, dlg_title,\r\n;button_text) oletusarvot otetaan sfx-paketista.\r\n;\r\n"
1213,1,";Kaikki merkkijonoarvot, myös tyhjät, on suljettava\r\n;lainesanoihin. Jos merkkijonoon on syötettävä lainesanoja, käytä kahta\r\n;peräkkäistä lainesanaa.\r\n;\r\n;Lukuja ei voi sulkea lainesanoihin.\r\n\r\n"
1214,1,"\r\n;asetustiedoston versio, nykyinen versio on 2\r\n;tämä on ainoa pakollinen muuttuja\r\n\r\n"
1215,1,"\r\n;kohdehakemiston määritys, joko absoluuttinen polku\r\n;tai suhteellinen polku; suhteellinen polku on suhteessa nykyiseen hakemistoon\r\n;sfx-tiedoston käynnistyessä\r\n"

[STRINGTABLE 15]
1216,1,";you could also use predefined variables at the beginning (!)\r\n;of the 'target_dir' string:\r\n;\r\n"
1217,1,";  $(Temp)      väliaikaishakemisto, oltava yksin\r\n;               target_dir-kentässä, ei saa seurata\r\n;               polkuosaa\r\n"
1218,1,";  $(ProgFiles) käyttäjän 'Program Files' -kansio\r\n;  $(WinDir)    windows-hakemisto\r\n;  $(SysDir)    järjestelmäkansio\r\n"
1219,1,";  $[variable]  ympäristömuuttujan arvo, jota kuvaa\r\n;               'variable'\r\n;  $<regkey>    rekisteriarvon arvo, jota kuvaa 'regkey'\r\n;  e.g SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\ProgramFilesDir\r\n\r\n"
1220,1,"\r\n;määritä, voiko käyttäjä vaihtaa kohdehakemistoa\r\n;purettaessa\r\n;aseta arvoksi 1, jos haluat ottaa tämän käyttöön\r\n\r\n"
1221,1,"\r\n;määritä, poistetaanko puretut tiedostot väliaikaiskansiosta\r\n;kun 'command'-muuttujalla määritetyn ohjelman suoritus päättyy\r\n"
1222,1,";aseta arvoksi 1, jos haluat poistaa väliaikaiset tiedostot\r\n;tämän muuttujan käyttö on järkevää vain, jos 'target_dir' on\r\n;"$(Temp)", muuten arvoa ei huomioida\r\n\r\n"
1223,1,"\r\n;määritä, käynnistetäänkö purku automaattisesti, kun käyttäjä\r\n;suorittaa itsepurkautuvan arkiston\r\n;aseta arvoksi 1, jos haluat purun alkavan automaattisesti\r\n\r\n"
1224,1,"\r\n;määritä, näytetäänkö tiedostojen purun onnistumisesta\r\n;ilmoittava viestiruutu purun päätyttyä\r\n;aseta arvoksi 1, jos haluat näyttää toimintoyhteenvedon\r\n\r\n"
1225,1,"\r\n;määritä, näytetäänkö itsepurkaimen pääikkuna\r\n;aseta arvoksi 1, jos et halua näyttää sfx-pääikkunaa\r\n;tämän muuttujan käyttö on järkevää vain, jos 'autostart' on 1,\r\n;muuten arvoa ei huomioida\r\n\r\n"
1226,1,"\r\n;määritä, korvataanko kaikki kohdehakemiston tiedostot\r\n;automaattisesti\r\n;aseta arvoksi 1, jos haluat tiedostojen korvaamisen\r\n;automaattisesti\r\n\r\n"
1227,1,"\r\n;määritä, luodaanko kohdehakemisto automaattisesti kysymättä\r\n;käyttäjältä\r\n;aseta arvoksi 1, jos haluat kohdehakemiston luomisen\r\n;automaattisesti\r\n\r\n"
1228,1,"\r\n;ohjelma, http-linkki tai asiakirja, joka suoritetaan/avataan, kun\r\n;tiedostojen purku on onnistuneesti valmis, polku on suhteellinen\r\n;purun kohdehakemistoon nähden, jos määrität ohjelman, voit myös\r\n;antaa sen argumentit\r\n\r\n"
1229,1,"\r\n;sfx-paketti, jota käytetään itsepurkautuvaa arkistoa luotaessa\r\n;suhteellinen polku suhteessa zip2sfx.exe:n hakemistoon\r\n\r\n"
1230,1,"\r\n;valinnaisessa viestiruudussa olevat painikkeet\r\n;voivat olla jokin seuraavista: "ok", "ok_cancel", "yes_no",\r\n;"agree_disagree"\r\n\r\n"
