[STRINGTABLE 0]
100,1,"DiskDir"
101,1,"Tạo và duyệt danh mục tệp tương thích với DiskDir của Total Commander."
102,1,"DiskDir"
103,1,"Giới thiệu DiskDir"
104,1,"Hỗ trợ tích hợp cho danh mục tương thích với DiskDir.\n\nCác tệp danh mục chứa tên, kích thước và dấu thời gian, không chứa nội dung tệp."
105,1,"Danh mục DiskDir"
106,1,"Đường dẫn danh mục không hợp lệ hoặc quá dài."
107,1,"Tên danh mục đã được một thư mục sử dụng."
108,1,"Danh mục đã tồn tại:\n\n"
109,1,"\n\nBạn có muốn ghi đè không?"
110,1,"Danh mục DiskDir không lưu nội dung tệp nên không thể di chuyển các tệp nguồn."
111,1,"Không hỗ trợ thêm mục vào danh mục DiskDir hiện có."

