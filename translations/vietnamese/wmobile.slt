[STRINGTABLE 0]
2000,0,"Windows Mobile"
2001,1,"Truy cập các tệp trên thiết bị Windows Mobile của bạn."
2002,1,"Về Plugin"

[STRINGTABLE 1]
3000,1,"Plugin Windows Mobile"
3001,1,"Lỗi Plugin Windows Mobile"
3002,1,"Câu hỏi Plugin Windows Mobile"
3003,1,"Không thể kết nối đến thiết bị.\n\nVui lòng đảm bảo bạn đã cài đặt truyền tải nền tảng (ví dụ: ActiveSync) và có thiết bị được kết nối."
3004,1,"Đang kết nối đến thiết bị, vui lòng chờ..."
3005,0,"Đường dẫn: %s\nLỗi: %s"
3006,1,"Bạn có muốn hủy thao tác này không?"
3007,1,"Hết bộ nhớ."

[STRINGTABLE 2]
3008,1,"Không thể hoàn thành thao tác vì đường dẫn quá dài."
3009,1,"Không thể tạo thư mục "%s"."
3010,1,"Thư mục "%s" không tồn tại.\n\nBạn có muốn tạo nó không?"
3011,1,"Tên "%s" đã được sử dụng cho một tệp."
3012,1,"Ngày có định dạng không hợp lệ."
3013,1,"Không thể hoàn thành thao tác vì tên quá dài."
3014,1,"Đường dẫn đã chỉ định chứa đường dẫn đến một tệp. Không thể mở tệp."
3015,1,"Không thể kết nối đến thiết bị.\r\n\r\nBạn có muốn đóng plugin không?"
3016,1,"Xin lỗi, nhưng plugin này không thể tạo thư mục trên ổ đĩa hoặc đường dẫn lưu trữ."
3017,1,"Xin lỗi, nhưng plugin này không thể tạo thư mục trên hệ thống tệp đã chỉ định."
3018,1,"Xin lỗi, nhưng plugin này không thể tạo thư mục ngoài ổ đĩa hiện đang mở."
