[STRINGTABLE 0]
100,1,"DiskDir"
101,1,"Ustvarja in pregleduje kataloge, združljive s Total Commander DiskDir."
102,1,"DiskDir"
103,1,"O DiskDir"
104,1,"Izvorna podpora za kataloge, združljive z DiskDir.\n\nKatalogi imajo imena, velikosti in časovne žige, ne vsebin."
105,1,"Katalog DiskDir"
106,1,"Pot kataloga je neveljavna ali predolga."
107,1,"Ime kataloga je že v uporabi kot imenik."
108,1,"The catalog already exists:\n\n"
109,1,"\n\nGa želite prepisati?"
110,1,"Katalogi DiskDir ne shranjujejo vsebin, zato datotek ni mogoče premeščati."
111,1,"Dodajanje vnosov v obstoječi katalog DiskDir ni podprto."

[STRINGTABLE 1]
112,1,"Ni mogoče ustvariti kataloga DiskDir."
113,1,"Izvirna datoteka, zabeležena v katalogu, ni na voljo."
