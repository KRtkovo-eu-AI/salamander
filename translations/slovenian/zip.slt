[STRINGTABLE 0]
139,1,"O vtičniku"

[STRINGTABLE 1]
1001,1,"Ni mogoče odpreti"
1002,1,"Nepravilni podatki."
1003,1,"Podpis konca centralnega imenika ni najden. Morda poškodovana datoteka."
1004,1,"Ni dovolj pomnilnika"
1005,1,"Ni mogoče dodati datoteke."
1006,1,"Ni mogoče dodati imenika."
1007,1,"ZIP"

[STRINGTABLE 2]
1008,1,"Datoteke, večje od 4 GB, niso podprte."
1009,1,"Ni mogoče dostopati"
1010,1,"Ni mogoče brati."
1011,1,"Nepričakovan konec."
1012,1,"Sporočilo o napaki je že prikazano. To besedilo se ne bi smelo pojaviti na zaslonu."
1013,1,"Ni mogoče odpreti/ustvariti."
1014,1,"Žal v tej različici vtičnika ZIP večdiskovni arhivi niso podprti."
1015,1,"Datoteka ima predolgo pot in je ni mogoče obdelati."
1016,1,"Datoteka ima predolgo ime poti in ne bo prikazana v plošči."
1017,1,"pripravljanje..."
1018,1,"Razpakiranje ZIP - %s"
1019,1,"Začasnega imenika v ciljnem imeniku ni mogoče ustvariti."
1020,1,"izvlečenje: "
1021,1,"Datoteke ni mogoče izvleči zaradi predolge poti."
1022,1,"Ni mogoče dodati enega ali več imenikov na seznam. Skupna pot je predolga.\nNekateri imeniki ali datoteke morda manjkajo v seznamu arhiva."
1023,1,"Napaka v podatkih arhiva."

[STRINGTABLE 3]
1024,1,"Datoteka je stisnjena z metodo, ki je ta različica vtičnika ZIP ne podpira."
1025,1,"Napaka v podatkih arhiva. CRC se ne ujema."
1026,1,"Ni mogoče zapisati."
1027,1,"Maska je predolga"
1028,1,"izvlečenje..."
1029,1,"Napačna raven."
1030,1,"Nepričakovana napaka pri stiskanju: blok je izginil."
1031,1,"Brisanje vnosov arhiva ZIP - %s"
1032,1,"brisanje..."
1033,1,"brisanje: "
1034,1,"prekinjanje operacije, počakajte..."
1035,1,"Ni mogoče ustvariti varnostne kopije."
1036,1,"Datoteka arhiva je samo za branje. Najprej počistite atribut za branje."
1037,1,"Prekinitev uporabnika. Besedilo ni za zaslon."
1038,1,"odstranjevanje odvečnih datotek ..."
1039,1,"dodajanje"

[STRINGTABLE 4]
1040,1,"dodaj: "
1041,1,"kopiranje arhiva..."
1042,1,"Preskoči datoteko. To besedilo ni namenjeno zaslonu."
1043,1,"Ni dostopa do imenika."
1044,1,"brisanje: "
1045,1,"Ni mogoče zamenjati izvirnega arhiva z začasno delovno datoteko. Arhiv ni spremenjen."
1046,1,"samodejno"
1047,1,"Raven stiskanja mora biti med 0 in 9."
1048,1,"Napaka"
1049,1,"Nepravilna velikost nosilca. Niz sme vsebovati samo številke in en decimalni ločilnik.\n\nVelikost mora biti vsaj 1KB in manj kot 4GB."
1050,1,"Vpisani gesli se ne ujemata."
1051,1,"Geslo mora biti dolgo vsaj en znak."
1052,1,"Geslo je nepravilno. Ponovno vpišite geslo. Črke v geslu vpišite z ustrezno velikostjo. Preverite, da CapsLock ni pomotoma vklopljen."
1053,1,"Nepravilno geslo"
1054,1,"Pakiranje ZIP-arhiv - %s"

[STRINGTABLE 5]
1056,1,"Obnovitev arhiva ZIP ni uspela. Podatki so morda poškodovani."
1057,1,"Šifriranje ni mogoče z metodo store (raven pakiranja 0)."
1058,1,"Samodejno razpakirajoči arhivi ne podpirajo šifriranja AES."
1059,1,"Ni mogoče narediti mape."
1060,1,"Arhiv z istim imenom datoteke že obstaja.\nVečnosilne arhive je mogoče ustvariti samo kot nov arhiv."
1061,1,"Navedeni datoteka že obstaja, ali jo želite prepisati?"
1062,1,"Pakiranje nosilca številka %d je končano.\nVstavite drug disk v pogon, uporabljen bo za nosilec arhiva številka %d."
1063,1,"bajti"
1064,1,"Na disku ni dovolj prostora. Disk ni mogoče uporabiti za pakiranje."
1065,1,"Opozorilo: Prosti prostor na disku je manjši od navedene velikosti nosilca."
1066,1,"Opozorilo: Na disku ni dovolj prostora."
1067,1,"Večnosilni arhivi ne morejo z metodo store (raven pakiranja 0)."
1068,1,"Vstavite disk z nosilcem številka %d ali poiščite datoteko na disku."
1069,1,"Arhiv ZIP (*.zip; *.z*; *.pk3; *.jar)"
1070,1,"Izberite arhiv"
1071,1,"*.zip;*.z*;*.pk3;*.jar"

[STRINGTABLE 6]
1072,1,"Želena operacija ni podprta za večnosilne arhive. Večnosilne arhive je mogoče samo izpisati in razpakirati.\n\nOpomba: Če to ni večnosilni arhiv, imajo podatki datoteke neznano obliko ali so poškodovani."
1073,1,"Nepravilna oblika podatkov. Manjka podpis glave datoteke."
1074,1,"Ne zaznam prostega prostora."
1075,1,"Napačna oblika podatkov. Manjka podpis osrednje glave datoteke."
1077,1,"pisanje samorazpakirnika..."
1078,1,"Ni mogoče nadaljevati. Datoteka ZIP ima predolgo ime poti."
1079,1,"Ne dobim imena modula."
1080,1,"To bo razpakiralo arhiv ZIP."
1081,1,"Ustvari nov arhiv"
1082,1,"Dodaj datoteke ZIP-u"
1083,1,"Samorazpakirni arhiv ZIP"
1084,1,"Naslov glavnega pogovornega okna ne sme biti prazen. Vnesite vsaj en znak."
1085,1,"Ne naložim shell32.dll. "
1086,1,"Ne morem dobiti naslova procedure iz dll modula. "
1087,1,"Ni mogoče dodati ikone v izvršljivi samorazpakirnik."

[STRINGTABLE 7]
1088,1,"Ne naložim ikone iz datoteke. "
1089,1,"Ni mogoče naložiti modula z ikonskimi podatki. Modul ni veljavna aplikacija Win32. "
