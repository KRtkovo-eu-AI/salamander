46,1,"SFTP"
47,1,"O vtičniku SFTP"

[STRINGTABLE 1]
48,1,"SFTP-odjemalec (SSH File Transfer Protocol) na libssh2."
49,1,"https://github.com/Dupl3xx/salamander-sftp-plugin"
50,1,"V Sftp je prišlo do izjeme, prosimo obvestite avtorje!\nČe ste takrat delali z datoteko .dop,\nprosimo poskusite napako ponovno ustvariti s to datoteko .dop in če se\nizjema ponovno pojavi, nam pošljite to datoteko .dop (napako bomo ustvarili in odpravili).\nHvala!"
51,1,"petr.solin@altap.cz"
52,1,"Konfiguracija je že odprta."
53,1,"Nekatera okna pregledovalnika Sftp so odprta. Ali jih želite zapreti?"
54,1,"Konfiguracija Sftp"
55,1,"Neveljavna številka!"
56,1,"Datoteke Sftp (*.dop)|*.dop|Vse datoteke (*.*)|*.*|"

