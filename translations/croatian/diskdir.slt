[STRINGTABLE 0]
100,1,"DiskDir"
101,1,"Stvara i pregledava kataloge datoteka kompatibilne s Total Commander DiskDirom."
102,1,"DiskDir"
103,1,"O DiskDiru"
104,1,"Izvorna podrška za kataloge kompatibilne s DiskDirom.\n\nDatoteke kataloga sadrže nazive, veličine i vremenske oznake, a ne sadržaj datoteka."
105,1,"DiskDir katalog"
106,1,"Putanja kataloga nije valjana ili je preduga."
107,1,"Naziv kataloga već koristi direktorij."
108,1,"Katalog već postoji:\n\n"
109,1,"\n\nŽelite li ga prebrisati?"
110,1,"DiskDir katalozi ne pohranjuju sadržaj datoteka pa se izvorne datoteke ne mogu premjestiti."
111,1,"Dodavanje stavki u postojeći DiskDir katalog nije podržano."

[STRINGTABLE 1]
112,1,"Nije moguće stvoriti DiskDir katalog."
113,1,"Izvorna datoteka zabilježena u katalogu nije dostupna."
114,1,"Jedna ili više izvornih datoteka zabilježenih u katalogu nisu dostupne."
