1211,1,";Noktalı virgülle (;) başlayan satırlar açıklama olarak değerlendirilir ve\r\n;ayar dosyası işlenirken yok sayılır.\r\n;\r\n"
1212,1,";version dışındaki tüm değişkenler isteğe bağlıdır. Değişken\r\n;dosyada bulunmazsa varsayılan değeri kullanılır.\r\n;Dile bağlı değişkenlerin (dlg_text, dlg_title, button_text)\r\n;varsayılan değerleri SFX paketinden alınır.\r\n;\r\n"
1213,1,";Boş dizeler dahil tüm dize değerleri çift tırnak içine\r\n;alınmalıdır. Dize içinde çift tırnak kullanmak için art arda\r\n;iki çift tırnak yazın.\r\n;\r\n;Sayılar çift tırnak içine alınamaz.\r\n\r\n"
1214,1,"\r\n;ayar dosyasının sürümü; geçerli sürüm 2\r\n;bu tek zorunlu değişkendir\r\n\r\n"
1215,1,"\r\n;hedef dizini belirtin; mutlak veya göreli bir yol olabilir\r\n;göreli yol, SFX çalıştırılabilir dosyası başlatıldığında\r\n;geçerli dizine göre değerlendirilir\r\n"

[STRINGTABLE 15]
1216,1,";'target_dir' dizesinin başında önceden tanımlanmış\r\n;değişkenleri (!) de kullanabilirsiniz:\r\n;\r\n"
1217,1,";  $(Temp)      geçici dizin; tek başına kullanılmalıdır\r\n;               target_dir alanında ardından herhangi bir yol\r\n;               parçası gelmemelidir\r\n"
1218,1,";  $(ProgFiles) kullanıcının 'Program Files' klasörü\r\n;  $(WinDir)    Windows dizini\r\n;  $(SysDir)    sistem dizini\r\n"
1219,1,";  $[variable]  'variable' ile belirtilen ortam\r\n;               değişkeninin değeri\r\n;  $<regkey>    'regkey' ile belirtilen kayıt defteri\r\n;               anahtarının değeri; ör. SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\ProgramFilesDir\r\n\r\n"
1220,1,"\r\n;paket açılırken kullanıcının hedef dizini değiştirip\r\n;değiştiremeyeceğini belirtin\r\n;bunu etkinleştirmek için değeri 1 yapın\r\n\r\n"
1221,1,"\r\n;'command' değişkeninde belirtilen program tamamlandığında\r\n;geçici klasördeki çıkarılmış dosyaların silinip silinmeyeceğini belirtin\r\n"
1222,1,";geçici dosyaları silmek için değeri 1 yapın\r\n;bu değişken yalnızca 'target_dir' değeri\r\n;"$(Temp)" ise anlamlıdır; aksi halde yok sayılır\r\n\r\n"
1223,1,"\r\n;kendiliğinden açılan arşiv çalıştırıldığında dosyaların\r\n;otomatik çıkarılıp çıkarılmayacağını belirtin\r\n;çıkarmayı otomatik başlatmak için değeri 1 yapın\r\n\r\n"
1224,1,"\r\n;dosyalar çıkarıldıktan sonra işlemin başarılı olduğunu\r\n;bildiren ileti kutusunun gösterilip gösterilmeyeceğini belirtin\r\n;işlem özetini göstermek için değeri 1 yapın\r\n\r\n"
1225,1,"\r\n;kendiliğinden açılan arşivin ana iletişim kutusunun\r\n;gösterilip gösterilmeyeceğini belirtin\r\n;ana SFX iletişim kutusunu gizlemek için değeri 1 yapın\r\n;yalnızca 'autostart' 1 ise anlamlıdır; aksi halde yok sayılır\r\n\r\n"
1226,1,"\r\n;hedef dizindeki tüm dosyaların otomatik olarak\r\n;üzerine yazılıp yazılmayacağını belirtin\r\n;dosyaların otomatik üzerine yazılması için değeri 1 yapın\r\n;\r\n\r\n"
1227,1,"\r\n;kullanıcıya sormadan hedef dizinin otomatik\r\n;oluşturulup oluşturulmayacağını belirtin\r\n;hedef dizini otomatik oluşturmak için değeri 1 yapın\r\n;\r\n\r\n"
1228,1,"\r\n;dosyalar başarıyla çıkarıldıktan sonra çalıştırılacak\r\n;veya açılacak program, HTTP bağlantısı ya da belge; yol\r\n;çıkarma hedef dizinine göredir. Program belirtirseniz\r\n;argümanlarını da girebilirsiniz\r\n\r\n"
1229,1,"\r\n;kendiliğinden açılan arşiv oluştururken kullanılacak SFX paketi\r\n;göreli yol, zip2sfx.exe dosyasının bulunduğu dizine göredir\r\n\r\n"
1230,1,"\r\n;isteğe bağlı ileti kutusundaki düğmeler\r\n;aşağıdakilerden biri olabilir: "ok", "ok_cancel", "yes_no",\r\n;"agree_disagree"\r\n\r\n"
1231,1,"\r\n;isteğe bağlı ileti kutusunun türü\r\n;aşağıdakilerden biri olabilir: "simple", "exclamation", "information",\r\n;"question", "long_message"\r\n\r\n"

