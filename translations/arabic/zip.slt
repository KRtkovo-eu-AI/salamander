1198,1,"خطأ AES."
1199,1,"رمز المصادقة غير متطابق. إما أن الملف تالف أو أن كلمة المرور غير صحيحة."

[STRINGTABLE 14]
1200,1,"العملية المطلوبة غير مدعومة لأرشيفات zip64. يمكن عرض قائمة أرشيفات zip64 وفك ضغطها فقط."
1201,1," (متاح في الإصدار الكامل فقط)"
1202,1,"إنشاء أرشيفات ZIP واستعراضها واستخراجها."
1208,1,"حدث خطأ في تدفق BZIP2. قد يكون الأرشيف تالفًا."
1209,1,"الدليل المركزي لهذا الأرشيف، الذي يحتوي على قائمة الملفات، مشفر أو مضغوط.\nوهذا غير مدعوم."
1210,1,";إعدادات أداة الاستخراج الذاتي\r\n\r\n;هذا ملف إعدادات أداة الاستخراج الذاتي.\r\n;\r\n;صياغة تنسيق الملف:\r\n;\r\n"
1211,1,";تُعامل الأسطر التي تبدأ بالرمز ';' كتعليقات ويتم\r\n;تجاهلها أثناء معالجة ملف الإعدادات.\r\n;\r\n"
1212,1,";جميع المتغيرات اختيارية ما عدا version. إذا لم يتم العثور على المتغير\r\n;في ملف الإعدادات، تُستخدم قيمته الافتراضية.\r\n;تُؤخذ القيم الافتراضية للمتغيرات المعتمدة على اللغة (dlg_text, dlg_title,\r\n;button_text) من حزمة sfx.\r\n;\r\n"
1213,1,";يجب وضع جميع القيم النصية، بما فيها النصوص الفارغة، بين\r\n;علامتي اقتباس مزدوجتين. لإدخال علامة اقتباس مزدوجة في النص استخدم\r\n;علامتي اقتباس مزدوجتين متتاليتين.\r\n;\r\n;لا يجوز وضع الأرقام بين علامتي اقتباس مزدوجتين.\r\n\r\n"
1214,1,"\r\n;إصدار ملف الإعدادات، الإصدار الحالي هو 2\r\n;هذا هو المتغير الإلزامي الوحيد\r\n\r\n"
1215,1,"\r\n;تحديد مجلد الوجهة، ويمكن أن يكون مسارًا مطلقًا\r\n;أو نسبيًا؛ ويكون المسار النسبي نسبةً إلى المجلد الحالي\r\n;عند تشغيل الملف التنفيذي لـ sfx\r\n"

[STRINGTABLE 15]
1216,1,";يمكنك أيضًا استخدام متغيرات محددة مسبقًا في بداية (!)‏\r\n;النص 'target_dir':\r\n;\r\n"
1217,1,";  $(Temp)      المجلد المؤقت، ويجب أن يظهر منفردًا فقط\r\n;               في الحقل target_dir دون أن يتبعه أي جزء\r\n;               من المسار\r\n"
1218,1,";  $(ProgFiles) مجلد 'Program Files' للمستخدم\r\n;  $(WinDir)    مجلد Windows\r\n;  $(SysDir)    مجلد النظام\r\n"
1219,1,";  $[variable]  قيمة متغير بيئة يحدده\r\n;               'variable'\r\n;  $<regkey>    قيمة إدخال سجل يحدده 'regkey'\r\n;               مثال: SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\ProgramFilesDir\r\n\r\n"
1220,1,"\r\n;حدد ما إذا كان بإمكان المستخدم تغيير مجلد الوجهة عند\r\n;فك الضغط\r\n;عيّن القيمة إلى 1 لتمكين ذلك\r\n\r\n"
1221,1,"\r\n;حدد ما إذا كان ينبغي إزالة الملفات المستخرجة من المجلد المؤقت\r\n;عند انتهاء البرنامج المحدد بالمتغير 'command'\r\n"
1222,1,";عيّن القيمة إلى 1 لإزالة الملفات المؤقتة\r\n;يكون لهذا المتغير معنى فقط إذا كانت قيمة 'target_dir' هي\r\n;"$(Temp)", وإلا فسيتم تجاهل القيمة\r\n\r\n"
1223,1,"\r\n;حدد ما إذا كان ينبغي بدء الاستخراج تلقائيًا عند تشغيل المستخدم\r\n;لأرشيف ذاتي الاستخراج\r\n;عيّن القيمة إلى 1 لبدء الاستخراج تلقائيًا\r\n\r\n"
1224,1,"\r\n;حدد ما إذا كان ينبغي عرض مربع رسالة لإعلام المستخدم بنجاح العملية\r\n;بعد اكتمال استخراج الملفات\r\n;عيّن القيمة إلى 1 لعرض ملخص العملية\r\n\r\n"
1225,1,"\r\n;حدد ما إذا كان ينبغي عرض مربع الحوار الرئيسي لأداة الاستخراج الذاتي\r\n;عيّن القيمة إلى 1 إذا كنت لا تريد عرض مربع حوار sfx الرئيسي\r\n;يكون لهذا المتغير معنى فقط إذا كانت قيمة 'autostart' تساوي 1،\r\n;وإلا فسيتم تجاهل القيمة\r\n\r\n"
1226,1,"\r\n;حدد ما إذا كان ينبغي استبدال جميع الملفات في مجلد الوجهة تلقائيًا\r\n;\r\n;عيّن القيمة إلى 1 لاستبدال الملفات\r\n;تلقائيًا\r\n\r\n"
1227,1,"\r\n;حدد ما إذا كان ينبغي إنشاء مجلد الوجهة تلقائيًا دون سؤال\r\n;المستخدم\r\n;عيّن القيمة إلى 1 لإنشاء مجلد الوجهة\r\n;تلقائيًا\r\n\r\n"
1228,1,"\r\n;البرنامج أو رابط http أو المستند الذي سيُشغّل/يُفتح عند اكتمال\r\n;استخراج الملفات بنجاح. المسار نسبي إلى مجلد وجهة الاستخراج. إذا حددت\r\n;برنامجًا، يمكنك أيضًا إدخال وسيطاته\r\n\r\n"
1229,1,"\r\n;حزمة sfx التي ستستخدم عند إنشاء أرشيف ذاتي الاستخراج\r\n;المسار النسبي نسبةً إلى المجلد الذي يحتوي على zip2sfx.exe\r\n\r\n"
1230,1,"\r\n;الأزرار في مربع الرسالة الاختياري\r\n;يمكن أن تكون إحدى القيم التالية: "ok" أو "ok_cancel" أو "yes_no"،\r\n;"agree_disagree"\r\n\r\n"
1231,1,"\r\n;نوع مربع الرسالة الاختياري\r\n;يمكن أن يكون إحدى القيم التالية: "simple" أو "exclamation" أو "information"،\r\n;"question" أو "long_message"\r\n\r\n"

[STRINGTABLE 16]
1232,1,"\r\n;نص مربع الرسالة الاختياري وعنوانه، ويُعرض قبل بدء\r\n;الاستخراج\r\n;إذا لم ترد عرض أي مربع رسالة، فاترك كلا الحقلين\r\n;فارغين ("")\r\n\r\n"
1233,1,"\r\n;النص الذي سيُعرض في مربع الحوار الرئيسي لأداة الاستخراج الذاتي\r\n\r\n"
1234,1,"\r\n;عنوان مربع الحوار الرئيسي لأداة الاستخراج الذاتي\r\n\r\n"
1235,1,"\r\n;النص في زر الاستخراج بمربع حوار sfx الرئيسي\r\n\r\n"
1236,1,"\r\n;اسم المورد في الزاوية السفلية اليسرى لمربع حوار sfx الرئيسي\r\n\r\n"
1237,1,"\r\n;رابط www في الزاوية السفلية اليمنى لمربع حوار sfx الرئيسي\r\n\r\n"
1238,1,"\r\n;الملفات التي تحتوي على بيانات الأيقونة، ويمكن أن تكون ملف ICO أو ملفًا\r\n;تنفيذيًا PE (مثل ملفات EXE أو DLL الخاصة بـ Win32) يحتوي على الأيقونة\r\n;المسار النسبي نسبةً إلى المجلد الذي يحتوي على zip2sfx.exe\r\n\r\n"
1239,1,"\r\n;القيمة الموجبة تعني فهرس الأيقونة في الملف التنفيذي\r\n;المحدد بالمتغير 'icon_file'\r\n;القيمة السالبة تعني معرّف مورد الأيقونة\r\n;في ملفات ICO يكون الفهرس دائمًا 0 ويتم تجاهل قيمته\r\n\r\n"
1240,1,"\r\n;يتيح لك هذا الخيار انتظار عملية أخرى غير العملية\r\n;المحددة في الحقل 'Command'. بعد انتهاء هذه العملية، تزيل أداة\r\n;الاستخراج الذاتي الملفات المؤقتة ثم تنهي عملها.\r\n"
1241,1,";هذا ضروري فقط إذا شغّل برنامج التثبيت ملفًا تنفيذيًا آخر\r\n;يتابع التثبيت بعد انتهاء برنامج التثبيت الأصلي.\r\n"
1242,1,";تعمل بهذه الطريقة مثلًا بعض إصدارات Install Shield.\r\n;يتم تجاهل هذا الخيار ما لم تكن قيمة 'remove_temp' تساوي 1.\r\n\r\n"
1243,1,"\r\n;يتطلب امتيازات المسؤول للتشغيل على Windows Vista أو أحدث\r\n\r\n"

