[STRINGTABLE 0]
1,1,"ملف LZH غير صالح أو تنسيق ملف غير معروف."
2,1,"خطأ في المجموع الاختباري للرأس.\nالأرشيف تالف؛ لا يمكن عرض جميع الملفات."
3,1,"نفدت الذاكرة."
4,1,"خطأ في الكتابة"
5,1,"UnLHA"
6,1,"خطأ في فتح الأرشيف."
7,1,"تعذّر إضافة عنصر الأرشيف إلى قائمة الملفات."
8,1,"يحتوي الأرشيف على رابط رمزي واحد أو أكثر من UNIX، ولن تظهر."
10,1,"تعذّر استخراج الملف."
11,1,"خطأ في البيانات المضغوطة. CRC غير متطابق."
12,1,"خطأ أثناء قراءة الأرشيف."
13,1,"استخراج أرشيف LHA - %s"
14,1,"جارٍ تجهيز البيانات وإنشاء المجلدات..."
15,1,"جارٍ الاستخراج: "

[STRINGTABLE 1]
16,1,"جارٍ الاستخراج..."
17,1,"تعذّر إكمال العملية لأن مسار الاسم طويل جدًا."
18,1,"تعذّر إكمال العملية لأن القناع طويل جدًا."
19,1,"طريقة ضغط غير معروفة. لا يمكن استخراج الملف."
