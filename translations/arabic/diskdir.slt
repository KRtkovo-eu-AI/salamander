[STRINGTABLE 0]
100,1,"DiskDir"
101,1,"ينشئ ويتصفح فهارس ملفات متوافقة مع DiskDir في Total Commander."
102,1,"DiskDir"
103,1,"حول DiskDir"
104,1,"دعم أصلي لفهارس DiskDir المتوافقة.\n\nتحتوي ملفات الفهرس على الأسماء والأحجام والتواريخ، وليس محتويات الملفات."
105,1,"فهرس DiskDir"
106,1,"مسار الفهرس غير صالح أو طويل جدًا."
107,1,"اسم الفهرس مستخدم بالفعل من قبل مجلد."
108,1,"الفهرس موجود بالفعل:\n\n"
109,1,"\n\nهل تريد استبداله؟"
110,1,"لا تخزن فهارس DiskDir محتويات الملفات، لذلك لا يمكن نقل الملفات المصدرية."
111,1,"إضافة مدخلات إلى فهرس DiskDir موجود غير مدعومة."

[STRINGTABLE 1]
112,1,"تعذر إنشاء فهرس DiskDir."
113,1,"الملف الأصلي المسجل في الفهرس غير متاح."
114,1,"واحد أو أكثر من الملفات الأصلية المسجلة في الفهرس غير متاح."
115,1,"تعذر فتح الفهرس."
116,1,"الفهرس كبير جدًا."
117,1,"تعذرت قراءة الفهرس."
118,1,"يحتوي فهرس UTF-8 على نص غير صالح."
119,1,"الملف لا يحتوي على فهرس DiskDir صالح."
120,1,"تعذرت كتابة فهرس DiskDir."

