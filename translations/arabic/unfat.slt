[STRINGTABLE 2]
1104,1,"خطأ أثناء قراءة المجلد من الملف "%s".\n%s\nالقطاع: %d، الإزاحة: 0x%s\n\nالملف ليس صورة FAT 12 أو 16 أو 32."
1106,1,"خطأ أثناء قراءة الملف من الملف "%s".\n%s\nالعنقود: %d\n\nالملف ليس صورة FAT 12 أو 16 أو 32."
1107,1,"خطأ أثناء كتابة الملف"
1108,1,"يبدو أن الملف "%s" صورة لقرص صلب كامل.\nلا يدعم ملحق UnFAT هذه الصور."
