[STRINGTABLE 0]
1000,1,"UnFAT"
1001,1,"حول الملحق"
1003,1,"استعراض صور الأقراص FAT 12 و16 و32 واستخراجها."

[STRINGTABLE 1]
1100,1,"تعذّر فتح الملف "%s"."
1101,1,"خطأ أثناء قراءة الملف "%s"."
1102,1,"خطأ في تحليل الملف "%s".\n\n%s"
