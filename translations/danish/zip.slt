1209,1,"Central Directory i dette arkiv, der indeholder fillisten, er krypteret eller komprimeret.\nDette understøttes ikke."
1210,1,";Self-Extractor Settings\r\n\r\n;This is settings file for Self-Extractor.\r\n;\r\n;File format syntax:\r\n;\r\n"
1211,1,";Linjer der begynder med ';'-tegnet er kommentarer og ignoreres\r\n;under behandling af indstillingsfilen.\r\n;\r\n"
1212,1,";Alle variabler undtagen version er valgfrie. Hvis variablen ikke\r\n;findes i indstillingsfilen, anvendes dens standardværdi.\r\n;Standardværdier for sprogafhængige variabler (dlg_text, dlg_title,\r\n;button_text) tages fra sfx-pakken.\r\n;\r\n"
1213,1,";Alle strengværdier, inkl. nullstrenge, skal være i\r\n;dobbelt anførselstegn. Brug to efterfølgende dobbelte\r\n;anførselstegn for at indtaste dem i strengen.\r\n;\r\n;Tal kan ikke være i dobbelte anførselstegn.\r\n\r\n"
1214,1,"\r\n;version af indstillingsfilen, aktuel version er 2\r\n;dette er den eneste obligatoriske variabel\r\n\r\n"
1215,1,"\r\n;specifikation af målkatalog, enten absolut sti\r\n;eller relativ sti; relativ sti er relativ til den aktuelle katalog\r\n;når sfx-programmet startes\r\n"

[STRINGTABLE 15]
1216,1,";you could also use predefined variables at the beginning (!)\r\n;of the 'target_dir' string:\r\n;\r\n"
1217,1,";  $(Temp)      midlertidig mappe, bør stå alene\r\n;               i feltet target_dir uden efterfølgende sti\r\n;               del\r\n"
1218,1,";  $(ProgFiles) brugerens mappe 'Program Files'\r\n;  $(WinDir)    windows-mappe\r\n;  $(SysDir)    systemmappe\r\n"
1219,1,";  $[variable]  værdien af en miljøvariabel beskrevet ved\r\n;               'variable'\r\n;  $<regkey>    værdien af registernøglen 'regkey'\r\n;  f.eks. SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\ProgramFilesDir\r\n\r\n"
1220,1,"\r\n;angiv, om brugeren kan ændre en målmappe ved\r\n;udpakning\r\n;indstil værdien til 1 for at aktivere dette\r\n\r\n"
1221,1,"\r\n;angiv, om udpakkede filer i den midlertidige mappe skal fjernes\r\n;når et program angivet ved variablen 'command' er afsluttet\r\n"
1222,1,";indstil til 1, hvis du vil fjerne de midlertidige filer\r\n;denne variabel giver kun mening, hvis 'target_dir' er sat til\r\n;"$(Temp)", ellers ignoreres værdien\r\n\r\n"
1223,1,"\r\n;angiv, om udpakningen skal starte automatisk, når en bruger kører\r\n;et selvudpakningsarkiv\r\n;indstil værdien til 1, hvis udpakningen skal starte automatisk\r\n\r\n"
1224,1,"\r\n;angiv, om der skal vises en meddelelsesboks, der bekræfter\r\n;operationen, når filudpakningen er fuldført\r\n;indstil til 1, hvis du vil vise et operationsresumé\r\n\r\n"
1225,1,"\r\n;angiv, om hoveddialogen for selvudpakkeren skal vises\r\n;indstil til 1, hvis du ikke vil vise hoveddialogen for sfx\r\n;brug af denne variabel giver kun mening, hvis 'autostart' er sat til 1,\r\n;ellers ignoreres værdien\r\n\r\n"
1226,1,"\r\n;angiv, om alle filer i mål\r\n;mappen skal overskrives automatisk\r\n;indstil til 1, hvis filerne skal overskrives\r\n;automatisk\r\n\r\n"
1227,1,"\r\n;angiv, om målmappen skal oprettes automatisk uden at spørge\r\n;brugeren\r\n;indstil til 1, hvis målmappen skal oprettes\r\n;automatisk\r\n\r\n"
1228,1,"\r\n;program, http-link eller dokument, der skal køres/åbnes, når\r\n;filerne er udpakket, stien er relativ til\r\n;målmappen for udpakningen, hvis du angiver et program, kan du\r\n;også angive dets argumenter\r\n\r\n"
1229,1,"\r\n;sfx-pakke, der bruges ved oprettelse af et selvudpakningsarkiv\r\n;den relative sti er relativ til mappen med zip2sfx.exe\r\n\r\n"
1230,1,"\r\n;knapper i den valgfrie meddelelsesboks\r\n;kan være en af følgende: "ok", "ok_cancel", "yes_no",\r\n;"agree_disagree"\r\n\r\n"
1231,1,"\r\n;type af den valgfrie meddelelsesboks\r\n;mulige værdier: "simple", "exclamation", "information",\r\n;"question", "long_message"\r\n\r\n"

[STRINGTABLE 16]
1232,1,"\r\n;tekst og titel på den valgfrie meddelelsesboks, der vises før\r\n;udpakningen starter\r\n;hvis du ikke vil vise en meddelelsesboks, lad begge felter\r\n;stå tomme ("")\r\n\r\n"
1233,1,"\r\n;tekst, der vises i hoveddialogen for selvudpakkeren\r\n\r\n"
1234,1,"\r\n;titel på hoveddialogen for selvudpakkeren\r\n\r\n"
1235,1,"\r\n;tekst i udpakningsknappen i hoveddialogen for sfx\r\n\r\n"
1236,1,"\r\n;udbydernavn nederst til venstre i sfx-dialogen\r\n\r\n"
1237,1,"\r\n;www-link nederst til højre i sfx-dialogen\r\n\r\n"
1238,1,"\r\n;filer, der indeholder ikond data, enten en ICO-fil eller en\r\n;PE-fil (f.eks. win32 EXE eller DLL) med ikonet\r\n;den relative sti er relativ til mappen med zip2sfx.exe\r\n\r\n"
1239,1,"\r\n;positiv værdi betyder indekset for et ikon i den eksekverbare fil\r\n;angivet ved variablen 'icon_file'\r\n;negativ værdi betyder et ressource-ID for ikonet\r\n;for ICO-filer er indekset altid 0, og værdien ignoreres\r\n\r\n"
1240,1,"\r\n;Denne indstilling lader dig vente på en anden proces end processen\r\n;du angav i feltet 'Command'. Når denne proces er afsluttet\r\n;fjerner selvudpakkeren de midlertidige filer og afslutter sig selv.\r\n"
1241,1,";Kun nødvendig, hvis installationsprogrammet starter en anden\r\n;eksekverbar fil, der fortsætter installationen, mens det oprindelige\r\n;program er afsluttet.\r\n"
1242,1,";Sådan gør f.eks. visse versioner af Install Shield.\r\n;Ignoreres, medmindre 'remove_temp' er sat til 1.\r\n\r\n"
1243,1,"\r\n;kræver administrative rettigheder på Windows Vista eller nyere\r\n\r\n"

