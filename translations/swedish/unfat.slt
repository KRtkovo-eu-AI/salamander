[STRINGTABLE 0]
1000,1,"UnFAT"
1001,1,"Om insticksmodulen"
1003,1,"Bläddra bland och packa upp FAT 12-, 16- och 32-diskavbildningar."

[STRINGTABLE 1]
1100,1,"Det går inte att öppna filen "%s"."
1101,1,"Det gick inte att läsa filen "%s"."
1102,1,"Det gick inte att tolka filen "%s".\n\n%s"
1103,1,"Startsektorn är skadad eller så är filen inte en FAT 12-, 16- eller 32-avbildning."

[STRINGTABLE 2]
1104,1,"Det gick inte att läsa katalogen från filen "%s".\n%s\nSektor: %d, position: 0x%s\n\nFilen är inte en giltig FAT 12-, 16- eller 32-avbildning."
1106,1,"Det gick inte att läsa filen från filen "%s".\n%s\nKluster: %d\n\nFilen är inte en giltig FAT 12-, 16- eller 32-avbildning."
1107,1,"Det gick inte att skriva filen"
1108,1,"Filen "%s" verkar vara en avbildning av en hel hårddisk.\nUnFAT-insticksmodulen stöder inte sådana avbildningar."
1109,1,"Packar upp FAT-avbildning - %s"
1110,1,"packar upp: %s"

